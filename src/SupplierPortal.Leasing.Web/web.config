<?xml version="1.0" encoding="utf-8"?>
<!--
  Base web.config shipped with the project. "dotnet publish" keeps this file and
  updates the <aspNetCore> processPath/arguments for the published app.

  The <remove> entries below disable the IIS WebDAV module and handler for this
  site. WebDAV (when installed on the server) intercepts PUT and DELETE requests
  and returns "405 Method Not Allowed" BEFORE they reach ASP.NET Core, which broke
  the self-service Save (PUT) and document-delete (DELETE) calls. Removing it here
  lets those verbs reach the app. POST and GET were never affected.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <aspNetCore processPath="dotnet" arguments=".\SupplierPortal.Leasing.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
