@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu @rendermode="InteractiveServer" />
    </div>

    <main>
        <div class="di-topbar no-print">
            @* Deployed build stamp — which version is live on the site. Values come from the built assembly. *@
            <span class="di-ver" title="@VersionTooltip">
                <span class="di-ver-dot"></span>
                <span class="di-ver-build">Build @SupplierPortal.Leasing.Web.AppVersion.BuildNumber</span>
                @if (!string.IsNullOrEmpty(SupplierPortal.Leasing.Web.AppVersion.Commit))
                {
                    <span class="di-ver-sep">·</span><span class="di-ver-sha">@SupplierPortal.Leasing.Web.AppVersion.Commit</span>
                }
                <span class="di-ver-sep">·</span><span class="di-ver-date">Updated @SupplierPortal.Leasing.Web.AppVersion.BuildDateDisplay</span>
            </span>
            <button type="button" class="di-theme-toggle di-sidebar-toggle" onclick="diSidebar.toggle()"
                    title="Hide / show navigation" aria-label="Hide or show the navigation sidebar">
                <svg class="di-ico-navhide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m16 15-3-3 3-3"/></svg>
                <svg class="di-ico-navshow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m14 9 3 3-3 3"/></svg>
            </button>
            <button type="button" class="di-theme-toggle" onclick="diTheme.toggle()"
                    title="Toggle light / dark theme" aria-label="Toggle light or dark theme">
                <svg class="di-ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
                <svg class="di-ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            </button>
            <LandlordBell @rendermode="InteractiveServer" />
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<LoadingBar @rendermode="InteractiveServer" />
<ToastContainer @rendermode="InteractiveServer" />
@* Locks the screen (auto-logout) after 15 minutes of inactivity for signed-in app users. *@
<IdleGuard @rendermode="InteractiveServer" TimeoutMinutes="15" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Tooltip for the topbar build stamp (kept out of the markup so nested quotes don't break Razor parsing).
    private static string VersionTooltip =>
        $"Deployed build {SupplierPortal.Leasing.Web.AppVersion.BuildNumber}"
        + (string.IsNullOrEmpty(SupplierPortal.Leasing.Web.AppVersion.Commit) ? "" : $" · commit {SupplierPortal.Leasing.Web.AppVersion.Commit}")
        + $" · updated {SupplierPortal.Leasing.Web.AppVersion.BuildDateDisplay}";
}
