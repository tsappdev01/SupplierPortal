@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models.Leasing
@using SupplierPortal.Web.Services
@using SupplierPortal.Web.Services.Leasing
@inject LandlordService LandlordService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="di-notif">
    <a class="di-notif-btn" href="/admin/landlords" title="Landlord registrations">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21h18" /><path d="M5 21V8l7-5 7 5v13" /><path d="M9 21v-6h6v6" />
        </svg>
    </a>

    <div class="di-notif-wrap">
        <button type="button" class="di-notif-btn" @onclick="ToggleAsync" title="Landlord registrations awaiting review">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            @if (pending.Count > 0)
            {
                <span class="di-notif-badge">@(pending.Count > 99 ? "99+" : pending.Count.ToString())</span>
            }
        </button>

        @if (open)
        {
            <div class="di-notif-panel">
                <div class="di-notif-head">
                    <span>Awaiting review</span>
                    <span class="di-notif-count">@pending.Count</span>
                </div>
                @if (pending.Count == 0)
                {
                    <div class="di-notif-empty">No landlord registrations awaiting review.</div>
                }
                else
                {
                    <div class="di-notif-list">
                        @foreach (var item in pending)
                        {
                            <button type="button" class="di-notif-item" @onclick="() => GoTo(item.Id)">
                                <span class="di-notif-name">@(string.IsNullOrWhiteSpace(item.DisplayName) ? item.PropertyCode : item.DisplayName)</span>
                                <span class="di-notif-meta">@item.PropertyCode &middot; @item.Status &middot; @item.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                            </button>
                        }
                    </div>
                    <a class="di-notif-foot" href="/admin/landlords" @onclick="Close">View all registrations</a>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<LandlordListItem> pending = [];
    private bool open;
    private bool isAdministrator;
    private int? businessUnitId;
    private Timer? refreshTimer;

    private static readonly LandlordStatus[] AwaitingStatuses = [LandlordStatus.Submitted, LandlordStatus.UnderReview];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdministrator = state.User.IsAdministrator();
        businessUnitId = isAdministrator ? null : state.User.GetBusinessUnitIds().Cast<int?>().FirstOrDefault();
        await ReloadAsync();
        refreshTimer = new Timer(async _ => await InvokeAsync(ReloadAsync), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private async Task ReloadAsync()
    {
        var all = await LandlordService.GetAllAsync(businessUnitId, AwaitingStatuses);
        pending = all.OrderByDescending(x => x.UpdatedAt).ToList();
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        open = !open;
        if (open) await ReloadAsync();
    }

    private void Close() => open = false;

    private void GoTo(int landlordId)
    {
        open = false;
        NavigationManager.NavigateTo($"/admin/landlords/{landlordId}");
    }

    public void Dispose() => refreshTimer?.Dispose();
}
