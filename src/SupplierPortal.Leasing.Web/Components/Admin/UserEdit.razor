@page "/admin/users/edit/{Id:int}"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject UserService UserService
@inject LoadingService Loading
@inject BusinessUnitService BusinessUnitService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Edit User - Supplier Portal</PageTitle>

<div class="di-cfm" style="max-width: 760px;">
    <div class="di-cfm-card">
        <div class="di-cfm-head">
            <div class="di-cfm-head-icon">
                <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/><path d="M8.256 14a4.474 4.474 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10c.26 0 .507.009.74.025.226-.341.496-.65.804-.918C9.077 9.038 8.564 9 8 9c-5 0-6 3-6 4s1 1 1 1h5.256z"/><path d="M15.854 5.146a.5.5 0 0 1 0 .708l-5 5a.5.5 0 0 1-.708 0l-2.5-2.5a.5.5 0 1 1 .708-.708L10.5 9.793l4.646-4.647a.5.5 0 0 1 .708 0z"/></svg>
            </div>
            <div class="di-cfm-head-text">
                <h1 class="di-cfm-title">Edit User</h1>
                <p class="di-cfm-sub">Update this account's details, roles, portals and access.</p>
            </div>
        </div>

        <div class="di-cfm-body">
            @if (notFound)
            {
                <div class="alert alert-danger">User not found.</div>
            }
            else if (Input is null)
            {
                <LoadingIndicator Message="Loading user…" />
            }
            else
            {
                <EditForm Model="Input" OnValidSubmit="SaveAsync" FormName="edit-user">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="di-cfm-fld-row">
                        <div class="di-cfm-fld">
                            <label>Username</label>
                            <InputText @bind-Value="Input.Username" />
                        </div>
                        <div class="di-cfm-fld">
                            <label>Full Name</label>
                            <InputText @bind-Value="Input.FullName" />
                        </div>
                    </div>
                    <div class="di-cfm-fld-row">
                        <div class="di-cfm-fld">
                            <label>Designation</label>
                            <InputText @bind-Value="Input.Designation" />
                        </div>
                        <div class="di-cfm-fld">
                            <label>Email</label>
                            <InputText @bind-Value="Input.Email" />
                        </div>
                    </div>
                    <div class="di-cfm-fld form-check">
                        <input type="checkbox" class="form-check-input" id="useLdap" @bind="UseLdap" />
                        <label class="form-check-label" for="useLdap">Authenticate using LDAP (Active Directory)</label>
                        <div class="form-text">When ticked, the user signs in with their AD account instead of a local password.</div>
                    </div>
                    @if (UseLdap)
                    {
                        <div class="di-cfm-fld">
                            <label>Active Directory Login</label>
                            <InputText @bind-Value="Input.AdLogin" placeholder="sAMAccountName, user@dipark.local or DIPARK\user" />
                            <div class="form-text">The user signs in with this AD account &mdash; no local password is used.</div>
                        </div>
                    }
                    else
                    {
                        <div class="di-cfm-fld">
                            <label>New Password</label>
                            <InputText type="password" @bind-Value="Input.NewPassword" />
                            <div class="form-text">Leave blank to keep the current password.</div>
                        </div>
                    }
                    <div class="di-cfm-fld">
                        <label>Profile Photo</label>
                        <InputFile OnChange="OnPhotoSelectedAsync" accept="image/*" />
                        @if (photoPreview is not null)
                        {
                            <img src="@photoPreview" alt="Preview" class="mt-2" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover;" />
                        }
                        else if (hasExistingPhoto)
                        {
                            <img src="/users/@Id/photo" alt="Current photo" class="mt-2" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover;" />
                        }
                    </div>
                    <div class="di-cfm-fld">
                        <label>Role</label>
                        <InputSelect style="max-width: 320px;" @bind-Value="Input.UserType">
                            <option value="@UserType.NormalUser">Normal User</option>
                            <option value="@UserType.ApplicationAdministrator">Application Administrator</option>
                            <option value="@UserType.Administrator">Administrator</option>
                        </InputSelect>
                        <div class="form-text">
                            <strong>Administrator</strong> has full access including the Settings area (users, business units,
                            field settings, audit log). <strong>Application Administrator</strong> has the same operational
                            access — all data within their assigned business units, import/export, register, notify — but
                            <strong>cannot open Settings</strong>.
                        </div>
                    </div>
                    <div class="di-cfm-fld">
                        <label>Portal Access</label>
                        <div class="di-bu-checklist">
                            @foreach (var portal in AllPortals)
                            {
                                <label class="di-bu-check">
                                    <input type="checkbox" checked="@selectedPortals.Contains(portal)"
                                           @onchange="e => TogglePortal(portal, (bool)e.Value!)" />
                                    @portal
                                </label>
                            }
                        </div>
                        <div class="form-text">The portals this user can open. Only granted portals appear on their home page and sidebar.</div>
                    </div>
                    <div class="di-cfm-fld">
                        <label>Company</label>
                        <InputSelect style="max-width: 420px;" @bind-Value="Input.CompanyBusinessUnitId">
                            <option value="">— Select —</option>
                            @foreach (var businessUnit in businessUnits)
                            {
                                <option value="@businessUnit.Id">@businessUnit.Name</option>
                            }
                        </InputSelect>
                        <div class="form-text">The business unit / company this user belongs to.</div>
                    </div>
                    <div class="di-cfm-fld">
                        <label>Department</label>
                        <InputSelect style="max-width: 420px;" @bind-Value="Input.DepartmentId">
                            <option value="">— Select —</option>
                            @foreach (var department in departments)
                            {
                                <option value="@department.Id">@department.Name</option>
                            }
                        </InputSelect>
                        <div class="form-text">The department this user belongs to; used to scope which suppliers they manage.</div>
                    </div>
                    <div class="di-cfm-fld">
                        <label>Business Unit(s)</label>
                        <div class="di-bu-checklist">
                            @foreach (var businessUnit in businessUnits)
                            {
                                <label class="di-bu-check">
                                    <input type="checkbox" checked="@selectedBusinessUnitIds.Contains(businessUnit.Id)"
                                           @onchange="e => ToggleBusinessUnit(businessUnit.Id, (bool)e.Value!)" />
                                    @businessUnit.Name
                                </label>
                            }
                        </div>
                        <div class="form-text">Additional business units whose suppliers this user can see.</div>
                    </div>
                    <div class="di-cfm-fld">
                        <label>Status</label>
                        <div>
                            <label class="di-switch di-switch-rg">
                                <input type="checkbox" @bind="Input.IsActive" />
                                <span class="di-switch-slider"></span>
                            </label>
                            <span class="ms-2">@(Input.IsActive ? "Active" : "Inactive")</span>
                        </div>
                    </div>

                    @if (errorMessage is not null)
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <div class="di-cfm-formfoot">
                        <button type="submit" class="di-cfm-btn di-cfm-btn-primary">Save</button>
                        <a class="di-cfm-btn di-cfm-btn-ghost" href="/admin/users">Cancel</a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

<style>
    .di-cfm-body { padding: 20px 22px; }
    .di-cfm-fld { margin-bottom: 16px; }
    .di-cfm-fld-row { display: flex; gap: 14px; flex-wrap: wrap; }
    .di-cfm-fld-row > .di-cfm-fld { flex: 1 1 220px; margin-bottom: 16px; }
    .di-cfm-fld > label { display: block; font-size: 12.5px; font-weight: 700; color: var(--label); margin-bottom: 5px; }
    .di-cfm-fld.form-check > label { display: inline; }
    .di-cfm-fld input:not([type=checkbox]):not([type=radio]), .di-cfm-fld textarea, .di-cfm-fld select {
        width: 100%; padding: 9px 11px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; font-family: inherit; color: #1a2233; background: #fff; }
    .di-cfm-fld input:disabled { background: #f4f5f8; color: #8a93a6; }
    .di-cfm-formfoot { display: flex; gap: 8px; margin-top: 6px; }
    a.di-cfm-btn { display: inline-flex; align-items: center; text-decoration: none; }

    .di-bu-checklist {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.75rem 1rem;
    }

    .di-bu-check {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: normal;
        margin-bottom: 0;
    }

    [data-theme="dark"] .di-cfm-fld input:not([type=checkbox]):not([type=radio]), [data-theme="dark"] .di-cfm-fld textarea, [data-theme="dark"] .di-cfm-fld select { background: #131a2b; color: #e7ecf5; border-color: #2b3550; }
</style>

@code {
    private const long MaxPhotoSize = 2 * 1024 * 1024;

    [Parameter] public int Id { get; set; }

    private static readonly PortalAccess[] AllPortals =
        [PortalAccess.Supplier, PortalAccess.Landlord, PortalAccess.Broker, PortalAccess.Customer];

    private List<BusinessUnit> businessUnits = [];
    private List<Department> departments = [];
    private HashSet<int> selectedBusinessUnitIds = [];
    private HashSet<PortalAccess> selectedPortals = [];
    private string currentUser = "unknown";
    private bool notFound;
    private bool hasExistingPhoto;
    private string? errorMessage;
    private string? photoPreview;
    private byte[]? photoBytes;
    private string? photoContentType;

    private UserModel? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";

        businessUnits = await BusinessUnitService.GetAllAsync();
        departments = await UserService.GetDepartmentsAsync();

        var user = await UserService.GetByIdAsync(Id);
        if (user is null)
        {
            notFound = true;
            return;
        }

        hasExistingPhoto = user.ProfilePhoto is not null;
        selectedBusinessUnitIds = user.BusinessUnits.Select(b => b.Id).ToHashSet();
        selectedPortals = AllPortals.Where(p => user.PortalAccess.HasFlag(p)).ToHashSet();
        Input = new UserModel
        {
            Username = user.Username,
            FullName = user.FullName ?? "",
            Designation = user.Designation,
            Email = user.Email,
            UserType = user.UserType,
            IsActive = user.IsActive,
            AuthSource = user.AuthSource,
            AdLogin = user.AdLogin,
            CompanyBusinessUnitId = user.CompanyBusinessUnitId,
            DepartmentId = user.DepartmentId
        };
    }

    private void ToggleBusinessUnit(int businessUnitId, bool isChecked)
    {
        if (isChecked)
        {
            selectedBusinessUnitIds.Add(businessUnitId);
        }
        else
        {
            selectedBusinessUnitIds.Remove(businessUnitId);
        }
    }

    private void TogglePortal(PortalAccess portal, bool isChecked)
    {
        if (isChecked) selectedPortals.Add(portal);
        else selectedPortals.Remove(portal);
    }

    private PortalAccess SelectedPortalAccess =>
        selectedPortals.Aggregate(PortalAccess.None, (acc, p) => acc | p);

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(MaxPhotoSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        photoBytes = memoryStream.ToArray();
        photoContentType = file.ContentType;
        photoPreview = $"data:{photoContentType};base64,{Convert.ToBase64String(photoBytes)}";
    }

    private async Task SaveAsync()
    {
        if (Input is null)
        {
            return;
        }

        var (success, error) = await Loading.RunAsync(() => UserService.UpdateUserAsync(
            Id, Input.Username, Input.FullName, Input.Designation, Input.Email, Input.UserType,
            selectedBusinessUnitIds.ToList(), Input.IsActive, photoBytes, photoContentType, Input.NewPassword,
            Input.AuthSource, Input.AdLogin, currentUser, SelectedPortalAccess, Input.CompanyBusinessUnitId, Input.DepartmentId));

        if (!success)
        {
            errorMessage = error;
            return;
        }

        NavigationManager.NavigateTo("/admin/users");
    }

    // Checkbox <-> AuthSource: ticked means the account authenticates against Active Directory (LDAP).
    private bool UseLdap
    {
        get => Input?.AuthSource == AuthSource.ActiveDirectory;
        set { if (Input is not null) { Input.AuthSource = value ? AuthSource.ActiveDirectory : AuthSource.Local; } }
    }

    private sealed class UserModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string FullName { get; set; } = "";

        public string? Designation { get; set; }

        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        public string? NewPassword { get; set; }

        public AuthSource AuthSource { get; set; } = AuthSource.Local;

        public string? AdLogin { get; set; }

        public UserType UserType { get; set; } = UserType.NormalUser;

        public int? CompanyBusinessUnitId { get; set; }
        public int? DepartmentId { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
