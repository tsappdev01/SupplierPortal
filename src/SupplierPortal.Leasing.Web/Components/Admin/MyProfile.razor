@page "/account/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject UserService UserService
@inject LoadingService Loading
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Profile - Landlord Portal</PageTitle>

@if (notFound)
{
    <div class="alert alert-danger">Your account could not be loaded.</div>
}
else if (Profile is null)
{
    <LoadingIndicator Message="Loading your profile…" />
}
else
{
    <div class="row g-4" style="max-width: 980px;">
        <div class="col-md-6">
            <div class="di-cfm">
                <div class="di-cfm-card">
                    <div class="di-cfm-head">
                        <div class="di-cfm-head-icon">
                            <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/></svg>
                        </div>
                        <div class="di-cfm-head-text">
                            <h1 class="di-cfm-title">My Profile</h1>
                            <p class="di-cfm-sub">Your personal details and profile photo.</p>
                        </div>
                    </div>
                    <div class="di-cfm-body">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            @if (photoPreview is not null)
                            {
                                <img src="@photoPreview" alt="" class="di-profile-pic" />
                            }
                            else if (hasExistingPhoto)
                            {
                                <img src="/users/@userId/photo" alt="" class="di-profile-pic" />
                            }
                            else
                            {
                                <span class="di-profile-pic di-profile-pic-initials">@GetInitials(Profile.FullName)</span>
                            }
                            <div>
                                <div class="h5 mb-0">@Profile.FullName</div>
                                <div class="text-muted">@(string.IsNullOrWhiteSpace(Profile.Designation) ? "—" : Profile.Designation)</div>
                                <div class="text-muted small">@email</div>
                            </div>
                        </div>

                        <EditForm Model="Profile" OnValidSubmit="SaveProfileAsync" FormName="my-profile">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="di-cfm-fld">
                                <label>Full Name</label>
                                <InputText @bind-Value="Profile.FullName" />
                            </div>
                            <div class="di-cfm-fld">
                                <label>Designation</label>
                                <InputText @bind-Value="Profile.Designation" />
                            </div>
                            <div class="di-cfm-fld">
                                <label>Email</label>
                                <input value="@email" disabled />
                                <div class="form-text">Contact an administrator to change your email.</div>
                            </div>
                            <div class="di-cfm-fld">
                                <label>Profile Photo</label>
                                <InputFile OnChange="OnPhotoSelectedAsync" accept="image/*" />
                            </div>

                            @if (profileError is not null)
                            {
                                <div class="alert alert-danger">@profileError</div>
                            }
                            @if (profileSaved)
                            {
                                <div class="alert alert-success py-2">Profile updated.</div>
                            }

                            <div class="di-cfm-formfoot">
                                <button type="submit" class="di-cfm-btn di-cfm-btn-primary">Save Profile</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="di-cfm">
                <div class="di-cfm-card">
                    <div class="di-cfm-head">
                        <div class="di-cfm-head-icon">
                            <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                        </div>
                        <div class="di-cfm-head-text">
                            <h2 class="di-cfm-title">Change Password</h2>
                            <p class="di-cfm-sub">Update the password used to sign in.</p>
                        </div>
                    </div>
                    <div class="di-cfm-body">
                        @if (isAdAccount)
                        {
                            <div class="alert alert-info mb-0">
                                You sign in with your Active Directory account. Your password is managed there and
                                cannot be changed here.
                            </div>
                        }
                        else
                        {
                            <EditForm Model="Password" OnValidSubmit="ChangePasswordAsync" FormName="change-password">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger" />

                                <div class="di-cfm-fld">
                                    <label>Current Password</label>
                                    <InputText type="password" @bind-Value="Password.CurrentPassword" />
                                </div>
                                <div class="di-cfm-fld">
                                    <label>New Password</label>
                                    <InputText type="password" @bind-Value="Password.NewPassword" />
                                </div>
                                <div class="di-cfm-fld">
                                    <label>Confirm New Password</label>
                                    <InputText type="password" @bind-Value="Password.ConfirmPassword" />
                                </div>

                                @if (passwordError is not null)
                                {
                                    <div class="alert alert-danger">@passwordError</div>
                                }
                                @if (passwordChanged)
                                {
                                    <div class="alert alert-success py-2">Password changed.</div>
                                }

                                <div class="di-cfm-formfoot">
                                    <button type="submit" class="di-cfm-btn di-cfm-btn-primary">Change Password</button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .di-cfm-body { padding: 20px 22px; }
    .di-cfm-fld { margin-bottom: 16px; }
    .di-cfm-fld > label { display: block; font-size: 12.5px; font-weight: 700; color: var(--label); margin-bottom: 5px; }
    .di-cfm-fld input:not([type=checkbox]):not([type=radio]), .di-cfm-fld textarea, .di-cfm-fld select {
        width: 100%; padding: 9px 11px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; font-family: inherit; color: #1a2233; background: #fff; }
    .di-cfm-fld input:disabled { background: #f4f5f8; color: #8a93a6; }
    .di-cfm-formfoot { display: flex; gap: 8px; margin-top: 6px; }

    .di-profile-pic {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .di-profile-pic-initials {
        background: #1a2233;
        color: #a89582;
        font-size: 1.4rem;
        font-weight: 700;
    }

    [data-theme="dark"] .di-cfm-fld input:not([type=checkbox]):not([type=radio]), [data-theme="dark"] .di-cfm-fld textarea, [data-theme="dark"] .di-cfm-fld select { background: #131a2b; color: #e7ecf5; border-color: #2b3550; }
</style>

@code {
    private const long MaxPhotoSize = 2 * 1024 * 1024;

    private int userId;
    private string currentUser = "unknown";
    private string email = "";
    private bool notFound;
    private bool hasExistingPhoto;
    private bool isAdAccount;

    private string? photoPreview;
    private byte[]? photoBytes;
    private string? photoContentType;

    private string? profileError;
    private bool profileSaved;
    private string? passwordError;
    private bool passwordChanged;

    private ProfileModel? Profile { get; set; }
    private PasswordModel Password { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";
        userId = state.User.GetUserId();

        var user = await UserService.GetByIdAsync(userId);
        if (user is null)
        {
            notFound = true;
            return;
        }

        email = user.Email;
        hasExistingPhoto = user.ProfilePhoto is not null || user.ProfilePhotoBlobKey is not null;
        isAdAccount = user.AuthSource == AuthSource.ActiveDirectory;
        Profile = new ProfileModel
        {
            FullName = user.FullName ?? "",
            Designation = user.Designation
        };
    }

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(MaxPhotoSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        photoBytes = memoryStream.ToArray();
        photoContentType = file.ContentType;
        photoPreview = $"data:{photoContentType};base64,{Convert.ToBase64String(photoBytes)}";
    }

    private async Task SaveProfileAsync()
    {
        if (Profile is null)
        {
            return;
        }

        profileError = null;
        profileSaved = false;

        var (success, error) = await Loading.RunAsync(() => UserService.UpdateProfileAsync(
            userId, Profile.FullName, Profile.Designation, photoBytes, photoContentType, currentUser));

        if (!success)
        {
            profileError = error;
            return;
        }

        if (photoBytes is not null)
        {
            hasExistingPhoto = true;
        }
        profileSaved = true;
    }

    private async Task ChangePasswordAsync()
    {
        passwordError = null;
        passwordChanged = false;

        if (Password.NewPassword != Password.ConfirmPassword)
        {
            passwordError = "The new password and its confirmation do not match.";
            return;
        }

        var (success, error) = await Loading.RunAsync(() => UserService.ChangePasswordAsync(
            userId, Password.CurrentPassword, Password.NewPassword, currentUser));

        if (!success)
        {
            passwordError = error;
            return;
        }

        Password = new PasswordModel();
        passwordChanged = true;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }

    private sealed class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FullName { get; set; } = "";

        public string? Designation { get; set; }
    }

    private sealed class PasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string CurrentPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(1)]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmPassword { get; set; } = "";
    }
}
