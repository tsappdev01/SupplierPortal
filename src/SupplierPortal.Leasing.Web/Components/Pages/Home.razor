@page "/"
@inject NavigationManager Nav

@* The Landlord portal has no separate landing page: send users straight to the
   Landlords list. Unauthenticated users are redirected to /account/login by the
   cookie auth middleware (the list requires the Portal.Landlord policy). *@

<PageTitle>Landlord Portal</PageTitle>

@code {
    protected override void OnInitialized() => Nav.NavigateTo("/admin/landlords", replace: true);
}
