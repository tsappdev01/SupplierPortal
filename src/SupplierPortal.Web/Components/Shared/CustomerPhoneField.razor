@namespace SupplierPortal.Web.Components.Shared
@using SupplierPortal.Web.Services

@* Customer telephone control: a country dial-code selector combined with the number input in one
   bordered group (e.g. [🇦🇪 +971] [ 50 123 4567 ]), matching the supplier's PhoneField. Two-way binds a
   single stored string ("+971 50 1234567"); parses it into (dial, number) and recomposes on change. *@
<div class="di-phone @(Disabled ? "di-phone-disabled" : null)">
    <select class="di-phone-code-select" value="@dial" @onchange="OnDialChanged" disabled="@Disabled" title="Country dialing code">
        @foreach (var c in CustomerLookups.PhoneCountries)
        {
            <option value="@c.Dial" selected="@(c.Dial == dial)">@Flag(c.Iso) +@c.Dial  @c.Name</option>
        }
    </select>
    <span class="di-phone-numberbox">
        <svg class="di-phone-icon" width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z" />
        </svg>
        <input type="tel" class="di-phone-number" value="@number" @oninput="OnNumberInput"
               placeholder="@Placeholder" disabled="@Disabled" inputmode="tel" />
    </span>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string DefaultDial { get; set; } = "971";

    private string dial = "";
    private string number = "";
    private string? lastEmitted;

    protected override void OnParametersSet()
    {
        // Re-parse only when the value changed from outside (not from our own emit) so typing isn't disrupted.
        if (Value != lastEmitted) { Parse(Value); }
    }

    private void Parse(string? v)
    {
        v = (v ?? "").Trim();
        if (v.StartsWith('+'))
        {
            var digits = new string(v.Skip(1).TakeWhile(ch => char.IsDigit(ch)).ToArray());
            var match = CustomerLookups.PhoneCountries
                .Where(c => digits.StartsWith(c.Dial, StringComparison.Ordinal))
                .OrderByDescending(c => c.Dial.Length)
                .FirstOrDefault();
            if (match.Dial is not null)
            {
                dial = match.Dial;
                number = v[(1 + match.Dial.Length)..].Trim();
                return;
            }
        }
        if (string.IsNullOrEmpty(dial)) { dial = DefaultDial; }
        number = v;
    }

    private async Task OnDialChanged(ChangeEventArgs e)
    {
        dial = e.Value?.ToString() ?? DefaultDial;
        await EmitAsync();
    }

    private async Task OnNumberInput(ChangeEventArgs e)
    {
        number = e.Value?.ToString() ?? "";
        await EmitAsync();
    }

    private async Task EmitAsync()
    {
        var composed = string.IsNullOrWhiteSpace(number) ? "" : $"+{dial} {number.Trim()}";
        lastEmitted = composed;
        await ValueChanged.InvokeAsync(composed);
    }

    private static string Flag(string? iso)
    {
        if (string.IsNullOrWhiteSpace(iso) || iso.Length != 2) { return ""; }
        iso = iso.ToUpperInvariant();
        if (iso[0] < 'A' || iso[0] > 'Z' || iso[1] < 'A' || iso[1] > 'Z') { return ""; }
        return char.ConvertFromUtf32(0x1F1E6 + (iso[0] - 'A')) + char.ConvertFromUtf32(0x1F1E6 + (iso[1] - 'A'));
    }
}
