@namespace SupplierPortal.Web.Components.Shared
@using SupplierPortal.Web.Models

@* Reusable telephone/mobile control: a flag + dial-code selector combined with the number
   input in a single bordered group (e.g. [🇦🇪 +971 ▾] [ 50 123 4567 ]). Two-way binds the
   country-code lookup id and the number; optionally shows a small area-code segment. *@
<div class="di-phone @(Disabled ? "di-phone-disabled" : null)">
    <button type="button" class="di-phone-code" @onclick="Toggle" disabled="@Disabled">
        <span class="di-phone-flag">@Flag(Selected?.Code)</span>
        <span class="di-phone-dial">@(Selected is null ? "Code" : $"+{Selected.PhoneCode}")</span>
        <svg class="di-phone-caret" width="10" height="10" viewBox="0 0 16 16" fill="currentColor">
            <path d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708Z" />
        </svg>
    </button>

    @if (ShowAreaCode)
    {
        <input type="text" class="di-phone-area" value="@AreaCode" @oninput="OnAreaInput"
               placeholder="Area" maxlength="5" inputmode="numeric" disabled="@Disabled" />
    }

    <span class="di-phone-numberbox">
        <svg class="di-phone-icon" width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z" />
        </svg>
        <input type="tel" class="di-phone-number" value="@Number" @oninput="OnNumberInput"
               placeholder="@Placeholder" disabled="@Disabled" />
    </span>

    @if (open)
    {
        <div class="di-phone-backdrop" @onclick="Close"></div>
        <div class="di-phone-menu">
            <input type="text" class="di-phone-search" placeholder="Search country or code"
                   @bind="search" @bind:event="oninput" />
            <div class="di-phone-list">
                @foreach (var c in Filtered)
                {
                    <button type="button" class="di-phone-option @(c.Id == CountryCodeId ? "is-selected" : null)"
                            @onclick="() => SelectAsync(c)">
                        <span class="di-phone-flag">@Flag(c.Code)</span>
                        <span class="di-phone-name">@c.DisplayName</span>
                        <span class="di-phone-dial">+@c.PhoneCode</span>
                    </button>
                }
                @if (!Filtered.Any())
                {
                    <div class="di-phone-empty">No matching country</div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Country lookups that carry a dial code (Category == Country, PhoneCode set).</summary>
    [Parameter] public List<LookupValue> Countries { get; set; } = new();

    [Parameter] public int? CountryCodeId { get; set; }
    [Parameter] public EventCallback<int?> CountryCodeIdChanged { get; set; }

    [Parameter] public string? Number { get; set; }
    [Parameter] public EventCallback<string?> NumberChanged { get; set; }

    [Parameter] public string? AreaCode { get; set; }
    [Parameter] public EventCallback<string?> AreaCodeChanged { get; set; }

    /// <summary>Show a small area-code segment before the number (used for landline phone).</summary>
    [Parameter] public bool ShowAreaCode { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Dial code to pre-select when no country is chosen yet (defaults to UAE, +971).</summary>
    [Parameter] public string? DefaultDialCode { get; set; } = "971";

    private bool open;
    private string search = "";

    private LookupValue? Selected => Countries.FirstOrDefault(c => c.Id == CountryCodeId);

    protected override async Task OnParametersSetAsync()
    {
        // Default the selector to a country (UAE by default) so the flag + dial code show up
        // instead of an empty placeholder, and the chosen code is persisted with the record.
        if (CountryCodeId is null && Countries.Count > 0 && !string.IsNullOrWhiteSpace(DefaultDialCode))
        {
            var def = Countries.FirstOrDefault(c => c.PhoneCode == DefaultDialCode);
            if (def is not null)
            {
                await CountryCodeIdChanged.InvokeAsync(def.Id);
            }
        }
    }

    private IEnumerable<LookupValue> Filtered =>
        string.IsNullOrWhiteSpace(search)
            ? Countries
            : Countries.Where(c =>
                c.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || (c.PhoneCode ?? "").Contains(search, StringComparison.OrdinalIgnoreCase)
                || c.Code.Contains(search, StringComparison.OrdinalIgnoreCase));

    private void Toggle()
    {
        if (Disabled)
        {
            return;
        }
        open = !open;
        search = "";
    }

    private void Close() => open = false;

    private async Task SelectAsync(LookupValue c)
    {
        if (CountryCodeId != c.Id)
        {
            await CountryCodeIdChanged.InvokeAsync(c.Id);
        }
        open = false;
    }

    private Task OnNumberInput(ChangeEventArgs e) => NumberChanged.InvokeAsync(e.Value?.ToString());

    private Task OnAreaInput(ChangeEventArgs e) => AreaCodeChanged.InvokeAsync(e.Value?.ToString());

    /// <summary>Turns a 2-letter ISO country code into its flag emoji (regional indicator symbols).</summary>
    private static string Flag(string? iso)
    {
        if (string.IsNullOrWhiteSpace(iso) || iso.Length != 2)
        {
            return "\U0001F310"; // globe fallback
        }
        iso = iso.ToUpperInvariant();
        if (iso[0] < 'A' || iso[0] > 'Z' || iso[1] < 'A' || iso[1] > 'Z')
        {
            return "\U0001F310";
        }
        return char.ConvertFromUtf32(0x1F1E6 + (iso[0] - 'A')) + char.ConvertFromUtf32(0x1F1E6 + (iso[1] - 'A'));
    }
}
