@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Services
@inject SupplierActivityService ActivityService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="di-notif">
    <a class="di-notif-btn" href="/admin/supplier-activity" title="Supplier activity — all changes">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8v4l3 2" /><circle cx="12" cy="12" r="9" />
        </svg>
    </a>

    <div class="di-notif-wrap">
        <button type="button" class="di-notif-btn" @onclick="ToggleAsync" title="Suppliers awaiting review">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            @if (pending.Count > 0)
            {
                <span class="di-notif-badge">@(pending.Count > 99 ? "99+" : pending.Count.ToString())</span>
            }
        </button>

        @if (open)
        {
            <div class="di-notif-panel">
                <div class="di-notif-head">
                    <span>Awaiting review</span>
                    <span class="di-notif-count">@pending.Count</span>
                </div>
                @if (pending.Count == 0)
                {
                    <div class="di-notif-empty">No supplier submissions awaiting review.</div>
                }
                else
                {
                    <div class="di-notif-list">
                        @foreach (var item in pending)
                        {
                            <button type="button" class="di-notif-item" @onclick="() => GoTo(item.SupplierId)">
                                <span class="di-notif-name">@item.SupplierName</span>
                                <span class="di-notif-meta">
                                    @item.ChangeCount field@(item.ChangeCount == 1 ? "" : "s") changed &middot; @item.LastChangedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </span>
                            </button>
                        }
                    </div>
                    <a class="di-notif-foot" href="/admin/supplier-activity" @onclick="Close">View all activity</a>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<PendingReviewSupplier> pending = [];
    private bool open;
    private bool isAdministrator;
    private List<int> businessUnitIds = [];
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdministrator = state.User.IsAdministrator();
        businessUnitIds = state.User.GetBusinessUnitIds();
        await ReloadAsync();

        // Poll every 60s so a new supplier submission surfaces without a manual refresh.
        refreshTimer = new Timer(async _ => await InvokeAsync(ReloadAsync), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private IReadOnlyCollection<int>? Scope => isAdministrator ? null : businessUnitIds;

    private async Task ReloadAsync()
    {
        pending = await ActivityService.GetPendingReviewAsync(Scope);
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        open = !open;
        if (open)
        {
            await ReloadAsync();
        }
    }

    private void Close() => open = false;

    private void GoTo(int supplierId)
    {
        open = false;
        NavigationManager.NavigateTo($"/supplier/edit/{supplierId}");
    }

    public void Dispose() => refreshTimer?.Dispose();
}
