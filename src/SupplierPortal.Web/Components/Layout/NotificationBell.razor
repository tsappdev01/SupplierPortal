@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Services
@inject SupplierActivityService ActivityService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="di-notif">
    <a class="di-notif-btn" href="/admin/supplier-activity" title="Supplier activity — all changes">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8v4l3 2" /><circle cx="12" cy="12" r="9" />
        </svg>
    </a>

    <div class="di-notif-wrap">
        <button type="button" class="di-notif-btn" @onclick="ToggleAsync" title="Suppliers awaiting review">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            @if (pending.Count > 0)
            {
                <span class="di-notif-badge">@(pending.Count > 99 ? "99+" : pending.Count.ToString())</span>
            }
        </button>

        @if (open)
        {
            <div class="di-notif-panel">
                <div class="di-notif-head">
                    <span>Awaiting review</span>
                    <span class="di-notif-count">@pending.Count</span>
                </div>
                @if (pending.Count == 0)
                {
                    <div class="di-notif-empty">No supplier submissions awaiting review.</div>
                }
                else
                {
                    <div class="di-notif-list">
                        @foreach (var item in pending)
                        {
                            <button type="button" class="di-notif-item" @onclick="() => GoTo(item.SupplierId)">
                                <span class="di-notif-name">@item.SupplierName</span>
                                <span class="di-notif-meta">
                                    @item.ChangeCount field@(item.ChangeCount == 1 ? "" : "s") changed &middot; @item.LastChangedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </span>
                            </button>
                        }
                    </div>
                    <a class="di-notif-foot" href="/admin/supplier-activity" @onclick="Close">View all activity</a>
                }
            </div>
        }
    </div>
</div>

<style>
    .di-notif { display: inline-flex; align-items: center; gap: 6px; }
    .di-notif-wrap { position: relative; }
    .di-notif-btn {
        position: relative; display: inline-flex; align-items: center; justify-content: center;
        width: 38px; height: 38px; border-radius: 8px; border: 1px solid #e2e5ea; background: #fff;
        color: #1a2233; cursor: pointer; text-decoration: none; transition: border-color .12s, box-shadow .12s;
    }
    .di-notif-btn:hover { border-color: #c8a24a; box-shadow: 0 2px 6px rgba(0,0,0,.1); }
    .di-notif-badge {
        position: absolute; top: -5px; right: -5px; min-width: 18px; height: 18px; padding: 0 4px;
        border-radius: 9px; background: #c0392b; color: #fff; font-size: 11px; font-weight: 700;
        display: flex; align-items: center; justify-content: center; line-height: 1;
    }
    .di-notif-panel {
        position: absolute; right: 0; top: 46px; width: 340px; max-height: 60vh; overflow: auto;
        background: #fff; border: 1px solid #e2e5ea; border-radius: 10px; box-shadow: 0 8px 24px rgba(26,34,51,.18); z-index: 2500;
    }
    .di-notif-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 14px; background: #1a2233; color: #fff; font-weight: 700;
        border-radius: 10px 10px 0 0; position: sticky; top: 0;
    }
    .di-notif-count { background: #c8a24a; color: #1a2233; border-radius: 10px; padding: 1px 9px; font-size: 12px; }
    .di-notif-empty { padding: 18px 14px; color: #7b8697; font-size: 14px; }
    .di-notif-list { display: flex; flex-direction: column; }
    .di-notif-item {
        display: flex; flex-direction: column; gap: 2px; text-align: left;
        padding: 10px 14px; background: #fff; border: none; border-bottom: 1px solid #eef1f6; cursor: pointer;
    }
    .di-notif-item:hover { background: #f4f6f9; }
    .di-notif-name { font-weight: 700; color: #1a2233; font-size: 14px; }
    .di-notif-meta { color: #7b8697; font-size: 12px; }
    .di-notif-foot { display: block; text-align: center; padding: 10px; color: #46618f; font-weight: 700; font-size: 13px; text-decoration: none; }
    .di-notif-foot:hover { background: #f4f6f9; }
</style>

@code {
    private List<PendingReviewSupplier> pending = [];
    private bool open;
    private bool isAdministrator;
    private List<int> businessUnitIds = [];
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdministrator = state.User.IsAdministrator();
        businessUnitIds = state.User.GetBusinessUnitIds();
        await ReloadAsync();

        // Poll every 60s so a new supplier submission surfaces without a manual refresh.
        refreshTimer = new Timer(async _ => await InvokeAsync(ReloadAsync), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private IReadOnlyCollection<int>? Scope => isAdministrator ? null : businessUnitIds;

    private async Task ReloadAsync()
    {
        pending = await ActivityService.GetPendingReviewAsync(Scope);
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        open = !open;
        if (open)
        {
            await ReloadAsync();
        }
    }

    private void Close() => open = false;

    private void GoTo(int supplierId)
    {
        open = false;
        NavigationManager.NavigateTo($"/supplier/edit/{supplierId}");
    }

    public void Dispose() => refreshTimer?.Dispose();
}
