@page "/admin/landlords"
@attribute [Authorize(Roles = "Administrator,LeasingManager")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using SupplierPortal.Web.Models.Leasing
@using SupplierPortal.Web.Services
@using SupplierPortal.Web.Services.Leasing
@inject LandlordService LandlordService
@inject LoadingService Loading
@inject ToastService Toast
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>Landlords - Supplier Portal</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Landlord Registrations</h1>
    <a class="btn btn-outline-primary" href="/admin/land-register">Initiate from Land Register →</a>
</div>

<div class="btn-group btn-group-sm mb-3" role="group">
    <button type="button" class="btn @(statusFilter is null ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(null)">All</button>
    @foreach (var s in statuses)
    {
        <button type="button" class="btn @(statusFilter == s ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(s)">@Label(s)</button>
    }
</div>

@if (items.Count == 0)
{
    <div class="alert alert-light border">No landlords@(statusFilter is null ? "" : $" with status \"{Label(statusFilter.Value)}\"") yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Company / Property</th>
                <th>Property Code</th>
                <th>Type</th>
                <th>Email</th>
                <th>Status</th>
                <th>Reference</th>
                <th>Updated</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in PageItems)
            {
                <tr style="cursor:pointer;" @onclick="() => Open(l.Id)">
                    <td>@l.DisplayName</td>
                    <td>@l.PropertyCode</td>
                    <td>@l.Type</td>
                    <td>@l.Email</td>
                    <td><span class="badge @StatusClass(l.Status)">@Label(l.Status)</span></td>
                    <td>@(l.Reference ?? "—")</td>
                    <td>@l.UpdatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end text-nowrap" @onclick:stopPropagation="true">
                        <button class="btn btn-sm btn-outline-secondary me-1" title="Edit" @onclick="() => Open(l.Id)">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10ZM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5Zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5Z" /></svg>
                        </button>
                        <button class="btn btn-sm btn-outline-primary me-1" title="Email invite"
                                disabled="@(!l.LinkActive || sending == l.Id)" @onclick="() => EmailAsync(l.Id)">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z" /></svg>
                        </button>
                        <button class="btn btn-sm btn-outline-info" title="Review"
                                disabled="@(l.Status is not (LandlordStatus.Submitted or LandlordStatus.UnderReview))" @onclick="() => Open(l.Id)">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M9.5 0a.5.5 0 0 1 .5.5.5.5 0 0 0 .5.5.5.5 0 0 1 .5.5V2a.5.5 0 0 1-.5.5h-5A.5.5 0 0 1 5 2v-.5a.5.5 0 0 1 .5-.5.5.5 0 0 0 .5-.5.5.5 0 0 1 .5-.5h3Z" /><path d="M3 2.5a.5.5 0 0 1 .5-.5H4a.5.5 0 0 0 0-1h-.5A1.5 1.5 0 0 0 2 2.5v12A1.5 1.5 0 0 0 3.5 16h9a1.5 1.5 0 0 0 1.5-1.5v-12A1.5 1.5 0 0 0 12.5 1H12a.5.5 0 0 0 0 1h.5a.5.5 0 0 1 .5.5v12a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-12Zm7.354 4.854-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 9.293l2.646-2.647a.5.5 0 0 1 .708.708Z" /></svg>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center">
        <span class="small text-muted">Showing @(items.Count == 0 ? 0 : ((page - 1) * PageSize + 1))–@Math.Min(page * PageSize, items.Count) of @items.Count</span>
        @if (TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(page == 1 ? "disabled" : "")"><button class="page-link" @onclick="() => GoTo(page - 1)">Prev</button></li>
                    @foreach (var pg in PageWindow)
                    {
                        <li class="page-item @(pg == page ? "active" : "")"><button class="page-link" @onclick="() => GoTo(pg)">@pg</button></li>
                    }
                    <li class="page-item @(page == TotalPages ? "disabled" : "")"><button class="page-link" @onclick="() => GoTo(page + 1)">Next</button></li>
                </ul>
            </nav>
        }
    </div>
}

@code {
    private List<LandlordListItem> items = [];
    private LandlordStatus? statusFilter;
    private string currentUser = "unknown";
    private int? sending;

    private const int PageSize = 50;
    private int page = 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(items.Count / (double)PageSize));
    private IEnumerable<LandlordListItem> PageItems => items.Skip((page - 1) * PageSize).Take(PageSize);
    private IEnumerable<int> PageWindow
    {
        get
        {
            var start = Math.Max(1, page - 2);
            var end = Math.Min(TotalPages, start + 4);
            start = Math.Max(1, end - 4);
            return Enumerable.Range(start, end - start + 1);
        }
    }
    private void GoTo(int p) { if (p >= 1 && p <= TotalPages) page = p; }
    private static readonly LandlordStatus[] statuses =
        [LandlordStatus.Draft, LandlordStatus.InvitationSent, LandlordStatus.InProgress, LandlordStatus.Submitted,
         LandlordStatus.UnderReview, LandlordStatus.CorrectionRequired, LandlordStatus.Rejected, LandlordStatus.RegistrationComplete];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = await LandlordService.GetAllAsync(status: statusFilter);
        page = 1;
    }

    private async Task EmailAsync(int id)
    {
        sending = id;
        var (ok, error, _) = await Loading.RunAsync(() => LandlordService.InviteAsync(id, currentUser, Nav.BaseUri));
        sending = null;
        if (!ok) { Toast.ShowError(error ?? "Could not send the invite."); return; }
        Toast.ShowSuccess("Invitation email sent to the landlord.");
        await LoadAsync();
    }

    private async Task SetFilter(LandlordStatus? s)
    {
        statusFilter = s;
        await LoadAsync();
    }

    private void Open(int id) => Nav.NavigateTo($"/admin/landlords/{id}");

    public static string Label(LandlordStatus s) => s switch
    {
        LandlordStatus.InvitationSent => "Invitation Sent",
        LandlordStatus.OtpVerified => "OTP Verified",
        LandlordStatus.InProgress => "In Progress",
        LandlordStatus.UnderReview => "Under Review",
        LandlordStatus.CorrectionRequired => "Correction Required",
        LandlordStatus.RegistrationComplete => "Registration Complete",
        _ => s.ToString()
    };

    public static string StatusClass(LandlordStatus s) => s switch
    {
        LandlordStatus.RegistrationComplete => "bg-success",
        LandlordStatus.UnderReview or LandlordStatus.Submitted => "bg-info text-dark",
        LandlordStatus.CorrectionRequired => "bg-warning text-dark",
        LandlordStatus.InvitationSent or LandlordStatus.OtpVerified or LandlordStatus.InProgress => "bg-primary",
        LandlordStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}
