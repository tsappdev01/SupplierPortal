@page "/admin/land-register"
@attribute [Authorize(Roles = "Administrator,LeasingManager")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using SupplierPortal.Web.Models.Leasing
@using SupplierPortal.Web.Services.Leasing
@inject LandRegisterService LandRegisterService

<PageTitle>Land Register - Supplier Portal</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="mb-0">Land Register</h1>
</div>
<p class="text-muted">Land is read from the Dubai Municipality property view. Each building is an ownable premises to which one or more landlords are assigned.</p>

<ul class="nav nav-tabs mb-3">
    @foreach (var z in LandRegisterService.Zones)
    {
        <li class="nav-item">
            <button type="button" class="nav-link @(z == zone ? "active" : "")" @onclick="() => SelectZone(z)">
                Zone @z
            </button>
        </li>
    }
</ul>

<div class="row g-2 mb-3">
    <div class="col-sm-3">
        <div class="di-stat-card">
            <span class="di-stat-value">@(view?.PropertyCount ?? 0)</span>
            <span class="di-stat-label">Property Codes</span>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="di-stat-card">
            <span class="di-stat-value">@(view?.TotalBuildings ?? 0)</span>
            <span class="di-stat-label">Buildings / Premises</span>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="di-stat-card">
            <span class="di-stat-value text-success">@(view?.AssignedBuildings ?? 0)</span>
            <span class="di-stat-label">With Owner</span>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="di-stat-card">
            <span class="di-stat-value text-warning">@(view?.UnassignedBuildings ?? 0)</span>
            <span class="di-stat-label">Unassigned</span>
        </div>
    </div>
</div>

<div class="input-group mb-3" style="max-width: 420px;">
    <span class="input-group-text">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
        </svg>
    </span>
    <input class="form-control" placeholder="Search property code or building…"
           value="@search" @oninput="OnSearchInput" />
    @if (!string.IsNullOrEmpty(search))
    {
        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">Clear</button>
    }
</div>

@if (loading)
{
    <p class="text-muted">Loading land register…</p>
}
else if (view is null || view.Properties.Count == 0)
{
    <div class="alert alert-light border">No properties found in zone @zone@(string.IsNullOrEmpty(search) ? "" : $" matching \"{search}\"").</div>
}
else
{
    <div class="accordion" id="landRegisterAccordion">
        @foreach (var (property, index) in view.Properties.Select((p, i) => (p, i)))
        {
            var isOpen = expanded.Contains(property.PropertyCode);
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button type="button" class="accordion-button @(isOpen ? "" : "collapsed")" @onclick="() => Toggle(property.PropertyCode)">
                        <span class="di-prop-code">@property.PropertyCode</span>
                        <span class="badge bg-secondary ms-2">@property.Buildings.Count building@(property.Buildings.Count == 1 ? "" : "s")</span>
                        @if (property.AssignedCount > 0)
                        {
                            <span class="badge bg-success ms-2">@property.AssignedCount assigned</span>
                        }
                    </button>
                </h2>
                @if (isOpen)
                {
                    <div class="accordion-body p-0 table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Building</th>
                                    <th>Lease No</th>
                                    <th>Landlord Code</th>
                                    <th>Company</th>
                                    <th>Contact</th>
                                    <th>Email</th>
                                    <th>Owner(s)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in property.Buildings)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(b.BuildingName) ? "—" : b.BuildingName)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.LeaseNo) ? "—" : b.LeaseNo)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.LandLordCode) ? "—" : b.LandLordCode)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.CompanyName) ? "—" : b.CompanyName)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.ContactName) ? "—" : b.ContactName)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.EmailAddress) ? "—" : b.EmailAddress)</td>
                                        <td>
                                            @if (b.Owners.Count == 0)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Unassigned</span>
                                            }
                                            else
                                            {
                                                @foreach (var o in b.Owners)
                                                {
                                                    <span class="badge @StatusClass(o.Status) me-1" title="@o.Status">@o.LegalName</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .di-stat-card {
        display: flex;
        flex-direction: column;
        padding: .75rem 1rem;
        border: 1px solid var(--bs-border-color);
        border-radius: .5rem;
        background: var(--bs-body-bg);
    }
    .di-stat-value { font-size: 1.5rem; font-weight: 600; line-height: 1.1; }
    .di-stat-label { font-size: .8rem; color: var(--bs-secondary-color); }
    .di-prop-code { font-weight: 600; font-variant-numeric: tabular-nums; }
</style>

@code {
    private string zone = "";
    private string search = "";
    private bool loading = true;
    private LandRegisterView? view;
    private readonly HashSet<string> expanded = new();
    private CancellationTokenSource? debounceCts;

    protected override async Task OnInitializedAsync()
    {
        zone = LandRegisterService.ResolveZone(null);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        view = await LandRegisterService.GetRegisterAsync(zone, search);
        expanded.RemoveWhere(code => view!.Properties.All(p => p.PropertyCode != code));
        loading = false;
    }

    private async Task SelectZone(string z)
    {
        if (z == zone) return;
        zone = z;
        expanded.Clear();
        await LoadAsync();
    }

    private void Toggle(string code)
    {
        if (!expanded.Add(code)) expanded.Remove(code);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            await LoadAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task ClearSearch()
    {
        search = "";
        await LoadAsync();
    }

    private static string StatusClass(LandlordStatus status) => status switch
    {
        LandlordStatus.Approved => "bg-success",
        LandlordStatus.UnderReview => "bg-info text-dark",
        LandlordStatus.AwaitingLandlordResponse => "bg-primary",
        LandlordStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}
