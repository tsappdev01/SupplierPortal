@code {
    [Parameter] public string? Token { get; set; }
    [Parameter] public int? TokenId { get; set; }
    [SupplyParameterFromQuery(Name = "s")] public string? SessionToken { get; set; }

    private bool uaePassLocked;

    private static readonly string[] stepLabels = ["Primary Contact", "Secondary Contacts", "Documents", "Signatories", "Review"];

    private LandlordAccessToken? accessToken;
    private Landlord? landlord;
    private LandlordRegistrationComment? correction;

    private readonly ContactInput primary = new() { IsPrimary = true, ContactType = ContactType.Owner };
    private readonly List<ContactInput> secondaries = new();
    private readonly List<SignatoryInput> signatories = new();
    private SigningRule signingRule = SigningRule.All;
    private List<LandlordDocument> documents = [];

    private int step;
    private bool loading = true, saving, submitted, declared;
    private string? error, reference;

    private string ActorLabel => $"Landlord Self-Service ({landlord?.Email})";
    private string? eidExtractNote;

    // Inline per-document upload indicator.
    private LandlordDocumentType? uploadingType;
    private string? uploadingName;

    // Per-signatory authorisation (MOA / POA) documents, keyed by the signatory's (lower-cased) email.
    private Dictionary<string, LandlordDocument> sigDocByEmail = new();
    private readonly Dictionary<string, SigUp> sigUpByEmail = new();
    private string? sigUploadingEmail;
    private sealed class SigUp { public LandlordDocumentType Type { get; set; } = LandlordDocumentType.Moa; public DateTime? Expiry { get; set; } }
    private SigUp SigUpFor(string key)
    {
        if (!sigUpByEmail.TryGetValue(key, out var v)) { v = new SigUp(); sigUpByEmail[key] = v; }
        return v;
    }
    private static string DocTypeShort(LandlordDocumentType t) => t == LandlordDocumentType.PowerOfAttorney ? "POA" : "MOA";

    private string StepHeading => step switch
    {
        0 => "Primary contact details", 1 => "Secondary contacts", 2 => "Supporting documents",
        3 => "Authorised signatories", _ => "Review & submit"
    };
    private string StepSubtitle => step switch
    {
        0 => "The person DIP will deal with on the tenancy. Property details are set by Business Centre and cannot be changed.",
        1 => "Add any additional contacts for this landlord (optional).",
        2 => "Upload the required documents. All documents are retained with your registration.",
        3 => "Who is authorised to sign on behalf of the landlord.",
        _ => "Check everything below, then submit for Business Centre review."
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(SessionToken))
            accessToken = TokenId is int tid
                ? await AccessTokenService.ValidateSessionByIdAsync(tid, SessionToken)
                : await AccessTokenService.ValidateSessionAsync(Token ?? "", SessionToken);

        if (accessToken is not null)
        {
            // When UAE Pass is enabled, identity verification is mandatory before the form opens; if the
            // session hasn't been through it, bounce back to the UAE Pass step. When disabled, skip it entirely.
            if (UaePass.Enabled && accessToken.UaePassVerifiedAt is null)
            {
                if (!string.IsNullOrWhiteSpace(Token))
                    Nav.NavigateTo($"/landlord/{Token}/uaepass?s={SessionToken}");
                loading = false;
                return;
            }

            landlord = await LandlordService.GetForSelfServiceAsync(accessToken.LandlordId);
            if (landlord is not null)
            {
                correction = await LandlordService.GetOpenCorrectionAsync(landlord.Id);
                SeedFromExisting();
                ApplyUaePass();
                documents = await LoadLandlordDocumentsAsync(landlord.Id);
                await LoadSignatoryDocsAsync();
            }
        }
        loading = false;
    }

    private void SeedFromExisting()
    {
        var ep = landlord!.Contacts.FirstOrDefault(c => c.IsPrimary);
        if (ep is not null) CopyInto(primary, ep);
        foreach (var c in landlord.Contacts.Where(c => !c.IsPrimary)) { var s = new ContactInput(); CopyInto(s, c); secondaries.Add(s); }
        signingRule = landlord.SigningRule;
        // Primary + secondary contacts are rendered as locked signatories (derived live from the contacts),
        // so load ONLY the user-defined ones here — i.e. those not matching any contact's email.
        var contactEmails = landlord.Contacts
            .Select(c => c.Email?.Trim().ToLowerInvariant())
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .ToHashSet();
        signatories.AddRange(landlord.Signatories
            .Where(s => !s.IsPrimaryContact && !contactEmails.Contains(s.Email?.Trim().ToLowerInvariant()))
            .OrderBy(s => s.Order)
            .Select(s => new SignatoryInput { Name = s.Name, Email = s.Email, Mobile = s.Mobile }));
    }

    /// <summary>Overwrites the primary contact's name / email / mobile with the UAE Pass identity and locks
    /// them in the UI. Emirates ID number is prefilled when UAE Pass exposes it, but stays editable.</summary>
    private void ApplyUaePass()
    {
        if (accessToken?.UaePassVerifiedAt is null) return;
        if (!string.IsNullOrWhiteSpace(accessToken.UaePassFullName)) primary.FullName = accessToken.UaePassFullName!;
        if (!string.IsNullOrWhiteSpace(accessToken.UaePassEmail)) primary.Email = accessToken.UaePassEmail!;
        if (!string.IsNullOrWhiteSpace(accessToken.UaePassMobile)) primary.Mobile = accessToken.UaePassMobile!;
        if (!string.IsNullOrWhiteSpace(accessToken.UaePassEmiratesId) && string.IsNullOrWhiteSpace(primary.EmiratesId))
            primary.EmiratesId = accessToken.UaePassEmiratesId;
        uaePassLocked = true;
    }

    private static void CopyInto(ContactInput t, LandlordContact c)
    {
        t.Id = c.Id; t.IsPrimary = c.IsPrimary; t.ContactType = c.ContactType; t.FullName = c.FullName;
        t.Designation = c.Designation; t.Mobile = c.Mobile; t.Email = c.Email; t.EmiratesId = c.EmiratesId;
        t.EmiratesIdName = c.EmiratesIdName; t.EmiratesIdExpiry = c.EmiratesIdExpiry;
    }

    private RenderFragment ContactFields(ContactInput c, bool isPrimary) => __builder =>
    {
        var locked = isPrimary && uaePassLocked;
        @if (locked)
        {
            <div class="uaep-note">✔ Verified by UAE Pass — name, email and mobile are taken from your UAE Pass account and cannot be changed.</div>
        }
        <div class="grid2">
            <div class="field" style="margin-bottom:0"><label class="lbl">Full name @MarkReq()</label><input type="text" placeholder="As on the Emirates ID" readonly="@locked" @bind="c.FullName" /></div>
            <div class="field" style="margin-bottom:0"><label class="lbl">Designation</label><input type="text" @bind="c.Designation" /></div>
            <div class="field" style="margin-bottom:0">
                <label class="lbl">Mobile number @MarkReq()</label><input type="text" placeholder="+971 5X XXX XXXX" readonly="@locked" @bind="c.Mobile" />
                <div class="hint">@(locked ? "From your UAE Pass account." : "UAE mobile, must match the UAE Pass account.")</div>
            </div>
            <div class="field" style="margin-bottom:0">
                <label class="lbl">Email address @MarkReq()</label><input type="text" placeholder="name@company.ae" readonly="@locked" @bind="c.Email" />
                <div class="hint">@(locked ? "From your UAE Pass account." : "Must match the UAE Pass account.")</div>
            </div>
            <div class="field" style="margin-bottom:0"><label class="lbl">Contact type</label>
                <select @bind="c.ContactType">@foreach (var t in Enum.GetValues<ContactType>()) { <option value="@t">@t</option> }</select>
            </div>
        </div>
    };

    private RenderFragment MarkReq() => __builder => { <span class="req">*</span> };

    private RenderFragment UploadField(LandlordDocumentType type, string label, bool required) => __builder =>
    {
        var doc = documents.FirstOrDefault(d => d.DocumentType == type);
        var isUploading = uploadingType == type;
        <div class="field">
            <label class="lbl">@label @(required ? MarkReq() : null)</label>
            <div class="up @(doc is not null ? "filled" : "") @(isUploading ? "uploading" : "")">
                @if (isUploading)
                {
                    <span class="name"><span class="di-up-spinner"></span> Uploading @(uploadingName ?? "file")…</span>
                }
                else
                {
                    <span class="name @(doc is null ? "empty" : "")">@(doc?.FileName ?? "No file chosen — PDF, JPG or PNG up to 10 MB")</span>
                    @if (doc is not null)
                    {
                        <button class="link danger" @onclick="() => DeleteDocAsync(doc.Id)">Replace / remove</button>
                    }
                    else
                    {
                        <label class="btn ghost" style="padding:7px 13px;font-size:13px;margin:0">
                            Choose file
                            <InputFile OnChange="@(e => UploadAsync(e, type))" style="display:none" accept=".pdf,image/*" />
                        </label>
                    }
                }
            </div>
            @if (isUploading)
            {
                <div class="di-up-bar"><div class="di-up-bar-fill"></div></div>
            }
        </div>
    };

    /// <summary>Editable Emirates ID details shown once the card is uploaded — prefilled from OCR, correctable
    /// by the landlord, and saved onto the primary contact.</summary>
    private RenderFragment EmiratesIdDetails() => __builder =>
    {
        <div class="panel mb-3">
            @if (eidExtractNote is not null)
            {
                <p style="color:var(--ok);margin:0 0 10px">@eidExtractNote</p>
            }
            <div class="grid2">
                <div class="field" style="margin-bottom:0"><label class="lbl">Emirates ID number @MarkReq()</label><input type="text" placeholder="784-YYYY-XXXXXXX-X" @bind="primary.EmiratesId" /></div>
                <div class="field" style="margin-bottom:0"><label class="lbl">Name (as on card) @MarkReq()</label><input type="text" @bind="primary.EmiratesIdName" /></div>
                <div class="field" style="margin-bottom:0"><label class="lbl">Expiry date @MarkReq()</label><input type="date" @bind="primary.EmiratesIdExpiry" /></div>
            </div>
            <div class="hint">Read automatically from the uploaded card — please check and correct if needed.</div>
            @if (primary.EmiratesIdExpiry is { } exp && exp.Date < DateTime.UtcNow.Date)
            {
                <p style="color:var(--danger);margin:8px 0 0;font-size:13px">This Emirates ID has expired (@exp.ToString("dd MMM yyyy")). A valid, unexpired Emirates ID is required to submit.</p>
            }
        </div>
    };

