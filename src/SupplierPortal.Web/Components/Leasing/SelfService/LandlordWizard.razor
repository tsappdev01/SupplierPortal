    /// <summary>Per-signatory MOA/POA authorisation document panel (upload / replace / view), keyed by the
    /// signatory's email. Uploading persists the current form as a draft first so the signatory has an id to
    /// attach the document to.</summary>
    private RenderFragment SignatoryDocPanel(string? email, bool required = false) => __builder =>
    {
        var key = (email ?? "").Trim().ToLowerInvariant();
        <div class="sig-doc">
            @if (string.IsNullOrWhiteSpace(key))
            {
                <span class="muted">Enter this signatory's email to attach their MOA / POA.</span>
            }
            else
            {
                var doc = sigDocByEmail.GetValueOrDefault(key);
                var up = SigUpFor(key);
                var busy = sigUploadingEmail == key;
                <div class="sig-doc-line">
                    <span class="sig-doc-lbl">Authorisation (MOA / POA)@(required ? " *" : "")</span>
                    @if (doc is not null)
                    {
                        <span class="sig-doc-file">@CheckIcon @DocTypeShort(doc.DocumentType) · @doc.FileName@(doc.ExpiryDate is { } de ? $" · exp {de:dd MMM yyyy}" : "")</span>
                        <a class="link" href="/landlord-documents/@doc.Id" target="_blank">View</a>
                    }
                    else if (!busy)
                    {
                        @if (required)
                        {
                            <span class="sig-doc-required">Required — please upload</span>
                        }
                        else
                        {
                            <span class="muted">Not uploaded</span>
                        }
                    }
                </div>
                <div class="sig-doc-controls">
                    <div class="sig-doc-fields">
                        <select class="di-in" style="max-width:100px" @bind="up.Type">
                            <option value="@LandlordDocumentType.Moa">MOA</option>
                            <option value="@LandlordDocumentType.PowerOfAttorney">POA</option>
                        </select>
                        <input type="date" class="di-in" style="max-width:160px" @bind="up.Expiry" placeholder="Expiry" />
                        @if (busy)
                        {
                            <span class="muted"><span class="di-up-spinner"></span> Uploading…</span>
                        }
                        else
                        {
                            <label class="btn sig-upload-btn">
                                @UploadIcon @(doc is null ? "Upload" : "Replace")
                                <InputFile OnChange="@(e => UploadSignatoryDocAsync(key, e))" style="display:none" accept=".pdf,image/*" />
                            </label>
                        }
                    </div>
                    @if (!busy)
                    {
                        <label class="sig-dropzone">
                            <span class="sig-dropzone-ico">@CloudUploadIcon</span>
                            <span class="sig-dropzone-txt"><b>Upload MOA / POA</b><span>PDF, JPG, PNG up to 10MB</span></span>
                            <InputFile OnChange="@(e => UploadSignatoryDocAsync(key, e))" style="display:none" accept=".pdf,image/*" />
                        </label>
                    }
                </div>
            }
        </div>
    };

    private async Task LoadSignatoryDocsAsync()
    {
        if (landlord is null) return;
        var byId = await DocumentService.GetSignatoryDocumentsAsync(landlord.Id);
        var emailById = landlord.Signatories.ToDictionary(s => s.Id, s => (s.Email ?? "").Trim().ToLowerInvariant());
        sigDocByEmail = byId.Where(kv => emailById.ContainsKey(kv.Key))
            .ToDictionary(kv => emailById[kv.Key], kv => kv.Value);
    }

    private async Task UploadSignatoryDocAsync(string emailKey, InputFileChangeEventArgs e)
    {
        if (landlord is null || accessToken is null) return;
        error = null;
        var up = SigUpFor(emailKey);

        // Validate the file up front so problems are reported clearly rather than as a generic failure.
        const long maxBytes = 10 * 1024 * 1024;
        var ext = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (e.File.Size == 0) { error = "The selected file is empty. Please choose a different file."; return; }
        if (e.File.Size > maxBytes) { error = "The file exceeds the 10 MB size limit."; return; }
        if (ext is not (".pdf" or ".jpg" or ".jpeg" or ".png" or ".tif" or ".tiff"))
        {
            error = $"Unsupported file type '{ext}'. Allowed: PDF or image (JPG, PNG, TIFF).";
            return;
        }

        sigUploadingEmail = emailKey;

        // Read the browser file into memory first (it can only be streamed once, and reading it before the
        // draft save avoids the stream being invalidated by the intervening server round-trips).
        byte[] bytes;
        try
        {
            using var ms = new MemoryStream();
            await using (var source = e.File.OpenReadStream(maxBytes))
            {
                await source.CopyToAsync(ms);
            }
            bytes = ms.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Signatory MOA/POA: reading the uploaded file failed (landlord {LandlordId}).", landlord.Id);
            error = $"Could not read the selected file ({ex.Message}). Please choose the file again.";
            sigUploadingEmail = null;
            return;
        }

        try
        {
            // Persist the current form as a draft so the signatory rows exist (with ids) to attach to.
            var draft = await LandlordService.SaveAsync(landlord.Id, BuildUpdate(), submit: false, ActorLabel, accessToken.Id, null);
            if (!draft.Success)
            {
                error = draft.Error ?? "Please complete the required fields before uploading the signatory document.";
                return;
            }
            landlord = await LandlordService.GetForSelfServiceAsync(accessToken.LandlordId) ?? landlord;
            var sig = landlord.Signatories.FirstOrDefault(s =>
                string.Equals((s.Email ?? "").Trim(), emailKey, StringComparison.OrdinalIgnoreCase));
            if (sig is null)
            {
                error = "Could not match this signatory — please check the email address and try again.";
                return;
            }
            var (ok, err) = await DocumentService.UploadSignatoryDocAsync(landlord.Id, sig.Id, up.Type, up.Expiry, e.File.Name, e.File.ContentType, bytes, ActorLabel);
            if (!ok) { error = err; return; }
            await LoadSignatoryDocsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Signatory MOA/POA upload failed (landlord {LandlordId}, signatory {Email}).", landlord.Id, emailKey);
            error = $"Could not upload the document: {ex.Message}";
        }
        finally { sigUploadingEmail = null; }
    }

    private static string FormatCode(string code) => code;

    private void AddSecondary() => secondaries.Add(new ContactInput { ContactType = ContactType.AuthorisedRepresentative });
    private void RemoveSecondary(int i) { if (i >= 0 && i < secondaries.Count) secondaries.RemoveAt(i); }
    private void AddSignatory() => signatories.Add(new SignatoryInput());
    private void RemoveSignatory(int i) { if (i >= 0 && i < signatories.Count) signatories.RemoveAt(i); }

    private void Back() { error = null; if (step > 0) step--; }

    /// <summary>Validates a contact's name / email / UAE mobile. Returns an error message or null.</summary>
    private static string? ValidateContact(ContactInput c, string who)
    {
        if (string.IsNullOrWhiteSpace(c.FullName)) return $"{who}: full name is required.";
        if (!ContactValidation.IsValidEmail(c.Email)) return $"{who}: a valid email address is required (it must match the UAE Pass account).";
        if (!ContactValidation.IsValidUaeMobile(c.Mobile)) return $"{who}: a valid UAE mobile number is required (e.g. +9715XXXXXXXX).";
        return null;
    }

    private void Next()
    {
        error = null;
        if (step == 0)
        {
            error = ValidateContact(primary, "Primary contact");
            if (error is not null) return;
        }
        if (step == 1)
        {
            for (var i = 0; i < secondaries.Count; i++)
            {
                error = ValidateContact(secondaries[i], $"Secondary contact {i + 1}");
                if (error is not null) return;
            }
        }
        if (step == 3)
        {
            error = ValidateSignatoryDocs();
            if (error is not null) return;
        }
        if (step < stepLabels.Length - 1) step++;
    }

    /// <summary>
    /// Every additional signatory (i.e. anyone who is not the primary or a secondary contact) must have an
    /// authorising MOA / POA document uploaded. Primary and secondary contacts are exempt.
    /// </summary>
    private string? ValidateSignatoryDocs()
    {
        foreach (var s in signatories.Where(s => !string.IsNullOrWhiteSpace(s.Name)))
        {
            var key = (s.Email ?? "").Trim().ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(key) || !sigDocByEmail.ContainsKey(key))
            {
                return $"Signatory '{s.Name}' requires an authorising MOA / POA document to be uploaded.";
            }
        }
        return null;
    }

    private LandlordSelfUpdate BuildUpdate()
    {
        var contacts = new List<ContactInput> { primary };
        contacts.AddRange(secondaries.Where(c => !string.IsNullOrWhiteSpace(c.FullName)));

        // Primary + secondary contacts are always authorised signatories and are not user-editable/removable;
        // the primary is flagged IsPrimaryContact. Any further user-defined signatories follow.
        var sigs = new List<SignatoryInput>
        {
            new() { Name = primary.FullName, Email = primary.Email, Mobile = primary.Mobile, IsPrimaryContact = true }
        };
        sigs.AddRange(secondaries.Where(c => !string.IsNullOrWhiteSpace(c.FullName))
            .Select(c => new SignatoryInput { Name = c.FullName, Email = c.Email, Mobile = c.Mobile }));
        sigs.AddRange(signatories.Where(s => !string.IsNullOrWhiteSpace(s.Name)));
        return new LandlordSelfUpdate { SigningRule = signingRule, Contacts = contacts, Signatories = sigs };
    }

    private async Task UploadAsync(InputFileChangeEventArgs e, LandlordDocumentType type)
    {
        if (landlord is null) return;
        error = null;
        var file = e.File;
        var fileName = file.Name;
        var contentType = file.ContentType;

        // 1) Read the browser file to bytes FIRST — before any re-render. Showing the "Uploading…" indicator
        //    re-renders and swaps out the <InputFile> element, which invalidates the browser file handle and
        //    was causing "Could not read the selected file". So capture the bytes before touching the UI.
        //    The stream can be opened only once, so the same bytes serve both the upload and the OCR.
        byte[] bytes;
        try
        {
            using var ms = new MemoryStream();
            await using (var src = file.OpenReadStream(10 * 1024 * 1024))
                await src.CopyToAsync(ms);
            bytes = ms.ToArray();
        }
        catch
        {
            error = "Could not read the selected file. Please choose the file again.";
            return;
        }
        if (bytes.Length == 0)
        {
            error = "The selected file is empty. Please choose a different file.";
            return;
        }

        // 2) Now show the inline indicator while the file is stored and (for an Emirates ID) OCR-scanned.
        uploadingType = type;
        uploadingName = fileName;
        await InvokeAsync(StateHasChanged);
        try
        {
            var res = await DocumentService.UploadBytesAsync(landlord.Id, type, fileName, contentType, bytes, ActorLabel);
            if (!res.Success)
            {
                error = res.Error ?? "The document could not be saved. Please try again.";
                return;
            }

            // Emirates-ID auto-read is best-effort — it must never fail the upload. On any problem we just
            // leave a note asking the user to enter the details manually.
            if (type == LandlordDocumentType.EmiratesId)
            {
                try { await TryExtractEmiratesIdAsync(bytes, fileName); }
                catch { eidExtractNote = "Document uploaded. We couldn't auto-read the Emirates ID — please enter the number, name and expiry below."; }
            }

            documents = await LoadLandlordDocumentsAsync(landlord.Id);
        }
        finally
        {
            uploadingType = null;
            uploadingName = null;
        }
    }

    /// <summary>Best-effort extraction of an uploaded Emirates ID: reads the PDF text layer locally first
    /// (instant, no cloud), then falls back to cloud OCR for image-only cards. Prefills the primary contact
    /// and always leaves a note so the user knows whether to check / enter the details manually.</summary>
    private async Task TryExtractEmiratesIdAsync(byte[] bytes, string fileName)
    {
        string? text = null;

        // 1) Fast path: a PDF that carries a real text layer can be read locally without any cloud OCR.
        if (fileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            text = LocalPdfText.TryExtract(bytes);
        var haveId = !string.IsNullOrWhiteSpace(text) && EmiratesIdExtractor.Parse(text).Number is not null;

        // 2) Fall back to cloud OCR for image-only cards (or PDFs without a usable text layer).
        if (!haveId && Ocr.IsEnabled)
        {
            string? temp = null;
            try
            {
                temp = Path.Combine(Path.GetTempPath(), $"eid-{Guid.NewGuid():N}{Path.GetExtension(fileName)}");
                await File.WriteAllBytesAsync(temp, bytes);
                var ocr = await Ocr.ExtractTextAsync(temp);
                if (!string.IsNullOrWhiteSpace(ocr)) text = ocr;
            }
            catch { /* fall through to the manual-entry note */ }
            finally { if (temp is not null && File.Exists(temp)) { try { File.Delete(temp); } catch { } } }
        }

        if (string.IsNullOrWhiteSpace(text))
        {
            eidExtractNote = Ocr.IsEnabled
                ? "We couldn't read the card automatically — please enter the Emirates ID details below."
                : "Automatic reading is unavailable — please enter the Emirates ID details below.";
            return;
        }

        var r = EmiratesIdExtractor.Parse(text);
        if (r.Number is not null) primary.EmiratesId = r.Number;
        // The card name is its OWN field — it is never copied into the contact's entered Full Name.
        if (r.Name is not null) primary.EmiratesIdName = r.Name;
        if (r.Expiry is not null && primary.EmiratesIdExpiry is null
            && DateTime.TryParseExact(r.Expiry.Replace('-', '/'), "dd/MM/yyyy",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var exp))
            primary.EmiratesIdExpiry = exp;
        eidExtractNote = (r.Number is not null || r.Name is not null || r.Expiry is not null)
            ? $"Read from the card — ID: {r.Number ?? "—"}, Name: {r.Name ?? "—"}, Expiry: {r.Expiry ?? "—"}. Please check and correct if needed."
            : "We couldn't read the card automatically — please enter the Emirates ID details below.";
    }

    // Landlord-facing document list — excludes the system-generated registration-summary PDF.
    private async Task<List<LandlordDocument>> LoadLandlordDocumentsAsync(int landlordId) =>
        (await DocumentService.GetDocumentsAsync(landlordId))
            .Where(d => d.DocumentType is not (LandlordDocumentType.RegistrationSummary or LandlordDocumentType.SignedDocument))
            .ToList();

    private async Task DeleteDocAsync(int docId)
    {
        await DocumentService.DeleteAsync(docId);
        documents = await LoadLandlordDocumentsAsync(landlord!.Id);
    }

    private async Task SaveDraftAsync()
    {
        if (landlord is null || accessToken is null) return;
        saving = true; error = null;
        var (ok, err, _) = await LandlordService.SaveAsync(landlord.Id, BuildUpdate(), submit: false, ActorLabel, accessToken.Id, null);
        saving = false;
        if (!ok) { error = err; return; }
        ToastService.ShowSuccess("Draft saved. You can return via your secure link to continue.");
    }

    private string? ValidateForSubmit()
    {
        var pc = ValidateContact(primary, "Primary contact");
        if (pc is not null) return pc;
        for (var i = 0; i < secondaries.Count; i++)
        {
            var sc = ValidateContact(secondaries[i], $"Secondary contact {i + 1}");
            if (sc is not null) return sc;
        }
        // Additional signatories, when named, need a valid email.
        foreach (var s in signatories.Where(s => !string.IsNullOrWhiteSpace(s.Name)))
            if (!ContactValidation.IsValidEmail(s.Email))
                return $"Signatory '{s.Name}' needs a valid email address.";

        // Every additional signatory must have an authorising MOA / POA uploaded (primary/secondary exempt).
        var sigDocError = ValidateSignatoryDocs();
        if (sigDocError is not null) return sigDocError;

        if (landlord!.Type == LandlordType.Individual)
        {
            if (!documents.Any(d => d.DocumentType == LandlordDocumentType.EmiratesId))
                return "Emirates ID document is mandatory for an individual landlord.";
            if (string.IsNullOrWhiteSpace(primary.EmiratesId))
                return "The Emirates ID number is required — check the Documents step.";
            if (string.IsNullOrWhiteSpace(primary.EmiratesIdName))
                return "The name as printed on the Emirates ID is required — check the Documents step.";
            if (primary.EmiratesIdExpiry is null)
                return "The Emirates ID expiry date is required — check the Documents step.";
            // An expired Emirates ID only raises an alert (below / inline) — it does not block submission.
        }
        else if (!documents.Any(d => d.DocumentType is LandlordDocumentType.MoaOrPoa
                     or LandlordDocumentType.PowerOfAttorney or LandlordDocumentType.Moa))
            return "The MOA / POA document is required for a company.";
        return null;
    }

    private async Task SubmitAsync()
    {
        if (landlord is null || accessToken is null) return;
        error = ValidateForSubmit();
        if (error is not null)
        {
            step = error.StartsWith("Secondary") ? 1
                 : error.StartsWith("Signatory") ? 3
                 : error.StartsWith("Primary") ? 0
                 : 2; // document errors
            return;
        }

        saving = true;
        var (ok, err, reason) = await LandlordService.SaveAsync(landlord.Id, BuildUpdate(), submit: true, ActorLabel, accessToken.Id, null, Nav.BaseUri);
        if (!ok) { error = err; saving = false; return; }
        await AccessTokenService.MarkUsedAsync(accessToken.Id);
        reference = reason;
        submitted = true;
        ToastService.ShowSuccess("Registration submitted for review.");
    }

    private static string DocLabel(LandlordDocumentType t) => t switch
    {
        LandlordDocumentType.EmiratesId => "Emirates ID",
        LandlordDocumentType.TradeLicense => "Trade Licence",
        LandlordDocumentType.Moa => "Memorandum of Association (MOA)",
        LandlordDocumentType.PowerOfAttorney => "Power of Attorney (POA)",
        LandlordDocumentType.MoaOrPoa => "MOA / POA",
        LandlordDocumentType.AuthorisationLetter => "Authorisation Letter",
        LandlordDocumentType.TitleDeed => "Title Deed",
        _ => "Other"
    };
}
