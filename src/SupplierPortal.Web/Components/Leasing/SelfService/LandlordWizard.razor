@page "/landlord/{Token}/update"
@layout Layout.PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Forms
@using SupplierPortal.Web.Models.Leasing
@using SupplierPortal.Web.Services
@using SupplierPortal.Web.Services.Leasing
@inject LandlordAccessTokenService AccessTokenService
@inject LandlordService LandlordService
@inject LandlordDocumentService DocumentService
@inject ToastService ToastService
@inject LoadingService Loading
@inject IDocumentOcrService Ocr
@inject IWebHostEnvironment Env

<PageTitle>Landlord Registration</PageTitle>

<div class="di-llw">
    @if (loading)
    {
        <div class="di-llw-shell"><div class="card"><div class="card-bd"><p><em>Loading…</em></p></div></div></div>
    }
    else if (landlord is null)
    {
        <div class="di-llw-shell"><div class="card"><div class="card-bd">
            <h2 class="di-h">Session expired</h2>
            <p class="muted">Your verification session is no longer valid. Please use the link from your email again to restart.</p>
        </div></div></div>
    }
    else if (submitted)
    {
        <div class="di-llw-shell"><div class="card"><div class="card-bd done-wrap">
            <svg class="tick" viewBox="0 0 24 24" fill="none" stroke="#1D6F53" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
            <h2 class="di-h mt-2">Registration submitted</h2>
            <p class="muted">Your registration has been submitted to Business Centre for review.</p>
            <div class="ref">@reference</div>
        </div></div></div>
    }
    else
    {
        @* -------- chevron step ribbon -------- *@
        <div class="ribbon">
            <div class="steps">
                @foreach (var (label, i) in stepLabels.Select((l, i) => (l, i)))
                {
                    <div class="step @(i == step ? "cur" : i < step ? "done" : "")">
                        <span class="n">@(i + 1)</span><span class="chev-label">@label</span>
                    </div>
                }
            </div>
            <div class="mstep">Step @(step + 1) of @stepLabels.Length · @stepLabels[step]</div>
        </div>

        <div class="di-llw-shell">
            <div class="card">
                <div class="card-hd">
                    <div class="eyebrow">Step @(step + 1) of @stepLabels.Length</div>
                    <h2>@StepHeading</h2>
                    <p>@StepSubtitle</p>
                </div>
                <div class="card-bd">
                    @if (correction is not null)
                    {
                        <div class="panel bad mb-3">
                            <h3>Correction requested by Business Centre</h3>
                            <p>@correction.Comment</p>
                        </div>
                    }
                    @if (error is not null)
                    {
                        <div class="panel bad mb-3"><p style="color:var(--danger);margin:0">@error</p></div>
                    }

                    @* ===== Step 0: Primary Contact ===== *@
                    @if (step == 0)
                    {
                        <div class="field">
                            <label class="lbl">Agreement type <span class="req">*</span></label>
                            <div class="choices">
                                <label class="choice @(landlord.Type == LandlordType.Company ? "sel" : "")">
                                    <input type="radio" checked="@(landlord.Type == LandlordType.Company)" disabled />
                                    <span><b>Company</b><span>Registered company holding the plot</span></span>
                                </label>
                                <label class="choice @(landlord.Type == LandlordType.Individual ? "sel" : "")">
                                    <input type="radio" checked="@(landlord.Type == LandlordType.Individual)" disabled />
                                    <span><b>Individual</b><span>Person holding the plot in their own name</span></span>
                                </label>
                            </div>
                            <div class="hint">Set by Business Centre for this property — read-only.</div>
                        </div>

                        <div class="field">
                            <label class="lbl">Property code <span class="req">*</span></label>
                            <div class="code">
                                <span class="k">Property code</span>
                                <span class="v">@FormatCode(landlord.PropertyCode)</span>
                            </div>
                            <div class="hint">@(landlord.CompanyName ?? "—") @(string.IsNullOrWhiteSpace(landlord.Building) ? "" : "· " + landlord.Building) · issued by Dubai Municipality (read-only).</div>
                        </div>

                        @ContactFields(primary, isPrimary: true)

                        @if (landlord.Type == LandlordType.Individual)
                        {
                            @UploadField(LandlordDocumentType.EmiratesId, "Emirates ID", required: true)
                            @if (eidExtractNote is not null)
                            {
                                <div class="hint" style="color:var(--ok)">@eidExtractNote</div>
                            }
                        }
                    }

                    @* ===== Step 1: Secondary Contacts ===== *@
                    else if (step == 1)
                    {
                        @if (secondaries.Count == 0)
                        {
                            <p class="muted">No secondary contacts added. These are optional.</p>
                        }
                        @for (var i = 0; i < secondaries.Count; i++)
                        {
                            var idx = i;
                            <div class="rev">
                                <h3>Secondary contact @(idx + 1)<button class="link danger" @onclick="() => RemoveSecondary(idx)">Remove</button></h3>
                                <div style="padding:14px 16px">@ContactFields(secondaries[idx], isPrimary: false)</div>
                            </div>
                        }
                        <div class="addrow"><button class="btn ghost" @onclick="AddSecondary">+ Add secondary contact</button></div>
                    }

                    @* ===== Step 2: Documents ===== *@
                    else if (step == 2)
                    {
                        @if (landlord.Type == LandlordType.Individual)
                        {
                            <p class="muted mb-3">Your Emirates ID was captured with the primary contact. You may add a title deed if available.</p>
                            @UploadField(LandlordDocumentType.EmiratesId, "Emirates ID", required: true)
                            @UploadField(LandlordDocumentType.TitleDeed, "Title Deed", required: false)
                        }
                        else
                        {
                            <p class="muted mb-3">Upload the company's MOA or POA (one document). Trade licence and title deed are optional.</p>
                            @UploadField(LandlordDocumentType.MoaOrPoa, "MOA / POA", required: true)
                            @UploadField(LandlordDocumentType.TradeLicense, "Trade Licence", required: false)
                            @UploadField(LandlordDocumentType.TitleDeed, "Title Deed", required: false)
                        }
                    }

                    @* ===== Step 3: Signatories ===== *@
                    else if (step == 3)
                    {
                        <div class="field">
                            <label class="lbl">Signing rule</label>
                            <div class="choices">
                                <label class="choice @(signingRule == SigningRule.All ? "sel" : "")">
                                    <input type="radio" name="sr" checked="@(signingRule == SigningRule.All)" @onchange="@(() => signingRule = SigningRule.All)" />
                                    <span><b>All must sign</b><span>Every signatory signs</span></span>
                                </label>
                                <label class="choice @(signingRule == SigningRule.Any ? "sel" : "")">
                                    <input type="radio" name="sr" checked="@(signingRule == SigningRule.Any)" @onchange="@(() => signingRule = SigningRule.Any)" />
                                    <span><b>Any one may sign</b><span>A single signatory suffices</span></span>
                                </label>
                            </div>
                        </div>
                        <div class="hint mb-2">The primary contact is always the first authorised signatory and cannot be removed.</div>
                        @* Locked primary signatory (mirrors the primary contact) *@
                        <div class="sig open">
                            <div class="sig-hd">
                                <span class="seq">1</span>
                                <div class="sig-id">
                                    <b>@(string.IsNullOrWhiteSpace(primary.FullName) ? "Primary contact" : primary.FullName)</b>
                                    <span>@primary.Email</span>
                                </div>
                                <span class="tagx">Primary</span>
                            </div>
                        </div>
                        @for (var i = 0; i < signatories.Count; i++)
                        {
                            var idx = i;
                            <div class="sig open">
                                <div class="sig-hd">
                                    <span class="seq">@(idx + 2)</span>
                                    <div class="sig-id" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
                                        <input class="di-in" placeholder="Name" @bind="signatories[idx].Name" />
                                        <input class="di-in" placeholder="Email" @bind="signatories[idx].Email" />
                                        <input class="di-in" placeholder="Mobile" @bind="signatories[idx].Mobile" />
                                    </div>
                                    <button class="link danger" @onclick="() => RemoveSignatory(idx)">Remove</button>
                                </div>
                            </div>
                        }
                        <div class="addrow"><button class="btn ghost" @onclick="AddSignatory">+ Add signatory</button></div>
                    }

                    @* ===== Step 4: Review ===== *@
                    else if (step == 4)
                    {
                        <div class="rev">
                            <h3>Property</h3>
                            <dl>
                                <div class="r"><dt>Property code</dt><dd class="mono">@FormatCode(landlord.PropertyCode)</dd></div>
                                <div class="r"><dt>Company</dt><dd>@(landlord.CompanyName ?? "—")</dd></div>
                                <div class="r"><dt>Agreement type</dt><dd>@landlord.Type</dd></div>
                            </dl>
                        </div>
                        <div class="rev">
                            <h3>Primary contact<button class="link" @onclick="() => step = 0">Edit</button></h3>
                            <dl>
                                <div class="r"><dt>Name</dt><dd>@primary.FullName</dd></div>
                                <div class="r"><dt>Email</dt><dd>@primary.Email</dd></div>
                                <div class="r"><dt>Mobile</dt><dd>@(primary.Mobile ?? "—")</dd></div>
                            </dl>
                        </div>
                        <div class="rev">
                            <h3>Details</h3>
                            <dl>
                                <div class="r"><dt>Secondary contacts</dt><dd>@secondaries.Count(c => !string.IsNullOrWhiteSpace(c.FullName))</dd></div>
                                <div class="r"><dt>Documents</dt><dd>@documents.Count</dd></div>
                                <div class="r"><dt>Signatories</dt><dd>@signatories.Count(s => !string.IsNullOrWhiteSpace(s.Name)) · @signingRule signing</dd></div>
                            </dl>
                        </div>
                        <div class="panel">
                            <label class="check"><input type="checkbox" @bind="declared" /> <span>I confirm the information provided is accurate and complete.</span></label>
                        </div>
                    }
                </div>

                <div class="card-ft">
                    <button class="btn ghost" disabled="@(step == 0)" @onclick="Back">Back</button>
                    <button class="btn taupe" disabled="@saving" @onclick="SaveDraftAsync">@(saving ? "Saving…" : "Save draft")</button>
                    <div class="spacer"></div>
                    @if (step < stepLabels.Length - 1)
                    {
                        <button class="btn" @onclick="Next">Continue <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6 6 6-6 6"/></svg></button>
                    }
                    else
                    {
                        <button class="btn" disabled="@(!declared || saving)" @onclick="SubmitAsync">@(saving ? "Submitting…" : "Submit registration")</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .di-llw{--navy:#092F56;--navy-deep:#06213D;--navy-mid:#164A7B;--navy-soft:#0E3A66;--taupe:#706259;--taupe-lt:#B4A79C;--sand:#F6F3EF;--line:#E2DCD4;--line-strong:#CFC5BA;--ink:#20262D;--ink-soft:#5C6670;--danger:#A32B24;--danger-bg:#FBF0EF;--ok:#1D6F53;--ok-bg:#EFF6F2;--r:4px;
        background:var(--navy-deep);min-height:100vh;color:var(--ink);font-size:15px;line-height:1.55}
    .di-llw-shell{max-width:720px;margin:0 auto;padding:24px 16px 48px}
    .di-llw h2.di-h,.di-llw .card-hd h2{font-size:23px;color:var(--navy);letter-spacing:-.015em;font-weight:600;margin:6px 0 4px}
    .di-llw .muted{color:var(--ink-soft)}
    .di-llw .mt-2{margin-top:.5rem}.di-llw .mb-2{margin-bottom:.5rem}.di-llw .mb-3{margin-bottom:1rem}

    .di-llw .ribbon{background:var(--navy);padding:14px 20px}
    .di-llw .steps{max-width:980px;margin:0 auto;display:flex;gap:2px}
    .di-llw .mstep{display:none;color:#cdd9e6;text-align:center;font-size:13px}
    .di-llw .step{flex:1;background:var(--navy-soft);color:#9DB3C8;padding:9px 10px 9px 28px;font-size:12.5px;
        clip-path:polygon(0 0,calc(100% - 13px) 0,100% 50%,calc(100% - 13px) 100%,0 100%,13px 50%);display:flex;align-items:center;gap:8px;min-width:0}
    .di-llw .step:first-child{clip-path:polygon(0 0,calc(100% - 13px) 0,100% 50%,calc(100% - 13px) 100%,0 100%);padding-left:16px}
    .di-llw .step:last-child{clip-path:polygon(0 0,100% 0,100% 100%,0 100%,13px 50%)}
    .di-llw .step.cur{background:#fff;color:var(--navy)}
    .di-llw .step.done{background:var(--navy-mid);color:#dbe6f2}
    .di-llw .step .n{font-family:monospace;font-size:11px;opacity:.85;flex:none}
    .di-llw .chev-label{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}

    .di-llw .card{background:#fff;border-radius:var(--r);border:1px solid var(--line);overflow:hidden}
    .di-llw .card-hd{padding:22px 28px 0}
    .di-llw .eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--taupe);font-weight:600}
    .di-llw .card-hd p{margin:0;color:var(--ink-soft);font-size:14px}
    .di-llw .card-bd{padding:22px 28px}
    .di-llw .card-ft{padding:16px 28px;background:var(--sand);border-top:1px solid var(--line);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .di-llw .card-ft .spacer{flex:1}

    .di-llw .field{margin-bottom:20px}
    .di-llw label.lbl{display:block;font-weight:600;font-size:13.5px;color:var(--navy);margin-bottom:6px}
    .di-llw .req{color:var(--danger)}
    .di-llw .hint{font-size:12.5px;color:var(--ink-soft);margin-top:6px}
    .di-llw .di-in,.di-llw input[type=text],.di-llw input[type=email],.di-llw input[type=tel],.di-llw select,.di-llw input:not([type]){
        width:100%;padding:10px 12px;font:inherit;font-size:14.5px;color:var(--ink);border:1px solid var(--line-strong);border-radius:var(--r);background:#fff}
    .di-llw .di-in:focus,.di-llw input:focus,.di-llw select:focus{outline:2px solid var(--taupe-lt);outline-offset:1px;border-color:var(--navy)}
    .di-llw .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}

    .di-llw .choices{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .di-llw .choice{border:1px solid var(--line-strong);border-radius:var(--r);padding:12px 14px;cursor:pointer;display:flex;gap:10px;align-items:flex-start;background:#fff}
    .di-llw .choice:hover{border-color:var(--taupe-lt);background:var(--sand)}
    .di-llw .choice input{margin:3px 0 0;accent-color:var(--navy);width:auto}
    .di-llw .choice b{display:block;font-size:14px;color:var(--navy);font-weight:600}
    .di-llw .choice span span,.di-llw .choice > span > span{font-size:12.5px;color:var(--ink-soft);font-weight:400}
    .di-llw .choice.sel{border-color:var(--navy);box-shadow:inset 0 0 0 1px var(--navy)}

    .di-llw .code{background:var(--navy);border-radius:var(--r);padding:12px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    .di-llw .code .k{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#9DB3C8;font-weight:600}
    .di-llw .code .v{font-family:monospace;font-size:21px;color:#fff;letter-spacing:.06em}

    .di-llw .up{border:1px dashed var(--line-strong);border-radius:var(--r);padding:12px 14px;display:flex;align-items:center;gap:12px;background:var(--sand);flex-wrap:wrap;margin-bottom:12px}
    .di-llw .up.filled{border-style:solid;border-color:var(--ok);background:var(--ok-bg)}
    .di-llw .up .name{font-size:13.5px;flex:1;min-width:120px;word-break:break-all}
    .di-llw .up .name.empty{color:var(--ink-soft)}
    .di-llw .link{background:none;border:0;padding:0;font:inherit;font-size:13px;color:var(--navy);text-decoration:underline;text-underline-offset:2px;cursor:pointer}
    .di-llw .link.danger{color:var(--danger)}

    .di-llw .btn{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:var(--r);border:1px solid transparent;font-size:14.5px;font-weight:600;cursor:pointer;background:var(--navy);color:#fff}
    .di-llw .btn:hover{background:var(--navy-mid)}
    .di-llw .btn.ghost{background:#fff;color:var(--navy);border-color:var(--line-strong)}
    .di-llw .btn.ghost:hover{background:var(--sand);border-color:var(--taupe-lt)}
    .di-llw .btn.taupe{background:var(--taupe);color:#fff}
    .di-llw .btn.taupe:hover{background:#8A7A6F}
    .di-llw .btn:disabled{opacity:.45;cursor:not-allowed}

    .di-llw .rev{border:1px solid var(--line);border-radius:var(--r);margin-bottom:16px}
    .di-llw .rev h3{margin:0;padding:11px 16px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--navy);background:var(--sand);border-bottom:1px solid var(--line);display:flex;align-items:center;font-weight:600}
    .di-llw .rev h3 .link{margin-left:auto;text-transform:none;letter-spacing:0}
    .di-llw .rev dl{margin:0;padding:6px 16px 12px}
    .di-llw .rev .r{display:flex;gap:14px;padding:7px 0;border-bottom:1px solid #F1EDE7;font-size:14px}
    .di-llw .rev .r:last-child{border:0}
    .di-llw .rev dt{flex:0 0 42%;color:var(--ink-soft);margin:0}
    .di-llw .rev dd{margin:0;flex:1;word-break:break-word}
    .di-llw .rev dd.mono{font-family:monospace}

    .di-llw .panel{border:1px solid var(--line-strong);border-radius:var(--r);padding:16px 18px;background:var(--sand)}
    .di-llw .panel.bad{border-color:var(--danger);background:var(--danger-bg)}
    .di-llw .panel h3{margin:0 0 6px;font-size:15px;color:var(--navy);font-weight:600}
    .di-llw .panel p{margin:0;font-size:13.5px;color:var(--ink-soft)}
    .di-llw .check{display:flex;gap:11px;align-items:flex-start;font-size:13.5px;line-height:1.6}
    .di-llw .check input{margin:3px 0 0;accent-color:var(--navy);width:17px;height:17px;flex:none}
    .di-llw .tick{width:44px;height:44px}
    .di-llw .done-wrap{text-align:center;padding:14px 0 6px}
    .di-llw .done-wrap .ref{font-family:monospace;font-size:24px;color:var(--navy);letter-spacing:.05em;margin:14px 0 4px}
    .di-llw .subhead{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--taupe);font-weight:600;margin:22px 0 10px}
    .di-llw .sig{border:1px solid var(--line);border-radius:var(--r);margin-bottom:10px;background:#fff}
    .di-llw .sig-hd{display:flex;align-items:center;gap:12px;padding:11px 14px}
    .di-llw .seq{font-family:monospace;font-size:13px;color:#fff;background:var(--navy);width:26px;height:26px;border-radius:3px;display:flex;align-items:center;justify-content:center;flex:none}
    .di-llw .tagx{font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:600;color:var(--taupe);border:1px solid var(--line-strong);border-radius:99px;padding:3px 9px;white-space:nowrap;flex:none}
    .di-llw .addrow{margin-top:12px}
    .di-llw .olist{margin:0;padding:0;list-style:none}
    .di-llw .olist li{display:flex;gap:10px;padding:6px 0;font-size:14px;align-items:baseline}
    .di-llw .olist .n{color:var(--taupe);flex:none}
    @@media (max-width:720px){
        .di-llw .steps{display:none}.di-llw .mstep{display:block}
        .di-llw .choices,.di-llw .grid2{grid-template-columns:1fr}
        .di-llw .card-hd,.di-llw .card-bd,.di-llw .card-ft{padding-left:18px;padding-right:18px}
        .di-llw .sig-id{grid-template-columns:1fr!important}
    }
</style>

@code {
    [Parameter] public string Token { get; set; } = "";
    [SupplyParameterFromQuery(Name = "s")] public string? SessionToken { get; set; }

    private static readonly string[] stepLabels = ["Primary Contact", "Secondary Contacts", "Documents", "Signatories", "Review"];

    private LandlordAccessToken? accessToken;
    private Landlord? landlord;
    private LandlordRegistrationComment? correction;

    private readonly ContactInput primary = new() { IsPrimary = true, ContactType = ContactType.Owner };
    private readonly List<ContactInput> secondaries = new();
    private readonly List<SignatoryInput> signatories = new();
    private SigningRule signingRule = SigningRule.All;
    private List<LandlordDocument> documents = [];

    private int step;
    private bool loading = true, saving, submitted, declared;
    private string? error, reference;

    private string ActorLabel => $"Landlord Self-Service ({landlord?.Email})";
    private string? eidExtractNote;

    private string StepHeading => step switch
    {
        0 => "Primary contact details", 1 => "Secondary contacts", 2 => "Supporting documents",
        3 => "Authorised signatories", _ => "Review & submit"
    };
    private string StepSubtitle => step switch
    {
        0 => "The person DIP will deal with on the tenancy. Property details are set by Business Centre and cannot be changed.",
        1 => "Add any additional contacts for this landlord (optional).",
        2 => "Upload the required documents. All documents are retained with your registration.",
        3 => "Who is authorised to sign on behalf of the landlord.",
        _ => "Check everything below, then submit for Business Centre review."
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(SessionToken))
            accessToken = await AccessTokenService.ValidateSessionAsync(Token, SessionToken);

        if (accessToken is not null)
        {
            landlord = await LandlordService.GetForSelfServiceAsync(accessToken.LandlordId);
            if (landlord is not null)
            {
                correction = await LandlordService.GetOpenCorrectionAsync(landlord.Id);
                SeedFromExisting();
                documents = await DocumentService.GetDocumentsAsync(landlord.Id);
            }
        }
        loading = false;
    }

    private void SeedFromExisting()
    {
        var ep = landlord!.Contacts.FirstOrDefault(c => c.IsPrimary);
        if (ep is not null) CopyInto(primary, ep);
        foreach (var c in landlord.Contacts.Where(c => !c.IsPrimary)) { var s = new ContactInput(); CopyInto(s, c); secondaries.Add(s); }
        signingRule = landlord.SigningRule;
        // The primary contact is rendered as the locked signatory #1, so only load the ADDITIONAL ones here.
        signatories.AddRange(landlord.Signatories.Where(s => !s.IsPrimaryContact).OrderBy(s => s.Order)
            .Select(s => new SignatoryInput { Name = s.Name, Email = s.Email, Mobile = s.Mobile }));
    }

    private static void CopyInto(ContactInput t, LandlordContact c)
    {
        t.Id = c.Id; t.IsPrimary = c.IsPrimary; t.ContactType = c.ContactType; t.FullName = c.FullName;
        t.Designation = c.Designation; t.Mobile = c.Mobile; t.Email = c.Email; t.EmiratesId = c.EmiratesId;
    }

    private RenderFragment ContactFields(ContactInput c, bool isPrimary) => __builder =>
    {
        <div class="grid2">
            <div class="field" style="margin-bottom:0"><label class="lbl">Full name @(isPrimary ? MarkReq() : null)</label><input type="text" placeholder="As on the Emirates ID" @bind="c.FullName" /></div>
            <div class="field" style="margin-bottom:0"><label class="lbl">Designation</label><input type="text" @bind="c.Designation" /></div>
            <div class="field" style="margin-bottom:0"><label class="lbl">Mobile number</label><input type="text" placeholder="+971 5X XXX XXXX" @bind="c.Mobile" /></div>
            <div class="field" style="margin-bottom:0"><label class="lbl">Email address @(isPrimary ? MarkReq() : null)</label><input type="text" placeholder="name@company.ae" @bind="c.Email" /></div>
            <div class="field" style="margin-bottom:0"><label class="lbl">Contact type</label>
                <select @bind="c.ContactType">@foreach (var t in Enum.GetValues<ContactType>()) { <option value="@t">@t</option> }</select>
            </div>
            <div class="field" style="margin-bottom:0"><label class="lbl">Emirates ID</label><input type="text" @bind="c.EmiratesId" /></div>
        </div>
    };

    private RenderFragment MarkReq() => __builder => { <span class="req">*</span> };

    private RenderFragment UploadField(LandlordDocumentType type, string label, bool required) => __builder =>
    {
        var doc = documents.FirstOrDefault(d => d.DocumentType == type);
        <div class="field">
            <label class="lbl">@label @(required ? MarkReq() : null)</label>
            <div class="up @(doc is not null ? "filled" : "")">
                <span class="name @(doc is null ? "empty" : "")">@(doc?.FileName ?? "No file chosen — PDF, JPG or PNG up to 10 MB")</span>
                @if (doc is not null)
                {
                    <button class="link danger" @onclick="() => DeleteDocAsync(doc.Id)">Replace / remove</button>
                }
                else
                {
                    <label class="btn ghost" style="padding:7px 13px;font-size:13px;margin:0">
                        Choose file
                        <InputFile OnChange="@(e => UploadAsync(e, type))" style="display:none" accept=".pdf,image/*" />
                    </label>
                }
            </div>
        </div>
    };

    private static string FormatCode(string code) => code;

    private void AddSecondary() => secondaries.Add(new ContactInput { ContactType = ContactType.AuthorisedRepresentative });
    private void RemoveSecondary(int i) { if (i >= 0 && i < secondaries.Count) secondaries.RemoveAt(i); }
    private void AddSignatory() => signatories.Add(new SignatoryInput());
    private void RemoveSignatory(int i) { if (i >= 0 && i < signatories.Count) signatories.RemoveAt(i); }

    private void Back() { error = null; if (step > 0) step--; }

    private void Next()
    {
        error = null;
        if (step == 0)
        {
            if (string.IsNullOrWhiteSpace(primary.FullName) || string.IsNullOrWhiteSpace(primary.Email))
            { error = "Primary contact name and email are required."; return; }
        }
        if (step == 1 && secondaries.Any(c => !string.IsNullOrWhiteSpace(c.FullName) && string.IsNullOrWhiteSpace(c.Email)))
        { error = "Each secondary contact needs an email."; return; }
        if (step < stepLabels.Length - 1) step++;
    }

    private LandlordSelfUpdate BuildUpdate()
    {
        var contacts = new List<ContactInput> { primary };
        contacts.AddRange(secondaries.Where(c => !string.IsNullOrWhiteSpace(c.FullName)));

        // Primary contact is always the first authorised signatory and is not user-editable/removable.
        var sigs = new List<SignatoryInput>
        {
            new() { Name = primary.FullName, Email = primary.Email, Mobile = primary.Mobile, IsPrimaryContact = true }
        };
        sigs.AddRange(signatories.Where(s => !string.IsNullOrWhiteSpace(s.Name)));
        return new LandlordSelfUpdate { SigningRule = signingRule, Contacts = contacts, Signatories = sigs };
    }

    private async Task UploadAsync(InputFileChangeEventArgs e, LandlordDocumentType type)
    {
        if (landlord is null) return;
        error = null;
        // Show the global progress bar while the file uploads (and, for an Emirates ID, is OCR-scanned).
        var (ok, err) = await Loading.RunAsync(async () =>
        {
            var res = await DocumentService.UploadAsync(landlord.Id, type, e.File, ActorLabel);
            if (res.Success && type == LandlordDocumentType.EmiratesId)
                await TryExtractEmiratesIdAsync(e.File);
            return res;
        });
        if (!ok) error = err;
        documents = await DocumentService.GetDocumentsAsync(landlord.Id);
    }

    /// <summary>Best-effort OCR of an uploaded Emirates ID: extracts the ID number, expiry and name and
    /// prefills the primary contact. Never blocks the upload — a disabled/failed OCR is silently ignored.</summary>
    private async Task TryExtractEmiratesIdAsync(IBrowserFile file)
    {
        eidExtractNote = null;
        if (!Ocr.IsEnabled) return;
        string? temp = null;
        try
        {
            temp = Path.Combine(Path.GetTempPath(), $"eid-{Guid.NewGuid():N}{Path.GetExtension(file.Name)}");
            await using (var fs = new FileStream(temp, FileMode.Create))
            await using (var src = file.OpenReadStream(10 * 1024 * 1024))
                await src.CopyToAsync(fs);

            var text = await Ocr.ExtractTextAsync(temp);
            var r = EmiratesIdExtractor.Parse(text);
            if (r.Number is not null) primary.EmiratesId = r.Number;
            if (r.Name is not null && string.IsNullOrWhiteSpace(primary.FullName)) primary.FullName = r.Name;
            if (r.Number is not null || r.Name is not null || r.Expiry is not null)
                eidExtractNote = $"Read from the card — ID: {r.Number ?? "—"}, Name: {r.Name ?? "—"}, Expiry: {r.Expiry ?? "—"}";
        }
        catch { /* OCR is best-effort enrichment */ }
        finally { if (temp is not null && File.Exists(temp)) { try { File.Delete(temp); } catch { } } }
    }

    private async Task DeleteDocAsync(int docId)
    {
        await DocumentService.DeleteAsync(docId);
        documents = await DocumentService.GetDocumentsAsync(landlord!.Id);
    }

    private async Task SaveDraftAsync()
    {
        if (landlord is null || accessToken is null) return;
        saving = true; error = null;
        var (ok, err, _) = await LandlordService.SaveAsync(landlord.Id, BuildUpdate(), submit: false, ActorLabel, accessToken.Id, null);
        saving = false;
        if (!ok) { error = err; return; }
        ToastService.ShowSuccess("Draft saved. You can return via your secure link to continue.");
    }

    private string? ValidateForSubmit()
    {
        if (string.IsNullOrWhiteSpace(primary.FullName) || string.IsNullOrWhiteSpace(primary.Email))
            return "Primary contact name and email are required.";
        if (landlord!.Type == LandlordType.Individual)
        {
            if (!documents.Any(d => d.DocumentType == LandlordDocumentType.EmiratesId))
                return "Emirates ID document is mandatory for an individual landlord.";
        }
        else if (!documents.Any(d => d.DocumentType is LandlordDocumentType.MoaOrPoa
                     or LandlordDocumentType.PowerOfAttorney or LandlordDocumentType.Moa))
            return "The MOA / POA document is required for a company.";
        return null;
    }

    private async Task SubmitAsync()
    {
        if (landlord is null || accessToken is null) return;
        error = ValidateForSubmit();
        if (error is not null) { step = error.Contains("contact") ? 0 : 2; return; }

        saving = true;
        var (ok, err, reason) = await LandlordService.SaveAsync(landlord.Id, BuildUpdate(), submit: true, ActorLabel, accessToken.Id, null);
        if (!ok) { error = err; saving = false; return; }
        await AccessTokenService.MarkUsedAsync(accessToken.Id);
        reference = reason;
        submitted = true;
        ToastService.ShowSuccess("Registration submitted for review.");
    }

    private static string DocLabel(LandlordDocumentType t) => t switch
    {
        LandlordDocumentType.EmiratesId => "Emirates ID",
        LandlordDocumentType.TradeLicense => "Trade Licence",
        LandlordDocumentType.Moa => "Memorandum of Association (MOA)",
        LandlordDocumentType.PowerOfAttorney => "Power of Attorney (POA)",
        LandlordDocumentType.MoaOrPoa => "MOA / POA",
        LandlordDocumentType.AuthorisationLetter => "Authorisation Letter",
        LandlordDocumentType.TitleDeed => "Title Deed",
        _ => "Other"
    };
}
