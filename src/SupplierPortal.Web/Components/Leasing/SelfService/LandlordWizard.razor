@page "/landlord/{Token}/update"
@page "/landlord/continue/{TokenId:int}"
@layout Layout.PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using SupplierPortal.Web.Models.Leasing
@using SupplierPortal.Web.Services
@using SupplierPortal.Web.Services.Leasing
@inject LandlordAccessTokenService AccessTokenService
@inject LandlordService LandlordService
@inject LandlordDocumentService DocumentService
@inject ToastService ToastService
@inject LoadingService Loading
@inject IDocumentOcrService Ocr
@inject IWebHostEnvironment Env
@inject IUaePassService UaePass
@inject NavigationManager Nav
@inject ILogger<LandlordWizard> Logger

<PageTitle>Landlord Registration</PageTitle>

<div class="di-llw">
    @if (loading)
    {
        <div class="di-llw-shell"><div class="card"><div class="card-bd"><p><em>Loading…</em></p></div></div></div>
    }
    else if (landlord is null)
    {
        <div class="di-llw-shell"><div class="card"><div class="card-bd">
            <h2 class="di-h">Session expired</h2>
            <p class="muted">Your verification session is no longer valid. Please use the link from your email again to restart.</p>
        </div></div></div>
    }
    else if (submitted)
    {
        <div class="di-llw-shell">
            <div class="done-card">
                <div class="done-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7" /></svg>
                </div>
                <h2 class="done-title">Registration submitted</h2>
                <p class="done-sub">Thank you — your landlord registration has been sent to Dubai Investments Business Centre for review.</p>

                <div class="done-ref">
                    <span class="done-ref-label">Reference number</span>
                    <span class="done-ref-value">@reference</span>
                </div>

                <div class="done-steps">
                    <div class="done-step">
                        <span class="done-step-ico">1</span>
                        <div class="done-step-txt"><b>Review</b><span>Business Centre verifies your details and documents.</span></div>
                    </div>
                    <div class="done-step">
                        <span class="done-step-ico">2</span>
                        <div class="done-step-txt"><b>Notification</b><span>You'll be emailed if a correction is needed, or once it's approved.</span></div>
                    </div>
                    <div class="done-step">
                        <span class="done-step-ico">3</span>
                        <div class="done-step-txt"><b>Signature</b><span>On approval, all authorised signatories receive the document to sign.</span></div>
                    </div>
                </div>

                <p class="done-foot">You can safely close this window. Please keep your reference number for any follow-up.</p>
            </div>
        </div>
    }
    else
    {
        @* -------- chevron step ribbon -------- *@
        <div class="ribbon">
            <div class="steps">
                @foreach (var (label, i) in stepLabels.Select((l, i) => (l, i)))
                {
                    <div class="step @(i == step ? "cur" : i < step ? "done" : "")">
                        <span class="n">@(i + 1)</span><span class="chev-label">@label</span>
                    </div>
                }
            </div>
            <div class="mstep">Step @(step + 1) of @stepLabels.Length · @stepLabels[step]</div>
        </div>

        <div class="di-llw-shell">
            <div class="card">
                <div class="card-hd">
                    <div class="eyebrow">Step @(step + 1) of @stepLabels.Length</div>
                    <h2>@StepHeading</h2>
                    <p>@StepSubtitle</p>
                </div>
                <div class="card-bd">
                    <div class="panel alert-restricted mb-3">
                        <strong>Alert!</strong> Access to this service is restricted to authorised users whose contact
                        details are registered and linked to their UAE&nbsp;Pass account.
                    </div>
                    @if (correction is not null)
                    {
                        <div class="panel bad mb-3">
                            <h3>Correction requested by Business Centre</h3>
                            <p>@correction.Comment</p>
                        </div>
                    }
                    @if (error is not null)
                    {
                        <div class="panel bad mb-3"><p style="color:var(--danger);margin:0">@error</p></div>
                    }

                    @* ===== Step 0: Primary Contact ===== *@
                    @if (step == 0)
                    {
                        <div class="field">
                            <label class="lbl">Agreement type <span class="req">*</span></label>
                            <div class="choices">
                                <label class="choice @(landlord.Type == LandlordType.Company ? "sel" : "")">
                                    <input type="radio" checked="@(landlord.Type == LandlordType.Company)" disabled />
                                    <span><b>Company</b><span>Registered company holding the plot</span></span>
                                </label>
                                <label class="choice @(landlord.Type == LandlordType.Individual ? "sel" : "")">
                                    <input type="radio" checked="@(landlord.Type == LandlordType.Individual)" disabled />
                                    <span><b>Individual</b><span>Person holding the plot in their own name</span></span>
                                </label>
                            </div>
                            <div class="hint">Set by Business Centre for this property — read-only.</div>
                        </div>

                        <div class="field">
                            <label class="lbl">Property details</label>
                            <div class="prop-details">
                                <div class="r"><span class="k">Property code</span><span class="v mono">@FormatCode(landlord.PropertyCode)</span></div>
                                <div class="r"><span class="k">Company</span><span class="v">@(string.IsNullOrWhiteSpace(landlord.CompanyName) ? "—" : landlord.CompanyName)</span></div>
                                <div class="r"><span class="k">Building</span><span class="v">@(string.IsNullOrWhiteSpace(landlord.Building) ? "—" : landlord.Building)</span></div>
                                <div class="r"><span class="k">Agreement type</span><span class="v">@landlord.Type</span></div>
                                @if (!string.IsNullOrWhiteSpace(landlord.LandLordCode))
                                {
                                    <div class="r"><span class="k">Landlord code</span><span class="v mono">@landlord.LandLordCode</span></div>
                                }
                            </div>
                            <div class="hint">Set by Business Centre · issued by Dubai Municipality (read-only).</div>
                        </div>

                        @ContactFields(primary, isPrimary: true)
                    }

                    @* ===== Step 1: Secondary Contacts ===== *@
                    else if (step == 1)
                    {
                        @if (secondaries.Count == 0)
                        {
                            <p class="muted">No secondary contacts added. These are optional.</p>
                        }
                        @for (var i = 0; i < secondaries.Count; i++)
                        {
                            var idx = i;
                            <div class="rev">
                                <h3>Secondary contact @(idx + 1)<button class="link danger" @onclick="() => RemoveSecondary(idx)">Remove</button></h3>
                                <div style="padding:14px 16px">@ContactFields(secondaries[idx], isPrimary: false)</div>
                            </div>
                        }
                        <div class="addrow"><button class="btn ghost" @onclick="AddSecondary">+ Add secondary contact</button></div>
                    }

                    @* ===== Step 2: Documents ===== *@
                    else if (step == 2)
                    {
                        @if (landlord.Type == LandlordType.Individual)
                        {
                            <p class="muted mb-3">Upload your Emirates ID (required). Its number, name and expiry are read from the card and can be corrected below. A title deed is optional.</p>
                            @UploadField(LandlordDocumentType.EmiratesId, "Emirates ID", required: true)
                            @if (documents.Any(d => d.DocumentType == LandlordDocumentType.EmiratesId))
                            {
                                @EmiratesIdDetails()
                            }
                            @UploadField(LandlordDocumentType.TitleDeed, "Title Deed", required: false)
                        }
                        else
                        {
                            <p class="muted mb-3">Upload the company's MOA or POA (one document, required). Trade licence and title deed are optional.</p>
                            @UploadField(LandlordDocumentType.MoaOrPoa, "MOA / POA", required: true)
                            @UploadField(LandlordDocumentType.TradeLicense, "Trade Licence", required: false)
                            @UploadField(LandlordDocumentType.TitleDeed, "Title Deed", required: false)
                        }
                    }

                    @* ===== Step 3: Signatories ===== *@
                    else if (step == 3)
                    {
                        <div class="field">
                            <label class="lbl">Signing rule</label>
                            <div class="choices">
                                <label class="choice @(signingRule == SigningRule.All ? "sel" : "")">
                                    <input type="radio" name="sr" checked="@(signingRule == SigningRule.All)" @onchange="@(() => signingRule = SigningRule.All)" />
                                    <span><b>All Authorized Signatories</b><span>Every authorised signatory must sign</span></span>
                                </label>
                                <label class="choice @(signingRule == SigningRule.Any ? "sel" : "")">
                                    <input type="radio" name="sr" checked="@(signingRule == SigningRule.Any)" @onchange="@(() => signingRule = SigningRule.Any)" />
                                    <span><b>Any One Authorized Signatory</b><span>A single authorised signatory suffices</span></span>
                                </label>
                            </div>
                        </div>
                        <div class="hint mb-2">Your primary and secondary contacts are automatically included as authorised signatories and cannot be removed — they do not require an MOA/POA. Every <strong>additional signatory you add must have an authorising MOA or POA uploaded</strong> in their card before you can continue.</div>

                        var lockedSecondaries = secondaries.Where(c => !string.IsNullOrWhiteSpace(c.FullName)).ToList();

                        @* Locked primary signatory (mirrors the primary contact) *@
                        <div class="sig locked">
                            <div class="sig-hd">
                                <span class="seq">1</span>
                                <span class="sig-avatar">@PersonIcon</span>
                                <div class="sig-id">
                                    <b>@(string.IsNullOrWhiteSpace(primary.FullName) ? "Primary contact" : primary.FullName)</b>
                                </div>
                                <span class="sig-meta">@MailIcon @primary.Email</span>
                                <span class="tagx tagx-primary">Primary</span>
                                <span class="sig-included">@CheckIcon Included</span>
                            </div>
                        </div>

                        @* Locked secondary-contact signatories (mirror the secondary contacts) *@
                        @for (var i = 0; i < lockedSecondaries.Count; i++)
                        {
                            var c = lockedSecondaries[i];
                            <div class="sig locked">
                                <div class="sig-hd">
                                    <span class="seq">@(i + 2)</span>
                                    <span class="sig-avatar">@PersonIcon</span>
                                    <div class="sig-id">
                                        <b>@c.FullName</b>
                                    </div>
                                    <span class="sig-meta">@MailIcon @c.Email</span>
                                    <span class="tagx">Secondary</span>
                                    <span class="sig-included">@CheckIcon Included</span>
                                </div>
                            </div>
                        }

                        @* Additional, user-defined signatories *@
                        @for (var i = 0; i < signatories.Count; i++)
                        {
                            var idx = i;
                            <div class="sig open">
                                <div class="sig-hd">
                                    <span class="seq">@(idx + 2 + lockedSecondaries.Count)</span>
                                    <div class="sig-inputs">
                                        <span class="sig-input"><span class="sig-input-ico">@PersonIcon</span><input class="di-in" placeholder="Name" @bind="signatories[idx].Name" /></span>
                                        <span class="sig-input"><span class="sig-input-ico">@MailIcon</span><input class="di-in" placeholder="Email" @bind="signatories[idx].Email" /></span>
                                        <span class="sig-input"><span class="sig-input-ico">@PhoneIcon</span><input class="di-in" placeholder="Mobile" @bind="signatories[idx].Mobile" /></span>
                                    </div>
                                    <button class="link danger sig-remove" @onclick="() => RemoveSignatory(idx)">@TrashIcon Remove</button>
                                </div>
                                @SignatoryDocPanel(signatories[idx].Email, required: true)
                            </div>
                        }
                        <div class="addrow"><button class="btn ghost btn-add-sig" @onclick="AddSignatory">@PersonPlusIcon Add signatory</button></div>
                    }

                    @* ===== Step 4: Review ===== *@
                    else if (step == 4)
                    {
                        var namedSecondaries = secondaries.Where(c => !string.IsNullOrWhiteSpace(c.FullName)).ToList();
                        var namedSignatories = signatories.Where(s => !string.IsNullOrWhiteSpace(s.Name)).ToList();

                        <div class="rev">
                            <h3>Property</h3>
                            <dl>
                                <div class="r"><dt>Property code</dt><dd class="mono">@FormatCode(landlord.PropertyCode)</dd></div>
                                <div class="r"><dt>Company</dt><dd>@(landlord.CompanyName ?? "—")</dd></div>
                                <div class="r"><dt>Agreement type</dt><dd>@landlord.Type</dd></div>
                            </dl>
                        </div>

                        <div class="rev">
                            <h3>Primary contact<button class="link" @onclick="() => step = 0">Edit</button></h3>
                            <dl>
                                <div class="r"><dt>Name</dt><dd>@primary.FullName</dd></div>
                                <div class="r"><dt>Designation</dt><dd>@(string.IsNullOrWhiteSpace(primary.Designation) ? "—" : primary.Designation)</dd></div>
                                <div class="r"><dt>Contact type</dt><dd>@primary.ContactType</dd></div>
                                <div class="r"><dt>Email</dt><dd>@primary.Email</dd></div>
                                <div class="r"><dt>Mobile</dt><dd>@(primary.Mobile ?? "—")</dd></div>
                                @if (landlord.Type == LandlordType.Individual)
                                {
                                    <div class="r"><dt>Emirates ID</dt><dd>@(string.IsNullOrWhiteSpace(primary.EmiratesId) ? "—" : primary.EmiratesId)</dd></div>
                                    <div class="r"><dt>Emirates ID expiry</dt><dd>@(primary.EmiratesIdExpiry is { } ex ? ex.ToString("dd MMM yyyy") : "—")</dd></div>
                                }
                            </dl>
                        </div>

                        <div class="rev">
                            <h3>Secondary contacts<button class="link" @onclick="() => step = 1">Edit</button></h3>
                            @if (namedSecondaries.Count == 0)
                            {
                                <dl><div class="r"><dd class="muted">None added.</dd></div></dl>
                            }
                            else
                            {
                                @foreach (var (c, i) in namedSecondaries.Select((c, i) => (c, i)))
                                {
                                    <dl>
                                        <div class="r"><dt>#@(i + 1) Name</dt><dd>@c.FullName</dd></div>
                                        <div class="r"><dt>Contact type</dt><dd>@c.ContactType</dd></div>
                                        <div class="r"><dt>Email</dt><dd>@c.Email</dd></div>
                                        <div class="r"><dt>Mobile</dt><dd>@(c.Mobile ?? "—")</dd></div>
                                    </dl>
                                }
                            }
                        </div>

                        <div class="rev">
                            <h3>Documents<button class="link" @onclick="() => step = 2">Edit</button></h3>
                            @if (documents.Count == 0)
                            {
                                <dl><div class="r"><dd class="muted">No documents uploaded.</dd></div></dl>
                            }
                            else
                            {
                                <dl>
                                    @foreach (var d in documents)
                                    {
                                        <div class="r"><dt>@DocLabel(d.DocumentType)</dt><dd>@d.FileName</dd></div>
                                    }
                                </dl>
                            }
                        </div>

                        <div class="rev">
                            <h3>Authorised signatories<button class="link" @onclick="() => step = 3">Edit</button></h3>
                            <dl>
                                <div class="r"><dt>Signing rule</dt><dd>@(signingRule == SigningRule.All ? "All Authorized Signatories" : "Any One Authorized Signatory")</dd></div>
                                <div class="r"><dt>#1 (Primary)</dt><dd>@primary.FullName — @primary.Email</dd></div>
                                @foreach (var (c, i) in namedSecondaries.Select((c, i) => (c, i)))
                                {
                                    <div class="r"><dt>#@(i + 2) (Secondary)</dt><dd>@c.FullName — @c.Email</dd></div>
                                }
                                @foreach (var (s, i) in namedSignatories.Select((s, i) => (s, i)))
                                {
                                    <div class="r"><dt>#@(i + 2 + namedSecondaries.Count)</dt><dd>@s.Name — @s.Email@(string.IsNullOrWhiteSpace(s.Mobile) ? "" : $" · {s.Mobile}")</dd></div>
                                }
                            </dl>
                        </div>

                        <div class="panel">
                            <label class="check"><input type="checkbox" @bind="declared" /> <span>I confirm that all the information provided above — contacts, documents and signatories — is accurate and complete.</span></label>
                        </div>
                    }
                </div>

                <div class="card-ft">
                    <button class="btn ghost" disabled="@(step == 0)" @onclick="Back">Back</button>
                    <button class="btn taupe" disabled="@saving" @onclick="SaveDraftAsync">@(saving ? "Saving…" : "Save draft")</button>
                    <div class="spacer"></div>
                    @if (step < stepLabels.Length - 1)
                    {
                        <button class="btn" @onclick="Next">Continue <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6 6 6-6 6"/></svg></button>
                    }
                    else
                    {
                        <button class="btn" disabled="@(!declared || saving)" @onclick="SubmitAsync">@(saving ? "Submitting…" : "Submit registration")</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .di-llw{--navy:#092F56;--navy-deep:#06213D;--navy-mid:#164A7B;--navy-soft:#0E3A66;--taupe:#706259;--taupe-lt:#B4A79C;--sand:#F6F3EF;--line:#E2DCD4;--line-strong:#CFC5BA;--ink:#20262D;--ink-soft:#5C6670;--danger:#A32B24;--danger-bg:#FBF0EF;--ok:#1D6F53;--ok-bg:#EFF6F2;--r:4px;
        background:var(--navy-deep);min-height:100vh;color:var(--ink);font-size:15px;line-height:1.55}
    .di-llw-shell{max-width:720px;margin:0 auto;padding:24px 16px 48px}
    .di-llw h2.di-h,.di-llw .card-hd h2{font-size:23px;color:var(--navy);letter-spacing:-.015em;font-weight:600;margin:6px 0 4px}
    .di-llw .muted{color:var(--ink-soft)}
    .di-llw .mt-2{margin-top:.5rem}.di-llw .mb-2{margin-bottom:.5rem}.di-llw .mb-3{margin-bottom:1rem}

    .di-llw .ribbon{background:var(--navy);padding:14px 20px}
    .di-llw .steps{max-width:980px;margin:0 auto;display:flex;gap:2px}
    .di-llw .mstep{display:none;color:#cdd9e6;text-align:center;font-size:13px}
    .di-llw .step{flex:1;background:var(--navy-soft);color:#9DB3C8;padding:9px 10px 9px 28px;font-size:12.5px;
        clip-path:polygon(0 0,calc(100% - 13px) 0,100% 50%,calc(100% - 13px) 100%,0 100%,13px 50%);display:flex;align-items:center;gap:8px;min-width:0}
    .di-llw .step:first-child{clip-path:polygon(0 0,calc(100% - 13px) 0,100% 50%,calc(100% - 13px) 100%,0 100%);padding-left:16px}
    .di-llw .step:last-child{clip-path:polygon(0 0,100% 0,100% 100%,0 100%,13px 50%)}
    .di-llw .step.cur{background:#fff;color:var(--navy)}
    .di-llw .step.done{background:var(--navy-mid);color:#dbe6f2}
    .di-llw .step .n{font-family:monospace;font-size:11px;opacity:.85;flex:none}
    .di-llw .chev-label{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}

    .di-llw .card{background:#fff;border-radius:var(--r);border:1px solid var(--line);overflow:hidden}
    .di-llw .card-hd{padding:22px 28px 0}
    .di-llw .eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--taupe);font-weight:600}
    .di-llw .card-hd p{margin:0;color:var(--ink-soft);font-size:14px}
    .di-llw .card-bd{padding:22px 28px}
    .di-llw .card-ft{padding:16px 28px;background:var(--sand);border-top:1px solid var(--line);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .di-llw .card-ft .spacer{flex:1}

    .di-llw .field{margin-bottom:20px}
    .di-llw label.lbl{display:block;font-weight:600;font-size:13.5px;color:var(--navy);margin-bottom:6px}
    .di-llw .req{color:var(--danger)}
    .di-llw .hint{font-size:12.5px;color:var(--ink-soft);margin-top:6px}
    .di-llw .di-in,.di-llw input[type=text],.di-llw input[type=email],.di-llw input[type=tel],.di-llw select,.di-llw input:not([type]){
        width:100%;padding:10px 12px;font:inherit;font-size:14.5px;color:var(--ink);border:1px solid var(--line-strong);border-radius:var(--r);background:#fff}
    .di-llw .di-in:focus,.di-llw input:focus,.di-llw select:focus{outline:2px solid var(--taupe-lt);outline-offset:1px;border-color:var(--navy)}
    .di-llw .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .di-llw input[readonly]{background:#F2F4F7;color:#5C6670;cursor:not-allowed}
    .di-llw .uaep-note{background:var(--ok-bg);border:1px solid #BFE3D4;color:var(--ok);border-radius:var(--r);padding:9px 12px;font-size:12.5px;margin-bottom:14px;font-weight:500}

    .di-llw .choices{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .di-llw .choice{border:1px solid var(--line-strong);border-radius:var(--r);padding:12px 14px;cursor:pointer;display:flex;gap:10px;align-items:flex-start;background:#fff}
    .di-llw .choice:hover{border-color:var(--taupe-lt);background:var(--sand)}
    .di-llw .choice input{margin:3px 0 0;accent-color:var(--navy);width:auto}
    .di-llw .choice b{display:block;font-size:14px;color:var(--navy);font-weight:600}
    .di-llw .choice span span,.di-llw .choice > span > span{font-size:12.5px;color:var(--ink-soft);font-weight:400}
    .di-llw .choice.sel{border-color:var(--navy);box-shadow:inset 0 0 0 1px var(--navy)}

    .di-llw .code{background:var(--navy);border-radius:var(--r);padding:12px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    .di-llw .code .k{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#9DB3C8;font-weight:600}
    .di-llw .code .v{font-family:monospace;font-size:21px;color:#fff;letter-spacing:.06em}

    .di-llw .up{border:1px dashed var(--line-strong);border-radius:var(--r);padding:12px 14px;display:flex;align-items:center;gap:12px;background:var(--sand);flex-wrap:wrap;margin-bottom:12px}
    .di-llw .up.filled{border-style:solid;border-color:var(--ok);background:var(--ok-bg)}
    .di-llw .up .name{font-size:13.5px;flex:1;min-width:120px;word-break:break-all}
    .di-llw .up .name.empty{color:var(--ink-soft)}
    .di-llw .up.uploading{border-style:solid;border-color:var(--gold,#c8a24a);background:#fbf6ea}
    .di-llw .di-up-spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(168,132,47,.35);border-top-color:#a8842f;border-radius:50%;animation:di-up-spin .7s linear infinite;vertical-align:-2px;margin-right:6px}
    @@keyframes di-up-spin{to{transform:rotate(360deg)}}
    .di-llw .di-up-bar{height:4px;border-radius:3px;background:#eee3c7;overflow:hidden;margin-top:6px}
    .di-llw .di-up-bar-fill{height:100%;width:40%;border-radius:3px;background:#a8842f;animation:di-up-slide 1.1s ease-in-out infinite}
    @@keyframes di-up-slide{0%{margin-left:-40%}100%{margin-left:100%}}
    .di-llw .link{background:none;border:0;padding:0;font:inherit;font-size:13px;color:var(--navy);text-decoration:underline;text-underline-offset:2px;cursor:pointer}
    .di-llw .link.danger{color:var(--danger)}

    .di-llw .btn{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:var(--r);border:1px solid transparent;font-size:14.5px;font-weight:600;cursor:pointer;background:var(--navy);color:#fff}
    .di-llw .btn:hover{background:var(--navy-mid)}
    .di-llw .btn.ghost{background:#fff;color:var(--navy);border-color:var(--line-strong)}
