    private async Task<List<SupplierDocument>> LoadDocumentsAsync()
        => ViaGateway
            ? await SsGateway!.ListDocumentsAsync(SsTokenValue, SsSessionValue)
            : await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);

