@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject SupplierService SupplierService
@inject BusinessUnitService BusinessUnitService
@inject SupplierFieldSettingService SupplierFieldSettingService
@inject SupplierDocumentService SupplierDocumentService
@inject ToastService ToastService
@inject LoadingService Loading
@inject IJSRuntime JS

<div class="di-form-page">

    <div class="di-form-topbar">
        <div class="di-form-headings">
            <div class="di-form-title">Supplier Registration</div>
            <div class="di-form-sub">Dubai Investments Entities &mdash; @(IsCreateMode ? "New supplier onboarding" : "Edit supplier")</div>
        </div>
        <div class="di-progress" title="@ProgressPct% complete">
            <svg class="di-progress-ring" viewBox="0 0 36 36">
                <circle class="di-progress-bg" cx="18" cy="18" r="15.9155"></circle>
                <circle class="di-progress-bar" cx="18" cy="18" r="15.9155" style="stroke-dasharray:@ProgressPct.ToString(System.Globalization.CultureInfo.InvariantCulture) 100"></circle>
            </svg>
            <div class="di-progress-center">
                <span class="di-progress-pct">@ProgressPct%</span>
                <span class="di-progress-word">Complete</span>
            </div>
        </div>
    </div>
    @if (SupplierFacing)
    {
        <div class="di-legend">
            <div><span class="di-req">*</span> Required field (set by Settings &gt; Supplier Fields)</div>
        </div>
    }

    <div class="di-stepper">
        @for (var i = 1; i <= 5; i++)
        {
            var step = i;
            <button type="button" class="di-stepper-item @(currentStep == step ? "active" : "") @(step <= maxStepReached ? "reached" : "")"
                    disabled="@(step > maxStepReached)" @onclick="() => GoToStep(step)">
                <span class="di-stepper-num">@step</span>
                <span class="di-stepper-label">@StepLabels[step]</span>
            </button>
            if (i < 5)
            {
                <svg class="di-stepper-chevron" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708Z" />
                </svg>
            }
        }
    </div>

    <EditForm Model="formModel" FormName="supplier-form">

        <!-- Step 1: Business / Organization Information -->
        <div class="di-section" style="display:@(currentStep == 1 ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M6.5 5.5a.5.5 0 1 0-1 0 .5.5 0 0 0 1 0Zm-1 2a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0Zm2.5-.5a.5.5 0 1 0 0 1 .5.5 0 0 0 0-1Zm2 .5a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0ZM8 5a.5.5 0 1 0 0 1 .5.5 0 0 0 0-1Zm2 .5a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0Z" /><path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H2V1Zm2 2v1h1V3H4Zm1 2H4v1h1V5Zm1 0v1h1V5H6Zm1-1V3H6v1h1Zm1 0h1V3H8v1Zm1 1H8v1h1V5Zm1-2v1h1V3h-1Zm1 2h-1v1h1V5ZM4 8v1h1V8H4Zm1 2H4v1h1v-1Zm1 0v1h1v-1H6Zm1-1V8H6v1h1Zm1 0h1V8H8v1Zm1 1H8v1h1v-1Zm1-2v1h1V8h-1Zm1 2h-1v1h1v-1ZM4 14h3v-3H4v3Zm5 0h3v-3H9v3Z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">Business / Organization Information</span>
                    <span class="di-section-desc">Provide accurate business details as per your trade license and official documents.</span>
                </span>
            </div>
            <div class="di-section-body">
                <div class="di-field">
                    <label>Supplier Number</label>
                    <input type="text" value="@(string.IsNullOrWhiteSpace(formModel.SupplierNumber) ? "System generated" : formModel.SupplierNumber)" disabled />
                </div>
                <div class="di-field @FieldClass("SupplierName")">
                    <label>Supplier Name@(Req("SupplierName"))</label>
                    <InputText @bind-Value="formModel.SupplierName" />
                </div>
                <div class="di-field @FieldClass("TaxOrganizationTypeId")">
                    <label>Tax Organization Type@(Req("TaxOrganizationTypeId"))</label>
                    <InputSelect @bind-Value="formModel.TaxOrganizationTypeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in taxOrgTypes)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("SupplierTypeId")">
                    <label>Supplier Type@(Req("SupplierTypeId"))</label>
                    <InputSelect @bind-Value="formModel.SupplierTypeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in supplierTypes)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("BusinessRelationshipId")">
                    <label>Business Relationship@(Req("BusinessRelationshipId"))</label>
                    <InputSelect @bind-Value="formModel.BusinessRelationshipId">
                        <option value="">— Select —</option>
                        @foreach (var lov in businessRelationships)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("TaxpayerCountryId")">
                    <label>Taxpayer Country@(Req("TaxpayerCountryId"))</label>
                    <InputSelect @bind-Value="formModel.TaxpayerCountryId">
                        <option value="">— Select —</option>
                        @foreach (var lov in countries)
                        {
                            <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("TradeLicenseNumber")">
                    <label>Trade License Number@(Req("TradeLicenseNumber"))</label>
                    <InputText @bind-Value="formModel.TradeLicenseNumber" />
                </div>
                <div class="di-field @FieldClass("TradeLicenseIssueDate")">
                    <label>Trade License Issue Date@(Req("TradeLicenseIssueDate"))</label>
                    <InputDate @bind-Value="formModel.TradeLicenseIssueDate" />
                </div>
                <div class="di-field @FieldClass("TradeLicenseExpiryDate")">
                    <label>Trade License Expiry Date@(Req("TradeLicenseExpiryDate"))</label>
                    <InputDate @bind-Value="formModel.TradeLicenseExpiryDate" />
                </div>
                <div class="di-field @FieldClass("TradeLicenseIssuingBodyId")">
                    <label>Trade License Issuing Body@(Req("TradeLicenseIssuingBodyId"))</label>
                    <InputSelect @bind-Value="formModel.TradeLicenseIssuingBodyId">
                        <option value="">— Select —</option>
                        @foreach (var lov in licensingAuthorities)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                @if (IsIssuingBodyOthers)
                {
                    <div class="di-field @FieldClass("IssuingBodyIfOthers")">
                        <label>Issuing Body if Others@(Req("IssuingBodyIfOthers"))</label>
                        <InputText @bind-Value="formModel.IssuingBodyIfOthers" />
                    </div>
                }
                <div class="di-field @FieldClass("VatRegistered")">
                    <label>VAT Registered?@(Req("VatRegistered"))</label>
                    <InputSelect @bind-Value="vatRegisteredYesNo">
                        <option value="">— Select —</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("TaxRegistrationNumber")">
                    <label>TRN/VAT Registration Number@(Req("TaxRegistrationNumber"))</label>
                    <InputText @bind-Value="formModel.TaxRegistrationNumber" />
                </div>
                <div class="di-field @FieldClass("VatRegistrationTypeId")">
                    <label>VAT Registration Type@(Req("VatRegistrationTypeId"))</label>
                    <InputSelect @bind-Value="formModel.VatRegistrationTypeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in vatRegistrationTypes)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                @if (IsVatGroupSelected)
                {
                    <div class="di-field @FieldClass("NumberOfVatGroupEntities")">
                        <label>Number of Entities if VAT Group@(Req("NumberOfVatGroupEntities"))</label>
                        <InputNumber @bind-Value="formModel.NumberOfVatGroupEntities" />
                    </div>
                    <div class="di-field di-full @FieldClass("VatGroupEntityNames")">
                        <label>Legal Names of all Entities under the VAT Group@(Req("VatGroupEntityNames"))</label>
                        <InputTextArea @bind-Value="formModel.VatGroupEntityNames" rows="3" placeholder="One legal entity name per line" />
                    </div>
                }
                <div class="di-field @FieldClass("SupplierTin")">
                    <label>Supplier TIN@(Req("SupplierTin"))</label>
                    <InputText @bind-Value="formModel.SupplierTin" />
                </div>
                <div class="di-field @FieldClass("BusinessPartnerTypeId")">
                    <label>Business Partner Type@(Req("BusinessPartnerTypeId"))</label>
                    <InputSelect @bind-Value="formModel.BusinessPartnerTypeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in businessPartnerTypes)
                        {
                            <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("BusinessLocationTypeId")">
                    <label>Business Location Type@(Req("BusinessLocationTypeId"))</label>
                    <InputSelect @bind-Value="formModel.BusinessLocationTypeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in businessLocationTypes)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("EInvoicingWaveId")">
                    <label>eINvoicing Wave Applicability@(Req("EInvoicingWaveId"))</label>
                    <InputSelect @bind-Value="formModel.EInvoicingWaveId">
                        <option value="">— Select —</option>
                        @foreach (var lov in eInvoicingWaves)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("VatCodeId")">
                    <label>VAT Code@(Req("VatCodeId"))</label>
                    <InputSelect @bind-Value="formModel.VatCodeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in vatCodes)
                        {
                            <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("DunsNumber")">
                    <label>D-U-N-S Number@(Req("DunsNumber"))</label>
                    <InputText @bind-Value="formModel.DunsNumber" />
                </div>
                <div class="di-checkbox-row">
                    <div class="di-checkbox-item @FieldClass("IsOneTimeSupplier")">
                        <InputCheckbox @bind-Value="formModel.IsOneTimeSupplier" id="oneTime" />
                        <label for="oneTime" style="margin:0;">One-time supplier</label>
                    </div>
                </div>

                <div class="di-documents-row">
                    <div class="di-document-slot">
                        <label>Trade License @if (SupplierFacing){<span class="di-req">*</span>}</label>
                        @if (GetDocument(SupplierDocumentType.TradeLicense) is { } tradeLicenseDoc)
                        {
                            <div class="di-document-current">Uploaded: @tradeLicenseDoc.FileName<button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(tradeLicenseDoc.Id)" disabled="@viewingDocument">View</button></div>
                        }
                        <InputFile OnChange="e => UploadDocumentAsync(e, SupplierDocumentType.TradeLicense)" disabled="@(Supplier.Id == 0 || uploadingDocument)" />
                        @if (SupplierFacing && Supplier.Id != 0 && !HasTradeLicenseDocument())
                        {
                            <div class="text-danger" style="font-size:0.85em;">Required — attach the Trade License before submitting.</div>
                        }
                    </div>
                    <div class="di-document-slot">
                        <label>VAT Certificate @if (SupplierFacing && !string.IsNullOrWhiteSpace(formModel.TaxRegistrationNumber)){<span class="di-req">*</span>}</label>
                        @if (GetDocument(SupplierDocumentType.VatCertification) is { } vatDoc)
                        {
                            <div class="di-document-current">Uploaded: @vatDoc.FileName<button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(vatDoc.Id)" disabled="@viewingDocument">View</button></div>
                        }
                        <InputFile OnChange="e => UploadDocumentAsync(e, SupplierDocumentType.VatCertification)" disabled="@(Supplier.Id == 0 || uploadingDocument)" />
                        @if (SupplierFacing && Supplier.Id != 0 && RequiresVatCertificate())
                        {
                            <div class="text-danger" style="font-size:0.85em;">Required — attach the VAT Certificate when a TRN/VAT number is provided.</div>
                        }
                    </div>
                    <div class="di-document-slot">
                        <label>Other Documents</label>
                        @foreach (var doc in OtherDocuments)
                        {
                            <div class="di-document-current">
                                @doc.FileName
                                <button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(doc.Id)" disabled="@viewingDocument">View</button>
                                <button type="button" class="di-document-remove" title="Remove" @onclick="() => RemoveDocumentAsync(doc.Id)">&times;</button>
                            </div>
                        }
                        <InputFile OnChange="e => UploadDocumentAsync(e, SupplierDocumentType.Other)" disabled="@(Supplier.Id == 0 || uploadingDocument)" />
                    </div>
                </div>
                @if (Supplier.Id == 0)
                {
                    <p class="text-muted di-document-hint">Documents can be uploaded after the first save (click Next).</p>
                }
            </div>
        </div>

        <!-- Step 2: Contact Information -->
        <!-- Step 2: Address Information -->
        <div class="di-section" style="display:@(currentStep == 2 ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">Address Information</span>
                    <span class="di-section-desc">Where the business is located and how it should be contacted.</span>
                </span>
            </div>
            <div class="di-section-body">
                <div class="di-field @FieldClass("AddressName")">
                    <label>Address Name@(Req("AddressName"))</label>
                    <InputText @bind-Value="formModel.AddressName" />
                </div>
                <div class="di-field di-full @FieldClass("AddressLine1")">
                    <label>Address Line 1@(Req("AddressLine1"))</label>
                    <InputText @bind-Value="formModel.AddressLine1" />
                </div>
                <div class="di-field di-full @FieldClass("AddressLine2")">
                    <label>Address Line 2@(Req("AddressLine2"))</label>
                    <InputText @bind-Value="formModel.AddressLine2" />
                </div>
                <div class="di-field @FieldClass("CountryId")">
                    <label>Country@(Req("CountryId"))</label>
                    <InputSelect @bind-Value="formModel.CountryId">
                        <option value="">— Select —</option>
                        @foreach (var lov in countries)
                        {
                            <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("CityId")">
                    <label>City / Emirate<span class="di-req">*</span></label>
                    @if (IsUaeCountry)
                    {
                        <InputSelect @bind-Value="formModel.CityId">
                            <option value="">— Select Emirate —</option>
                            @foreach (var lov in provinces)
                            {
                                <option value="@lov.Id">@lov.DisplayName</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <InputText @bind-Value="formModel.CityText" placeholder="Enter city" />
                    }
                </div>
                <div class="di-field @FieldClass("PostalCode")">
                    <label>PO Box / Postal Code@(Req("PostalCode"))</label>
                    <InputText @bind-Value="formModel.PostalCode" />
                </div>
                <div class="di-field @FieldClass("State")">
                    <label>State@(Req("State"))</label>
                    <InputText @bind-Value="formModel.State" />
                </div>
                <div class="di-field @FieldClass("CorporateWebSite")">
                    <label>Corporate Web Site@(Req("CorporateWebSite"))</label>
                    <InputText @bind-Value="formModel.CorporateWebSite" placeholder="https://" />
                </div>
                <div class="di-field @FieldClass("Email")">
                    <label>Business E-Mail@(Req("Email"))</label>
                    <InputText @bind-Value="formModel.Email" />
                </div>
                <div class="di-field @FieldClass("BusinessPhone")">
                    <label>Business Contact Number@(Req("BusinessPhone"))</label>
                    <PhoneField Countries="countriesWithPhoneCode"
                                @bind-CountryCodeId="formModel.BusinessPhoneCountryCodeId"
                                @bind-AreaCode="formModel.BusinessPhoneAreaCode"
                                @bind-Number="formModel.BusinessPhone"
                                ShowAreaCode="true"
                                Placeholder="888 6998" />
                </div>
                <div class="di-field di-full">
                    <label>Address Purpose</label>
                    <div class="di-checkbox-row">
                        <div class="di-checkbox-item @FieldClass("AddressPurposeOrdering")"><InputCheckbox @bind-Value="formModel.AddressPurposeOrdering" id="apOrdering" /><label for="apOrdering" style="margin:0;">Ordering</label></div>
                        <div class="di-checkbox-item @FieldClass("AddressPurposeRemitTo")"><InputCheckbox @bind-Value="formModel.AddressPurposeRemitTo" id="apRemit" /><label for="apRemit" style="margin:0;">Remit to</label></div>
                        <div class="di-checkbox-item @FieldClass("AddressPurposeRfqBidding")"><InputCheckbox @bind-Value="formModel.AddressPurposeRfqBidding" id="apRfq" /><label for="apRfq" style="margin:0;">RFQ or Bidding</label></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3: Contact Information -->
        <div class="di-section" style="display:@(currentStep == 3 ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">Contact Information</span>
                    <span class="di-section-desc">Primary and additional people we should reach out to.</span>
                </span>
            </div>
            <div class="di-section-body">
                <div class="di-field @FieldClass("PrefixId")">
                    <label>Prefix@(Req("PrefixId"))</label>
                    <InputSelect @bind-Value="formModel.PrefixId">
                        <option value="">— Select —</option>
                        @foreach (var lov in prefixes)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("FirstName")">
                    <label>First Name@(Req("FirstName"))</label>
                    <InputText @bind-Value="formModel.FirstName" />
                </div>
                <div class="di-field @FieldClass("MiddleName")">
                    <label>Middle Name@(Req("MiddleName"))</label>
                    <InputText @bind-Value="formModel.MiddleName" />
                </div>
                <div class="di-field @FieldClass("LastName")">
                    <label>Last Name@(Req("LastName"))</label>
                    <InputText @bind-Value="formModel.LastName" />
                </div>
                <div class="di-field @FieldClass("AdministrativeContact")">
                    <label>Administrative Contact@(Req("AdministrativeContact"))</label>
                    <InputSelect @bind-Value="formModel.AdministrativeContact">
                        <option value="">— Select —</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("ContactEmail")">
                    <label>Contacts E-Mail@(Req("ContactEmail"))</label>
                    <InputText @bind-Value="formModel.ContactEmail" />
                </div>
                <div class="di-field @FieldClass("Phone")">
                    <label>Phone@(Req("Phone"))</label>
                    <PhoneField Countries="countriesWithPhoneCode"
                                @bind-CountryCodeId="formModel.PhoneCountryCodeId"
                                @bind-AreaCode="formModel.PhoneAreaCode"
                                @bind-Number="formModel.Phone"
                                ShowAreaCode="true"
                                Placeholder="888 6998" />
                </div>
                <div class="di-field @FieldClass("Mobile")">
                    <label>Mobile@(Req("Mobile"))</label>
                    <PhoneField Countries="countriesWithPhoneCode"
                                @bind-CountryCodeId="formModel.MobileCountryCodeId"
                                @bind-AreaCode="formModel.MobileAreaCode"
                                @bind-Number="formModel.Mobile"
                                ShowAreaCode="true"
                                Placeholder="50 123 4567" />
                </div>

                <!-- Additional contacts (beyond the primary contact above) -->
                <div class="di-field di-full">
                    <div class="di-subsection-header">
                        <svg class="di-subsection-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022ZM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816ZM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0Zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" /></svg>
                        Additional Contacts
                    </div>
                    @if (formModel.AdditionalContacts.Count == 0)
                    {
                        <p class="di-contact-empty">No additional contacts yet.</p>
                    }
                    @for (var index = 0; index < formModel.AdditionalContacts.Count; index++)
                    {
                        var contact = formModel.AdditionalContacts[index];
                        var contactNo = index + 1;
                        <div class="di-contact-card">
                            <div class="di-contact-card-head">
                                <span class="di-contact-card-title">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" /></svg>
                                    Contact @contactNo
                                </span>
                                <button type="button" class="di-icon-btn di-icon-btn-danger" title="Remove contact" @onclick="() => RemoveContact(contact)">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3V2h11v1h-11Z" /></svg>
                                </button>
                            </div>
                            <div class="di-contact-grid">
                                <div class="di-field">
                                    <label>Prefix</label>
                                    <InputSelect @bind-Value="contact.PrefixId">
                                        <option value="">— Select —</option>
                                        @foreach (var lov in prefixes)
                                        {
                                            <option value="@lov.Id">@lov.DisplayName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>First Name</label>
                                    <InputText @bind-Value="contact.FirstName" />
                                </div>
                                <div class="di-field">
                                    <label>Middle Name</label>
                                    <InputText @bind-Value="contact.MiddleName" />
                                </div>
                                <div class="di-field">
                                    <label>Last Name</label>
                                    <InputText @bind-Value="contact.LastName" />
                                </div>
                                <div class="di-field">
                                    <label>Administrative Contact</label>
                                    <InputSelect @bind-Value="contact.AdministrativeContact">
                                        <option value="">— Select —</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Contacts E-Mail</label>
                                    <InputText @bind-Value="contact.ContactEmail" />
                                </div>
                                <div class="di-field">
                                    <label>Phone</label>
                                    <PhoneField Countries="countriesWithPhoneCode"
                                                @bind-CountryCodeId="contact.PhoneCountryCodeId"
                                                @bind-AreaCode="contact.PhoneAreaCode"
                                                @bind-Number="contact.Phone"
                                                ShowAreaCode="true"
                                                Placeholder="888 6998" />
                                </div>
                                <div class="di-field">
                                    <label>Mobile</label>
                                    <PhoneField Countries="countriesWithPhoneCode"
                                                @bind-CountryCodeId="contact.MobileCountryCodeId"
                                                @bind-AreaCode="contact.MobileAreaCode"
                                                @bind-Number="contact.Mobile"
                                                ShowAreaCode="true"
                                                Placeholder="50 123 4567" />
                                </div>
                            </div>
                        </div>
                    }
                    <button type="button" class="di-add-contact" title="Add a new contact" @onclick="AddContact">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H1s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" /><path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5Z" /></svg>
                        <span>Add New Contact</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Step 5: Payment / Banking Information -->
        <div class="di-section" style="display:@(currentStep == 5 ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">Payment / Banking Information</span>
                    <span class="di-section-desc">Bank account and payment details used to settle invoices.</span>
                </span>
            </div>
            <div class="di-section-body">
                <div class="di-field @FieldClass("BankId")">
                    <label>Bank Name@(Req("BankId"))</label>
                    <InputSelect @bind-Value="formModel.BankId" @bind-Value:after="OnBankChanged">
                        <option value="">— Select —</option>
                        @foreach (var bank in banks)
                        {
                            <option value="@bank.Id">@bank.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("BankBranchId")">
                    <label>Branch Name@(Req("BankBranchId"))</label>
                    <InputSelect @bind-Value="formModel.BankBranchId" disabled="@(formModel.BankId is null)">
                        <option value="">— Select —</option>
                        @foreach (var branch in SelectedBankBranches)
                        {
                            <option value="@branch.Id">@branch.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("AccountCountryCodeId")">
                    <label>Account Country Code@(Req("AccountCountryCodeId"))</label>
                    <InputSelect @bind-Value="formModel.AccountCountryCodeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in countries)
                        {
                            <option value="@lov.Id">@lov.Code – @lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("AccountName")">
                    <label>Account Name@(Req("AccountName"))</label>
                    <InputText @bind-Value="formModel.AccountName" />
                </div>
                <div class="di-field @FieldClass("AccountNumber")">
                    <label>Account Number@(Req("AccountNumber"))</label>
                    <InputText @bind-Value="formModel.AccountNumber" />
                </div>
                <div class="di-field @FieldClass("AccountCurrencyCodeId")">
                    <label>Account Currency Code@(Req("AccountCurrencyCodeId"))</label>
                    <InputSelect @bind-Value="formModel.AccountCurrencyCodeId">
                        <option value="">— Select —</option>
                        @foreach (var lov in currencies)
                        {
                            <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("SwiftCode")">
                    <label>Swift Code / BIC Code@(Req("SwiftCode"))</label>
                    <InputText @bind-Value="formModel.SwiftCode" />
                </div>
                <div class="di-field @FieldClass("Iban")">
                    <label>IBAN@(Req("Iban"))</label>
                    <InputText @bind-Value="formModel.Iban" />
                </div>
                <div class="di-field @FieldClass("AccountStartDate")">
                    <label>Account Start Date@(Req("AccountStartDate"))</label>
                    <InputDate @bind-Value="formModel.AccountStartDate" />
                </div>
                @if (!SupplierFacing)
                {
                    <div class="di-field @FieldClass("AccountEndDate")">
                        <label>Account End Date</label>
                        <InputDate @bind-Value="formModel.AccountEndDate" />
                        <div class="di-hint">Administrators only — set when the bank account is closed.</div>
                    </div>
                }
                <div class="di-field @FieldClass("RemitAdviceEmail")">
                    <label>Remit Advice Email@(Req("RemitAdviceEmail"))</label>
                    <InputText @bind-Value="formModel.RemitAdviceEmail" />
                </div>
                <div class="di-checkbox-row">
                    <div class="di-checkbox-item @FieldClass("AllowInternationalPayments")">
                        <InputCheckbox @bind-Value="formModel.AllowInternationalPayments" id="intlPay" />
                        <label for="intlPay" style="margin:0;">Allow International Payments</label>
                    </div>
                    <div class="di-checkbox-item @FieldClass("IntermediaryAccountApplicable")">
                        <InputCheckbox @bind-Value="formModel.IntermediaryAccountApplicable" id="intermediaryApplicable" />
                        <label for="intermediaryApplicable" style="margin:0;">Intermediary Account Applicable?</label>
                    </div>
                </div>

                @if (formModel.IntermediaryAccountApplicable)
                {
                    <div class="di-subsection-header">Intermediary Bank Account</div>
                    <div class="di-field @FieldClass("IntermediaryCountryId")">
                        <label>Country Name@(Req("IntermediaryCountryId"))</label>
                        <InputSelect @bind-Value="formModel.IntermediaryCountryId">
                            <option value="">— Select —</option>
                            @foreach (var lov in countries)
                            {
                                <option value="@lov.Id">@lov.DisplayName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="di-field @FieldClass("IntermediaryBankName")">
                        <label>Bank Name@(Req("IntermediaryBankName"))</label>
                        <InputText @bind-Value="formModel.IntermediaryBankName" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryAccountNumber")">
                        <label>Account Number@(Req("IntermediaryAccountNumber"))</label>
                        <InputText @bind-Value="formModel.IntermediaryAccountNumber" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryBranchNumber")">
                        <label>Branch Number@(Req("IntermediaryBranchNumber"))</label>
                        <InputText @bind-Value="formModel.IntermediaryBranchNumber" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryIban")">
                        <label>IBAN@(Req("IntermediaryIban"))</label>
                        <InputText @bind-Value="formModel.IntermediaryIban" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryBicSwiftCode")">
                        <label>BIC/Swift Code@(Req("IntermediaryBicSwiftCode"))</label>
                        <InputText @bind-Value="formModel.IntermediaryBicSwiftCode" />
                    </div>
                }

                <!-- Additional bank accounts (beyond the primary account above) -->
                <div class="di-field di-full">
                    <div class="di-subsection-header">
                        <svg class="di-subsection-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                        Additional Bank Accounts
                    </div>
                    @if (formModel.AdditionalBankAccounts.Count == 0)
                    {
                        <p class="di-contact-empty">No additional bank accounts yet.</p>
                    }
                    @for (var index = 0; index < formModel.AdditionalBankAccounts.Count; index++)
                    {
                        var account = formModel.AdditionalBankAccounts[index];
                        var accountNo = index + 1;
                        <div class="di-contact-card">
                            <div class="di-contact-card-head">
                                <span class="di-contact-card-title">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                                    Bank Account @accountNo
                                </span>
                                <button type="button" class="di-icon-btn di-icon-btn-danger" title="Remove bank account" @onclick="() => RemoveBankAccount(account)">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3V2h11v1h-11Z" /></svg>
                                </button>
                            </div>
                            <div class="di-contact-grid">
                                <div class="di-field">
                                    <label>Bank Name</label>
                                    <InputSelect @bind-Value="account.BankId" @bind-Value:after="() => OnAccountBankChanged(account)">
                                        <option value="">— Select —</option>
                                        @foreach (var bank in banks)
                                        {
                                            <option value="@bank.Id">@bank.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Branch Name</label>
                                    <InputSelect @bind-Value="account.BankBranchId" disabled="@(account.BankId is null)">
                                        <option value="">— Select —</option>
                                        @foreach (var branch in BranchesForBank(account.BankId))
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Account Country Code</label>
                                    <InputSelect @bind-Value="account.AccountCountryCodeId">
                                        <option value="">— Select —</option>
                                        @foreach (var lov in countries)
                                        {
                                            <option value="@lov.Id">@lov.Code – @lov.DisplayName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Account Name</label>
                                    <InputText @bind-Value="account.AccountName" />
                                </div>
                                <div class="di-field">
                                    <label>Account Number</label>
                                    <InputText @bind-Value="account.AccountNumber" />
                                </div>
                                <div class="di-field">
                                    <label>Account Currency Code</label>
                                    <InputSelect @bind-Value="account.AccountCurrencyCodeId">
                                        <option value="">— Select —</option>
                                        @foreach (var lov in currencies)
                                        {
                                            <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Swift Code / BIC Code</label>
                                    <InputText @bind-Value="account.SwiftCode" />
                                </div>
                                <div class="di-field">
                                    <label>IBAN</label>
                                    <InputText @bind-Value="account.Iban" />
                                </div>
                                <div class="di-field">
                                    <label>Account Start Date</label>
                                    <InputDate @bind-Value="account.AccountStartDate" />
                                </div>
                                @if (!SupplierFacing)
                                {
                                    <div class="di-field">
                                        <label>Account End Date</label>
                                        <InputDate @bind-Value="account.AccountEndDate" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <button type="button" class="di-add-contact" title="Add a new bank account" @onclick="AddBankAccount">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                        <span>Add New Bank Account</span>
                    </button>
                </div>

                <div class="di-documents-row">
                    <div class="di-document-slot">
                        <label>Bank Confirmation Letter@(RequiresBankConfirmationLetter() ? " *" : "")</label>
                        @if (GetDocument(SupplierDocumentType.BankConfirmationLetter) is { } bankLetterDoc)
                        {
                            <div class="di-document-current">Uploaded: @bankLetterDoc.FileName<button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(bankLetterDoc.Id)" disabled="@viewingDocument">View</button></div>
                        }
                        <InputFile OnChange="e => UploadDocumentAsync(e, SupplierDocumentType.BankConfirmationLetter)" disabled="@(Supplier.Id == 0 || uploadingDocument)" />
                        @if (RequiresBankConfirmationLetter())
                        {
                            <div class="text-danger" style="font-size:0.85em;">Required: you changed the bank account, so a Bank Confirmation Letter must be attached.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 4: Site / Business Unit -->
        <div class="di-section" style="display:@(currentStep == 4 ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">Site / Business Unit</span>
                    <span class="di-section-desc">Assign the supplier to business units and select site usages.</span>
                </span>
            </div>
            <div class="di-section-body">
                <div class="di-field @FieldClass("SupplierSite")">
                    <label>Supplier Site@(Req("SupplierSite"))</label>
                    <InputText @bind-Value="formModel.SupplierSite" />
                </div>
                <div class="di-field @FieldClass("ProcurementBuId")">
                    <label>Procurement BU@(Req("ProcurementBuId"))</label>
                    <InputSelect @bind-Value="formModel.ProcurementBuId">
                        <option value="">— Select —</option>
                        @foreach (var bu in businessUnits)
                        {
                            <option value="@bu.Id">@bu.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("ClientBuId")">
                    <label>Client BU@(Req("ClientBuId"))</label>
                    <InputSelect @bind-Value="formModel.ClientBuId">
                        <option value="">— Select —</option>
                        @foreach (var bu in businessUnits)
                        {
                            <option value="@bu.Id">@bu.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("BillToBuId")">
                    <label>Bill-to BU@(Req("BillToBuId"))</label>
                    <InputSelect @bind-Value="formModel.BillToBuId">
                        <option value="">— Select —</option>
                        @foreach (var bu in businessUnits)
                        {
                            <option value="@bu.Id">@bu.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("PaymentMethodId")">
                    <label>Payment Method@(Req("PaymentMethodId"))</label>
                    <InputSelect @bind-Value="formModel.PaymentMethodId">
                        <option value="">— Select —</option>
                        @foreach (var lov in paymentMethods)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="di-field @FieldClass("PaymentTermsId")">
                    <label>Payment Terms@(Req("PaymentTermsId"))</label>
                    <InputSelect @bind-Value="formModel.PaymentTermsId">
                        <option value="">— Select —</option>
                        @foreach (var lov in paymentTerms)
                        {
                            <option value="@lov.Id">@lov.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                @if (!SupplierFacing || SiteUsageKeys.Any(k => !hiddenFromSupplierKeys.Contains(k)))
                {
                    <div class="di-field di-full">
                        <label>Site Usages</label>
                        <div class="di-checkbox-row">
                            <div class="di-checkbox-item @FieldClass("IsRfqOrBidding")"><InputCheckbox @bind-Value="formModel.IsRfqOrBidding" id="rfq" /><label for="rfq" style="margin:0;">RFQ or Bidding</label></div>
                            <div class="di-checkbox-item @FieldClass("IsOrdering")"><InputCheckbox @bind-Value="formModel.IsOrdering" id="ordering" /><label for="ordering" style="margin:0;">Ordering</label></div>
                            <div class="di-checkbox-item @FieldClass("IsSourcingOnly")"><InputCheckbox @bind-Value="formModel.IsSourcingOnly" id="sourcing" /><label for="sourcing" style="margin:0;">Sourcing only</label></div>
                            <div class="di-checkbox-item @FieldClass("IsPurchasing")"><InputCheckbox @bind-Value="formModel.IsPurchasing" id="purchasing" /><label for="purchasing" style="margin:0;">Purchasing</label></div>
                            <div class="di-checkbox-item @FieldClass("IsPay")"><InputCheckbox @bind-Value="formModel.IsPay" id="pay" /><label for="pay" style="margin:0;">Pay</label></div>
                            <div class="di-checkbox-item @FieldClass("IsPrimaryPay")"><InputCheckbox @bind-Value="formModel.IsPrimaryPay" id="primaryPay" /><label for="primaryPay" style="margin:0;">Primary Pay</label></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (SupplierFacing && currentStep == 5)
        {
            <div class="di-disclaimer">
                <label class="di-disclaimer-label">
                    <input type="checkbox" @bind="disclaimerAccepted" />
                    <span>@DisclaimerText</span>
                </label>
            </div>
        }
        else if (!SupplierFacing && currentStep == 5 && Supplier.DisclaimerAcknowledged)
        {
            <div class="di-disclaimer di-disclaimer-ack">
                <div class="di-disclaimer-label" style="cursor:default;">
                    <span>✔</span>
                    <span>
                        <strong>Supplier declaration accepted.</strong>
                        &ldquo;@(Supplier.DisclaimerText ?? DisclaimerText)&rdquo;
                        <br />
                        <span class="text-muted">
                            Acknowledged by @Supplier.DisclaimerAcknowledgedBy
                            @if (Supplier.DisclaimerAcknowledgedAt is not null)
                            {
                                <text> on @Supplier.DisclaimerAcknowledgedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</text>
                            }
                        </span>
                    </span>
                </div>
            </div>
        }

        <div class="di-actions">
            @if (currentStep > 1)
            {
                <button class="di-btn di-btn-secondary" type="button" @onclick="Back" disabled="@isSaving">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0Z" /></svg>
                    Back
                </button>
            }
            @if (currentStep < 5)
            {
                <button class="di-btn di-btn-primary" type="button" @onclick="NextAsync" disabled="@isSaving">
                    Next
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708Z" /></svg>
                </button>
            }
            else if (Supplier.IsDraft)
            {
                <button class="di-btn di-btn-secondary" type="button" @onclick="SaveAsDraftAsync" disabled="@isSaving">Save as Draft</button>
                <button class="di-btn di-btn-primary" type="button" @onclick="SubmitForApprovalAsync" disabled="@isSaving">Submit for Approval</button>
            }
            else
            {
                <button class="di-btn di-btn-primary" type="button" @onclick="SubmitForApprovalAsync" disabled="@isSaving">Save Changes</button>
            }
        </div>
    </EditForm>

    @if (viewerUrl is not null)
    {
        <div class="di-viewer-backdrop" @onclick="CloseViewer">
            <div class="di-viewer" @onclick:stopPropagation="true">
                <div class="di-viewer-head">
                    <span class="di-viewer-name">@viewerName</span>
                    <button type="button" class="di-viewer-close" title="Close" @onclick="CloseViewer">&times;</button>
                </div>
                <iframe class="di-viewer-frame" src="@viewerUrl" title="Document preview"></iframe>
            </div>
        </div>
    }
</div>

<style>
    .di-hidden-field { display: none !important; }
    .di-subsection-header {
        grid-column: 1 / -1;
        font-weight: 600;
        font-size: 0.9rem;
        margin: 0.75rem 0 0.25rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid var(--di-border, #e2e5ea);
        color: var(--di-text, inherit);
    }
</style>

@code {
    [Parameter, EditorRequired] public Supplier Supplier { get; set; } = default!;
    [Parameter] public bool IsCreateMode { get; set; }
    [Parameter, EditorRequired] public string CurrentUser { get; set; } = "unknown";
    [Parameter, EditorRequired] public EventCallback<Supplier> OnComplete { get; set; }

    /// <summary>When set, replaces the default Create/Update persistence entirely (e.g. a dry-run
    /// admin preview that must never write to a real supplier record). When null, behaves exactly
    /// as before this parameter existed.</summary>
    [Parameter] public Func<Supplier, Task>? PersistOverride { get; set; }

    /// <summary>Attributed to any resulting SupplierFieldChange rows so admin edits and supplier
    /// self-service edits can be told apart; null for admin edits.</summary>
    [Parameter] public int? AccessTokenId { get; set; }

    /// <summary>True when the form is shown to the supplier (self-service). Fields the business has
    /// marked "not visible to supplier" are hidden, and adding a new bank account requires a Bank
    /// Confirmation Letter attachment.</summary>
    [Parameter] public bool SupplierFacing { get; set; }

    private static readonly Dictionary<int, string> StepLabels = new()
    {
        [1] = "Business / Organization",
        [2] = "Address Information",
        [3] = "Contact Information",
        [4] = "Site / Business Unit",
        [5] = "Payment / Banking"
    };

    private SupplierFormModel formModel = new();
    private int currentStep = 1;
    private int maxStepReached = 1;

    /// <summary>Wizard completion percentage (step-based) shown in the progress ring.</summary>
    private int ProgressPct => (int)Math.Round(currentStep / 5.0 * 100);
    private bool isSaving;

    /// <summary>The disclaimer a self-service supplier must accept before submitting. Stored verbatim
    /// with the submission so the exact wording agreed to is preserved.</summary>
    public const string DisclaimerText =
        "I hereby confirm that all the information provided in this form is true, complete and correct to the best of my knowledge.";

    /// <summary>Bound to the self-service disclaimer checkbox on the final step.</summary>
    private bool disclaimerAccepted;

    private List<SupplierFieldSetting> fieldSettings = [];
    private HashSet<string> mandatoryKeys = [];

    private List<LookupValue> taxOrgTypes = [];
    private List<LookupValue> supplierTypes = [];
    private List<LookupValue> countries = [];
    private List<LookupValue> countriesWithPhoneCode = [];
    private List<LookupValue> businessRelationships = [];
    private List<LookupValue> provinces = [];
    private List<LookupValue> vatCodes = [];
    private List<LookupValue> paymentMethods = [];
    private List<LookupValue> paymentTerms = [];
    private List<LookupValue> prefixes = [];
    private List<LookupValue> communicationMethods = [];
    private List<LookupValue> currencies = [];
    private List<LookupValue> vatRegistrationTypes = [];
    private List<LookupValue> businessPartnerTypes = [];
    private List<LookupValue> businessLocationTypes = [];
    private List<LookupValue> eInvoicingWaves = [];
    private List<LookupValue> licensingAuthorities = [];
    private List<Bank> banks = [];
    private List<BusinessUnit> businessUnits = [];
    private List<SupplierDocument> documents = [];
    private bool uploadingDocument;
    private bool viewingDocument;
    private string? viewerUrl;
    private string? viewerName;
    private HashSet<string> changedFieldKeys = [];
    private HashSet<string> hiddenFromSupplierKeys = [];

    // Site-usage checkbox field keys (Step 4); used to hide the "Site usages" hint when all are hidden.
    private static readonly string[] SiteUsageKeys =
        ["IsRfqOrBidding", "IsOrdering", "IsSourcingOnly", "IsPurchasing", "IsPay", "IsPrimaryPay"];
    private int? originalBankId;
    private string? originalAccountNumber;

    private List<BankBranch> SelectedBankBranches =>
        banks.FirstOrDefault(b => b.Id == formModel.BankId)?.Branches ?? [];

    /// <summary>The UAE country lookup id (for the Emirate-vs-free-text-city switch on the address).</summary>
    private int? UaeCountryId =>
        countries.FirstOrDefault(c => c.DisplayName.Contains("United Arab Emirates", StringComparison.OrdinalIgnoreCase))?.Id;

    /// <summary>True when the selected country is the UAE — the City field is then the Emirate LOV; otherwise
    /// it is a free-text city input. A not-yet-chosen country defaults to UAE (the form's default).</summary>
    private bool IsUaeCountry => formModel.CountryId is null || formModel.CountryId == UaeCountryId;

    /// <summary>Pre-fills the (freely editable) Supplier Site with a copy of the Address Name when it is
    /// still blank, so the user lands on a concrete value they can keep or overwrite.</summary>
    private void PrimeSupplierSite()
    {
        if (string.IsNullOrWhiteSpace(formModel.SupplierSite) && !string.IsNullOrWhiteSpace(formModel.AddressName))
        {
            formModel.SupplierSite = formModel.AddressName;
        }
    }

    // bool? -> Yes/No/"" proxy so the VAT Registered dropdown binds cleanly (unset shows "— Select —").
    private string vatRegisteredYesNo
    {
        get => formModel.VatRegistered is null ? "" : (formModel.VatRegistered.Value ? "Yes" : "No");
        set => formModel.VatRegistered = string.IsNullOrEmpty(value) ? null : value == "Yes";
    }

    /// <summary>The VAT-Group-only sub-fields (entity count and names) show only when the selected
    /// VAT Registration Type is the "VAT Group" option.</summary>
    private bool IsVatGroupSelected =>
        vatRegistrationTypes.FirstOrDefault(v => v.Id == formModel.VatRegistrationTypeId)?
            .DisplayName.Contains("Group", StringComparison.OrdinalIgnoreCase) == true;

    /// <summary>The free-text "Issuing Body if Others" shows only when the selected licensing
    /// authority is "Others".</summary>
    private bool IsIssuingBodyOthers =>
        licensingAuthorities.FirstOrDefault(l => l.Id == formModel.TradeLicenseIssuingBodyId)?
            .DisplayName.Equals("Others", StringComparison.OrdinalIgnoreCase) == true;

    /// <summary>Bank account data is required when the Payment Method is "Electronic"; for "Cheque"
    /// (or when unset) it is optional.</summary>
    private bool IsElectronicPayment =>
        paymentMethods.FirstOrDefault(p => p.Id == formModel.PaymentMethodId)?
            .DisplayName.Equals("Electronic", StringComparison.OrdinalIgnoreCase) == true;

    // Fields only meaningful / required when the supplier is VAT registered.
    private static readonly HashSet<string> VatDependentKeys =
    [
        "TaxRegistrationNumber", "VatRegistrationTypeId", "NumberOfVatGroupEntities",
        "VatGroupEntityNames", "SupplierTin"
    ];

    // Step-1 fields whose required state is conditional and enforced by dedicated always-on rules
    // in ValidateStep, so the generic mandatory loop skips them (avoids double/incorrect checks).
    private static readonly HashSet<string> ConditionalStep1Keys =
        ["IssuingBodyIfOthers", "NumberOfVatGroupEntities", "VatGroupEntityNames"];

    /// <summary>Effective required state for a field, layering conditional business rules on top of the
    /// admin-configured mandatory flag:
    /// • Issuing Body if Others — required only when the issuing body is "Others".
    /// • VAT Group entity count / names — required when the VAT Registration Type is a VAT Group.
    /// • VAT-dependent fields (TRN, VAT type, TIN) — never required when VAT Registered is not "Yes".</summary>
    private bool IsFieldMandatory(string fieldKey)
    {
        if (fieldKey == "IssuingBodyIfOthers")
        {
            return IsIssuingBodyOthers;
        }
        if (fieldKey is "NumberOfVatGroupEntities" or "VatGroupEntityNames")
        {
            return IsVatGroupSelected;
        }
        // The whole Payment / Banking section (step 5) is required only when paying Electronically;
        // for Cheque (or when the payment method is unset) all bank fields are optional.
        if (fieldSettings.FirstOrDefault(f => f.FieldKey == fieldKey)?.Step == 5)
        {
            return IsElectronicPayment && mandatoryKeys.Contains(fieldKey);
        }
        if (VatDependentKeys.Contains(fieldKey) && formModel.VatRegistered != true)
        {
            return false;
        }
        return mandatoryKeys.Contains(fieldKey);
    }

    private List<SupplierDocument> OtherDocuments =>
        documents.Where(d => d.DocumentType == SupplierDocumentType.Other).ToList();

    private SupplierDocument? GetDocument(SupplierDocumentType type) =>
        documents.FirstOrDefault(d => d.DocumentType == type);

    protected override async Task OnInitializedAsync()
    {
        // Mandatory-field validation applies only to the supplier-facing self-service portal. Every
        // internal view (SupplierFacing == false) — for administrators and other staff alike — edits
        // with all fields open, so there is no per-role check to make here.

        taxOrgTypes = await SupplierService.GetLookupsAsync(LookupCategory.TaxOrganizationType);
        supplierTypes = await SupplierService.GetLookupsAsync(LookupCategory.SupplierType);
        countries = await SupplierService.GetLookupsAsync(LookupCategory.Country);
        countriesWithPhoneCode = countries.Where(c => !string.IsNullOrWhiteSpace(c.PhoneCode)).ToList();
        businessRelationships = await SupplierService.GetLookupsAsync(LookupCategory.BusinessRelationship);
        provinces = await SupplierService.GetLookupsAsync(LookupCategory.Province);
        vatCodes = await SupplierService.GetLookupsAsync(LookupCategory.VatCode);
        paymentMethods = await SupplierService.GetLookupsAsync(LookupCategory.PaymentMethod);
        paymentTerms = await SupplierService.GetLookupsAsync(LookupCategory.PaymentTerms);
        prefixes = await SupplierService.GetLookupsAsync(LookupCategory.Prefix);
        communicationMethods = await SupplierService.GetLookupsAsync(LookupCategory.CommunicationMethod);
        currencies = await SupplierService.GetLookupsAsync(LookupCategory.Currency);
        vatRegistrationTypes = await SupplierService.GetLookupsAsync(LookupCategory.VatRegistrationType);
        businessPartnerTypes = await SupplierService.GetLookupsAsync(LookupCategory.BusinessPartnerType);
        businessLocationTypes = await SupplierService.GetLookupsAsync(LookupCategory.BusinessLocationType);
        eInvoicingWaves = await SupplierService.GetLookupsAsync(LookupCategory.EInvoicingWave);
        licensingAuthorities = await SupplierService.GetLookupsAsync(LookupCategory.LicensingAuthority);
        banks = await SupplierService.GetBanksAsync();
        businessUnits = await BusinessUnitService.GetAllAsync();

        fieldSettings = await SupplierFieldSettingService.GetAllAsync();
        mandatoryKeys = fieldSettings.Where(f => f.IsMandatory).Select(f => f.FieldKey).ToHashSet();
        hiddenFromSupplierKeys = fieldSettings.Where(f => !f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();

        // Pre-check the self-service disclaimer if this record was already acknowledged before.
        disclaimerAccepted = Supplier.DisclaimerAcknowledged;

        // Remember the bank account as loaded, to detect a supplier adding/changing a bank account.
        originalBankId = Supplier.BankId;
        originalAccountNumber = Supplier.AccountNumber;

        formModel = SupplierFormModel.FromSupplier(Supplier);

        if (IsCreateMode && Supplier.Id == 0)
        {
            var uae = countries.FirstOrDefault(c => c.DisplayName.Contains("United Arab Emirates", StringComparison.OrdinalIgnoreCase));
            formModel.CountryId ??= uae?.Id;
            formModel.AccountCountryCodeId ??= uae?.Id;
            var phoneUae = countriesWithPhoneCode.FirstOrDefault(c => c.PhoneCode == "971");
            formModel.PhoneCountryCodeId ??= phoneUae?.Id;
            formModel.PhoneAreaCode ??= "04";
            formModel.ProcurementBuId ??= Supplier.BusinessUnitId;
            formModel.ClientBuId ??= Supplier.BusinessUnitId;
            formModel.BillToBuId ??= Supplier.BusinessUnitId;
            formModel.SupplierSiteBuId ??= Supplier.BusinessUnitId;
            // A new bank account defaults its start date to today (editable).
            formModel.AccountStartDate ??= DateTime.Today;
            // Address purposes default to all selected for a new supplier.
            formModel.AddressPurposeOrdering = true;
            formModel.AddressPurposeRemitTo = true;
            formModel.AddressPurposeRfqBidding = true;
            // Site usages default to Purchasing / Pay / Primary Pay for a new supplier.
            formModel.IsPurchasing = true;
            formModel.IsPay = true;
            formModel.IsPrimaryPay = true;
        }
        else
        {
            maxStepReached = 5;
        }

        if (Supplier.Id != 0)
        {
            documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
            changedFieldKeys = await SupplierService.GetPendingSupplierEditedFieldsAsync(Supplier.Id);
        }
    }

    /// <summary>CSS class for a field wrapper: highlights it green when its current value came from a
    /// supplier self-service edit that an admin hasn't reviewed (saved over) yet, and hides it
    /// entirely when the form is supplier-facing and the field is marked not visible to suppliers.</summary>
    private string FieldClass(string fieldKey)
    {
        var classes = "";
        if (changedFieldKeys.Contains(fieldKey))
        {
            classes = "di-field-changed";
        }
        if (SupplierFacing && hiddenFromSupplierKeys.Contains(fieldKey))
        {
            classes = string.IsNullOrEmpty(classes) ? "di-hidden-field" : classes + " di-hidden-field";
        }
        return classes;
    }

    private bool IsHiddenFromSupplier(string fieldKey) => SupplierFacing && hiddenFromSupplierKeys.Contains(fieldKey);

    private bool BankAccountChanged() =>
        formModel.BankId != originalBankId ||
        !string.Equals((formModel.AccountNumber ?? "").Trim(), (originalAccountNumber ?? "").Trim(), StringComparison.Ordinal);

    private bool HasBankConfirmationLetter() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.BankConfirmationLetter);

    /// <summary>A Trade License document is mandatory before a supplier can be submitted.</summary>
    private bool HasTradeLicenseDocument() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.TradeLicense);

    /// <summary>A VAT Registration Certificate is required once a TRN/VAT Registration Number is entered.</summary>
    private bool HasVatCertificate() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.VatCertification);

    private bool RequiresVatCertificate() =>
        !string.IsNullOrWhiteSpace(formModel.TaxRegistrationNumber) && !HasVatCertificate();

    /// <summary>A Bank Confirmation Letter must be attached when an existing (already-submitted)
    /// supplier changes/adds a bank account. Drafts (initial registration) are exempt.</summary>
    private bool RequiresBankConfirmationLetter() =>
        Supplier.Id != 0 && !Supplier.IsDraft && BankAccountChanged() && !HasBankConfirmationLetter();

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e, SupplierDocumentType documentType)
    {
        if (Supplier.Id == 0)
        {
            return;
        }

        if (e.File.Size > 10 * 1024 * 1024)
        {
            ToastService.ShowError($"'{e.File.Name}' is {e.File.Size / (1024 * 1024)} MB, over the 10 MB limit. Please attach a smaller file.");
            return;
        }

        uploadingDocument = true;
        try
        {
        var result = await SupplierDocumentService.UploadAsync(Supplier.Id, documentType, e.File, CurrentUser);

        if (!result.Success)
        {
            ToastService.ShowError(result.Error ?? "Upload failed.");
            uploadingDocument = false;
            return;
        }

        var message = $"'{e.File.Name}' uploaded successfully.";
        if (result.ExtractedNumber is not null)
        {
            if (documentType == SupplierDocumentType.VatCertification)
            {
                formModel.TaxRegistrationNumber = result.ExtractedNumber;
                message += $" Tax Registration Number '{result.ExtractedNumber}' was read from the document and filled in.";
            }
            else if (documentType == SupplierDocumentType.TradeLicense)
            {
                formModel.TradeLicenseNumber = result.ExtractedNumber;
                message += $" Trade License Number '{result.ExtractedNumber}' was read from the document and filled in.";
            }
        }

        if (documentType == SupplierDocumentType.TradeLicense && result.DunsNumber is not null)
        {
            formModel.DunsNumber = result.DunsNumber;
            message += $" D-U-N-S Number '{result.DunsNumber}' was read from the document and filled in.";
        }

        ToastService.ShowSuccess(message);
        documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
        }
        catch (Exception)
        {
            // A failure (oversized stream, transient error) shows a message instead of an unhandled
            // circuit error that looks like the upload silently did nothing.
            ToastService.ShowError($"Could not upload '{e.File.Name}'. The file may be too large or in an unsupported format. Please try again.");
        }
        finally { uploadingDocument = false; }
    }

    private async Task ViewDocumentAsync(int documentId)
    {
        // Only documents attached to this supplier can be viewed.
        if (documents.All(d => d.Id != documentId))
        {
            return;
        }

        viewingDocument = true;
        try
        {
            await CloseViewer();
            var file = await SupplierDocumentService.GetFileAsync(documentId);
            if (file is null)
            {
                ToastService.ShowError("Could not open the document. Please try again.");
                return;
            }
            viewerUrl = await JS.InvokeAsync<string>("ssDoc.makeUrl", file.Value.Bytes, file.Value.ContentType);
            viewerName = file.Value.FileName;
        }
        catch (Exception)
        {
            ToastService.ShowError("Could not open the document. Please try again.");
        }
        finally { viewingDocument = false; }
    }

    private async Task CloseViewer()
    {
        if (viewerUrl is not null)
        {
            try { await JS.InvokeVoidAsync("ssDoc.revoke", viewerUrl); } catch { /* ignore */ }
            viewerUrl = null;
            viewerName = null;
        }
    }

    private async Task RemoveDocumentAsync(int documentId)
    {
        var (success, error) = await SupplierDocumentService.DeleteAsync(documentId, CurrentUser);
        if (success)
        {
            ToastService.ShowSuccess("Document removed.");
            documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
        }
        else
        {
            ToastService.ShowError(error ?? "Could not remove the document.");
        }
    }

    private RenderFragment Req(string fieldKey) => builder =>
    {
        // Show the required marker whenever the field is effectively mandatory (admin setting plus the
        // conditional business rules) — in both the internal and supplier-facing views.
        if (IsFieldMandatory(fieldKey))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "di-req");
            builder.AddContent(2, "*");
            builder.CloseElement();
        }
    };

    private void OnBankChanged()
    {
        formModel.BankBranchId = null;
    }

    private void AddContact()
    {
        formModel.AdditionalContacts.Add(new SupplierContactModel());
    }

    private void RemoveContact(SupplierContactModel contact)
    {
        formModel.AdditionalContacts.Remove(contact);
    }

    private void AddBankAccount()
    {
        formModel.AdditionalBankAccounts.Add(new SupplierBankAccountModel());
    }

    private void RemoveBankAccount(SupplierBankAccountModel account)
    {
        formModel.AdditionalBankAccounts.Remove(account);
    }

    /// <summary>Clears the selected branch when an additional account's bank changes (branches are bank-specific).</summary>
    private void OnAccountBankChanged(SupplierBankAccountModel account)
    {
        account.BankBranchId = null;
    }

    /// <summary>Branch options for a given bank id (used by the additional bank-account cards).</summary>
    private List<BankBranch> BranchesForBank(int? bankId) =>
        banks.FirstOrDefault(b => b.Id == bankId)?.Branches ?? [];

    private void GoToStep(int step)
    {
        if (step <= maxStepReached)
        {
            currentStep = step;
            if (currentStep == 4)
            {
                PrimeSupplierSite();
            }
        }
    }

    private void Back()
    {
        currentStep = Math.Max(1, currentStep - 1);
    }

    /// <summary>Email fields shown on each wizard step, with their display label, so their format can
    /// be validated with a regular expression regardless of whether they are marked mandatory.</summary>
    private static readonly Dictionary<int, (string Key, string Label)[]> EmailFieldsByStep = new()
    {
        [1] = [("Email", "Business E-Mail")],
        [3] = [("ContactEmail", "Contacts E-Mail")],
        [5] = [("RemitAdviceEmail", "Remit Advice Email")]
    };

    private static readonly System.ComponentModel.DataAnnotations.EmailAddressAttribute EmailValidator = new();

    private List<string> ValidateStep(SupplierFormModel model, int step)
    {
        var errors = new List<string>();

        // Required/conditional/document checks apply ONLY to suppliers updating via the self-service
        // portal. Internal users (administrators and other staff alike) edit with everything open —
        // no mandatory-field enforcement — so this returns no errors for any non-self-service view.
        if (!SupplierFacing)
        {
            return errors;
        }

        // City is always required and must block progression, regardless of admin/self-service mode:
        // the UAE uses the Emirate LOV (CityId); every other country uses the free-text city (CityText).
        if (step == 2)
        {
            if (IsUaeCountry)
            {
                if (IsEmpty(model.CityId))
                {
                    errors.Add("City / Emirate is required.");
                }
            }
            else if (string.IsNullOrWhiteSpace(model.CityText))
            {
                errors.Add("City is required.");
            }
        }

        // Conditional required rules for Business / Organization, enforced in both admin and
        // supplier-facing modes (like the City rule above):
        //  • Issuing Body if Others — when the issuing body is "Others".
        //  • VAT Group entity count / names — when the VAT Registration Type is a VAT Group.
        if (step == 1)
        {
            if (IsIssuingBodyOthers && string.IsNullOrWhiteSpace(model.IssuingBodyIfOthers))
            {
                errors.Add("Issuing Body if Others is required.");
            }
            if (IsVatGroupSelected)
            {
                if (IsEmpty(model.NumberOfVatGroupEntities))
                {
                    errors.Add("Number of Entities if VAT Group is required.");
                }
                if (string.IsNullOrWhiteSpace(model.VatGroupEntityNames))
                {
                    errors.Add("Legal Names of all Entities under the VAT Group is required.");
                }
            }

            // Document triggers surface on the Business / Organization tab (documents can only be
            // attached after the first save, so these apply to an existing/saved supplier).
            if (SupplierFacing && Supplier.Id != 0)
            {
                if (!HasTradeLicenseDocument())
                {
                    errors.Add("A Trade License document must be attached.");
                }
                if (RequiresVatCertificate())
                {
                    errors.Add("A VAT Registration Certificate must be attached when a TRN/VAT Registration Number is provided.");
                }
            }
        }

        // Mandatory-field enforcement blocks moving to the next step whenever a required field is empty
        // — in both the internal admin/user view and the supplier-facing portal.
        foreach (var setting in fieldSettings.Where(f => f.Step == step && !IsHiddenFromSupplier(f.FieldKey)))
        {
            // City and the conditional Step-1 rules are handled above as always-on rules.
            if (setting.FieldKey == "CityId" || ConditionalStep1Keys.Contains(setting.FieldKey))
            {
                continue;
            }
            // IsFieldMandatory layers the conditional rules (e.g. VAT Registered = No relaxes the
            // VAT fields; Cheque relaxes the bank section) on top of the admin-configured flag.
            if (!IsFieldMandatory(setting.FieldKey))
            {
                continue;
            }

            var property = typeof(SupplierFormModel).GetProperty(setting.FieldKey);
            var value = property?.GetValue(model);
            if (IsEmpty(value))
            {
                errors.Add($"{setting.DisplayLabel} is required.");
            }
        }

        // Validate the format of any email field on this step that has a value (a required-but-empty
        // email is already reported above; here we catch entries that are present but malformed).
        if (EmailFieldsByStep.TryGetValue(step, out var emailFields))
        {
            foreach (var (key, label) in emailFields)
            {
                if (IsHiddenFromSupplier(key))
                {
                    continue;
                }
                var value = typeof(SupplierFormModel).GetProperty(key)?.GetValue(model) as string;
                if (!string.IsNullOrWhiteSpace(value) && !EmailValidator.IsValid(value))
                {
                    errors.Add($"{label} is not a valid email address.");
                }
            }
        }

        return errors;
    }

    private static bool IsEmpty(object? value) => value switch
    {
        null => true,
        string s => string.IsNullOrWhiteSpace(s),
        _ => false
    };

    private async Task PersistAsync(bool submitting = false)
    {
        formModel.ApplyTo(Supplier);

        await Loading.RunAsync(async () =>
        {
            if (PersistOverride is not null)
            {
                await PersistOverride(Supplier);
                return;
            }

            if (Supplier.Id == 0)
            {
                Supplier.SupplierNumber = await SupplierService.GenerateSupplierNumberAsync(Supplier.BusinessUnitId);
                Supplier.CreatedBy = CurrentUser;
                await SupplierService.CreateAsync(Supplier, CurrentUser);
                formModel.SupplierNumber = Supplier.SupplierNumber;
            }
            else
            {
                await SupplierService.UpdateAsync(Supplier, CurrentUser, AccessTokenId, markForReview: submitting);
            }
        });

        await SyncPersistedChildIdsAsync();
    }

    /// <summary>
    /// After a save, copies the database-generated ids of the additional contacts and bank accounts back
    /// onto the form models (matched by their persisted order) so a subsequent save updates the same rows
    /// instead of inserting duplicates.
    /// </summary>
    private async Task SyncPersistedChildIdsAsync()
    {
        if (Supplier.Id == 0)
        {
            return;
        }

        var saved = await SupplierService.GetByIdAsync(Supplier.Id);
        if (saved is null)
        {
            return;
        }

        var savedContacts = saved.Contacts.OrderBy(c => c.SortOrder).ToList();
        var formContacts = formModel.AdditionalContacts.Where(c => !c.IsBlank).ToList();
        for (var i = 0; i < formContacts.Count && i < savedContacts.Count; i++)
        {
            formContacts[i].Id = savedContacts[i].Id;
        }

        var savedAccounts = saved.BankAccounts.OrderBy(a => a.SortOrder).ToList();
        var formAccounts = formModel.AdditionalBankAccounts.Where(a => !a.IsBlank).ToList();
        for (var i = 0; i < formAccounts.Count && i < savedAccounts.Count; i++)
        {
            formAccounts[i].Id = savedAccounts[i].Id;
        }
    }

    private async Task NextAsync()
    {
        var errors = ValidateStep(formModel, currentStep);
        if (errors.Count > 0)
        {
            ToastService.ShowError(string.Join(" ", errors));
            return;
        }

        if (SupplierFacing && currentStep == 5 && RequiresBankConfirmationLetter())
        {
            ToastService.ShowError("A Bank Confirmation Letter must be attached because the bank account was changed.");
            return;
        }

        isSaving = true;
        try
        {
            await PersistAsync();
            if (Supplier.Id != 0)
            {
                documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
            }
            currentStep++;
            if (currentStep == 4)
            {
                PrimeSupplierSite();
            }
            maxStepReached = Math.Max(maxStepReached, currentStep);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAsDraftAsync()
    {
        var errors = ValidateStep(formModel, 5);
        if (errors.Count > 0)
        {
            ToastService.ShowError(string.Join(" ", errors));
            return;
        }

        Supplier.IsDraft = true;
        await FinishAsync(submitting: false);
    }

    private async Task SubmitForApprovalAsync()
    {
        var errors = Enumerable.Range(1, 5).SelectMany(step => ValidateStep(formModel, step)).ToList();
        if (errors.Count > 0)
        {
            for (var step = 1; step <= 5; step++)
            {
                if (ValidateStep(formModel, step).Count > 0)
                {
                    currentStep = step;
                    maxStepReached = Math.Max(maxStepReached, step);
                    break;
                }
            }

            ToastService.ShowError("Complete all required fields before submitting: " + string.Join(" ", errors));
            return;
        }

        if (SupplierFacing && !HasTradeLicenseDocument())
        {
            currentStep = 1;
            ToastService.ShowError("A Trade License document must be attached before submitting.");
            return;
        }

        if (SupplierFacing && RequiresVatCertificate())
        {
            currentStep = 1;
            ToastService.ShowError("A VAT Registration Certificate must be attached because a TRN/VAT Registration Number is provided.");
            return;
        }

        if (SupplierFacing && RequiresBankConfirmationLetter())
        {
            currentStep = 5;
            maxStepReached = Math.Max(maxStepReached, 5);
            ToastService.ShowError("A Bank Confirmation Letter must be attached because the bank account was changed.");
            return;
        }

        // Self-service suppliers must acknowledge the disclaimer before submitting; record the
        // acknowledgement (who / when / exact wording) with the submission.
        if (SupplierFacing)
        {
            if (!disclaimerAccepted)
            {
                currentStep = 5;
                maxStepReached = Math.Max(maxStepReached, 5);
                ToastService.ShowError("Please tick the declaration confirming the information is correct before submitting.");
                return;
            }

            Supplier.DisclaimerAcknowledged = true;
            Supplier.DisclaimerAcknowledgedAt = DateTime.UtcNow;
            Supplier.DisclaimerAcknowledgedBy = CurrentUser;
            Supplier.DisclaimerText = DisclaimerText;
        }

        Supplier.IsDraft = false;
        await FinishAsync(submitting: true);
    }

    private async Task FinishAsync(bool submitting)
    {
        isSaving = true;
        try
        {
            await PersistAsync(submitting);
            await OnComplete.InvokeAsync(Supplier);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
