    /// <summary>The VAT-Group-only sub-fields (entity count and names) show only when the selected
    /// VAT Registration Type is the "VAT Group" option.</summary>
    private bool IsVatGroupSelected =>
        vatRegistrationTypes.FirstOrDefault(v => v.Id == formModel.VatRegistrationTypeId)?
            .DisplayName.Contains("Group", StringComparison.OrdinalIgnoreCase) == true;

    /// <summary>The free-text "Issuing Body if Others" shows only when the selected licensing
    /// authority is "Others".</summary>
    private bool IsIssuingBodyOthers =>
        licensingAuthorities.FirstOrDefault(l => l.Id == formModel.TradeLicenseIssuingBodyId)?
            .DisplayName.Equals("Others", StringComparison.OrdinalIgnoreCase) == true;

    /// <summary>Bank account data is required when the Payment Method is "Electronic"; for "Cheque"
    /// (or when unset) it is optional.</summary>
    private bool IsElectronicPayment =>
        paymentMethods.FirstOrDefault(p => p.Id == formModel.PaymentMethodId)?
            .DisplayName.Equals("Electronic", StringComparison.OrdinalIgnoreCase) == true;

    // Fields only meaningful / required when the supplier is VAT registered.
    private static readonly HashSet<string> VatDependentKeys =
    [
        "TaxRegistrationNumber", "VatRegistrationTypeId", "NumberOfVatGroupEntities",
        "VatGroupEntityNames", "SupplierTin"
    ];

    // Step-1 fields whose required state is conditional and enforced by dedicated always-on rules
    // in ValidateStep, so the generic mandatory loop skips them (avoids double/incorrect checks).
    private static readonly HashSet<string> ConditionalStep1Keys =
        ["IssuingBodyIfOthers", "NumberOfVatGroupEntities", "VatGroupEntityNames"];

    /// <summary>Effective required state for a field, layering conditional business rules on top of the
    /// admin-configured mandatory flag:
    /// • Issuing Body if Others — required only when the issuing body is "Others".
    /// • VAT Group entity count / names — required when the VAT Registration Type is a VAT Group.
    /// • VAT-dependent fields (TRN, VAT type, TIN) — never required when VAT Registered is not "Yes".</summary>
    private bool IsFieldMandatory(string fieldKey)
    {
        // Supplier Site is a free-text field with no validation — never required, whatever the admin setting.
        if (fieldKey == "SupplierSite")
        {
            return false;
        }
        if (fieldKey == "IssuingBodyIfOthers")
        {
            return IsIssuingBodyOthers;
        }
        if (fieldKey is "NumberOfVatGroupEntities" or "VatGroupEntityNames")
        {
            return IsVatGroupSelected;
        }
        // The whole Payment / Banking section (step 5) is required only when paying Electronically;
        // for Cheque (or when the payment method is unset) all bank fields are optional.
        if (fieldSettings.FirstOrDefault(f => f.FieldKey == fieldKey)?.Step == 5)
        {
            return IsElectronicPayment && mandatoryKeys.Contains(fieldKey);
        }
        if (VatDependentKeys.Contains(fieldKey) && formModel.VatRegistered != true)
        {
            return false;
        }
        return mandatoryKeys.Contains(fieldKey);
    }

