    /// <summary>Maximum size (MB) allowed for an uploaded document. Shown in the card hint and enforced
    /// on upload.</summary>
    private const int MaxUploadMb = 10;

    private static string FormatSize(long bytes)
    {
        if (bytes <= 0) return "0 KB";
        double kb = bytes / 1024.0;
        return kb < 1024 ? $"{kb:0} KB" : $"{kb / 1024.0:0.0} MB";
    }

    private static string FileExtLabel(string? fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName ?? "").TrimStart('.').ToUpperInvariant();
        if (string.IsNullOrEmpty(ext)) return "FILE";
        return ext.Length > 4 ? ext[..4] : ext;
    }

