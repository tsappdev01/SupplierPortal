    fieldFragments["AccountCountryCodeId"] = @<div class="di-field @FieldClass("AccountCountryCodeId")">
        <label>Account Country Code@(Req("AccountCountryCodeId"))</label>
        <InputSelect @bind-Value="formModel.AccountCountryCodeId">
            <option value="">— Select —</option>
            @foreach (var lov in countries)
            {
                <option value="@lov.Id">@lov.Code – @lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["AccountName"] = @<div class="di-field @FieldClass("AccountName")">
        <label>Account Name@(Req("AccountName"))</label>
        <InputText @bind-Value="formModel.AccountName" />
    </div>;
    fieldFragments["AccountNumber"] = @<div class="di-field @FieldClass("AccountNumber")">
        <label>Account Number@(Req("AccountNumber"))</label>
        <InputText @bind-Value="formModel.AccountNumber" />
    </div>;
    fieldFragments["AccountCurrencyCodeId"] = @<div class="di-field @FieldClass("AccountCurrencyCodeId")">
        <label>Account Currency Code@(Req("AccountCurrencyCodeId"))</label>
        <InputSelect @bind-Value="formModel.AccountCurrencyCodeId">
            <option value="">— Select —</option>
            @foreach (var lov in currencies)
            {
                <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
