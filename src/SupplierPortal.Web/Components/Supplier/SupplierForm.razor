    // Render a loading indicator first, then load the form data after the first render so the user sees
    // progress instead of a blank panel while the (cached) reference data is fetched.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoaded)
        {
            return;
        }
        dataLoaded = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        // Self-service (DMZ or internal) supplies a pre-loaded bundle via the gateway, so the form renders
        // without any database access here. Internal admin edit/create loads the reference data directly.
        if (Preloaded is not null)
        {
            ApplyBundle(Preloaded);
        }
        else
        {
        // Reference data is independent and cached server-side; load it concurrently (each call uses its
        // own DbContext) so opening the form is fast instead of ~20 sequential round-trips.
        var tTaxOrg = SupplierService.GetLookupsAsync(LookupCategory.TaxOrganizationType);
        var tSupplierTypes = SupplierService.GetLookupsAsync(LookupCategory.SupplierType);
        var tCountries = SupplierService.GetLookupsAsync(LookupCategory.Country);
        var tBusinessRel = SupplierService.GetLookupsAsync(LookupCategory.BusinessRelationship);
        var tProvinces = SupplierService.GetLookupsAsync(LookupCategory.Province);
        var tVatCodes = SupplierService.GetLookupsAsync(LookupCategory.VatCode);
        var tPayMethods = SupplierService.GetLookupsAsync(LookupCategory.PaymentMethod);
        var tPayTerms = SupplierService.GetLookupsAsync(LookupCategory.PaymentTerms);
        var tPrefixes = SupplierService.GetLookupsAsync(LookupCategory.Prefix);
        var tComm = SupplierService.GetLookupsAsync(LookupCategory.CommunicationMethod);
        var tCurrencies = SupplierService.GetLookupsAsync(LookupCategory.Currency);
        var tVatRegTypes = SupplierService.GetLookupsAsync(LookupCategory.VatRegistrationType);
        var tBpTypes = SupplierService.GetLookupsAsync(LookupCategory.BusinessPartnerType);
        var tBlTypes = SupplierService.GetLookupsAsync(LookupCategory.BusinessLocationType);
        var tEinv = SupplierService.GetLookupsAsync(LookupCategory.EInvoicingWave);
        var tLicensing = SupplierService.GetLookupsAsync(LookupCategory.LicensingAuthority);
        var tBanks = SupplierService.GetBanksAsync();
        var tBUs = BusinessUnitService.GetAllAsync();
        var tFieldSettings = SupplierFieldSettingService.GetAllAsync();
        var tTabs = SupplierFieldSettingService.GetTabsAsync();

        await Task.WhenAll(tTaxOrg, tSupplierTypes, tCountries, tBusinessRel, tProvinces, tVatCodes,
            tPayMethods, tPayTerms, tPrefixes, tComm, tCurrencies, tVatRegTypes, tBpTypes, tBlTypes,
            tEinv, tLicensing, tBanks, tBUs, tFieldSettings, tTabs);

        taxOrgTypes = tTaxOrg.Result;
        supplierTypes = tSupplierTypes.Result;
        countries = tCountries.Result;
        countriesWithPhoneCode = countries.Where(c => !string.IsNullOrWhiteSpace(c.PhoneCode)).ToList();
        businessRelationships = tBusinessRel.Result;
        provinces = tProvinces.Result;
        vatCodes = tVatCodes.Result;
        paymentMethods = tPayMethods.Result;
        paymentTerms = tPayTerms.Result;
        prefixes = tPrefixes.Result;
        communicationMethods = tComm.Result;
        currencies = tCurrencies.Result;
        vatRegistrationTypes = tVatRegTypes.Result;
        businessPartnerTypes = tBpTypes.Result;
        businessLocationTypes = tBlTypes.Result;
        eInvoicingWaves = tEinv.Result;
        licensingAuthorities = tLicensing.Result;
        banks = tBanks.Result;
        businessUnits = tBUs.Result;
        fieldSettings = tFieldSettings.Result;
        mandatoryKeys = fieldSettings.Where(f => f.IsMandatory).Select(f => f.FieldKey).ToHashSet();
        hiddenFromSupplierKeys = fieldSettings.Where(f => !f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();
        tabSettings = tTabs.Result;
        }

        // Pre-fill the signature if this record was already signed before.
        declarationSignature = Supplier.DisclaimerSignature ?? "";

        // Remember the bank account as loaded, to detect a supplier adding/changing a bank account.
        originalBankId = Supplier.BankId;
        originalAccountNumber = Supplier.AccountNumber;

        formModel = SupplierFormModel.FromSupplier(Supplier);

        if (IsCreateMode && Supplier.Id == 0)
        {
            var uae = countries.FirstOrDefault(c => c.DisplayName.Contains("United Arab Emirates", StringComparison.OrdinalIgnoreCase));
            formModel.CountryId ??= uae?.Id;
            formModel.AccountCountryCodeId ??= uae?.Id;
            var phoneUae = countriesWithPhoneCode.FirstOrDefault(c => c.PhoneCode == "971");
            formModel.PhoneCountryCodeId ??= phoneUae?.Id;
            formModel.PhoneAreaCode ??= "04";
            formModel.ProcurementBuId ??= Supplier.BusinessUnitId;
            formModel.ClientBuId ??= Supplier.BusinessUnitId;
            formModel.BillToBuId ??= Supplier.BusinessUnitId;
            formModel.SupplierSiteBuId ??= Supplier.BusinessUnitId;
            // A new bank account defaults its start date to today (editable).
            formModel.AccountStartDate ??= DateTime.Today;
            // Address purposes default to all selected for a new supplier.
            formModel.AddressPurposeOrdering = true;
            formModel.AddressPurposeRemitTo = true;
            formModel.AddressPurposeRfqBidding = true;
            // Site usages default to Purchasing / Pay / Primary Pay for a new supplier.
            formModel.IsPurchasing = true;
            formModel.IsPay = true;
            formModel.IsPrimaryPay = true;
        }
        else
        {
            maxStepReached = VisiblePages.Count;
        }

        // Default Taxpayer Country and Account Country Code to UAE, and Account Currency Code to AED,
        // whenever they are not already set — applies to new suppliers and to existing records left blank.
        var uaeCountry = countries.FirstOrDefault(c => c.DisplayName.Contains("United Arab Emirates", StringComparison.OrdinalIgnoreCase));
        formModel.TaxpayerCountryId ??= uaeCountry?.Id;
        formModel.AccountCountryCodeId ??= uaeCountry?.Id;
        var aed = currencies.FirstOrDefault(c => string.Equals(c.Code, "AED", StringComparison.OrdinalIgnoreCase))
                  ?? currencies.FirstOrDefault(c => c.DisplayName.Contains("Dirham", StringComparison.OrdinalIgnoreCase));
        formModel.AccountCurrencyCodeId ??= aed?.Id;

        // Documents and pending-edit highlights: the bundle already carried these for self-service; only
        // the internal path needs to fetch them here.
        if (Preloaded is null && Supplier.Id != 0)
        {
            var tDocs = SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
            var tChanged = SupplierService.GetPendingSupplierEditedFieldsAsync(Supplier.Id);
            await Task.WhenAll(tDocs, tChanged);
            documents = tDocs.Result;
            changedFieldKeys = tChanged.Result;
        }
    }

    /// <summary>Populates the reference-data / document fields from a pre-loaded self-service bundle,
    /// avoiding any database access (used on the DMZ and for internal self-service).</summary>
    private void ApplyBundle(SupplierPortal.Web.Services.SelfService.SsFormData d)
    {
        taxOrgTypes = d.TaxOrgTypes;
        supplierTypes = d.SupplierTypes;
        countries = d.Countries;
        countriesWithPhoneCode = countries.Where(c => !string.IsNullOrWhiteSpace(c.PhoneCode)).ToList();
        businessRelationships = d.BusinessRelationships;
        provinces = d.Provinces;
        vatCodes = d.VatCodes;
        paymentMethods = d.PaymentMethods;
        paymentTerms = d.PaymentTerms;
        prefixes = d.Prefixes;
        communicationMethods = d.CommunicationMethods;
        currencies = d.Currencies;
        vatRegistrationTypes = d.VatRegistrationTypes;
        businessPartnerTypes = d.BusinessPartnerTypes;
        businessLocationTypes = d.BusinessLocationTypes;
        eInvoicingWaves = d.EInvoicingWaves;
        licensingAuthorities = d.LicensingAuthorities;
        banks = d.Banks;
        businessUnits = d.BusinessUnits;
        fieldSettings = d.FieldSettings;
        mandatoryKeys = fieldSettings.Where(f => f.IsMandatory).Select(f => f.FieldKey).ToHashSet();
        hiddenFromSupplierKeys = fieldSettings.Where(f => !f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();
        tabSettings = d.TabSettings;
        documents = d.Documents;
        changedFieldKeys = d.ChangedFieldKeys.ToHashSet();
    }

    /// <summary>CSS class for a field wrapper: highlights it green when its current value came from a
    /// supplier self-service edit that an admin hasn't reviewed (saved over) yet, and hides it
    /// entirely when the field is toggled off in the field manager (hidden on every form — supplier
    /// and internal alike).</summary>
    private string FieldClass(string fieldKey)
    {
        var classes = "";
        if (changedFieldKeys.Contains(fieldKey))
        {
            classes = "di-field-changed";
        }
        if (hiddenFromSupplierKeys.Contains(fieldKey))
        {
            classes = string.IsNullOrEmpty(classes) ? "di-hidden-field" : classes + " di-hidden-field";
        }
        return classes;
    }

    /// <summary>A field toggled off in the field manager is hidden on every form (supplier and
    /// internal), and so is never required.</summary>
    private bool IsHiddenFromSupplier(string fieldKey) => hiddenFromSupplierKeys.Contains(fieldKey);

    private bool BankAccountChanged() =>
        formModel.BankId != originalBankId ||
        !string.Equals((formModel.AccountNumber ?? "").Trim(), (originalAccountNumber ?? "").Trim(), StringComparison.Ordinal);

    private bool HasBankConfirmationLetter() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.BankConfirmationLetter);

    /// <summary>A Trade License document is mandatory before a supplier can be submitted.</summary>
    private bool HasTradeLicenseDocument() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.TradeLicense);

    /// <summary>A VAT Registration Certificate is required once a TRN/VAT Registration Number is entered.</summary>
    private bool HasVatCertificate() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.VatCertification);

    private bool RequiresVatCertificate() =>
        !string.IsNullOrWhiteSpace(formModel.TaxRegistrationNumber) && !HasVatCertificate();

    /// <summary>A Bank Confirmation Letter must be attached when an existing (already-submitted)
    /// supplier changes/adds a bank account. Drafts (initial registration) are exempt.</summary>
    private bool RequiresBankConfirmationLetter() =>
        Supplier.Id != 0 && !Supplier.IsDraft && BankAccountChanged() && !HasBankConfirmationLetter();

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e, SupplierDocumentType documentType)
    {
        if (Supplier.Id == 0)
        {
            return;
        }

        if (e.File.Size > MaxUploadMb * 1024L * 1024L)
        {
            ToastService.ShowError($"'{e.File.Name}' is {e.File.Size / (1024 * 1024)} MB, over the {MaxUploadMb} MB limit. Please attach a smaller file.");
            return;
        }

        uploadingDocument = true;
        try
        {
        bool success; string? error; string? extractedNumber; string? dunsNumber;
        if (ViaGateway)
        {
            await using var ms = new MemoryStream();
            await using (var rs = e.File.OpenReadStream(MaxUploadMb * 1024L * 1024L))
            {
                await rs.CopyToAsync(ms);
            }
            var up = await SsGateway!.UploadDocumentAsync(
                SsTokenValue, SsSessionValue, (int)documentType, e.File.Name, e.File.ContentType, ms.ToArray());
            (success, error, extractedNumber, dunsNumber) = (up.Success, up.Error, up.ExtractedNumber, up.DunsNumber);
        }
        else
        {
            var result = await SupplierDocumentService.UploadAsync(Supplier.Id, documentType, e.File, CurrentUser);
            (success, error, extractedNumber, dunsNumber) = (result.Success, result.Error, result.ExtractedNumber, result.DunsNumber);
        }

        if (!success)
        {
            ToastService.ShowError(error ?? "Upload failed.");
            uploadingDocument = false;
            return;
        }

        var message = $"'{e.File.Name}' uploaded successfully.";
        if (extractedNumber is not null)
        {
            if (documentType == SupplierDocumentType.VatCertification)
            {
                formModel.TaxRegistrationNumber = extractedNumber;
                message += $" Tax Registration Number '{extractedNumber}' was read from the document and filled in.";
            }
            else if (documentType == SupplierDocumentType.TradeLicense)
            {
                formModel.TradeLicenseNumber = extractedNumber;
                message += $" Trade License Number '{extractedNumber}' was read from the document and filled in.";
            }
        }

        if (documentType == SupplierDocumentType.TradeLicense && dunsNumber is not null)
        {
            formModel.DunsNumber = dunsNumber;
            message += $" D-U-N-S Number '{dunsNumber}' was read from the document and filled in.";
        }

        ToastService.ShowSuccess(message);
        documents = await LoadDocumentsAsync();
        }
        catch (Exception)
        {
            // A failure (oversized stream, transient error) shows a message instead of an unhandled
            // circuit error that looks like the upload silently did nothing.
            ToastService.ShowError($"Could not upload '{e.File.Name}'. The file may be too large or in an unsupported format. Please try again.");
        }
        finally { uploadingDocument = false; }
    }

    private async Task ViewDocumentAsync(int documentId)
    {
        // Only documents attached to this supplier can be viewed.
        if (documents.All(d => d.Id != documentId))
        {
            return;
        }

        viewingDocument = true;
        try
        {
            await CloseViewer();
            byte[] bytes; string contentType; string fileName;
            if (ViaGateway)
            {
                var f = await SsGateway!.GetDocumentFileAsync(SsTokenValue, SsSessionValue, documentId);
                if (f is null)
                {
                    ToastService.ShowError("Could not open the document. Please try again.");
                    return;
                }
                (bytes, contentType, fileName) = (Convert.FromBase64String(f.BytesBase64), f.ContentType, f.FileName);
            }
            else
            {
                var file = await SupplierDocumentService.GetFileAsync(documentId);
                if (file is null)
                {
                    ToastService.ShowError("Could not open the document. Please try again.");
                    return;
                }
                (bytes, contentType, fileName) = (file.Value.Bytes, file.Value.ContentType, file.Value.FileName);
            }
            viewerUrl = await JS.InvokeAsync<string>("ssDoc.makeUrl", bytes, contentType);
            viewerName = fileName;
        }
        catch (Exception)
        {
            ToastService.ShowError("Could not open the document. Please try again.");
        }
        finally { viewingDocument = false; }
    }

    private async Task CloseViewer()
    {
        if (viewerUrl is not null)
        {
            try { await JS.InvokeVoidAsync("ssDoc.revoke", viewerUrl); } catch { /* ignore */ }
            viewerUrl = null;
            viewerName = null;
        }
    }

    private async Task RemoveDocumentAsync(int documentId)
    {
        bool success; string? error;
        if (ViaGateway)
        {
            var r = await SsGateway!.DeleteDocumentAsync(SsTokenValue, SsSessionValue, documentId);
            (success, error) = (r.Success, r.Error);
        }
        else
        {
            (success, error) = await SupplierDocumentService.DeleteAsync(documentId, CurrentUser);
        }
        if (success)
        {
            ToastService.ShowSuccess("Document removed.");
            documents = await LoadDocumentsAsync();
        }
        else
        {
            ToastService.ShowError(error ?? "Could not remove the document.");
        }
    }

