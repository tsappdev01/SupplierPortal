    private string vatRegisteredYesNo
    {
        get => formModel.VatRegistered is null ? "" : (formModel.VatRegistered.Value ? "Yes" : "No");
        set => formModel.VatRegistered = string.IsNullOrEmpty(value) ? null : value == "Yes";
