@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject SupplierService SupplierService
@inject BusinessUnitService BusinessUnitService
@inject SupplierFieldSettingService SupplierFieldSettingService
@inject SupplierDocumentService SupplierDocumentService
@inject ToastService ToastService
@inject LoadingService Loading
@inject IJSRuntime JS

@if (loading)
{
    <LoadingIndicator Message="Loading supplier form…" />
}
else
{
<div class="di-form-page">
@{
    // Registry of movable fields keyed by FieldKey. Each step renders the fields the admin field
    // manager has assigned to it (in Sequence order) by looking them up here; composite/interdependent
    // sections (checkbox groups, phone controls carry their own key, the intermediary block, document
    // uploads, additional contacts/accounts) stay anchored in their step and are rendered separately.
    fieldFragments = new Dictionary<string, RenderFragment>();

    fieldFragments["SupplierName"] = @<div class="di-field @FieldClass("SupplierName")">
        <label>Supplier Name@(Req("SupplierName"))@Help("SupplierName")</label>
        <InputText @bind-Value="formModel.SupplierName" />
    </div>;
    fieldFragments["TaxOrganizationTypeId"] = @<div class="di-field @FieldClass("TaxOrganizationTypeId")">
        <label>Tax Organization Type@(Req("TaxOrganizationTypeId"))</label>
        @* Editable for internal admins/staff, but frozen (read-only) on the supplier self-service
           portal so suppliers cannot change a value set by the business. *@
        <InputSelect @bind-Value="formModel.TaxOrganizationTypeId" disabled="@SupplierFacing" class="@(SupplierFacing ? "di-frozen" : null)">
            <option value="">— Select —</option>
            @foreach (var lov in taxOrgTypes)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["SupplierTypeId"] = @<div class="di-field @FieldClass("SupplierTypeId")">
        <label>Supplier Type@(Req("SupplierTypeId"))</label>
        <InputSelect @bind-Value="formModel.SupplierTypeId">
            <option value="">— Select —</option>
            @foreach (var lov in supplierTypes)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["BusinessRelationshipId"] = @<div class="di-field @FieldClass("BusinessRelationshipId")">
        <label>Business Relationship@(Req("BusinessRelationshipId"))</label>
        <InputSelect @bind-Value="formModel.BusinessRelationshipId">
            <option value="">— Select —</option>
            @foreach (var lov in businessRelationships)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["TaxpayerCountryId"] = @<div class="di-field @FieldClass("TaxpayerCountryId")">
        <label>Taxpayer Country@(Req("TaxpayerCountryId"))</label>
        <InputSelect @bind-Value="formModel.TaxpayerCountryId">
            <option value="">— Select —</option>
            @foreach (var lov in countries)
            {
                <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["TradeLicenseNumber"] = @<div class="di-field @FieldClass("TradeLicenseNumber")">
        <label>Trade License Number@(Req("TradeLicenseNumber"))</label>
        <InputText @bind-Value="formModel.TradeLicenseNumber" />
    </div>;
    fieldFragments["TradeLicenseIssueDate"] = @<div class="di-field @FieldClass("TradeLicenseIssueDate")">
        <label>Trade License Issue Date@(Req("TradeLicenseIssueDate"))</label>
        <InputDate @bind-Value="formModel.TradeLicenseIssueDate" />
    </div>;
    fieldFragments["TradeLicenseExpiryDate"] = @<div class="di-field @FieldClass("TradeLicenseExpiryDate")">
        <label>Trade License Expiry Date@(Req("TradeLicenseExpiryDate"))</label>
        <InputDate @bind-Value="formModel.TradeLicenseExpiryDate" />
    </div>;
    fieldFragments["TradeLicenseIssuingBodyId"] = @<div class="di-field @FieldClass("TradeLicenseIssuingBodyId")">
        <label>Trade License Issuing Body@(Req("TradeLicenseIssuingBodyId"))@Help("TradeLicenseIssuingBodyId")</label>
        <InputSelect @bind-Value="formModel.TradeLicenseIssuingBodyId">
            <option value="">— Select —</option>
            @foreach (var lov in licensingAuthorities)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["IssuingBodyIfOthers"] = @<text>
        @if (IsIssuingBodyOthers)
        {
            <div class="di-field @FieldClass("IssuingBodyIfOthers")">
                <label>Issuing Body if Others@(Req("IssuingBodyIfOthers"))</label>
                <InputText @bind-Value="formModel.IssuingBodyIfOthers" />
            </div>
        }
    </text>;
    fieldFragments["VatRegistered"] = @<div class="di-field @FieldClass("VatRegistered")">
        <label>VAT Registered?@(Req("VatRegistered"))</label>
        <InputSelect @bind-Value="vatRegisteredYesNo">
            <option value="">— Select —</option>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
        </InputSelect>
    </div>;
    @* TRN/VAT Registration Number and VAT Registration Type are only relevant when the supplier is
       VAT-registered, so they are hidden entirely when VAT Registered? = No. *@
    fieldFragments["TaxRegistrationNumber"] = @<text>
        @if (IsVatRegistered)
        {
            <div class="di-field @FieldClass("TaxRegistrationNumber")">
                <label>TRN/VAT Registration Number@(Req("TaxRegistrationNumber"))@Help("TaxRegistrationNumber")</label>
                <InputText @bind-Value="formModel.TaxRegistrationNumber" maxlength="15"
                           inputmode="numeric" pattern="[0-9]*" title="15 digits" />
            </div>
        }
    </text>;
    fieldFragments["VatRegistrationTypeId"] = @<text>
        @if (IsVatRegistered)
        {
            <div class="di-field @FieldClass("VatRegistrationTypeId")">
                <label>VAT Registration Type@(Req("VatRegistrationTypeId"))@Help("VatRegistrationTypeId")</label>
                <InputSelect @bind-Value="formModel.VatRegistrationTypeId">
                    <option value="">— Select —</option>
                    @foreach (var lov in vatRegistrationTypes)
                    {
                        <option value="@lov.Id">@lov.DisplayName</option>
                    }
                </InputSelect>
            </div>
        }
    </text>;
    fieldFragments["SupplierTin"] = @<div class="di-field @FieldClass("SupplierTin")">
        <label>Supplier TIN@(Req("SupplierTin"))@Help("SupplierTin")</label>
        <InputText @bind-Value="formModel.SupplierTin" maxlength="10"
                   inputmode="numeric" pattern="[0-9]*" title="10 digits" />
    </div>;
    fieldFragments["BusinessPartnerTypeId"] = @<div class="di-field @FieldClass("BusinessPartnerTypeId")">
        <label>Business Partner Type@(Req("BusinessPartnerTypeId"))</label>
        <InputSelect @bind-Value="formModel.BusinessPartnerTypeId">
            <option value="">— Select —</option>
            @foreach (var lov in businessPartnerTypes)
            {
                <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["BusinessLocationTypeId"] = @<div class="di-field @FieldClass("BusinessLocationTypeId")">
        <label>Business Location Type@(Req("BusinessLocationTypeId"))</label>
        <InputSelect @bind-Value="formModel.BusinessLocationTypeId">
            <option value="">— Select —</option>
            @foreach (var lov in businessLocationTypes)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["EInvoicingWaveId"] = @<div class="di-field @FieldClass("EInvoicingWaveId")">
        <label>eINvoicing Wave Applicability@(Req("EInvoicingWaveId"))@Help("EInvoicingWaveId")</label>
        <InputSelect @bind-Value="formModel.EInvoicingWaveId">
            <option value="">— Select —</option>
            @foreach (var lov in eInvoicingWaves)
