            </InputSelect>
        }
        else
        {
            <InputText @bind-Value="formModel.CityText" placeholder="Enter city" />
        }
    </div>;
    fieldFragments["PostalCode"] = @<div class="di-field @FieldClass("PostalCode")">
        <label>PO Box / Postal Code@(Req("PostalCode"))</label>
        <InputText @bind-Value="formModel.PostalCode" />
    </div>;
    fieldFragments["State"] = @<div class="di-field @FieldClass("State")">
        <label>State@(Req("State"))</label>
        <InputText @bind-Value="formModel.State" />
    </div>;
    fieldFragments["CorporateWebSite"] = @<div class="di-field @FieldClass("CorporateWebSite")">
        <label>Corporate Web Site@(Req("CorporateWebSite"))</label>
        <InputText @bind-Value="formModel.CorporateWebSite" placeholder="https://" />
    </div>;
    fieldFragments["Email"] = @<div class="di-field @FieldClass("Email")">
        <label>Business E-Mail@(Req("Email"))</label>
        <InputText @bind-Value="formModel.Email" />
    </div>;
    fieldFragments["BusinessPhone"] = @<div class="di-field @FieldClass("BusinessPhone")">
        <label>Business Contact Number@(Req("BusinessPhone"))</label>
        <PhoneField Countries="countriesWithPhoneCode"
                    @bind-CountryCodeId="formModel.BusinessPhoneCountryCodeId"
                    @bind-AreaCode="formModel.BusinessPhoneAreaCode"
                    @bind-Number="formModel.BusinessPhone"
                    ShowAreaCode="true"
                    Placeholder="888 6998" />
    </div>;

    fieldFragments["PrefixId"] = @<div class="di-field @FieldClass("PrefixId")">
        <label>Prefix@(Req("PrefixId"))</label>
        <InputSelect @bind-Value="formModel.PrefixId">
            <option value="">— Select —</option>
            @foreach (var lov in prefixes)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["FirstName"] = @<div class="di-field @FieldClass("FirstName")">
        <label>First Name@(Req("FirstName"))</label>
        <InputText @bind-Value="formModel.FirstName" />
    </div>;
    fieldFragments["MiddleName"] = @<div class="di-field @FieldClass("MiddleName")">
        <label>Middle Name@(Req("MiddleName"))</label>
        <InputText @bind-Value="formModel.MiddleName" />
    </div>;
    fieldFragments["LastName"] = @<div class="di-field @FieldClass("LastName")">
        <label>Last Name@(Req("LastName"))</label>
        <InputText @bind-Value="formModel.LastName" />
    </div>;
    fieldFragments["AdministrativeContact"] = @<div class="di-field @FieldClass("AdministrativeContact")">
        <label>Administrative Contact@(Req("AdministrativeContact"))</label>
        <InputSelect @bind-Value="formModel.AdministrativeContact">
            <option value="">— Select —</option>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
        </InputSelect>
    </div>;
    fieldFragments["ContactEmail"] = @<div class="di-field @FieldClass("ContactEmail")">
        <label>Contacts E-Mail@(Req("ContactEmail"))</label>
        <InputText @bind-Value="formModel.ContactEmail" />
    </div>;
    fieldFragments["Phone"] = @<div class="di-field @FieldClass("Phone")">
        <label>Phone@(Req("Phone"))</label>
        <PhoneField Countries="countriesWithPhoneCode"
                    @bind-CountryCodeId="formModel.PhoneCountryCodeId"
                    @bind-AreaCode="formModel.PhoneAreaCode"
                    @bind-Number="formModel.Phone"
                    ShowAreaCode="true"
                    Placeholder="888 6998" />
    </div>;
    fieldFragments["Mobile"] = @<div class="di-field @FieldClass("Mobile")">
        <label>Mobile@(Req("Mobile"))</label>
        <PhoneField Countries="countriesWithPhoneCode"
                    @bind-CountryCodeId="formModel.MobileCountryCodeId"
                    @bind-AreaCode="formModel.MobileAreaCode"
                    @bind-Number="formModel.Mobile"
                    ShowAreaCode="true"
                    Placeholder="50 123 4567" />
    </div>;

    fieldFragments["SupplierSite"] = @<div class="di-field @FieldClass("SupplierSite")">
        <label>Supplier Site@(Req("SupplierSite"))</label>
        <InputText @bind-Value="formModel.SupplierSite" />
    </div>;
    fieldFragments["ProcurementBuId"] = @<div class="di-field @FieldClass("ProcurementBuId")">
        <label>Procurement BU@(Req("ProcurementBuId"))</label>
        <InputSelect @bind-Value="formModel.ProcurementBuId">
            <option value="">— Select —</option>
            @foreach (var bu in businessUnits)
            {
                <option value="@bu.Id">@bu.Name</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["ClientBuId"] = @<div class="di-field @FieldClass("ClientBuId")">
        <label>Client BU@(Req("ClientBuId"))</label>
        <InputSelect @bind-Value="formModel.ClientBuId">
            <option value="">— Select —</option>
            @foreach (var bu in businessUnits)
            {
                <option value="@bu.Id">@bu.Name</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["BillToBuId"] = @<div class="di-field @FieldClass("BillToBuId")">
        <label>Bill-to BU@(Req("BillToBuId"))</label>
        <InputSelect @bind-Value="formModel.BillToBuId">
            <option value="">— Select —</option>
            @foreach (var bu in businessUnits)
            {
                <option value="@bu.Id">@bu.Name</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["PaymentMethodId"] = @<div class="di-field @FieldClass("PaymentMethodId")">
        <label>Payment Method@(Req("PaymentMethodId"))</label>
        <InputSelect @bind-Value="formModel.PaymentMethodId">
            <option value="">— Select —</option>
            @foreach (var lov in paymentMethods)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["PaymentTermsId"] = @<div class="di-field @FieldClass("PaymentTermsId")">
        <label>Payment Terms@(Req("PaymentTermsId"))</label>
        <InputSelect @bind-Value="formModel.PaymentTermsId">
            <option value="">— Select —</option>
            @foreach (var lov in paymentTerms)
            {
                <option value="@lov.Id">@lov.DisplayName</option>
            }
        </InputSelect>
    </div>;

    fieldFragments["BankId"] = @<div class="di-field @FieldClass("BankId")">
        <label>Bank Name@(Req("BankId"))</label>
        <InputSelect @bind-Value="formModel.BankId" @bind-Value:after="OnBankChanged">
            <option value="">— Select —</option>
            @foreach (var bank in banks)
            {
                <option value="@bank.Id">@bank.Name</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["BankBranchId"] = @<div class="di-field @FieldClass("BankBranchId")">
        <label>Branch Name@(Req("BankBranchId"))</label>
        <InputSelect @bind-Value="formModel.BankBranchId" disabled="@(formModel.BankId is null)">
            <option value="">— Select —</option>
            @foreach (var branch in SelectedBankBranches)
            {
                <option value="@branch.Id">@branch.Name</option>
            }
        </InputSelect>
