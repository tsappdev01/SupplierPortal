    /// <summary>Email fields shown on each wizard step, with their display label, so their format can
    /// be validated with a regular expression regardless of whether they are marked mandatory.</summary>
    private static readonly (string Key, string Label, int DefaultStep)[] EmailFields =
    [
        ("Email", "Business E-Mail", 2),
        ("ContactEmail", "Contacts E-Mail", 3),
        ("RemitAdviceEmail", "Remit Advice Email", 5)
    ];

    // Stricter than DataAnnotations' EmailAddressAttribute, which accepts a bare "user@host" with no
    // domain dot (e.g. "nay@jdj"). This requires a local part, an "@", and a domain with at least one
    // dot and a 2+ character top-level domain, so malformed entries are rejected.
    private static readonly System.Text.RegularExpressions.Regex EmailRegex = new(
        @"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$",
        System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    private static bool IsValidEmail(string? value) =>
        !string.IsNullOrWhiteSpace(value) && EmailRegex.IsMatch(value.Trim());

    private List<string> ValidateStep(SupplierFormModel model, int step)
    {
        var errors = new List<string>();

        // Trade License date sanity checks apply to everyone (a data-quality rule, not a self-service-only
        // mandatory-field rule): the issue date can't be in the future, and the expiry can't precede it.
        // Skipped only for a self-service supplier who can't see the field (so they aren't blocked on a
        // value they can't edit).
        if (step == StepOf("TradeLicenseIssueDate", 1) && !(SupplierFacing && IsHiddenFromSupplier("TradeLicenseIssueDate")))
        {
            if (model.TradeLicenseIssueDate is DateTime issueDate && issueDate.Date > DateTime.Today)
            {
                errors.Add("Trade License Issue Date cannot be a future date.");
            }
            if (model.TradeLicenseIssueDate is DateTime iss && model.TradeLicenseExpiryDate is DateTime exp
                && exp.Date < iss.Date)
            {
                errors.Add("Trade License Expiry Date cannot be before the Trade License Issue Date.");
            }
        }

        // When the address differs from the Trade License / VAT Certificate, the alternate VAT-certificate
        // address is mandatory. This is a data-quality rule (like the dates above) so it applies to every
        // view — the toggle is shown on the Address step (2) to internal users and self-service alike.
        if (step == 2 && model.AddressSameAsTradeLicense == false)
        {
            if (string.IsNullOrWhiteSpace(model.VatAddressLine1))
            {
                errors.Add("Address (As per VAT Certificate): Address Line 1 is required.");
            }
            if (model.VatCountryId is null)
            {
                errors.Add("Address (As per VAT Certificate): Country is required.");
            }
            // City follows the same UAE-vs-other rule as the main address: Emirate LOV for the UAE,
            // free-text city otherwise.
            var vatIsUae = model.VatCountryId is null || model.VatCountryId == UaeCountryId;
            if (vatIsUae ? model.VatCityId is null : string.IsNullOrWhiteSpace(model.VatCityText))
            {
                errors.Add("Address (As per VAT Certificate): City / Emirate is required.");
            }
        }

        // Format checks are data-quality rules (like the date checks above) and apply to EVERY view —
        // internal admin/user edits and the self-service portal alike — so a malformed value can never
        // be saved from either place. They only fire when a value is present; emptiness is a separate
        // mandatory-field concern handled below for the self-service flow.

        // Email fields assigned to this step must be a valid address when filled.
        foreach (var (key, label, defaultStep) in EmailFields)
        {
            if (step != StepOf(key, defaultStep) || IsHiddenFromSupplier(key))
            {
                continue;
            }
            var value = typeof(SupplierFormModel).GetProperty(key)?.GetValue(model) as string;
            if (!string.IsNullOrWhiteSpace(value) && !IsValidEmail(value))
            {
                errors.Add($"{label} is not a valid email address.");
            }
        }

        // Supplier TIN must be exactly 10 digits; TRN/VAT Registration Number exactly 15 digits (when entered).
        if (step == StepOf("SupplierTin", 1) && !IsHiddenFromSupplier("SupplierTin")
            && !string.IsNullOrWhiteSpace(model.SupplierTin) && !IsDigits(model.SupplierTin, 10))
        {
            errors.Add("Supplier TIN must be exactly 10 digits.");
        }
        if (step == StepOf("TaxRegistrationNumber", 1) && !IsHiddenFromSupplier("TaxRegistrationNumber") && IsVatRegistered
            && !string.IsNullOrWhiteSpace(model.TaxRegistrationNumber) && !IsDigits(model.TaxRegistrationNumber, 15))
        {
            errors.Add("TRN/VAT Registration Number must be exactly 15 digits.");
        }

        // Required/conditional/document checks apply ONLY to suppliers updating via the self-service
        // portal. Internal users (administrators and other staff alike) edit with everything open —
        // no mandatory-field enforcement — so this returns no further errors for any non-self-service view.
        if (!SupplierFacing)
        {
            return errors;
        }

        // City is always required and must block progression: the UAE uses the Emirate LOV (CityId);
        // every other country uses the free-text city (CityText). The check follows the tab the City
        // field is assigned to (admins can move it).
        if (step == StepOf("CityId", 2))
        {
            if (IsUaeCountry)
            {
                if (IsEmpty(model.CityId))
                {
                    errors.Add("City / Emirate is required.");
                }
            }
            else if (string.IsNullOrWhiteSpace(model.CityText))
            {
                errors.Add("City is required.");
            }
        }

        // Conditional required rules that follow their field's assigned tab:
        //  • Issuing Body if Others — when the issuing body is "Others".
        //  • VAT Group entity count / names — when the VAT Registration Type is a VAT Group.
        if (step == StepOf("IssuingBodyIfOthers", 1)
            && IsIssuingBodyOthers && string.IsNullOrWhiteSpace(model.IssuingBodyIfOthers))
        {
            errors.Add("Issuing Body if Others is required.");
        }
        // VAT Group entities table (anchored on the Business / Organization tab, step 1): when the VAT
        // Registration Type is a VAT Group the supplier must list at least one entity with every column
        // filled.
        if (IsVatGroupSelected && step == 1)
        {
            var rows = model.VatGroupEntities.Where(e => !e.IsBlank).ToList();
            if (rows.Count == 0)
            {
                errors.Add("Please list at least one entity within your VAT group.");
            }
            else if (rows.Any(e => !e.IsComplete))
            {
                errors.Add("Complete every column (Business Legal Name, Address, E-Invoicing Wave, TRN Number, TIN Number, Bus. Location Type) for each VAT group entity.");
            }
        }

        // Document triggers surface on the Business / Organization tab (the document upload cards are
        // anchored there; documents can only be attached after the first save).
        if (step == 1 && SupplierFacing && Supplier.Id != 0)
        {
            if (!HasTradeLicenseDocument())
            {
                errors.Add("A Trade License document must be attached.");
            }
            if (RequiresVatCertificate())
            {
                errors.Add("A VAT Registration Certificate must be attached when a TRN/VAT Registration Number is provided.");
            }
        }

        // Mandatory-field enforcement blocks moving to the next step whenever a required field is empty
        // — in both the internal admin/user view and the supplier-facing portal.
        foreach (var setting in fieldSettings.Where(f => f.Step == step && !IsHiddenFromSupplier(f.FieldKey)))
        {
            // City and the conditional Step-1 rules are handled above as always-on rules.
            if (setting.FieldKey == "CityId" || ConditionalStep1Keys.Contains(setting.FieldKey))
            {
                continue;
            }
            // IsFieldMandatory layers the conditional rules (e.g. VAT Registered = No relaxes the
            // VAT fields; Cheque relaxes the bank section) on top of the admin-configured flag.
            if (!IsFieldMandatory(setting.FieldKey))
            {
                continue;
            }

            var property = typeof(SupplierFormModel).GetProperty(setting.FieldKey);
            var value = property?.GetValue(model);
            if (IsEmpty(value))
            {
                errors.Add($"{setting.DisplayLabel} is required.");
            }
        }

        return errors;
    }

    /// <summary>True when the value is exactly <paramref name="length"/> digits (spaces/dashes ignored).</summary>
    private static bool IsDigits(string value, int length)
    {
        var d = value.Replace(" ", "").Replace("-", "");
        return d.Length == length && d.All(char.IsDigit);
    }

    private static bool IsEmpty(object? value) => value switch
    {
        null => true,
        string s => string.IsNullOrWhiteSpace(s),
        _ => false
    };

    /// <summary>The innermost exception message — EF's DbUpdateException hides the real SQL cause in its
    /// inner exception, so surface that in the toast instead of the generic wrapper.</summary>
    private static string DeepestMessage(Exception ex)
    {
        var current = ex;
        while (current.InnerException is not null)
        {
            current = current.InnerException;
        }
        return current.Message;
    }

    private async Task PersistAsync(bool submitting = false)
    {
        formModel.ApplyTo(Supplier);

        Supplier? savedViaGateway = null;
        await Loading.RunAsync(async () =>
        {
            if (PersistOverride is not null)
            {
                await PersistOverride(Supplier);
                return;
            }

            // Self-service (DMZ or internal) persists through the gateway (HTTP-backed on the DMZ), which
            // handles the update, completion, notifications and token expiry on the internal side.
            if (ViaGateway)
            {
                var result = await SsGateway!.SaveAsync(SsTokenValue, SsSessionValue, Supplier, complete: submitting);
                if (!result.Success)
                {
                    throw new InvalidOperationException(result.Error ?? "Save failed.");
                }
                savedViaGateway = result.Saved;
                return;
            }

            if (Supplier.Id == 0)
            {
                Supplier.SupplierNumber = await SupplierService.GenerateSupplierNumberAsync(Supplier.BusinessUnitId);
                Supplier.CreatedBy = CurrentUser;
                await SupplierService.CreateAsync(Supplier, CurrentUser);
                formModel.SupplierNumber = Supplier.SupplierNumber;
            }
            else
            {
                await SupplierService.UpdateAsync(Supplier, CurrentUser, AccessTokenId, markComplete: submitting);
            }
        });

        await SyncPersistedChildIdsAsync(savedViaGateway);
    }

    /// <summary>
    /// After a save, copies the database-generated ids of the additional contacts and bank accounts back
    /// onto the form models (matched by their persisted order) so a subsequent save updates the same rows
    /// instead of inserting duplicates.
    /// </summary>
    private async Task SyncPersistedChildIdsAsync(Supplier? preloadedSaved = null)
    {
        if (Supplier.Id == 0)
        {
            return;
        }

        // Self-service supplies the reloaded record (from the gateway); internal edit fetches it directly.
        var saved = preloadedSaved ?? (ViaGateway ? null : await SupplierService.GetByIdAsync(Supplier.Id));
        if (saved is null)
        {
            return;
        }

        var savedContacts = saved.Contacts.OrderBy(c => c.SortOrder).ToList();
        var formContacts = formModel.AdditionalContacts.Where(c => !c.IsBlank).ToList();
        for (var i = 0; i < formContacts.Count && i < savedContacts.Count; i++)
        {
            formContacts[i].Id = savedContacts[i].Id;
        }

        var savedAccounts = saved.BankAccounts.OrderBy(a => a.SortOrder).ToList();
        var formAccounts = formModel.AdditionalBankAccounts.Where(a => !a.IsBlank).ToList();
        for (var i = 0; i < formAccounts.Count && i < savedAccounts.Count; i++)
        {
            formAccounts[i].Id = savedAccounts[i].Id;
        }
    }

    private async Task NextAsync()
    {
        var errors = CurrentSections.SelectMany(s => ValidateStep(formModel, s)).ToList();
        if (errors.Count > 0)
        {
            ToastService.ShowErrors(errors);
            return;
        }

        if (SupplierFacing && CurrentSections.Contains(5) && RequiresBankConfirmationLetter())
        {
            ToastService.ShowError("A Bank Confirmation Letter must be attached because the bank account was changed.");
            return;
        }

        isSaving = true;
        try
        {
            await PersistAsync();
            if (Supplier.Id != 0)
            {
                documents = await LoadDocumentsAsync();
            }
            currentStep = Math.Min(currentStep + 1, VisiblePages.Count);
            maxStepReached = Math.Max(maxStepReached, currentStep);
            AfterNavigate();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {DeepestMessage(ex)}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAsDraftAsync()
    {
        var errors = CurrentSections.SelectMany(s => ValidateStep(formModel, s)).ToList();
        if (errors.Count > 0)
        {
            ToastService.ShowErrors(errors);
            return;
        }

        Supplier.IsDraft = true;
        await FinishAsync(submitting: false);
    }

    private async Task SubmitForApprovalAsync()
    {
        var pages = VisiblePages;
        var errors = pages.SelectMany(p => p).SelectMany(s => ValidateStep(formModel, s)).ToList();
        if (errors.Count > 0)
        {
            for (var i = 0; i < pages.Count; i++)
            {
                if (pages[i].Any(s => ValidateStep(formModel, s).Count > 0))
                {
                    currentStep = i + 1;
                    maxStepReached = Math.Max(maxStepReached, currentStep);
                    break;
                }
            }

            ToastService.ShowError("Complete all required fields before submitting.");
            ToastService.ShowErrors(errors);
            return;
        }

        if (SupplierFacing && !HasTradeLicenseDocument())
        {
            currentStep = PageIndexOf(1);
            ToastService.ShowError("A Trade License document must be attached before submitting.");
            return;
        }

        if (SupplierFacing && RequiresVatCertificate())
        {
            currentStep = PageIndexOf(1);
            ToastService.ShowError("A VAT Registration Certificate must be attached because a TRN/VAT Registration Number is provided.");
            return;
        }

        if (SupplierFacing && RequiresBankConfirmationLetter())
        {
            currentStep = PageIndexOf(5);
            maxStepReached = Math.Max(maxStepReached, currentStep);
            ToastService.ShowError("A Bank Confirmation Letter must be attached because the bank account was changed.");
            return;
        }

        // Self-service suppliers must sign a declaration before submitting: open the pop-up (the
        // wording depends on whether they are VAT registered) and finish the submit only once signed.
        if (SupplierFacing)
        {
            showDeclaration = true;
            return;
        }

        Supplier.IsDraft = false;
        await FinishAsync(submitting: true);
    }

    private void CancelDeclaration()
    {
        showDeclaration = false;
    }

    /// <summary>Records the signed declaration and completes the submission.</summary>
    private async Task ConfirmDeclarationAsync()
    {
        if (string.IsNullOrWhiteSpace(declarationSignature))
        {
            return;
        }

        Supplier.DisclaimerAcknowledged = true;
        Supplier.DisclaimerAcknowledgedAt = DateTime.UtcNow;
        Supplier.DisclaimerAcknowledgedBy = CurrentUser;
        Supplier.DisclaimerText = DeclarationFullText();
        Supplier.DisclaimerSignature = declarationSignature.Trim();

        showDeclaration = false;
        Supplier.IsDraft = false;
        await FinishAsync(submitting: true);
    }

    private async Task FinishAsync(bool submitting)
    {
        isSaving = true;
        try
        {
            await PersistAsync(submitting);
            await OnComplete.InvokeAsync(Supplier);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {DeepestMessage(ex)}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
