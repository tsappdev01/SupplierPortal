    <div class="di-form-topbar">
        <div class="di-form-headings">
            <div class="di-form-title">Supplier Registration</div>
            <div class="di-form-sub">Dubai Investments Entities &mdash; @(IsCreateMode ? "New supplier onboarding" : "Edit supplier")</div>
        </div>
        <div class="di-progress" title="@ProgressPct% complete">
            <svg class="di-progress-ring" viewBox="0 0 36 36">
                <circle class="di-progress-bg" cx="18" cy="18" r="15.9155"></circle>
                <circle class="di-progress-bar" cx="18" cy="18" r="15.9155" style="stroke-dasharray:@ProgressPct.ToString(System.Globalization.CultureInfo.InvariantCulture) 100"></circle>
            </svg>
            <div class="di-progress-center">
                <span class="di-progress-pct">@ProgressPct%</span>
                <span class="di-progress-word">Complete</span>
            </div>
        </div>
    </div>
    @if (SupplierFacing)
    {
        <div class="di-legend">
            <div><span class="di-req">*</span> Required field (set by Settings &gt; Supplier Fields)</div>
        </div>
    }

    <div class="di-stepper">
        @{ var visiblePages = VisiblePages; }
        @for (var i = 1; i <= visiblePages.Count; i++)
        {
            var step = i;
            <button type="button" class="di-stepper-item @(currentStep == step ? "active" : "") @(step <= maxStepReached ? "reached" : "")"
                    disabled="@(step > maxStepReached)" @onclick="() => GoToStep(step)">
                <span class="di-stepper-num">@step</span>
                <span class="di-stepper-label">@PageTitle(visiblePages[step - 1])</span>
            </button>
            if (i < visiblePages.Count)
            {
                <svg class="di-stepper-chevron" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708Z" />
                </svg>
            }
        }
    </div>

    <EditForm Model="formModel" FormName="supplier-form">

        <!-- Step 1: Business / Organization Information -->
        <div class="di-section" style="display:@(CurrentSections.Contains(1) ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M6.5 5.5a.5.5 0 1 0-1 0 .5.5 0 0 0 1 0Zm-1 2a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0Zm2.5-.5a.5.5 0 1 0 0 1 .5.5 0 0 0 0-1Zm2 .5a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0ZM8 5a.5.5 0 1 0 0 1 .5.5 0 0 0 0-1Zm2 .5a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0Z" /><path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H2V1Zm2 2v1h1V3H4Zm1 2H4v1h1V5Zm1 0v1h1V5H6Zm1-1V3H6v1h1Zm1 0h1V3H8v1Zm1 1H8v1h1V5Zm1-2v1h1V3h-1Zm1 2h-1v1h1V5ZM4 8v1h1V8H4Zm1 2H4v1h1v-1Zm1 0v1h1v-1H6Zm1-1V8H6v1h1Zm1 0h1V8H8v1Zm1 1H8v1h1v-1Zm1-2v1h1V8h-1Zm1 2h-1v1h1v-1ZM4 14h3v-3H4v3Zm5 0h3v-3H9v3Z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">@SectionTitle(1)</span>
                    <span class="di-section-desc">Provide accurate business details as per your trade license and official documents.</span>
                </span>
            </div>
            <div class="di-section-body">
                <div class="di-field">
                    <label>Supplier Number</label>
                    <input type="text" value="@(string.IsNullOrWhiteSpace(formModel.SupplierNumber) ? "System generated" : formModel.SupplierNumber)" disabled />
                </div>
                @* Internal triage priority — hidden entirely from the supplier self-service portal. *@
                @if (!SupplierFacing)
                {
                    <div class="di-field">
                        <label>Priority</label>
                        <InputSelect @bind-Value="formModel.Priority">
                            <option value="">— Select —</option>
                            <option value="P1">P1</option>
                            <option value="P2">P2</option>
                            <option value="P3">P3</option>
                        </InputSelect>
                    </div>
                }
                @foreach (var key in MovableKeysForStep(1))
                {
                    @fieldFragments[key]
                }

                @if (IsVatGroupSelected)
                {
                    <div class="di-field di-full di-vatgroup">
                        <div class="di-vatgroup-head">
                            <span class="di-vatgroup-title">VAT Group</span>@Help("VatGroup")
                            <button type="button" class="di-add-contact" @onclick="AddVatGroupEntity">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z" /></svg>
                                <span>Add Row</span>
                            </button>
                        </div>
                        <p class="di-vatgroup-note">
                            Please list all entities registered under your VAT Group that are conducting business with our company.
                        </p>
                        <div class="di-vatgroup-scroll">
                            <table class="di-vatgroup-table">
                                <thead>
                                    <tr>
                                        <th>Business Legal Name@(IsVatGroupSelected && SupplierFacing ? "*" : "")</th>
                                        <th>Address@(IsVatGroupSelected && SupplierFacing ? "*" : "")</th>
                                        <th>E-Invoicing Wave<br />(Wave 1/Wave 2)@(IsVatGroupSelected && SupplierFacing ? "*" : "")</th>
                                        <th>TRN Number@(IsVatGroupSelected && SupplierFacing ? "*" : "")</th>
                                        <th>TIN Number@(IsVatGroupSelected && SupplierFacing ? "*" : "")</th>
                                        <th>Bus. Location Type<br />(Mainland/Free Zone)@(IsVatGroupSelected && SupplierFacing ? "*" : "")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (formModel.VatGroupEntities.Count == 0)
                                    {
                                        <tr><td colspan="7" class="di-vatgroup-empty">No entities added yet. Click "Add Row" to list a VAT group entity.</td></tr>
                                    }
                                    @foreach (var entity in formModel.VatGroupEntities)
                                    {
                                        <tr>
                                            <td><input type="text" @bind="entity.BusinessLegalName" /></td>
                                            <td><input type="text" @bind="entity.Address" /></td>
                                            <td>
                                                <select @bind="entity.EInvoicingWaveId">
                                                    <option value="">Select</option>
                                                    @foreach (var lov in eInvoicingWaves)
                                                    {
                                                        <option value="@lov.Id">@lov.DisplayName</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input type="text" @bind="entity.TrnNumber" /></td>
                                            <td><input type="text" @bind="entity.TinNumber" /></td>
                                            <td>
                                                <select @bind="entity.BusinessLocationTypeId">
                                                    <option value="">Select</option>
                                                    @foreach (var lov in businessLocationTypes)
                                                    {
                                                        <option value="@lov.Id">@lov.DisplayName</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <button type="button" class="di-icon-btn di-icon-btn-danger" title="Remove entity" @onclick="() => RemoveVatGroupEntity(entity)">
                                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3V2h11v1h-11Z" /></svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <div class="di-documents-grid">
                    @(DocCard("Trade License", SupplierDocumentType.TradeLicense, "di-thumb-red",
                             SupplierFacing,
                             SupplierFacing && Supplier.Id != 0 && !HasTradeLicenseDocument(),
                             "Required — attach the Trade License before submitting."))
                    @(DocCard("VAT Certificate", SupplierDocumentType.VatCertification, "di-thumb-green",
                             SupplierFacing && !string.IsNullOrWhiteSpace(formModel.TaxRegistrationNumber),
                             SupplierFacing && Supplier.Id != 0 && RequiresVatCertificate(),
                             "Required — attach the VAT Certificate when a TRN/VAT number is provided."))

                    <div class="di-doccard">
                        @{ var otherDisabled = Supplier.Id == 0 || uploadingDocument; }
                        <div class="di-doccard-thumb di-thumb-amber">
                            <svg width="26" height="26" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM4.5 9a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0 2a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0-4a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1h-3z" /></svg>
                            <span class="di-doccard-ext">FILES</span>
                        </div>
                        <div class="di-doccard-main">
                            <div class="di-doccard-title">Other Documents</div>
                            @if (OtherDocuments.Count == 0)
                            {
                                <div class="di-doccard-meta di-doccard-empty">No files uploaded yet.</div>
                            }
                            else
                            {
                                @foreach (var doc in OtherDocuments)
                                {
                                    <div class="di-doccard-chip">
                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" /></svg>
                                        <span class="di-doccard-fname" title="@doc.FileName">@doc.FileName</span>
                                        <button type="button" class="di-doccard-view-inline" @onclick="() => ViewDocumentAsync(doc.Id)" disabled="@viewingDocument">View</button>
                                        <button type="button" class="di-document-remove" title="Remove" @onclick="() => RemoveDocumentAsync(doc.Id)">&times;</button>
                                    </div>
                                }
                            }
                        </div>
                        <div class="di-doccard-upload">
                            <label class="di-doccard-choose @(otherDisabled ? "is-disabled" : null)" for="docfile-Other">
                                <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" /></svg>
                                <span>Choose File</span>
                                <svg class="di-doccard-caret" width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" /></svg>
                            </label>
                            <InputFile id="docfile-Other" class="di-doccard-input" accept=".pdf,.jpg,.jpeg,.png" OnChange="e => UploadDocumentAsync(e, SupplierDocumentType.Other)" disabled="@otherDisabled" />
                            <div class="di-doccard-hint">Supported formats: PDF, JPG, PNG<br />Max size: @MaxUploadMb MB</div>
                        </div>
                    </div>
                </div>
                @if (Supplier.Id == 0)
                {
                    <p class="text-muted di-document-hint">Documents can be uploaded after the first save (click Next).</p>
                }
            </div>
        </div>

        <!-- Step 2: Contact Information -->
        <!-- Step 2: Address Information -->
        <div class="di-section" style="display:@(CurrentSections.Contains(2) ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">@SectionTitle(2) <span style="font-weight:500">(As per Trade License)</span></span>
                    <span class="di-section-desc">Where the business is located and how it should be contacted.</span>
                </span>
            </div>
            <div class="di-section-body">
                @foreach (var key in MovableKeysForStep(2))
                {
                    @fieldFragments[key]
                }

                <!-- Is the address above the same as on the Trade License and VAT Certificate?
                     When "No", the supplier must give the alternate address per their VAT Certificate. -->
                <div class="di-field di-full">
                    <label>Is your address the same as your Trade License and VAT Certificate?</label>
                    <div class="di-switch-wrap">
                        <button type="button" role="switch"
                                aria-checked="@(formModel.AddressSameAsTradeLicense == true ? "true" : "false")"
                                class="di-switch @(formModel.AddressSameAsTradeLicense == true ? "on" : "") @(formModel.AddressSameAsTradeLicense == false ? "off" : "")"
                                @onclick="ToggleAddressSameAsTradeLicense">
                            <span class="di-switch-knob"></span>
                        </button>
                        <span class="di-switch-text">@(formModel.AddressSameAsTradeLicense == true ? "Yes" : formModel.AddressSameAsTradeLicense == false ? "No" : "—")</span>
                    </div>
                </div>
                @if (formModel.AddressSameAsTradeLicense == false)
                {
                    <div class="di-field di-full">
                        <div class="di-subsection-header">
                            <svg class="di-subsection-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
                            Address (As per VAT Certificate)
                        </div>
                    </div>
                    <div class="di-field di-full">
                        <label>Address Line 1<span class="di-req">*</span></label>
                        <InputText @bind-Value="formModel.VatAddressLine1" />
                    </div>
                    <div class="di-field di-full">
                        <label>Address Line 2</label>
                        <InputText @bind-Value="formModel.VatAddressLine2" />
                    </div>
                    <div class="di-field">
                        <label>Country<span class="di-req">*</span></label>
                        <InputSelect @bind-Value="formModel.VatCountryId">
                            <option value="">— Select —</option>
                            @foreach (var lov in countries)
                            {
                                <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="di-field">
                        <label>City / Emirate<span class="di-req">*</span></label>
                        @if (IsVatUaeCountry)
                        {
                            <InputSelect @bind-Value="formModel.VatCityId">
                                <option value="">— Select Emirate —</option>
                                @foreach (var lov in provinces)
                                {
                                    <option value="@lov.Id">@lov.DisplayName</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <InputText @bind-Value="formModel.VatCityText" placeholder="Enter city" />
                        }
                    </div>
                    <div class="di-field">
                        <label>PO Box / Postal Code</label>
                        <InputText @bind-Value="formModel.VatPostalCode" />
                    </div>
                }
                @if (AddressPurposeKeys.Any(k => !hiddenFromSupplierKeys.Contains(k)))
                {
                <div class="di-field di-full">
                    <label>Address Purpose</label>
                    <div class="di-checkbox-row">
                        <div class="di-checkbox-item @FieldClass("AddressPurposeOrdering")"><InputCheckbox @bind-Value="formModel.AddressPurposeOrdering" id="apOrdering" /><label for="apOrdering" style="margin:0;">Ordering</label></div>
                        <div class="di-checkbox-item @FieldClass("AddressPurposeRemitTo")"><InputCheckbox @bind-Value="formModel.AddressPurposeRemitTo" id="apRemit" /><label for="apRemit" style="margin:0;">Remit to</label></div>
                        <div class="di-checkbox-item @FieldClass("AddressPurposeRfqBidding")"><InputCheckbox @bind-Value="formModel.AddressPurposeRfqBidding" id="apRfq" /><label for="apRfq" style="margin:0;">RFQ or Bidding</label></div>
                    </div>
                </div>
                }
            </div>
        </div>

        <!-- Step 3: Contact Information (shares the Address page; both always expanded) -->
        <div class="di-section" style="display:@(CurrentSections.Contains(3) ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">@SectionTitle(3)</span>
                    <span class="di-section-desc">Primary and additional people we should reach out to.</span>
                </span>
            </div>
            <div class="di-section-body">
                @foreach (var key in MovableKeysForStep(3))
                {
                    @fieldFragments[key]
                }

                <!-- Additional contacts (beyond the primary contact above) -->
                <div class="di-field di-full">
                    <div class="di-subsection-header">
                        <svg class="di-subsection-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022ZM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816ZM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0Zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" /></svg>
                        Additional Contacts
                    </div>
                    @if (formModel.AdditionalContacts.Count == 0)
                    {
                        <p class="di-contact-empty">No additional contacts yet.</p>
                    }
                    @for (var index = 0; index < formModel.AdditionalContacts.Count; index++)
                    {
                        var contact = formModel.AdditionalContacts[index];
                        var contactNo = index + 1;
                        <div class="di-contact-card">
                            <div class="di-contact-card-head">
                                <span class="di-contact-card-title">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" /></svg>
                                    Contact @contactNo
                                </span>
                                <button type="button" class="di-icon-btn di-icon-btn-danger" title="Remove contact" @onclick="() => RemoveContact(contact)">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3V2h11v1h-11Z" /></svg>
                                </button>
                            </div>
                            <div class="di-contact-grid">
                                <div class="di-field">
                                    <label>Prefix</label>
                                    <InputSelect @bind-Value="contact.PrefixId">
                                        <option value="">— Select —</option>
                                        @foreach (var lov in prefixes)
                                        {
                                            <option value="@lov.Id">@lov.DisplayName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>First Name</label>
                                    <InputText @bind-Value="contact.FirstName" />
                                </div>
                                <div class="di-field">
                                    <label>Middle Name</label>
                                    <InputText @bind-Value="contact.MiddleName" />
                                </div>
                                <div class="di-field">
                                    <label>Last Name</label>
                                    <InputText @bind-Value="contact.LastName" />
                                </div>
                                <div class="di-field">
                                    <label>Administrative Contact</label>
                                    <InputSelect @bind-Value="contact.AdministrativeContact">
                                        <option value="">— Select —</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Contacts E-Mail</label>
                                    <InputText @bind-Value="contact.ContactEmail" />
                                </div>
                                <div class="di-field">
                                    <label>Phone</label>
                                    <PhoneField Countries="countriesWithPhoneCode"
                                                @bind-CountryCodeId="contact.PhoneCountryCodeId"
                                                @bind-AreaCode="contact.PhoneAreaCode"
                                                @bind-Number="contact.Phone"
                                                ShowAreaCode="true"
                                                Placeholder="888 6998" />
                                </div>
                                <div class="di-field">
                                    <label>Mobile</label>
                                    <PhoneField Countries="countriesWithPhoneCode"
                                                @bind-CountryCodeId="contact.MobileCountryCodeId"
                                                @bind-AreaCode="contact.MobileAreaCode"
                                                @bind-Number="contact.Mobile"
                                                ShowAreaCode="true"
                                                Placeholder="50 123 4567" />
                                </div>
                            </div>
                        </div>
                    }
                    <button type="button" class="di-add-contact" title="Add a new contact" @onclick="AddContact">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H1s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" /><path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5Z" /></svg>
                        <span>Add New Contact</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Step 5: Payment / Banking Information -->
        <div class="di-section" style="display:@(CurrentSections.Contains(5) ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">@SectionTitle(5)</span>
                    <span class="di-section-desc">Bank account and payment details used to settle invoices.</span>
                </span>
            </div>
            <div class="di-section-body">
                @foreach (var key in MovableKeysForStep(5))
                {
                    @fieldFragments[key]
                }
                @if (!SupplierFacing)
                {
                    <div class="di-field @FieldClass("AccountEndDate")">
                        <label>Account End Date</label>
                        <InputDate @bind-Value="formModel.AccountEndDate" />
                        <div class="di-hint">Administrators only — set when the bank account is closed.</div>
                    </div>
                }
                <div class="di-checkbox-row">
                    <div class="di-checkbox-item @FieldClass("AllowInternationalPayments")">
                        <InputCheckbox @bind-Value="formModel.AllowInternationalPayments" id="intlPay" />
                        <label for="intlPay" style="margin:0;">Allow International Payments</label>
                    </div>
                    <div class="di-checkbox-item @FieldClass("IntermediaryAccountApplicable")">
                        <InputCheckbox @bind-Value="formModel.IntermediaryAccountApplicable" id="intermediaryApplicable" />
                        <label for="intermediaryApplicable" style="margin:0;">Intermediary Account Applicable?</label>
                    </div>
                </div>

                @if (formModel.IntermediaryAccountApplicable)
                {
                    <div class="di-subsection-header">Intermediary Bank Account</div>
                    <div class="di-field @FieldClass("IntermediaryCountryId")">
                        <label>Country Name@(Req("IntermediaryCountryId"))</label>
                        <InputSelect @bind-Value="formModel.IntermediaryCountryId">
                            <option value="">— Select —</option>
                            @foreach (var lov in countries)
                            {
                                <option value="@lov.Id">@lov.DisplayName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="di-field @FieldClass("IntermediaryBankName")">
                        <label>Bank Name@(Req("IntermediaryBankName"))</label>
                        <InputText @bind-Value="formModel.IntermediaryBankName" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryAccountNumber")">
                        <label>Account Number@(Req("IntermediaryAccountNumber"))</label>
                        <InputText @bind-Value="formModel.IntermediaryAccountNumber" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryBranchNumber")">
                        <label>Branch Number@(Req("IntermediaryBranchNumber"))</label>
                        <InputText @bind-Value="formModel.IntermediaryBranchNumber" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryIban")">
                        <label>IBAN@(Req("IntermediaryIban"))</label>
                        <InputText @bind-Value="formModel.IntermediaryIban" />
                    </div>
                    <div class="di-field @FieldClass("IntermediaryBicSwiftCode")">
                        <label>BIC/Swift Code@(Req("IntermediaryBicSwiftCode"))</label>
                        <InputText @bind-Value="formModel.IntermediaryBicSwiftCode" />
                    </div>
                }

                <!-- Additional bank accounts (beyond the primary account above) -->
                <div class="di-field di-full">
                    <div class="di-subsection-header">
                        <svg class="di-subsection-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                        Additional Bank Accounts
                    </div>
                    @if (formModel.AdditionalBankAccounts.Count == 0)
                    {
                        <p class="di-contact-empty">No additional bank accounts yet.</p>
                    }
                    @for (var index = 0; index < formModel.AdditionalBankAccounts.Count; index++)
                    {
                        var account = formModel.AdditionalBankAccounts[index];
                        var accountNo = index + 1;
                        <div class="di-contact-card">
                            <div class="di-contact-card-head">
                                <span class="di-contact-card-title">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                                    Bank Account @accountNo
                                </span>
                                <button type="button" class="di-icon-btn di-icon-btn-danger" title="Remove bank account" @onclick="() => RemoveBankAccount(account)">
                                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3V2h11v1h-11Z" /></svg>
                                </button>
                            </div>
                            <div class="di-contact-grid">
                                <div class="di-field">
                                    <label>Bank Name</label>
                                    <InputSelect @bind-Value="account.BankId" @bind-Value:after="() => OnAccountBankChanged(account)">
                                        <option value="">— Select —</option>
                                        @foreach (var bank in banks)
                                        {
                                            <option value="@bank.Id">@bank.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Branch Name</label>
                                    <InputSelect @bind-Value="account.BankBranchId" disabled="@(account.BankId is null)">
                                        <option value="">— Select —</option>
                                        @foreach (var branch in BranchesForBank(account.BankId))
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Account Country Code</label>
                                    <InputSelect @bind-Value="account.AccountCountryCodeId">
                                        <option value="">— Select —</option>
                                        @foreach (var lov in countries)
                                        {
                                            <option value="@lov.Id">@lov.Code – @lov.DisplayName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Account Name</label>
                                    <InputText @bind-Value="account.AccountName" />
                                </div>
                                <div class="di-field">
                                    <label>Account Number</label>
                                    <InputText @bind-Value="account.AccountNumber" />
                                </div>
                                <div class="di-field">
                                    <label>Account Currency Code</label>
                                    <InputSelect @bind-Value="account.AccountCurrencyCodeId">
                                        <option value="">— Select —</option>
                                        @foreach (var lov in currencies)
                                        {
                                            <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>Swift Code / BIC Code</label>
                                    <InputText @bind-Value="account.SwiftCode" />
                                </div>
                                <div class="di-field">
                                    <label>IBAN</label>
                                    <InputText @bind-Value="account.Iban" />
                                </div>
                                <div class="di-field">
                                    <label>Account Start Date</label>
                                    <InputDate @bind-Value="account.AccountStartDate" />
                                </div>
                                @if (!SupplierFacing)
                                {
                                    <div class="di-field">
                                        <label>Account End Date</label>
                                        <InputDate @bind-Value="account.AccountEndDate" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <button type="button" class="di-add-contact" title="Add a new bank account" @onclick="AddBankAccount">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.783 14 5v.5H2V5l6-3.217zM2 6h12v6h1v1H1v-1h1V6zm2 1v4h1V7H4zm3 0v4h1V7H7zm3 0v4h1V7h-1zM1 14h14v1H1v-1z" /></svg>
                        <span>Add New Bank Account</span>
                    </button>
                </div>

                <div class="di-documents-grid">
                    @(DocCard("Bank Confirmation Letter", SupplierDocumentType.BankConfirmationLetter, "di-thumb-blue",
                             RequiresBankConfirmationLetter(),
                             RequiresBankConfirmationLetter(),
                             "Required: you changed the bank account, so a Bank Confirmation Letter must be attached."))
                </div>
            </div>
        </div>

        <!-- Step 4: Site / Business Unit -->
        <div class="di-section" style="display:@(CurrentSections.Contains(4) ? "block" : "none")">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z" /></svg>
                </span>
                <span class="di-section-heading">
                    <span class="di-section-title">@SectionTitle(4)</span>
                    <span class="di-section-desc">Assign the supplier to business units and select site usages.</span>
                </span>
            </div>
            <div class="di-section-body">
                @foreach (var key in MovableKeysForStep(4))
                {
                    @fieldFragments[key]
                }
                @if (SiteUsageKeys.Any(k => !hiddenFromSupplierKeys.Contains(k)))
                {
                    <div class="di-field di-full">
                        <label>Site Usages</label>
                        <div class="di-checkbox-row">
                            <div class="di-checkbox-item @FieldClass("IsRfqOrBidding")"><InputCheckbox @bind-Value="formModel.IsRfqOrBidding" id="rfq" /><label for="rfq" style="margin:0;">RFQ or Bidding</label></div>
                            <div class="di-checkbox-item @FieldClass("IsOrdering")"><InputCheckbox @bind-Value="formModel.IsOrdering" id="ordering" /><label for="ordering" style="margin:0;">Ordering</label></div>
                            <div class="di-checkbox-item @FieldClass("IsSourcingOnly")"><InputCheckbox @bind-Value="formModel.IsSourcingOnly" id="sourcing" /><label for="sourcing" style="margin:0;">Sourcing only</label></div>
                            <div class="di-checkbox-item @FieldClass("IsPurchasing")"><InputCheckbox @bind-Value="formModel.IsPurchasing" id="purchasing" /><label for="purchasing" style="margin:0;">Purchasing</label></div>
                            <div class="di-checkbox-item @FieldClass("IsPay")"><InputCheckbox @bind-Value="formModel.IsPay" id="pay" /><label for="pay" style="margin:0;">Pay</label></div>
                            <div class="di-checkbox-item @FieldClass("IsPrimaryPay")"><InputCheckbox @bind-Value="formModel.IsPrimaryPay" id="primaryPay" /><label for="primaryPay" style="margin:0;">Primary Pay</label></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* On the last page the supplier signs a declaration in a pop-up when they click Submit (see the
           declaration modal below). For internal reviewers, show the recorded declaration + signature. *@
        @if (!SupplierFacing && IsLastPage && Supplier.DisclaimerAcknowledged)
        {
            <div class="di-disclaimer di-disclaimer-ack">
                <div class="di-disclaimer-label" style="cursor:default;">
                    <span>✔</span>
                    <span>
                        <strong>@(Supplier.DisclaimerText is not null ? "Declaration signed by supplier." : "Supplier declaration accepted.")</strong>
                        @if (!string.IsNullOrWhiteSpace(Supplier.DisclaimerSignature))
                        {
                            <text> Digital signature: <em>@Supplier.DisclaimerSignature</em>.</text>
                        }
                        <br />
                        <span class="text-muted">
                            Acknowledged by @Supplier.DisclaimerAcknowledgedBy
                            @if (Supplier.DisclaimerAcknowledgedAt is not null)
                            {
                                <text> on @Supplier.DisclaimerAcknowledgedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</text>
                            }
                        </span>
                    </span>
                </div>
            </div>
        }

        <div class="di-actions">
            @if (currentStep > 1)
            {
                <button class="di-btn di-btn-secondary" type="button" @onclick="Back" disabled="@isSaving">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0Z" /></svg>
                    Back
                </button>
            }
            @if (!IsLastPage)
            {
                <button class="di-btn di-btn-primary" type="button" @onclick="NextAsync" disabled="@isSaving">
                    Next
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708Z" /></svg>
                </button>
            }
            else if (Supplier.IsDraft)
            {
                <button class="di-btn di-btn-secondary" type="button" @onclick="SaveAsDraftAsync" disabled="@isSaving">Save as Draft</button>
                <button class="di-btn di-btn-primary" type="button" @onclick="SubmitForApprovalAsync" disabled="@isSaving">Submit for Approval</button>
            }
            else
            {
                <button class="di-btn di-btn-primary" type="button" @onclick="SubmitForApprovalAsync" disabled="@isSaving">Save Changes</button>
            }
        </div>
    </EditForm>

    @if (viewerUrl is not null)
    {
        <div class="di-viewer-backdrop" @onclick="CloseViewer">
            <div class="di-viewer" @onclick:stopPropagation="true">
                <div class="di-viewer-head">
                    <span class="di-viewer-name">@viewerName</span>
                    <button type="button" class="di-viewer-close" title="Close" @onclick="CloseViewer">&times;</button>
                </div>
                <iframe class="di-viewer-frame" src="@viewerUrl" title="Document preview"></iframe>
            </div>
        </div>
    }

    @if (showDeclaration)
    {
        <div class="di-decl-backdrop">
            <div class="di-decl" role="dialog" aria-modal="true">
                <div class="di-decl-head">
                    <h2 class="di-decl-title">@DeclarationTitle</h2>
                    <div class="di-decl-subtitle">@DeclarationSubtitle</div>
                </div>
                <div class="di-decl-body">
                    <p class="di-decl-section">Declaration (For true and correct information provided):</p>
                    <p>@GeneralDeclaration</p>

                    @if (!IsVatRegistered)
                    {
                        <p class="di-decl-section">Declaration &ndash; Non-Registration for VAT:</p>
                        @foreach (var para in VatNonRegistrationParagraphs)
                        {
                            <p>@para</p>
                        }
                    }

                    <p class="di-decl-certify">@DeclarationCertify</p>

                    <label class="di-decl-siglabel">Full Name (Digital Signature)</label>
                    <input type="text" class="di-decl-sig" @bind="declarationSignature" @bind:event="oninput"
                           placeholder="Type your full name here (this will be considered as your digital signature)" />
                </div>
                <div class="di-decl-actions">
                    <button type="button" class="di-btn di-btn-secondary" @onclick="CancelDeclaration" disabled="@isSaving">Cancel</button>
                    <button type="button" class="di-btn di-btn-primary" @onclick="ConfirmDeclarationAsync"
                            disabled="@(isSaving || string.IsNullOrWhiteSpace(declarationSignature))">
                        Agree &amp; Submit
                    </button>
                </div>
            </div>
        </div>
    }

    @if (helpKey is not null && fieldHelp.TryGetValue(helpKey, out var help))
    {
        <div class="di-help-backdrop" @onclick="CloseHelp">
            <div class="di-help-pop" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <div class="di-help-head">
                    <h3 class="di-help-title">@help.Title</h3>
                    <button type="button" class="di-help-close" title="Close" @onclick="CloseHelp">&times;</button>
                </div>
                <p class="di-help-body">@help.Body</p>
            </div>
        </div>
    }
</div>

<style>
    .di-help-btn { border: none; background: transparent; color: #3b5bdb; cursor: pointer; padding: 0 0 0 5px; vertical-align: middle; line-height: 1; display: inline-flex; }
    .di-help-btn:hover { color: #1e40af; }
    .di-help-backdrop { position: fixed; inset: 0; background: rgba(15,22,35,0.5); display: flex; align-items: center; justify-content: center; z-index: 1090; padding: 24px; }
    .di-help-pop { background: #fff; border-radius: 10px; width: min(420px, 100%); padding: 18px 20px; box-shadow: 0 12px 40px rgba(0,0,0,0.35); }
    .di-help-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
    .di-help-title { margin: 0; font-size: 16px; font-weight: 700; color: #0b2545; }
    .di-help-close { border: none; background: transparent; font-size: 22px; line-height: 1; color: #6b7280; cursor: pointer; }
    .di-help-body { margin: 0; font-size: 14px; color: #2f3a4c; line-height: 1.6; white-space: pre-line; }
    .di-decl-section { font-weight: 700; color: #0b2545; margin: 14px 0 4px; }
    .di-decl-section:first-child { margin-top: 0; }
    .di-hidden-field { display: none !important; }
    .di-subsection-header {
        grid-column: 1 / -1;
        font-weight: 600;
        font-size: 0.9rem;
        margin: 0.75rem 0 0.25rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid var(--di-border, #e2e5ea);
        color: var(--di-text, inherit);
    }
</style>
}

@code {
    [Parameter, EditorRequired] public Supplier Supplier { get; set; } = default!;
    [Parameter] public bool IsCreateMode { get; set; }
    [Parameter, EditorRequired] public string CurrentUser { get; set; } = "unknown";
    [Parameter, EditorRequired] public EventCallback<Supplier> OnComplete { get; set; }

    /// <summary>When set, replaces the default Create/Update persistence entirely (e.g. a dry-run
    /// admin preview that must never write to a real supplier record). When null, behaves exactly
    /// as before this parameter existed.</summary>
    [Parameter] public Func<Supplier, Task>? PersistOverride { get; set; }

    /// <summary>Attributed to any resulting SupplierFieldChange rows so admin edits and supplier
    /// self-service edits can be told apart; null for admin edits.</summary>
    [Parameter] public int? AccessTokenId { get; set; }

    /// <summary>True when the form is shown to the supplier (self-service). Fields the business has
    /// marked "not visible to supplier" are hidden, and adding a new bank account requires a Bank
    /// Confirmation Letter attachment.</summary>
    [Parameter] public bool SupplierFacing { get; set; }

    /// <summary>Self-service data gateway supplied by the public self-service page. When set, the form
    /// loads/saves/manages documents through this gateway (which is HTTP-backed on the DMZ) instead of the
    /// database services — this is what lets the DMZ run with no database. Null for internal admin views.</summary>
    [Parameter] public SupplierPortal.Web.Services.SelfService.ISupplierSelfServiceDataGateway? SsGateway { get; set; }
    /// <summary>Pre-loaded form bundle (from the gateway) used to populate the form without touching the
    /// database. Set together with <see cref="SsGateway"/> on the self-service page.</summary>
    [Parameter] public SupplierPortal.Web.Services.SelfService.SsFormData? Preloaded { get; set; }
    [Parameter] public string? SsToken { get; set; }
    [Parameter] public string? SsSession { get; set; }

    private bool ViaGateway => SsGateway is not null;

    // Capture the self-service token/session the first time they arrive non-empty and keep them. Guards
    // against a later parameter re-supply handing us nulls mid-flow (which surfaced as a "link-not-found"
    // session error on document upload even though the form had loaded on a valid link).
    private string? ssTokenActive;
    private string? ssSessionActive;
    private string SsTokenValue => ssTokenActive ?? SsToken ?? "";
    private string SsSessionValue => ssSessionActive ?? SsSession ?? "";

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SsToken)) { ssTokenActive = SsToken; }
        if (!string.IsNullOrEmpty(SsSession)) { ssSessionActive = SsSession; }
    }

    // Admin-configured tab titles + visibility (one row per field-section step 1-5).
    private List<SupplierTabSetting> tabSettings = [];

    // Wizard pages group one or more field-sections. Address (2) and Contact (3) share one page and
    // are shown as an accordion; the other sections are each their own page. A page appears only if at
    // least one of its sections is visible; within a page only visible sections render.
    private static readonly int[][] BasePages = [[1], [2, 3], [4], [5]];

    private bool SectionVisible(int step) =>
        tabSettings.FirstOrDefault(t => t.Step == step)?.IsVisible ?? true;

    private string SectionTitle(int step)
    {
        var t = tabSettings.FirstOrDefault(x => x.Step == step);
        return t is not null && !string.IsNullOrWhiteSpace(t.Title)
            ? t.Title
            : SupplierFieldSettingService.DefaultTabTitles.GetValueOrDefault(step, $"Step {step}");
    }

    private List<int[]> VisiblePages => BasePages
        .Select(p => p.Where(SectionVisible).ToArray())
        .Where(p => p.Length > 0)
        .ToList();

    private string PageTitle(int[] sections) => string.Join(" & ", sections.Select(SectionTitle));

    private int[] CurrentSections
    {
        get
        {
            var pages = VisiblePages;
            if (pages.Count == 0) return [];
            var idx = Math.Clamp(currentStep, 1, pages.Count) - 1;
            return pages[idx];
        }
    }

    private bool IsLastPage => currentStep >= VisiblePages.Count;

    /// <summary>1-based page index that contains the given field-section (falls back to 1).</summary>
    private int PageIndexOf(int section)
    {
        var pages = VisiblePages;
        for (var i = 0; i < pages.Count; i++)
        {
            if (pages[i].Contains(section)) return i + 1;
        }
        return 1;
    }

    private SupplierFormModel formModel = new();
    private int currentStep = 1;
    private int maxStepReached = 1;

    /// <summary>Wizard completion percentage (page-based) shown in the progress ring.</summary>
    private int ProgressPct
    {
        get
        {
            var count = VisiblePages.Count;
            return count == 0 ? 0 : (int)Math.Round(Math.Clamp(currentStep, 1, count) / (double)count * 100);
        }
    }
    private bool isSaving;
    // Form data loads after the first render (see OnAfterRenderAsync); until then a loading indicator shows.
    private bool loading = true;
    private bool dataLoaded;

    // ---- Declaration pop-up (shown to self-service suppliers on Submit) ----

    /// <summary>True while the declaration pop-up is open, awaiting the supplier's digital signature.</summary>
    private bool showDeclaration;

    /// <summary>The full name the supplier types as their digital signature in the declaration pop-up.</summary>
    private string declarationSignature = "";

    /// <summary>True when the supplier is VAT registered (drives which declaration is shown).</summary>
    private bool IsVatRegistered => formModel.VatRegistered == true;

    /// <summary>Cycles the "address same as Trade License / VAT Certificate" toggle. Starts unset (—),
    /// then Yes, then No. Clears the alternate VAT-certificate address whenever the answer is not "No".</summary>
    private void ToggleAddressSameAsTradeLicense()
    {
        formModel.AddressSameAsTradeLicense = formModel.AddressSameAsTradeLicense switch
        {
            true => false,
            false => true,
            null => true,
        };
        if (formModel.AddressSameAsTradeLicense != false)
        {
            formModel.VatAddressLine1 = null;
            formModel.VatAddressLine2 = null;
            formModel.VatCityId = null;
            formModel.VatCityText = null;
            formModel.VatCountryId = null;
            formModel.VatPostalCode = null;
        }
    }

    /// <summary>The contracting entity named in the declaration — the supplier's own business unit, so the
    /// wording differs per business unit. Falls back to a neutral label if the unit can't be resolved.</summary>
    private string CompanyName
    {
        get
        {
            var bu = businessUnits.FirstOrDefault(b => b.Id == Supplier.BusinessUnitId)?.Name;
            return string.IsNullOrWhiteSpace(bu) ? "the Company" : bu.Trim();
        }
    }

    private string DeclarationTitle => "Supplier Declaration";

    private string DeclarationSubtitle => "Supplier Data Gathering Portal";

    private string SupplierDisplayName =>
        string.IsNullOrWhiteSpace(Supplier.SupplierName) ? "the Supplier" : Supplier.SupplierName.Trim();

    /// <summary>General declaration (true &amp; correct information), shown to every supplier.</summary>
    private string GeneralDeclaration =>
        "I/We hereby declare that the information and data provided in this form are true, correct, and " +
        "complete to the best of our knowledge, and are furnished in compliance with the applicable UAE " +
        "e-invoicing requirements issued by the Ministry of Finance / Federal Tax Authority. We undertake " +
        $"to promptly inform {CompanyName} of any changes to the above.";

    /// <summary>Additional declaration shown only when the supplier is NOT registered for VAT.</summary>
    private string[] VatNonRegistrationParagraphs =>
    [
        $"I/We, the undersigned, being an authorized signatory of {SupplierDisplayName} (\"the Supplier\"), " +
        "hereby declare that our taxable supplies and imports have not exceeded the mandatory VAT " +
        "registration threshold of AED 375,000 during the previous 12 months, and we have therefore not " +
        "obtained registration for Value Added Tax (VAT) with the Federal Tax Authority (FTA) under UAE " +
        "Federal Decree-Law No. 8 of 2017 (as amended).",

        $"We undertake to immediately notify {CompanyName} in writing, and to obtain VAT registration within " +
        "the timeline prescribed by law, should our taxable supplies and imports exceed the mandatory " +
        $"registration threshold at any point in the future. Until such registration is obtained, we confirm " +
        $"that we shall not charge VAT on any supplies made to {CompanyName}.",

        "We confirm that the above is true and correct to the best of our knowledge."
    ];

    private string DeclarationCertify =>
        "By signing below, I/We acknowledge and accept the declaration(s) set out above.";

    /// <summary>The full declaration text stored with the submission (wording preserved for audit).</summary>
    private string DeclarationFullText()
    {
        var parts = new List<string>
        {
            DeclarationTitle,
            DeclarationSubtitle,
            "Declaration (For true and correct information provided):",
            GeneralDeclaration
        };
        if (!IsVatRegistered)
        {
            parts.Add("Declaration – Non-Registration for VAT:");
            parts.AddRange(VatNonRegistrationParagraphs);
        }
        parts.Add(DeclarationCertify);
        return string.Join("\n\n", parts);
    }

    private List<SupplierFieldSetting> fieldSettings = [];
    private HashSet<string> mandatoryKeys = [];

    private List<LookupValue> taxOrgTypes = [];
    private List<LookupValue> supplierTypes = [];
    private List<LookupValue> countries = [];
    private List<LookupValue> countriesWithPhoneCode = [];
    private List<LookupValue> businessRelationships = [];
    private List<LookupValue> provinces = [];
    private List<LookupValue> vatCodes = [];
    private List<LookupValue> paymentMethods = [];
    private List<LookupValue> paymentTerms = [];
