    // Registry of movable field markup, keyed by FieldKey; rebuilt each render in the markup block at
    // the top of the component. A step renders the movable fields the admin assigned to it, in order.
    private Dictionary<string, RenderFragment> fieldFragments = new();

    // Default (fallback) order of movable fields, matching the form's original layout. Used as a tie
    // breaker when stored Sequence values are equal (e.g. all zero before the admin first saves a
    // layout), so the form keeps its familiar order until an admin deliberately reorders fields.
    private static readonly string[] MovableOrder =
    [
        // Step 1
        "SupplierName", "TaxOrganizationTypeId", "SupplierTypeId", "BusinessRelationshipId",
        "TaxpayerCountryId", "TradeLicenseNumber", "TradeLicenseIssueDate", "TradeLicenseExpiryDate",
        "TradeLicenseIssuingBodyId", "IssuingBodyIfOthers", "VatRegistered", "TaxRegistrationNumber",
        "VatRegistrationTypeId", "NumberOfVatGroupEntities", "VatGroupEntityNames", "SupplierTin",
        "BusinessPartnerTypeId", "BusinessLocationTypeId", "EInvoicingWaveId", "VatCodeId", "DunsNumber",
        "IsOneTimeSupplier",
        // Step 2
        "AddressName", "AddressLine1", "AddressLine2", "CountryId", "CityId", "PostalCode", "State",
        "CorporateWebSite", "Email", "BusinessPhone",
        // Step 3
        "PrefixId", "FirstName", "MiddleName", "LastName", "AdministrativeContact", "ContactEmail",
        "Phone", "Mobile",
        // Step 4
        "SupplierSite", "ProcurementBuId", "ClientBuId", "BillToBuId", "PaymentMethodId", "PaymentTermsId",
        // Step 5
        "BankId", "BankBranchId", "AccountCountryCodeId", "AccountName", "AccountNumber",
        "AccountCurrencyCodeId", "SwiftCode", "Iban", "AccountStartDate", "RemitAdviceEmail",
    ];

    private static int CanonicalIndex(string key)
    {
        var i = Array.IndexOf(MovableOrder, key);
        return i < 0 ? int.MaxValue : i;
    }

    /// <summary>The movable fields assigned to a given tab, in display order. Driven by the admin field
    /// manager's tab (Step) + Sequence, excluding removed fields (already filtered out of
    /// <c>fieldSettings</c>) and composite/fixed-position fields that the wizard renders in a set spot.</summary>
    private IEnumerable<string> MovableKeysForStep(int step) =>
        fieldSettings
            .Where(f => f.Step == step
                        && fieldFragments.ContainsKey(f.FieldKey)
                        && !SupplierFieldSettingService.FixedPositionKeys.Contains(f.FieldKey))
            .OrderBy(f => f.Sequence)
            .ThenBy(f => CanonicalIndex(f.FieldKey))
            .Select(f => f.FieldKey);

    /// <summary>The tab (step) a field is currently assigned to, so validation rules pinned to a
    /// specific field follow it when an admin moves it to another tab. Falls back to the given step
    /// when the field has been removed/hidden from the settings list.</summary>
    private int StepOf(string fieldKey, int fallback) =>
        fieldSettings.FirstOrDefault(f => f.FieldKey == fieldKey)?.Step ?? fallback;
