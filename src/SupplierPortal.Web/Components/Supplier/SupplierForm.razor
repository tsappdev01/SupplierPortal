    fieldFragments["VatCodeId"] = @<div class="di-field @FieldClass("VatCodeId")">
        <label>VAT Code@(Req("VatCodeId"))</label>
        <InputSelect @bind-Value="formModel.VatCodeId">
            <option value="">— Select —</option>
            @foreach (var lov in vatCodes)
            {
                <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["DunsNumber"] = @<div class="di-field @FieldClass("DunsNumber")">
        <label>D-U-N-S Number@(Req("DunsNumber"))</label>
        <InputText @bind-Value="formModel.DunsNumber" />
    </div>;
    fieldFragments["IsOneTimeSupplier"] = @<div class="di-checkbox-row">
        <div class="di-checkbox-item @FieldClass("IsOneTimeSupplier")">
            <InputCheckbox @bind-Value="formModel.IsOneTimeSupplier" id="oneTime" />
            <label for="oneTime" style="margin:0;">One-time supplier</label>
        </div>
    </div>;

    fieldFragments["AddressName"] = @<div class="di-field @FieldClass("AddressName")">
        <label>Address Name@(Req("AddressName"))</label>
        <InputText @bind-Value="formModel.AddressName" />
    </div>;
    fieldFragments["AddressLine1"] = @<div class="di-field di-full @FieldClass("AddressLine1")">
        <label>Address Line 1@(Req("AddressLine1"))@Help("AddressLine1")</label>
        <InputText @bind-Value="formModel.AddressLine1" />
    </div>;
    fieldFragments["AddressLine2"] = @<div class="di-field di-full @FieldClass("AddressLine2")">
        <label>Address Line 2@(Req("AddressLine2"))@Help("AddressLine2")</label>
        <InputText @bind-Value="formModel.AddressLine2" />
    </div>;
    fieldFragments["CountryId"] = @<div class="di-field @FieldClass("CountryId")">
        <label>Country@(Req("CountryId"))@Help("CountryId")</label>
        <InputSelect @bind-Value="formModel.CountryId">
            <option value="">— Select —</option>
            @foreach (var lov in countries)
            {
                <option value="@lov.Id">@lov.Code - @lov.DisplayName</option>
            }
        </InputSelect>
    </div>;
    fieldFragments["CityId"] = @<div class="di-field @FieldClass("CityId")">
        <label>City / Emirate<span class="di-req">*</span>@Help("CityId")</label>
        @if (IsUaeCountry)
        {
            <InputSelect @bind-Value="formModel.CityId">
                <option value="">— Select Emirate —</option>
                @foreach (var lov in provinces)
                {
                    <option value="@lov.Id">@lov.DisplayName</option>
