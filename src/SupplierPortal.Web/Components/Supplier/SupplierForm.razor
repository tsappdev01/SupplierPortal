    private string? originalAccountNumber;

    private List<BankBranch> SelectedBankBranches =>
        banks.FirstOrDefault(b => b.Id == formModel.BankId)?.Branches ?? [];

    private List<SupplierDocument> OtherDocuments =>
        documents.Where(d => d.DocumentType == SupplierDocumentType.Other).ToList();

    private SupplierDocument? GetDocument(SupplierDocumentType type) =>
        documents.FirstOrDefault(d => d.DocumentType == type);

    protected override async Task OnInitializedAsync()
    {
        taxOrgTypes = await SupplierService.GetLookupsAsync(LookupCategory.TaxOrganizationType);
        supplierTypes = await SupplierService.GetLookupsAsync(LookupCategory.SupplierType);
        countries = await SupplierService.GetLookupsAsync(LookupCategory.Country);
        countriesWithPhoneCode = countries.Where(c => !string.IsNullOrWhiteSpace(c.PhoneCode)).ToList();
        businessRelationships = await SupplierService.GetLookupsAsync(LookupCategory.BusinessRelationship);
        provinces = await SupplierService.GetLookupsAsync(LookupCategory.Province);
        vatCodes = await SupplierService.GetLookupsAsync(LookupCategory.VatCode);
        paymentMethods = await SupplierService.GetLookupsAsync(LookupCategory.PaymentMethod);
        paymentTerms = await SupplierService.GetLookupsAsync(LookupCategory.PaymentTerms);
        prefixes = await SupplierService.GetLookupsAsync(LookupCategory.Prefix);
        communicationMethods = await SupplierService.GetLookupsAsync(LookupCategory.CommunicationMethod);
        currencies = await SupplierService.GetLookupsAsync(LookupCategory.Currency);
        banks = await SupplierService.GetBanksAsync();
        businessUnits = await BusinessUnitService.GetAllAsync();

        fieldSettings = await SupplierFieldSettingService.GetAllAsync();
        mandatoryKeys = fieldSettings.Where(f => f.IsMandatory).Select(f => f.FieldKey).ToHashSet();
        hiddenFromSupplierKeys = fieldSettings.Where(f => !f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();

        // Remember the bank account as loaded, to detect a supplier adding/changing a bank account.
        originalBankId = Supplier.BankId;
        originalAccountNumber = Supplier.AccountNumber;

        formModel = SupplierFormModel.FromSupplier(Supplier);

        if (IsCreateMode && Supplier.Id == 0)
        {
            var uae = countries.FirstOrDefault(c => c.DisplayName.Contains("United Arab Emirates", StringComparison.OrdinalIgnoreCase));
            formModel.CountryId ??= uae?.Id;
            formModel.CountryNameId ??= uae?.Id;
            formModel.AccountCountryCodeId ??= uae?.Id;
            var phoneUae = countriesWithPhoneCode.FirstOrDefault(c => c.PhoneCode == "971");
            formModel.PhoneCountryCodeId ??= phoneUae?.Id;
            formModel.PhoneAreaCode ??= "04";
            formModel.ProcurementBuId ??= Supplier.BusinessUnitId;
            formModel.ClientBuId ??= Supplier.BusinessUnitId;
            formModel.BillToBuId ??= Supplier.BusinessUnitId;
            formModel.SupplierSiteBuId ??= Supplier.BusinessUnitId;
        }
        else
        {
            maxStepReached = 4;
        }

        if (Supplier.Id != 0)
        {
            documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
            changedFieldKeys = await SupplierService.GetPendingSupplierEditedFieldsAsync(Supplier.Id);
        }
    }

    /// <summary>CSS class for a field wrapper: highlights it green when its current value came from a
    /// supplier self-service edit that an admin hasn't reviewed (saved over) yet, and hides it
    /// entirely when the form is supplier-facing and the field is marked not visible to suppliers.</summary>
    private string FieldClass(string fieldKey)
    {
        var classes = "";
        if (changedFieldKeys.Contains(fieldKey))
        {
            classes = "di-field-changed";
        }
        if (SupplierFacing && hiddenFromSupplierKeys.Contains(fieldKey))
        {
            classes = string.IsNullOrEmpty(classes) ? "di-hidden-field" : classes + " di-hidden-field";
        }
        return classes;
    }

    private bool IsHiddenFromSupplier(string fieldKey) => SupplierFacing && hiddenFromSupplierKeys.Contains(fieldKey);

    private bool BankAccountChanged() =>
        formModel.BankId != originalBankId ||
        !string.Equals((formModel.AccountNumber ?? "").Trim(), (originalAccountNumber ?? "").Trim(), StringComparison.Ordinal);

    private bool HasBankConfirmationLetter() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.BankConfirmationLetter);

    /// <summary>A Trade License document is mandatory before a supplier can be submitted.</summary>
    private bool HasTradeLicenseDocument() =>
        documents.Any(d => d.DocumentType == SupplierDocumentType.TradeLicense);

    /// <summary>A Bank Confirmation Letter must be attached when an existing (already-submitted)
    /// supplier changes/adds a bank account. Drafts (initial registration) are exempt.</summary>
    private bool RequiresBankConfirmationLetter() =>
        Supplier.Id != 0 && !Supplier.IsDraft && BankAccountChanged() && !HasBankConfirmationLetter();

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e, SupplierDocumentType documentType)
    {
        if (Supplier.Id == 0)
        {
            return;
        }

        if (e.File.Size > 10 * 1024 * 1024)
        {
            ToastService.ShowError($"'{e.File.Name}' is {e.File.Size / (1024 * 1024)} MB, over the 10 MB limit. Please attach a smaller file.");
            return;
        }

        uploadingDocument = true;
        try
        {
        var result = await SupplierDocumentService.UploadAsync(Supplier.Id, documentType, e.File, CurrentUser);

        if (!result.Success)
        {
            ToastService.ShowError(result.Error ?? "Upload failed.");
            uploadingDocument = false;
            return;
        }

        var message = $"'{e.File.Name}' uploaded successfully.";
        if (result.ExtractedNumber is not null)
        {
            if (documentType == SupplierDocumentType.VatCertification)
            {
                formModel.TaxRegistrationNumber = result.ExtractedNumber;
                message += $" Tax Registration Number '{result.ExtractedNumber}' was read from the document and filled in.";
            }
            else if (documentType == SupplierDocumentType.TradeLicense)
            {
                formModel.TradeLicenseNumber = result.ExtractedNumber;
                message += $" Trade License Number '{result.ExtractedNumber}' was read from the document and filled in.";
            }
        }

        if (documentType == SupplierDocumentType.TradeLicense && result.DunsNumber is not null)
        {
            formModel.DunsNumber = result.DunsNumber;
            message += $" D-U-N-S Number '{result.DunsNumber}' was read from the document and filled in.";
        }

        ToastService.ShowSuccess(message);
        documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
        }
        catch (Exception)
        {
            // A failure (oversized stream, transient error) shows a message instead of an unhandled
            // circuit error that looks like the upload silently did nothing.
            ToastService.ShowError($"Could not upload '{e.File.Name}'. The file may be too large or in an unsupported format. Please try again.");
        }
        finally { uploadingDocument = false; }
    }

    private async Task ViewDocumentAsync(int documentId)
    {
        // Only documents attached to this supplier can be viewed.
        if (documents.All(d => d.Id != documentId))
        {
            return;
        }

        viewingDocument = true;
        try
        {
            await CloseViewer();
            var file = await SupplierDocumentService.GetFileAsync(documentId);
            if (file is null)
            {
                ToastService.ShowError("Could not open the document. Please try again.");
                return;
            }
            viewerUrl = await JS.InvokeAsync<string>("ssDoc.makeUrl", file.Value.Bytes, file.Value.ContentType);
            viewerName = file.Value.FileName;
        }
        catch (Exception)
        {
            ToastService.ShowError("Could not open the document. Please try again.");
        }
        finally { viewingDocument = false; }
    }

    private async Task CloseViewer()
    {
        if (viewerUrl is not null)
        {
            try { await JS.InvokeVoidAsync("ssDoc.revoke", viewerUrl); } catch { /* ignore */ }
            viewerUrl = null;
            viewerName = null;
        }
    }

    private async Task RemoveDocumentAsync(int documentId)
    {
        var (success, error) = await SupplierDocumentService.DeleteAsync(documentId, CurrentUser);
        if (success)
        {
            ToastService.ShowSuccess("Document removed.");
            documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
        }
        else
        {
            ToastService.ShowError(error ?? "Could not remove the document.");
        }
    }

    private RenderFragment Req(string fieldKey) => builder =>
    {
        if (mandatoryKeys.Contains(fieldKey))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "di-req");
            builder.AddContent(2, "*");
            builder.CloseElement();
        }
    };

    private void OnBankChanged()
    {
        formModel.BankBranchId = null;
    }

    private void GoToStep(int step)
    {
        if (step <= maxStepReached)
        {
            currentStep = step;
        }
    }

    private void Back()
    {
        currentStep = Math.Max(1, currentStep - 1);
    }

    /// <summary>Email fields shown on each wizard step, with their display label, so their format can
    /// be validated with a regular expression regardless of whether they are marked mandatory.</summary>
    private static readonly Dictionary<int, (string Key, string Label)[]> EmailFieldsByStep = new()
    {
        [1] = [("Email", "Business E-Mail")],
        [3] = [("RemitAdviceEmail", "Remit Advice Email")],
        [4] = [("ContactEmail", "Contact Email"), ("CommunicationEmail", "Communication Email"), ("RemittanceEmail", "Remittance E-mail")]
    };

    private static readonly System.ComponentModel.DataAnnotations.EmailAddressAttribute EmailValidator = new();

    private List<string> ValidateStep(SupplierFormModel model, int step)
    {
        var errors = new List<string>();
        foreach (var setting in fieldSettings.Where(f => f.Step == step && f.IsMandatory && !IsHiddenFromSupplier(f.FieldKey)))
        {
            var property = typeof(SupplierFormModel).GetProperty(setting.FieldKey);
            var value = property?.GetValue(model);
            if (IsEmpty(value))
            {
                errors.Add($"{setting.DisplayLabel} is required.");
            }
        }

        // Validate the format of any email field on this step that has a value (a required-but-empty
        // email is already reported above; here we catch entries that are present but malformed).
        if (EmailFieldsByStep.TryGetValue(step, out var emailFields))
        {
            foreach (var (key, label) in emailFields)
            {
                if (IsHiddenFromSupplier(key))
                {
                    continue;
                }
                var value = typeof(SupplierFormModel).GetProperty(key)?.GetValue(model) as string;
                if (!string.IsNullOrWhiteSpace(value) && !EmailValidator.IsValid(value))
                {
                    errors.Add($"{label} is not a valid email address.");
                }
            }
        }

        return errors;
    }

    private static bool IsEmpty(object? value) => value switch
    {
        null => true,
        string s => string.IsNullOrWhiteSpace(s),
        _ => false
    };

    private async Task PersistAsync()
    {
        formModel.ApplyTo(Supplier);

        await Loading.RunAsync(async () =>
        {
            if (PersistOverride is not null)
            {
                await PersistOverride(Supplier);
                return;
            }

            if (Supplier.Id == 0)
            {
                Supplier.SupplierNumber = await SupplierService.GenerateSupplierNumberAsync(Supplier.BusinessUnitId);
                Supplier.CreatedBy = CurrentUser;
                await SupplierService.CreateAsync(Supplier, CurrentUser);
                formModel.SupplierNumber = Supplier.SupplierNumber;
            }
            else
            {
                await SupplierService.UpdateAsync(Supplier, CurrentUser, AccessTokenId);
            }
        });
    }

    private async Task NextAsync()
    {
        var errors = ValidateStep(formModel, currentStep);
        if (errors.Count > 0)
        {
            errorMessage = string.Join(" ", errors);
            return;
        }

        if (currentStep == 3 && RequiresBankConfirmationLetter())
        {
            errorMessage = "A Bank Confirmation Letter must be attached because the bank account was changed.";
            return;
        }

        errorMessage = null;
        isSaving = true;
        try
        {
            await PersistAsync();
            if (Supplier.Id != 0)
            {
                documents = await SupplierDocumentService.GetDocumentsAsync(Supplier.Id);
            }
            currentStep++;
            maxStepReached = Math.Max(maxStepReached, currentStep);
        }
        catch (Exception ex)
        {
            errorMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAsDraftAsync()
    {
        var errors = ValidateStep(formModel, 4);
        if (errors.Count > 0)
        {
            errorMessage = string.Join(" ", errors);
            return;
        }

        errorMessage = null;
        Supplier.IsDraft = true;
        await FinishAsync();
    }

    private async Task SubmitForApprovalAsync()
    {
        var errors = Enumerable.Range(1, 4).SelectMany(step => ValidateStep(formModel, step)).ToList();
        if (errors.Count > 0)
        {
            for (var step = 1; step <= 4; step++)
            {
                if (ValidateStep(formModel, step).Count > 0)
                {
                    currentStep = step;
                    maxStepReached = Math.Max(maxStepReached, step);
                    break;
                }
            }

            errorMessage = "Complete all required fields before submitting: " + string.Join(" ", errors);
            return;
        }

        if (!HasTradeLicenseDocument())
        {
            currentStep = 1;
            errorMessage = "A Trade License document must be attached before submitting.";
            return;
        }

        if (RequiresBankConfirmationLetter())
        {
            currentStep = 3;
            maxStepReached = Math.Max(maxStepReached, 3);
            errorMessage = "A Bank Confirmation Letter must be attached because the bank account was changed.";
            return;
        }

        errorMessage = null;
        Supplier.IsDraft = false;
        await FinishAsync();
    }

    private async Task FinishAsync()
    {
        isSaving = true;
        try
        {
            await PersistAsync();
            await OnComplete.InvokeAsync(Supplier);
        }
        catch (Exception ex)
        {
            errorMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
