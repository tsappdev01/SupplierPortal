@code {
    private enum SupplierTab { RecentlyUpdated, UpdatedLastWeek, EverythingElse }

    // "Generate Template" dialog state.
    private bool showTemplateDialog;
    private bool templatePopulate;
    private int templateBuId;
    private bool generatingTemplate;
    private string templateProgress = "";

    private void OpenTemplateDialog()
    {
        templatePopulate = false;
        templateBuId = filterBusinessUnitId;
        generatingTemplate = false;
        showTemplateDialog = true;
    }

    private void CloseTemplateDialog()
    {
        if (generatingTemplate)
        {
            return;
        }
        showTemplateDialog = false;
    }

    /// <summary>Builds the template server-side (showing progress) and hands the finished file to the
    /// browser via JS, so the user sees a spinner while a populated template is being generated.</summary>
    private async Task DownloadTemplateAsync()
    {
        if (generatingTemplate)
        {
            return;
        }

        generatingTemplate = true;
        try
        {
            List<Supplier> suppliers = [];
            if (templatePopulate)
            {
                templateProgress = "Loading supplier data…";
                StateHasChanged();

                suppliers = await SupplierService.GetSuppliersAsync(
                    AccessBusinessUnitIds(templateBuId), assignedToUserId: AssigneeScope, visibleToDepartmentId: DepartmentScope);
            }

            templateProgress = templatePopulate
                ? $"Generating template for {suppliers.Count} supplier(s)…"
                : "Generating template…";
            StateHasChanged();

            // Offload the CPU-bound workbook build so the spinner renders while it runs.
            var bytes = await Task.Run(() => ExportService.ExportToExcelUploadTemplate(suppliers));
            var fileName = templatePopulate ? "Supplier Template (Populated).xlsx" : "Supplier Template (Blank).xlsx";

            templateProgress = "Preparing download…";
            StateHasChanged();

            await JS.InvokeVoidAsync("ssDoc.download", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));

            generatingTemplate = false;
            showTemplateDialog = false;
        }
        finally
        {
            generatingTemplate = false;
        }
    }

    private static readonly System.ComponentModel.DataAnnotations.EmailAddressAttribute EmailValidator = new();

    // How many rows to show per page; admin-configurable via Settings > Supplier Fields.
    private int pageSize = 50;

    private List<SupplierListItem> suppliers = [];
    private bool initialLoad = true;
    private List<BusinessUnit> businessUnits = [];
    private bool isAdministrator;
    private int? currentUserId;
    private int? currentDepartmentId;
    private List<Department> departments = [];
    private List<int> userBusinessUnitIds = [];

    /// <summary>Assignee scope for list/export queries: null for administrators (no restriction); for a
    /// normal user, their own id — falling back to -1 (match nothing) if the id can't be resolved, so a
    /// missing id never leaks the full list.</summary>
    private int? AssigneeScope => isAdministrator ? null : (currentUserId ?? -1);

    /// <summary>Department scope: null for administrators; the normal user's own department (so they also
    /// see their department's suppliers). Null when the user has no department.</summary>
    private int? DepartmentScope => isAdministrator ? null : currentDepartmentId;

    /// <summary>Whether the user sees every business unit's suppliers. Only an administrator with NO
    /// business-unit assignment is org-wide; a user (administrator or not) assigned to specific
    /// business units is scoped to those, matching the "Business Unit(s)" access on their account.</summary>
    private bool SeesAllBusinessUnits => isAdministrator && userBusinessUnitIds.Count == 0;

    private int filterBusinessUnitId;
    private string supplierNameFilter = "";
    private string statusFilter = "";   // default: "All Statuses"
    private string priorityFilter = ""; // default: "All Priorities"
    private string assignedFilter = ""; // default: "All Assignees"; "unassigned" or a user id
    private SupplierTab activeTab = SupplierTab.RecentlyUpdated;
    private string currentUser = "unknown";
    private int? notifyingSupplierId;
    private SupplierListItem? confirmNotifySupplier;

    private static string SupplierInitials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
    }

    private void RequestNotify(SupplierListItem supplier) => confirmNotifySupplier = supplier;
    private void CancelNotify() => confirmNotifySupplier = null;

    private async Task ConfirmNotifyAsync()
    {
        var supplier = confirmNotifySupplier;
        confirmNotifySupplier = null;
        if (supplier is not null)
        {
            await NotifyAsync(supplier);
        }
    }
    private int currentPage = 1;
    private HashSet<int> selectedIds = [];
    private bool bulkSending;
    private string? bulkDepartmentId;

    // Business Unit filter is a custom dropdown so each option can show the BU logo before its name.
    private bool buDropdownOpen;

    // Attached-documents viewer modal (available on every row/status; enabled only when documents exist).
    private bool showDocsModal;
    private int docsSupplierId;
    private string docsSupplierName = "";
    private List<SupplierDocument> modalDocuments = [];
    private int modalDocIndex;
    private bool modalDocsLoading;
    // Tracks which document previews (img/iframe) have finished loading, so each card shows a "Loading
    // preview…" spinner until its own preview is ready.
    private readonly HashSet<int> previewLoaded = [];
    private void MarkPreviewLoaded(int docId) { previewLoaded.Add(docId); }
    private ElementReference docsViewerRef;
    private bool focusDocsPending;

    // Download progress: files are streamed via JS so the user sees a live progress bar, both for the
    // "Download all (zip)" button and each single-document Download. Only one download runs at a time, so a
    // single set of progress fields is shared; zipDownloading vs downloadingDocId says which UI to light up.
    private bool zipDownloading;
    private int? downloadingDocId;
    private int dlPercent;
    private string dlReceivedText = "";
    private string dlTotalText = "";
    private DotNetObjectReference<Dashboard>? dlDotNetRef;

    private string SelectedBuLabel => filterBusinessUnitId == 0
        ? (SeesAllBusinessUnits ? "All Business Units" : "All My Business Units")
        : businessUnits.FirstOrDefault(b => b.Id == filterBusinessUnitId)?.Name ?? "";

    // Human-readable scope for the "Notify" action, matching the current business-unit filter: a single
    // subsidiary when one is selected, otherwise all subsidiaries in view. The supplier list itself is
    // already filtered to this scope, so the notification only ever reaches suppliers in it.
    private string NotifyScopeLabel => filterBusinessUnitId == 0
        ? (SeesAllBusinessUnits ? "all subsidiaries" : "all your business units")
        : SelectedBuLabel;

    // Suppliers matching the selected workflow-status, priority and assignee filters (empty = all).
    private IEnumerable<SupplierListItem> StatusFiltered =>
        suppliers
            .Where(s => string.IsNullOrEmpty(statusFilter) || s.StatusName == statusFilter)
            .Where(s => string.IsNullOrEmpty(priorityFilter) || s.Priority == priorityFilter)
            .Where(MatchesAssignedFilter);

    private bool MatchesAssignedFilter(SupplierListItem s) => assignedFilter switch
    {
        "" => true,
        "unassigned" => s.AssignedToUserId is null,
        var v when int.TryParse(v, out var uid) => s.AssignedToUserId == uid,
        _ => true
    };

    private IEnumerable<SupplierListItem> TabFilteredSuppliers => activeTab switch
    {
        SupplierTab.RecentlyUpdated => StatusFiltered.Where(IsRecentlyUpdated),
        SupplierTab.UpdatedLastWeek => StatusFiltered.Where(IsUpdatedLastWeek),
        _ => StatusFiltered.Where(IsEverythingElse)
    };

    // Sort by priority (P1 → P2 → P3, then unset), keeping most-recently-updated first within each.
    private IEnumerable<SupplierListItem> SortedSuppliers =>
        TabFilteredSuppliers.OrderBy(s => PriorityRank(s.Priority)).ThenByDescending(EffectiveUpdated);

    private static int PriorityRank(string? priority) => priority switch
    {
        "P1" => 1,
        "P2" => 2,
        "P3" => 3,
        _ => 4
    };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TabFilteredSuppliers.Count() / (double)pageSize));

    private List<SupplierListItem> PagedSuppliers =>
        SortedSuppliers.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private bool AllOnPageSelected => PagedSuppliers.Count > 0 && PagedSuppliers.All(s => selectedIds.Contains(s.Id));

    private int CountByStatus(string statusName) => suppliers.Count(s => s.StatusName == statusName);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdministrator = state.User.IsAdministrator();
        userBusinessUnitIds = state.User.GetBusinessUnitIds();
        currentUser = state.User.Identity?.Name ?? "unknown";
        // Non-administrators see the suppliers assigned to them or owned by their department; administrators
        // see the full list (scoped to their business units) so they can review and assign.
        var uid = state.User.GetUserId();
        currentUserId = uid > 0 ? uid : null;
        departments = await UserService.GetDepartmentsAsync();
        if (currentUserId is int meId)
        {
            currentDepartmentId = (await UserService.GetByIdAsync(meId))?.DepartmentId;
        }

        var allBusinessUnits = await BusinessUnitService.GetAllAsync();
        businessUnits = SeesAllBusinessUnits
            ? allBusinessUnits
            : allBusinessUnits.Where(b => userBusinessUnitIds.Contains(b.Id)).ToList();

        pageSize = await SupplierFieldSettingService.GetListPageSizeAsync();
        assignableUsers = await UserService.GetSupplierAssignableUsersAsync();

        await ReloadAsync();
    }

    // Active users with Supplier portal access (each with their Business Units) that a supplier can be
    // assigned to. Scoped per row to the supplier's own Business Unit.
    private List<User> assignableUsers = [];

    /// <summary>Users assignable to this supplier: active Supplier-portal users in the supplier's Business
    /// Unit. The currently-assigned user is always included so the dropdown reflects the saved value even
    /// if their access/BU later changed.</summary>
    private IEnumerable<User> AssignableFor(SupplierListItem supplier) =>
        assignableUsers
            .Where(u => u.BusinessUnits.Any(b => b.Id == supplier.BusinessUnitId)
                        || u.Id == supplier.AssignedToUserId)
            .OrderBy(u => u.FullName ?? u.Username);

    private async Task AssignAsync(SupplierListItem supplier, string? value)
    {
        int? userId = int.TryParse(value, out var id) ? id : null;
        if (supplier.AssignedToUserId == userId)
        {
            return;
        }
        await SupplierService.AssignAsync(supplier.Id, userId, currentUser);
        supplier.AssignedToUserId = userId;
        supplier.AssignedToUserName = userId is null
            ? null
            : assignableUsers.Where(u => u.Id == userId).Select(u => u.FullName ?? u.Username).FirstOrDefault();
        var who = userId is null ? "unassigned" : $"assigned to {supplier.AssignedToUserName}";
        ToastService.ShowSuccess($"{supplier.SupplierName} {who}.");
    }

    private async Task AssignDepartmentAsync(SupplierListItem supplier, string? value)
    {
        int? departmentId = int.TryParse(value, out var id) ? id : null;
        if (supplier.DepartmentId == departmentId)
        {
            return;
        }
        await SupplierService.AssignDepartmentAsync(supplier.Id, departmentId, currentUser);
        supplier.DepartmentId = departmentId;
        supplier.DepartmentName = departmentId is null ? null : departments.FirstOrDefault(d => d.Id == departmentId)?.Name;
        ToastService.ShowSuccess(departmentId is null
            ? $"{supplier.SupplierName} department removed."
            : $"{supplier.SupplierName} assigned to {supplier.DepartmentName}.");
    }

    /// <summary>Business-unit scope for access queries. Administrators (and non-admins for their department
    /// branch) are scoped to their assigned business units — an explicit picker choice narrows to that unit,
    /// otherwise it is all their units (or null = all, for an administrator with none assigned). For a
    /// non-administrator the service combines this with the department scope as one branch of an OR whose
    /// other branch is "assigned to me directly", which bypasses the business-unit scope.</summary>
    private IReadOnlyCollection<int>? AccessBusinessUnitIds(int explicitBuId)
        => explicitBuId != 0
            ? new[] { explicitBuId }
            : (SeesAllBusinessUnits ? null : userBusinessUnitIds);

    private async Task ReloadAsync()
    {
        await Loading.RunAsync(async () =>
        {
            suppliers = await SupplierService.GetSupplierListAsync(
                AccessBusinessUnitIds(filterBusinessUnitId), supplierNameFilter, AssigneeScope, DepartmentScope);
        });
        initialLoad = false;
        currentPage = 1;
        selectedIds.Clear();
    }

    private void SetTab(SupplierTab tab)
    {
        activeTab = tab;
        currentPage = 1;
        // Clear any bulk selection so a bulk action can't hit rows that are no longer in the visible tab.
        selectedIds.Clear();
    }

    private void OnStatusFilterChanged()
    {
        currentPage = 1;
        selectedIds.Clear();
    }

    private void OnPriorityFilterChanged()
    {
        currentPage = 1;
        selectedIds.Clear();
    }

    private void OnAssignedFilterChanged()
    {
        currentPage = 1;
        selectedIds.Clear();
    }

    private void GoToPage(int newPage)
    {
        currentPage = Math.Clamp(newPage, 1, TotalPages);
    }

    private void ToggleSelected(int supplierId)
    {
        if (!selectedIds.Add(supplierId))
        {
            selectedIds.Remove(supplierId);
        }
    }

    private void ToggleSelectAllOnPage()
    {
        if (AllOnPageSelected)
        {
            foreach (var supplier in PagedSuppliers)
            {
                selectedIds.Remove(supplier.Id);
            }
        }
        else
        {
            foreach (var supplier in PagedSuppliers)
            {
                selectedIds.Add(supplier.Id);
            }
        }
    }

    private void ClearSelection() => selectedIds.Clear();

    private void ToggleBuDropdown() => buDropdownOpen = !buDropdownOpen;
    private void CloseBuDropdown() => buDropdownOpen = false;

    private async Task SelectBuAsync(int businessUnitId)
    {
        buDropdownOpen = false;
        filterBusinessUnitId = businessUnitId;
        await ReloadAsync();
    }

    private static bool IsImage(SupplierDocument document) =>
        document.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static string SplitDocType(SupplierDocumentType type) =>
        System.Text.RegularExpressions.Regex.Replace(type.ToString(), "(?<!^)([A-Z])", " $1");

    private async Task ShowDocumentsAsync(SupplierListItem supplier)
    {
        showDocsModal = true;
        docsSupplierId = supplier.Id;
        docsSupplierName = supplier.SupplierName;
        modalDocIndex = 0;
        modalDocuments = [];
        previewLoaded.Clear();
        modalDocsLoading = true;
        StateHasChanged();

        modalDocuments = await SupplierDocumentService.GetDocumentsAsync(supplier.Id);
        modalDocsLoading = false;
        focusDocsPending = true;
    }

    /// <summary>Opens the "combine images into one PDF" view — but only when the supplier actually has image
    /// attachments. Otherwise it shows a friendly toast instead of navigating to the endpoint, which would
    /// render a raw "no image attachments" message in a blank browser tab.</summary>
    private async Task OpenImagesPdfAsync()
    {
        if (!modalDocuments.Any(IsImage))
        {
            ToastService.ShowInfo("This supplier has no image attachments (e.g. scans/photos) to combine into a PDF.");
            return;
        }
        await JS.InvokeVoidAsync("open", $"/suppliers/{docsSupplierId}/documents.pdf", "_blank");
    }

    private void CloseDocsModal() => showDocsModal = false;
    private void ModalPrevDoc() { if (modalDocIndex > 0) { modalDocIndex--; } }
    private void ModalNextDoc() { if (modalDocIndex < modalDocuments.Count - 1) { modalDocIndex++; } }

    /// <summary>Streams the "download all" zip via JS so the user sees a live progress bar. The JS calls
    /// back into the <see cref="OnDownloadProgress"/>/<see cref="OnDownloadComplete"/>/<see cref="OnDownloadError"/>
    /// methods below.</summary>
    private async Task DownloadAllZipAsync()
    {
        if (zipDownloading || downloadingDocId is not null) { return; }
        zipDownloading = true;
        BeginDownloadState(preparing: true); // "Preparing…" until the first bytes (server builds the archive).
        try
        {
            await JS.InvokeVoidAsync("ssDoc.downloadWithProgress",
                $"/suppliers/{docsSupplierId}/documents.zip",
                $"supplier-{docsSupplierId}.zip",
                dlDotNetRef);
        }
        catch
        {
            zipDownloading = false;
            ToastService.ShowError("Could not start the download. Please try again.");
        }
    }

    /// <summary>Streams a single document via JS so its Download button shows the same live progress.</summary>
    private async Task DownloadDocAsync(SupplierDocument doc)
    {
        if (zipDownloading || downloadingDocId is not null) { return; }
        downloadingDocId = doc.Id;
        BeginDownloadState(preparing: false); // a single file streams immediately, so start at 0%.
        try
        {
            await JS.InvokeVoidAsync("ssDoc.downloadWithProgress",
                $"/suppliers/documents/{doc.Id}?download=1",
                string.IsNullOrWhiteSpace(doc.FileName) ? $"document-{doc.Id}" : doc.FileName,
                dlDotNetRef);
        }
        catch
        {
            downloadingDocId = null;
            ToastService.ShowError("Could not start the download. Please try again.");
        }
    }

    private void BeginDownloadState(bool preparing)
    {
        dlPercent = preparing ? -1 : 0;
        dlReceivedText = "";
        dlTotalText = "";
        dlDotNetRef ??= DotNetObjectReference.Create(this);
    }

    [JSInvokable]
    public Task OnDownloadProgress(int percent, long received, long total)
    {
        dlPercent = percent;
        dlReceivedText = FormatBytes(received);
        dlTotalText = total > 0 ? FormatBytes(total) : "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnDownloadComplete(string fileName)
    {
        zipDownloading = false;
        downloadingDocId = null;
        dlPercent = 100;
        ToastService.ShowSuccess($"Downloaded {fileName}");
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnDownloadError(string message)
    {
        zipDownloading = false;
        downloadingDocId = null;
        ToastService.ShowError(string.IsNullOrWhiteSpace(message) ? "Download failed." : message);
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Human-readable size for the download progress label (KB up to 1 MB, then MB).</summary>
    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) { return "0 KB"; }
        double kb = bytes / 1024d;
        return kb < 1024 ? $"{kb:0} KB" : $"{kb / 1024:0.0} MB";
    }

    public void Dispose() => dlDotNetRef?.Dispose();

    private async Task ModalPrintAsync(int documentId) =>
        await JS.InvokeVoidAsync("printImageUrl", $"/suppliers/documents/{documentId}");

    private void OnDocsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight" || e.Key == "PageDown") { ModalNextDoc(); }
        else if (e.Key == "ArrowLeft" || e.Key == "PageUp") { ModalPrevDoc(); }
        else if (e.Key == "Escape") { CloseDocsModal(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDocsPending)
        {
            focusDocsPending = false;
            try { await docsViewerRef.FocusAsync(); } catch { /* element not ready; harmless */ }
        }
    }

    private static bool HasValidEmail(SupplierListItem supplier) =>
        !string.IsNullOrWhiteSpace(supplier.ContactEmail) && EmailValidator.IsValid(supplier.ContactEmail);

    private async Task BulkNotifyAsync()
    {
        bulkSending = true;
        StateHasChanged();

        var selected = suppliers.Where(s => selectedIds.Contains(s.Id) && !s.IsDraft).ToList();

        // Skip suppliers that have no valid Contact Email rather than counting them as failures.
        var skipped = selected.Count(s => !HasValidEmail(s));
        var targets = selected.Where(HasValidEmail).ToList();

        var sent = 0;
        var failed = 0;
        await Loading.RunAsync(async () =>
        {
            foreach (var supplier in targets)
            {
                var (success, _) = await SupplierEmailService.NotifySupplierAsync(
                    supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);
                if (success)
                {
                    sent++;
                }
                else
                {
                    failed++;
                }
            }
        });

        var summary = $"{sent} email(s) sent.";
        if (skipped > 0)
        {
            summary += $" {skipped} skipped (no valid email).";
        }
        if (failed > 0)
        {
            summary += $" {failed} failed to send.";
        }

        if (failed > 0)
        {
            ToastService.ShowError(summary);
        }
        else if (sent == 0)
        {
            ToastService.ShowWarning(summary);
        }
        else
        {
            ToastService.ShowSuccess(summary);
        }

        selectedIds.Clear();
        bulkSending = false;
    }

    private async Task BulkAssignDepartmentAsync()
    {
        if (selectedIds.Count == 0)
        {
            return;
        }

        int? departmentId = int.TryParse(bulkDepartmentId, out var id) ? id : null;
        var ids = suppliers.Where(s => selectedIds.Contains(s.Id)).Select(s => s.Id).ToList();

        bulkSending = true;
        StateHasChanged();

        var changed = 0;
        await Loading.RunAsync(async () =>
        {
            changed = await SupplierService.BulkAssignDepartmentAsync(ids, departmentId, currentUser);
        });

        // Reflect the new department locally so the grid updates without a full reload.
        var departmentName = departmentId is null ? null : departments.FirstOrDefault(d => d.Id == departmentId)?.Name;
        foreach (var supplier in suppliers.Where(s => selectedIds.Contains(s.Id)))
        {
            supplier.DepartmentId = departmentId;
            supplier.DepartmentName = departmentName;
        }

        if (changed == 0)
        {
            ToastService.ShowInfo("No suppliers changed (already set to that department).");
        }
        else
        {
            ToastService.ShowSuccess(departmentId is null
                ? $"Removed department from {changed} supplier(s)."
                : $"{changed} supplier(s) assigned to {departmentName}.");
        }

        selectedIds.Clear();
        bulkSending = false;
    }

    private async Task NotifyAsync(SupplierListItem supplier)
    {
        notifyingSupplierId = supplier.Id;
        StateHasChanged();

        if (!HasValidEmail(supplier))
        {
            ToastService.ShowWarning($"{supplier.SupplierName} was skipped — no valid Contact Email on file.");
            notifyingSupplierId = null;
            return;
        }

        var (success, error) = await SupplierEmailService.NotifySupplierAsync(
            supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);

        if (success)
        {
            ToastService.ShowSuccess($"1 email sent to {supplier.ContactEmail}.");
        }
        else
        {
            ToastService.ShowError($"Could not send notification: {error}");
        }

        notifyingSupplierId = null;
    }

    private async Task NotifyAllAsync()
    {
        var candidates = suppliers.Where(s => !s.IsDraft).ToList();
        var toSend = candidates.Where(HasValidEmail).ToList();
        var skipped = candidates.Count - toSend.Count;

        if (toSend.Count == 0)
        {
            ToastService.ShowWarning("No suppliers with a valid Contact Email to notify.");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Send a review notification email to {toSend.Count} supplier(s) in {NotifyScopeLabel}?" + (skipped > 0 ? $" ({skipped} without a valid email will be skipped.)" : ""));
        if (!confirmed)
        {
            return;
        }

        bulkSending = true;
        StateHasChanged();

        var sent = 0;
        var failed = 0;
        await Loading.RunAsync(async () =>
        {
            foreach (var supplier in toSend)
            {
                var (success, _) = await SupplierEmailService.NotifySupplierAsync(
                    supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);
                if (success)
                {
                    sent++;
                }
                else
                {
                    failed++;
                }
            }
        });

        var summary = $"{sent} email(s) sent.";
        if (skipped > 0)
        {
            summary += $" {skipped} skipped (no valid email).";
        }
        if (failed > 0)
        {
            summary += $" {failed} failed to send.";
        }

        if (failed > 0)
        {
            ToastService.ShowError(summary);
        }
        else
        {
            ToastService.ShowSuccess(summary);
        }

        bulkSending = false;
        await ReloadAsync();
    }

    private async Task MarkCompleteAsync(SupplierListItem supplier)
    {
        await SupplierService.MarkCompleteAsync(supplier.Id, currentUser);

        // Notify the supplier that their registration is finalised with a thank-you email.
        var (emailed, emailError) = await SupplierEmailService.NotifySupplierCompletedAsync(
            supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, supplier.BusinessUnitId);

        if (emailed)
        {
            ToastService.ShowSuccess($"{supplier.SupplierName} marked Complete — thank-you email sent to {supplier.ContactEmail}.");
        }
        else
        {
            ToastService.ShowWarning($"{supplier.SupplierName} marked Complete, but the thank-you email was not sent: {emailError}");
        }

        await ReloadAsync();
    }

    private static string WorkflowBadgeClass(string? statusName) => statusName switch
    {
        SupplierStatuses.New => "bg-secondary",
        SupplierStatuses.AwaitingSupplierResponse => "bg-info text-dark",
        SupplierStatuses.Complete => "bg-success",
        _ => "bg-light text-dark"
    };

    // ---- Print (choose columns, print every row in the active tab) ----

    private sealed class PrintColumn
    {
        public string Label = "";
        public Func<SupplierListItem, string> Value = _ => "";
        public bool Default;
        public bool Selected;
    }

    private bool showPrintDialog;
    private List<PrintColumn> printColumns = [];

    private string ActiveTabLabel => activeTab switch
    {
        SupplierTab.RecentlyUpdated => "Recently Updated",
        SupplierTab.UpdatedLastWeek => "Updated Last Week",
        _ => "Everything Else"
    };

    private void EnsurePrintColumns()
    {
        if (printColumns.Count > 0) { return; }
        printColumns =
        [
            new() { Label = "Supplier Number", Value = s => s.SupplierNumber, Default = true },
            new() { Label = "Priority", Value = s => s.Priority ?? "", Default = true },
            new() { Label = "Supplier Name", Value = s => s.SupplierName, Default = true },
            new() { Label = "Full Name", Value = s => s.FullName, Default = true },
            new() { Label = "Contact Email", Value = s => s.ContactEmail ?? "", Default = true },
            new() { Label = "Status", Value = s => s.StatusName ?? "", Default = true },
            new() { Label = "Assigned To", Value = s => s.AssignedToUserName ?? "", Default = true },
            new() { Label = "Department", Value = s => s.DepartmentName ?? "", Default = true },
            new() { Label = "Tax Organization Type", Value = s => s.TaxOrganizationTypeName ?? "" },
            new() { Label = "Supplier Type", Value = s => s.SupplierTypeName ?? "" },
            new() { Label = "Tax Registration Number", Value = s => s.TaxRegistrationNumber ?? "" },
            new() { Label = "Trade License Number", Value = s => s.TradeLicenseNumber ?? "" },
            new() { Label = "Last Updated", Value = s => (s.UpdatedAt ?? s.CreatedAt).ToString("dd MMM yyyy") },
        ];
        SelectDefaultPrintColumns();
    }

    private void OpenPrintDialog() { EnsurePrintColumns(); showPrintDialog = true; }
    private void ClosePrintDialog() => showPrintDialog = false;
    private void SelectAllPrintColumns() { foreach (var c in printColumns) { c.Selected = true; } }
    private void ClearPrintColumns() { foreach (var c in printColumns) { c.Selected = false; } }
    private void SelectDefaultPrintColumns() { foreach (var c in printColumns) { c.Selected = c.Default; } }

    private async Task DoPrintAsync()
    {
        var cols = printColumns.Where(c => c.Selected).ToList();
        if (cols.Count == 0)
        {
            ToastService.ShowInfo("Please select at least one column to print.");
            return;
        }
        var rows = SortedSuppliers.ToList();
        var html = BuildPrintHtml(cols, rows);
        showPrintDialog = false;
        await JS.InvokeVoidAsync("printHtml", html);
    }

    /// <summary>Builds a standalone, print-ready HTML report (chosen columns × every row in the active tab).
    /// Orientation and font size adapt to the number of columns so wide selections stay legible.</summary>
    private string BuildPrintHtml(List<PrintColumn> cols, List<SupplierListItem> rows)
    {
        static string Esc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
        var landscape = cols.Count > 5;
        var fontSize = cols.Count <= 6 ? "11px" : cols.Count <= 9 ? "9.5px" : "8.5px";

        var sb = new System.Text.StringBuilder();
        sb.Append("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Manage Supplier</title><style>");
        sb.Append($"@page{{size:A4 {(landscape ? "landscape" : "portrait")};margin:12mm;}}");
        sb.Append($"*{{box-sizing:border-box;}}body{{font-family:'Segoe UI',Arial,sans-serif;color:#1a2233;font-size:{fontSize};margin:0;}}");
        sb.Append(".hd{display:flex;align-items:flex-end;justify-content:space-between;border-bottom:2px solid #caa04d;padding-bottom:8px;margin-bottom:12px;}");
        sb.Append(".hd h1{font-size:20px;color:#0b2545;margin:0;}");
        sb.Append(".hd .meta{font-size:10px;color:#6b7280;text-align:right;}");
        sb.Append("table{width:100%;border-collapse:collapse;}");
        sb.Append("th,td{border:1px solid #d3dae6;padding:4px 6px;text-align:left;vertical-align:top;word-break:break-word;}");
        sb.Append("th{background:#0b2545;color:#fff;font-weight:600;}");
        sb.Append("tr:nth-child(even) td{background:#f6f8fb;}");
        sb.Append("</style></head><body>");
        sb.Append("<div class=\"hd\"><h1>Manage Supplier</h1><div class=\"meta\">");
        sb.Append($"{Esc(ActiveTabLabel)} &middot; {rows.Count} supplier(s)<br>Generated {Esc(DateTime.Now.ToString("dd MMM yyyy HH:mm"))}");
        sb.Append("</div></div>");
        sb.Append("<table><thead><tr>");
        foreach (var c in cols) { sb.Append($"<th>{Esc(c.Label)}</th>"); }
        sb.Append("</tr></thead><tbody>");
        foreach (var s in rows)
        {
            sb.Append("<tr>");
            foreach (var c in cols) { sb.Append($"<td>{Esc(c.Value(s))}</td>"); }
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table></body></html>");
        return sb.ToString();
    }

    private string ExportUrl(string format)
    {
        var query = new List<string>();
        if (filterBusinessUnitId != 0)
        {
            query.Add($"businessUnitId={filterBusinessUnitId}");
        }
        if (!string.IsNullOrEmpty(statusFilter))
        {
            query.Add($"status={Uri.EscapeDataString(statusFilter)}");
        }
        return query.Count > 0 ? $"/export/{format}?{string.Join("&", query)}" : $"/export/{format}";
    }

    private static DateTime EffectiveUpdated(SupplierListItem supplier) => supplier.UpdatedAt ?? supplier.CreatedAt;

    private static bool IsRecentlyUpdated(SupplierListItem supplier) => EffectiveUpdated(supplier) >= DateTime.UtcNow.AddDays(-3);

    private static bool IsUpdatedLastWeek(SupplierListItem supplier)
    {
        var updated = EffectiveUpdated(supplier);
        return updated < DateTime.UtcNow.AddDays(-3) && updated >= DateTime.UtcNow.AddDays(-7);
    }

    private static bool IsEverythingElse(SupplierListItem supplier) => EffectiveUpdated(supplier) < DateTime.UtcNow.AddDays(-7);
}
