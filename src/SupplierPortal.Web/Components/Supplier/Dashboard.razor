@page "/supplier/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject SupplierService SupplierService
@inject BusinessUnitService BusinessUnitService
@inject SupplierEmailService SupplierEmailService
@inject SupplierFieldSettingService SupplierFieldSettingService
@inject ToastService ToastService
@inject LoadingService Loading
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Manage Supplier - Supplier Portal</PageTitle>

<h1>Manage Supplier</h1>

<div class="di-stat-row no-print">
    <div class="di-stat-tile di-stat-total">
        <div class="di-stat-value">@suppliers.Count</div>
        <div class="di-stat-label">Total Suppliers</div>
    </div>
    <div class="di-stat-tile di-stat-new">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.New)</div>
        <div class="di-stat-label">Not Submitted</div>
    </div>
    <div class="di-stat-tile di-stat-await">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.AwaitingSupplierResponse)</div>
        <div class="di-stat-label">Awaiting Supplier Response</div>
    </div>
    <div class="di-stat-tile di-stat-review">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.ForReview)</div>
        <div class="di-stat-label">For Review</div>
    </div>
    <div class="di-stat-tile di-stat-complete">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.Complete)</div>
        <div class="di-stat-label">Completes</div>
    </div>
</div>

<div class="d-flex gap-2 mb-3 no-print align-items-center">
    <a class="di-export-btn" href="@ExportUrl("csv")" title="Export to CSV" aria-label="Export to CSV">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="3" width="34" height="46" rx="4" fill="#ffffff" stroke="#2e7d32" stroke-width="2.5" />
            <path d="M30 3h9v9z" fill="#a5d6a7" stroke="#2e7d32" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 15h16M12 21h16M12 27h9" stroke="#a5d6a7" stroke-width="2" stroke-linecap="round" />
            <rect x="5" y="33" width="34" height="15" rx="3" fill="#2e7d32" />
            <text x="22" y="44.5" font-family="Arial, sans-serif" font-size="10.5" font-weight="800" fill="#ffffff" text-anchor="middle">CSV</text>
        </svg>
        <span>CSV</span>
    </a>
    <a class="di-export-btn" href="@ExportUrl("pdf")" title="Export to PDF" aria-label="Export to PDF">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="3" width="34" height="46" rx="4" fill="#ffffff" stroke="#c62828" stroke-width="2.5" />
            <path d="M30 3h9v9z" fill="#ef9a9a" stroke="#c62828" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 15h16M12 21h16M12 27h9" stroke="#ef9a9a" stroke-width="2" stroke-linecap="round" />
            <rect x="5" y="33" width="34" height="15" rx="3" fill="#c62828" />
            <text x="22" y="44.5" font-family="Arial, sans-serif" font-size="10.5" font-weight="800" fill="#ffffff" text-anchor="middle">PDF</text>
        </svg>
        <span>PDF</span>
    </a>
    <button type="button" class="di-export-btn" @onclick="PrintAsync" title="Print" aria-label="Print">
        <svg width="28" height="30" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 6h20v11H14z" fill="#ffffff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round" />
            <rect x="7" y="16" width="34" height="17" rx="3.5" fill="#607d8b" />
            <rect x="14" y="29" width="20" height="13" rx="1.5" fill="#ffffff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M18 34h12M18 38h8" stroke="#455a64" stroke-width="2" stroke-linecap="round" />
            <circle cx="35" cy="22" r="2.2" fill="#c8e6c9" />
        </svg>
        <span>Print</span>
    </button>
    <button class="btn btn-info text-white ms-auto" disabled="@bulkSending" @onclick="NotifyAllAsync">
        @if (bulkSending)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <text> Sending...</text>
        }
        else
        {
            <text>Notify All Suppliers</text>
        }
    </button>
    <a class="btn btn-primary" href="/supplier/register">Register Supplier</a>
    <a class="btn btn-di-gold" href="/supplier/upload">Upload Supplier Data</a>
</div>

<div class="row g-2 mb-3 no-print">
    @if (businessUnits.Count > 1 || isAdministrator)
    {
        <div class="col-auto" style="min-width: 240px;">
            <label class="form-label">Business Unit</label>
            <select class="form-select" @bind="filterBusinessUnitId" @bind:after="ReloadAsync">
                <option value="0">@(isAdministrator ? "All Business Units" : "All My Business Units")</option>
                @foreach (var businessUnit in businessUnits)
                {
                    <option value="@businessUnit.Id">@businessUnit.Name</option>
                }
            </select>
        </div>
    }
    <div class="col-auto" style="min-width: 240px;">
        <label class="form-label">Supplier Name</label>
        <input class="form-control" @bind="supplierNameFilter" @bind:event="oninput" @bind:after="ReloadAsync" placeholder="Search by name..." />
    </div>
    <div class="col-auto" style="min-width: 220px;">
        <label class="form-label">Status</label>
        <select class="form-select" @bind="statusFilter" @bind:after="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            @foreach (var status in SupplierStatuses.All)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
</div>

<ul class="nav nav-tabs no-print mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.RecentlyUpdated ? "active" : "")" @onclick="() => SetTab(SupplierTab.RecentlyUpdated)">
            Recently Updated (@StatusFiltered.Count(IsRecentlyUpdated))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.UpdatedLastWeek ? "active" : "")" @onclick="() => SetTab(SupplierTab.UpdatedLastWeek)">
            Updated Last Week (@StatusFiltered.Count(IsUpdatedLastWeek))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.EverythingElse ? "active" : "")" @onclick="() => SetTab(SupplierTab.EverythingElse)">
            Everything Else (@StatusFiltered.Count(IsEverythingElse))
        </button>
    </li>
</ul>

@if (selectedIds.Count > 0)
{
    <div class="di-bulk-bar no-print">
        <span>@selectedIds.Count selected</span>
        <button class="btn btn-sm btn-primary" disabled="@bulkSending" @onclick="BulkNotifyAsync">
            @if (bulkSending)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <text> Sending...</text>
            }
            else
            {
                <text>Send Notification to Selected</text>
            }
        </button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@bulkSending" @onclick="ClearSelection">Clear Selection</button>
    </div>
}

@if (suppliers.Count > 0 && TotalPages > 1)
{
    <div class="d-flex align-items-center gap-2 no-print mb-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
        <span>Page @currentPage of @TotalPages (@TabFilteredSuppliers.Count() suppliers)</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
    </div>
}

<div style="overflow-x: auto;">
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th class="no-print"><input type="checkbox" checked="@AllOnPageSelected" @onchange="ToggleSelectAllOnPage" /></th>
            <th>Supplier Number</th>
            <th>Supplier Name</th>
            <th>First Name</th>
            <th>Contact Email</th>
            <th>Status</th>
            <th class="no-print">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in PagedSuppliers)
        {
            <tr>
                <td class="no-print"><input type="checkbox" checked="@selectedIds.Contains(supplier.Id)" @onchange="() => ToggleSelected(supplier.Id)" /></td>
                <td>@supplier.SupplierNumber</td>
                <td>
                    @supplier.SupplierName
                    @if (supplier.PendingSupplierChangeCount > 0)
                    {
                        <a href="/supplier/edit/@supplier.Id" class="di-bell" title="@($"{supplier.PendingSupplierChangeCount} change(s) submitted by the supplier awaiting review")">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2ZM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.375 3.632-.116.687-.257 1.382-.42 1.941-.169.588-.107 1.045.109 1.376.204.313.606.593 1.36.783C7.19 15.24 9.786 15.24 12.326 13.732c.754-.19 1.156-.47 1.36-.783.216-.331.278-.788.109-1.376a13.24 13.24 0 0 1-.42-1.94C13.134 8.196 13 6.628 13 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917Z" />
                            </svg>
                            @supplier.PendingSupplierChangeCount
                        </a>
                    }
                </td>
                <td>@supplier.FirstName</td>
                <td>@supplier.ContactEmail</td>
                <td>
                    @if (!string.IsNullOrEmpty(supplier.StatusName))
                    {
                        <span class="badge @WorkflowBadgeClass(supplier.StatusName)">@supplier.StatusName</span>
                    }
                </td>
                <td class="no-print">
                    <a class="btn btn-sm btn-outline-primary" href="/supplier/edit/@supplier.Id" title="@(supplier.IsDraft ? "Continue editing" : "Edit")">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10ZM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5Zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5ZM3.51 10.658l-1.8 4.5 1.8-4.5.001 0Z" />
                        </svg>
                    </a>
                    @if (!supplier.IsDraft)
                    {
                        <button class="btn btn-sm btn-outline-secondary" title="Notify supplier via email"
                                disabled="@(notifyingSupplierId == supplier.Id)" @onclick="() => NotifyAsync(supplier)">
                            @if (notifyingSupplierId == supplier.Id)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z" />
                                </svg>
                            }
                        </button>
                        @if (supplier.StatusName == SupplierStatuses.ForReview)
                        {
                            <button class="btn btn-sm btn-outline-success" title="Mark review complete" @onclick="() => MarkCompleteAsync(supplier)">
                                Mark Complete
                            </button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (suppliers.Count == 0)
{
    <p><em>No supplier data yet. Use "Register Supplier" or "Upload Supplier Data" to add records.</em></p>
}
else if (TotalPages > 1)
{
    <div class="d-flex align-items-center gap-2 no-print">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
        <span>Page @currentPage of @TotalPages (@TabFilteredSuppliers.Count() suppliers)</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
    }

    .di-stat-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
    }

    .di-stat-tile {
        background: #fff;
        border: 1px solid #e2e5ea;
        border-top: 3px solid var(--di-navy, #1a2233);
        border-radius: 10px;
        padding: 1.0rem 1.4rem;
        min-width: 160px;
    }

    .di-stat-value {
        font-size: 1.9rem;
        font-weight: 700;
        color: #1a2233;
        line-height: 1.2;
    }

    /* Corporate colour accents per workflow status */
    .di-stat-total { border-top-color: #1a2233; }
    .di-stat-total .di-stat-value { color: #1a2233; }

    .di-stat-new { border-top-color: #6c757d; }
    .di-stat-new .di-stat-value { color: #6c757d; }

    .di-stat-await { border-top-color: #2f80b5; }
    .di-stat-await .di-stat-value { color: #2f80b5; }

    .di-stat-review { border-top-color: #c8a24a; }
    .di-stat-review .di-stat-value { color: #a8842f; }

    .di-stat-complete { border-top-color: #2e7d46; }
    .di-stat-complete .di-stat-value { color: #2e7d46; }

    .di-stat-label {
        font-size: 0.8rem;
        color: #7b8697;
        margin-top: 0.15rem;
    }

    .di-bulk-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #eef1ff;
        border: 1px solid #c7d0f7;
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 12px;
    }

    .di-bell {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        margin-left: 6px;
        color: #b5892f;
        text-decoration: none;
        font-size: 0.85em;
        font-weight: 700;
    }

    .di-bell:hover {
        color: #8a6a1f;
    }
</style>

@code {
    private enum SupplierTab { RecentlyUpdated, UpdatedLastWeek, EverythingElse }

    private static readonly System.ComponentModel.DataAnnotations.EmailAddressAttribute EmailValidator = new();

    // How many rows to show per page; admin-configurable via Settings > Supplier Fields.
    private int pageSize = 50;

    private List<SupplierListItem> suppliers = [];
    private List<BusinessUnit> businessUnits = [];
    private bool isAdministrator;
    private List<int> userBusinessUnitIds = [];
    private int filterBusinessUnitId;
    private string supplierNameFilter = "";
    private string statusFilter = SupplierStatuses.New;   // default: "Not Submitted"
    private SupplierTab activeTab = SupplierTab.RecentlyUpdated;
    private string currentUser = "unknown";
    private int? notifyingSupplierId;
    private int currentPage = 1;
    private HashSet<int> selectedIds = [];
    private bool bulkSending;

    // Suppliers matching the selected workflow-status filter (empty = all statuses).
    private IEnumerable<SupplierListItem> StatusFiltered =>
        string.IsNullOrEmpty(statusFilter) ? suppliers : suppliers.Where(s => s.StatusName == statusFilter);

    private IEnumerable<SupplierListItem> TabFilteredSuppliers => activeTab switch
    {
        SupplierTab.RecentlyUpdated => StatusFiltered.Where(IsRecentlyUpdated),
        SupplierTab.UpdatedLastWeek => StatusFiltered.Where(IsUpdatedLastWeek),
        _ => StatusFiltered.Where(IsEverythingElse)
    };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TabFilteredSuppliers.Count() / (double)pageSize));

    private List<SupplierListItem> PagedSuppliers =>
        TabFilteredSuppliers.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private bool AllOnPageSelected => PagedSuppliers.Count > 0 && PagedSuppliers.All(s => selectedIds.Contains(s.Id));

    private int CountByStatus(string statusName) => suppliers.Count(s => s.StatusName == statusName);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdministrator = state.User.IsAdministrator();
        userBusinessUnitIds = state.User.GetBusinessUnitIds();
        currentUser = state.User.Identity?.Name ?? "unknown";

        var allBusinessUnits = await BusinessUnitService.GetAllAsync();
        businessUnits = isAdministrator
            ? allBusinessUnits
            : allBusinessUnits.Where(b => userBusinessUnitIds.Contains(b.Id)).ToList();

        pageSize = await SupplierFieldSettingService.GetListPageSizeAsync();

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        List<int>? businessUnitIds;
        if (filterBusinessUnitId != 0)
        {
            businessUnitIds = [filterBusinessUnitId];
        }
        else
        {
            businessUnitIds = isAdministrator ? null : userBusinessUnitIds;
        }

        await Loading.RunAsync(async () =>
        {
            suppliers = await SupplierService.GetSupplierListAsync(businessUnitIds, supplierNameFilter);
        });
        currentPage = 1;
        selectedIds.Clear();
    }

    private void SetTab(SupplierTab tab)
    {
        activeTab = tab;
        currentPage = 1;
    }

    private void OnStatusFilterChanged()
    {
        currentPage = 1;
        selectedIds.Clear();
    }

    private void GoToPage(int newPage)
    {
        currentPage = Math.Clamp(newPage, 1, TotalPages);
    }

    private void ToggleSelected(int supplierId)
    {
        if (!selectedIds.Add(supplierId))
        {
            selectedIds.Remove(supplierId);
        }
    }

    private void ToggleSelectAllOnPage()
    {
        if (AllOnPageSelected)
        {
            foreach (var supplier in PagedSuppliers)
            {
                selectedIds.Remove(supplier.Id);
            }
        }
        else
        {
            foreach (var supplier in PagedSuppliers)
            {
                selectedIds.Add(supplier.Id);
            }
        }
    }

    private void ClearSelection() => selectedIds.Clear();

    private static bool HasValidEmail(SupplierListItem supplier) =>
        !string.IsNullOrWhiteSpace(supplier.ContactEmail) && EmailValidator.IsValid(supplier.ContactEmail);

    private async Task BulkNotifyAsync()
    {
        bulkSending = true;
        StateHasChanged();

        var selected = suppliers.Where(s => selectedIds.Contains(s.Id) && !s.IsDraft).ToList();

        // Skip suppliers that have no valid Contact Email rather than counting them as failures.
        var skipped = selected.Count(s => !HasValidEmail(s));
        var targets = selected.Where(HasValidEmail).ToList();

        var sent = 0;
        var failed = 0;
        await Loading.RunAsync(async () =>
        {
            foreach (var supplier in targets)
            {
                var (success, _) = await SupplierEmailService.NotifySupplierAsync(
                    supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);
                if (success)
                {
                    sent++;
                }
                else
                {
                    failed++;
                }
            }
        });

        var summary = $"{sent} email(s) sent.";
        if (skipped > 0)
        {
            summary += $" {skipped} skipped (no valid email).";
        }
        if (failed > 0)
        {
            summary += $" {failed} failed to send.";
        }

        if (failed > 0)
        {
            ToastService.ShowError(summary);
        }
        else if (sent == 0)
        {
            ToastService.ShowWarning(summary);
        }
        else
        {
            ToastService.ShowSuccess(summary);
        }

        selectedIds.Clear();
        bulkSending = false;
    }

    private async Task NotifyAsync(SupplierListItem supplier)
    {
        notifyingSupplierId = supplier.Id;
        StateHasChanged();

        if (!HasValidEmail(supplier))
        {
            ToastService.ShowWarning($"{supplier.SupplierName} was skipped — no valid Contact Email on file.");
            notifyingSupplierId = null;
            return;
        }

        var (success, error) = await SupplierEmailService.NotifySupplierAsync(
            supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);

        if (success)
        {
            ToastService.ShowSuccess($"1 email sent to {supplier.ContactEmail}.");
        }
        else
        {
            ToastService.ShowError($"Could not send notification: {error}");
        }

        notifyingSupplierId = null;
    }

    private async Task NotifyAllAsync()
    {
        var candidates = suppliers.Where(s => !s.IsDraft).ToList();
        var toSend = candidates.Where(HasValidEmail).ToList();
        var skipped = candidates.Count - toSend.Count;

        if (toSend.Count == 0)
        {
            ToastService.ShowWarning("No suppliers with a valid Contact Email to notify.");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Send a review notification email to {toSend.Count} supplier(s)?" + (skipped > 0 ? $" ({skipped} without a valid email will be skipped.)" : ""));
        if (!confirmed)
        {
            return;
        }

        bulkSending = true;
        StateHasChanged();

        var sent = 0;
        var failed = 0;
        await Loading.RunAsync(async () =>
        {
            foreach (var supplier in toSend)
            {
                var (success, _) = await SupplierEmailService.NotifySupplierAsync(
                    supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);
                if (success)
                {
                    sent++;
                }
                else
                {
                    failed++;
                }
            }
        });

        var summary = $"{sent} email(s) sent.";
        if (skipped > 0)
        {
            summary += $" {skipped} skipped (no valid email).";
        }
        if (failed > 0)
        {
            summary += $" {failed} failed to send.";
        }

        if (failed > 0)
        {
            ToastService.ShowError(summary);
        }
        else
        {
            ToastService.ShowSuccess(summary);
        }

        bulkSending = false;
        await ReloadAsync();
    }

    private async Task MarkCompleteAsync(SupplierListItem supplier)
    {
        await SupplierService.MarkCompleteAsync(supplier.Id, currentUser);
        ToastService.ShowSuccess($"{supplier.SupplierName} marked Complete.");
        await ReloadAsync();
    }

    private static string WorkflowBadgeClass(string? statusName) => statusName switch
    {
        SupplierStatuses.New => "bg-secondary",
        SupplierStatuses.AwaitingSupplierResponse => "bg-info text-dark",
        SupplierStatuses.ForReview => "bg-warning text-dark",
        SupplierStatuses.Complete => "bg-success",
        _ => "bg-light text-dark"
    };

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("print");
    }

    private string ExportUrl(string format)
    {
        return filterBusinessUnitId != 0
            ? $"/export/{format}?businessUnitId={filterBusinessUnitId}"
            : $"/export/{format}";
    }

    private static DateTime EffectiveUpdated(SupplierListItem supplier) => supplier.UpdatedAt ?? supplier.CreatedAt;

    private static bool IsRecentlyUpdated(SupplierListItem supplier) => EffectiveUpdated(supplier) >= DateTime.UtcNow.AddDays(-3);

    private static bool IsUpdatedLastWeek(SupplierListItem supplier)
    {
        var updated = EffectiveUpdated(supplier);
        return updated < DateTime.UtcNow.AddDays(-3) && updated >= DateTime.UtcNow.AddDays(-7);
    }

    private static bool IsEverythingElse(SupplierListItem supplier) => EffectiveUpdated(supplier) < DateTime.UtcNow.AddDays(-7);
}
