@page "/supplier/dashboard"
@attribute [Authorize(Policy = "Portal.Supplier")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject SupplierService SupplierService
@inject BusinessUnitService BusinessUnitService
@inject SupplierDocumentService SupplierDocumentService
@inject SupplierEmailService SupplierEmailService
@inject SupplierFieldSettingService SupplierFieldSettingService
@inject ExportService ExportService
@inject ToastService ToastService
@inject LoadingService Loading
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Manage Supplier - Supplier Portal</PageTitle>

<h1>Manage Supplier</h1>

<div class="di-stat-row no-print">
    <div class="di-stat-tile di-stat-total">
        <div class="di-stat-value">@suppliers.Count</div>
        <div class="di-stat-label">Total Suppliers</div>
    </div>
    <div class="di-stat-tile di-stat-new">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.New)</div>
        <div class="di-stat-label">Not Submitted</div>
    </div>
    <div class="di-stat-tile di-stat-await">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.AwaitingSupplierResponse)</div>
        <div class="di-stat-label">Awaiting Supplier Response</div>
    </div>
    <div class="di-stat-tile di-stat-review">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.ForReview)</div>
        <div class="di-stat-label">For Review</div>
    </div>
    <div class="di-stat-tile di-stat-complete">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.Complete)</div>
        <div class="di-stat-label">Completed</div>
    </div>
</div>

<div class="d-flex gap-2 mb-3 no-print align-items-center">
    <a class="di-export-btn" href="@ExportUrl("xlsx")" title="Export to Excel (Supplier Data Template)" aria-label="Export to Excel">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="3" width="34" height="46" rx="4" fill="#ffffff" stroke="#2e7d32" stroke-width="2.5" />
            <path d="M30 3h9v9z" fill="#a5d6a7" stroke="#2e7d32" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 15h16M12 21h16M12 27h9" stroke="#a5d6a7" stroke-width="2" stroke-linecap="round" />
            <rect x="5" y="33" width="34" height="15" rx="3" fill="#2e7d32" />
            <text x="22" y="44.5" font-family="Arial, sans-serif" font-size="10.5" font-weight="800" fill="#ffffff" text-anchor="middle">XLS</text>
        </svg>
        <span>Excel</span>
    </a>
    <a class="di-export-btn" href="@ExportUrl("xlsx-full")" title="Export to Excel — all supplier fields" aria-label="Export all fields to Excel">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="3" width="34" height="46" rx="4" fill="#ffffff" stroke="#1b5e20" stroke-width="2.5" />
            <path d="M30 3h9v9z" fill="#a5d6a7" stroke="#1b5e20" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 15h16M12 21h16M12 27h16M12 33h9" stroke="#a5d6a7" stroke-width="2" stroke-linecap="round" />
            <rect x="5" y="37" width="34" height="12" rx="3" fill="#1b5e20" />
            <text x="22" y="46.5" font-family="Arial, sans-serif" font-size="8.5" font-weight="800" fill="#ffffff" text-anchor="middle">ALL</text>
        </svg>
        <span>Excel (All Fields)</span>
    </a>
    <button type="button" class="di-export-btn" @onclick="OpenTemplateDialog" title="Generate a supplier upload template" aria-label="Generate supplier template">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="3" width="34" height="46" rx="4" fill="#ffffff" stroke="#1565c0" stroke-width="2.5" />
            <path d="M30 3h9v9z" fill="#90caf9" stroke="#1565c0" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 16h16M12 22h16M12 28h16M12 34h9" stroke="#90caf9" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Generate Template</span>
    </button>
    <a class="di-export-btn" href="@ExportUrl("pdf")" title="Export to PDF" aria-label="Export to PDF">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="3" width="34" height="46" rx="4" fill="#ffffff" stroke="#c62828" stroke-width="2.5" />
            <path d="M30 3h9v9z" fill="#ef9a9a" stroke="#c62828" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 15h16M12 21h16M12 27h9" stroke="#ef9a9a" stroke-width="2" stroke-linecap="round" />
            <rect x="5" y="33" width="34" height="15" rx="3" fill="#c62828" />
            <text x="22" y="44.5" font-family="Arial, sans-serif" font-size="10.5" font-weight="800" fill="#ffffff" text-anchor="middle">PDF</text>
        </svg>
        <span>PDF</span>
    </a>
    <button type="button" class="di-export-btn" @onclick="PrintAsync" title="Print" aria-label="Print">
        <svg width="28" height="30" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 6h20v11H14z" fill="#ffffff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round" />
            <rect x="7" y="16" width="34" height="17" rx="3.5" fill="#607d8b" />
            <rect x="14" y="29" width="20" height="13" rx="1.5" fill="#ffffff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M18 34h12M18 38h8" stroke="#455a64" stroke-width="2" stroke-linecap="round" />
            <circle cx="35" cy="22" r="2.2" fill="#c8e6c9" />
        </svg>
        <span>Print</span>
    </button>
    <button type="button" class="di-action-btn is-notify ms-auto" disabled="@bulkSending" @onclick="NotifyAllAsync"
            title="@($"Email a review notification to suppliers in {NotifyScopeLabel}")" aria-label="Notify suppliers in the selected business unit">
        @if (bulkSending)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Sending...</span>
        }
        else
        {
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2.5" y="4.5" width="19" height="14" rx="2.5" fill="#e3f6fb" stroke="#0aa2c0" stroke-width="1.7" />
                <path d="M3.5 6.5 12 12.5l8.5-6" stroke="#0aa2c0" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="19.5" cy="6" r="3.4" fill="#0aa2c0" stroke="#fff" stroke-width="1.2" />
                <path d="M19.5 4.4v3.2M17.9 6h3.2" stroke="#fff" stroke-width="1.2" stroke-linecap="round" />
            </svg>
            <span>@(filterBusinessUnitId == 0 ? "Notify All Suppliers" : $"Notify Suppliers in {SelectedBuLabel}")</span>
        }
    </button>
    <a class="di-action-btn is-register" href="/supplier/register" title="Register a new supplier" aria-label="Register supplier">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="9.5" cy="8" r="3.6" fill="#e6ebf7" stroke="#1a2233" stroke-width="1.7" />
            <path d="M3.5 20c0-3.6 2.7-6 6-6s6 2.4 6 6" fill="#e6ebf7" stroke="#1a2233" stroke-width="1.7" stroke-linecap="round" />
            <circle cx="18.5" cy="16.5" r="4.5" fill="#1a2233" />
            <path d="M18.5 14.3v4.4M16.3 16.5h4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span>Register Supplier</span>
    </a>
    <a class="di-action-btn is-upload" href="/supplier/upload" title="Bulk-upload suppliers from an Excel file" aria-label="Upload supplier data">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 19.5a4 4 0 0 1-.6-7.96 5.5 5.5 0 0 1 10.8-1.06A3.75 3.75 0 0 1 18.5 19.5H6Z" fill="#faf1d8" stroke="#a8842f" stroke-width="1.7" stroke-linejoin="round" />
            <path d="M12 16.5V9m0 0-2.6 2.6M12 9l2.6 2.6" stroke="#a8842f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Upload Supplier Data</span>
    </a>
</div>

@if (showTemplateDialog)
{
    <div class="di-tmpl-backdrop" @onclick="CloseTemplateDialog">
        <div class="di-tmpl-modal" @onclick:stopPropagation>
            <h5 class="di-tmpl-title">Generate Supplier Template</h5>
            <p class="di-tmpl-text">
                Download an Excel template for the business to fill in and re-upload. On upload,
                duplicate suppliers (by Supplier Number) are detected and skipped automatically.
            </p>
            <label class="di-tmpl-radio">
                <input type="radio" name="tmplMode" checked="@(!templatePopulate)" @onchange="() => templatePopulate = false" />
                <span>Blank template (headers only)</span>
            </label>
            <label class="di-tmpl-radio">
                <input type="radio" name="tmplMode" checked="@templatePopulate" @onchange="() => templatePopulate = true" />
                <span>Populate with existing supplier data</span>
            </label>
            @if (templatePopulate)
            {
                <div class="di-tmpl-field">
                    <label>Business Unit</label>
                    <select @bind="templateBuId">
                        <option value="0">@(SeesAllBusinessUnits ? "All Business Units" : "All My Business Units")</option>
                        @foreach (var bu in businessUnits)
                        {
                            <option value="@bu.Id">@bu.Name</option>
                        }
                    </select>
                </div>
            }
            @if (generatingTemplate)
            {
                <div class="di-tmpl-progress">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>@templateProgress</span>
                </div>
            }
            <div class="di-tmpl-actions">
                <button type="button" class="di-btn di-btn-secondary" @onclick="CloseTemplateDialog" disabled="@generatingTemplate">Cancel</button>
                <button type="button" class="di-btn di-btn-primary" @onclick="DownloadTemplateAsync" disabled="@generatingTemplate">
                    @if (generatingTemplate)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Generating…</span>
                    }
                    else
                    {
                        <span>Download</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (rejectTarget is not null)
{
    <div class="di-tmpl-backdrop" @onclick="CloseRejectDialog">
        <div class="di-tmpl-modal" @onclick:stopPropagation>
            <h5 class="di-tmpl-title">Reject Supplier</h5>
            <p class="di-tmpl-text">Rejecting <strong>@rejectTarget.SupplierName</strong> sends it back for correction. Add remarks explaining what needs to change.</p>
            <div class="di-tmpl-field">
                <label>Review Remarks</label>
                <textarea rows="4" @bind="rejectRemarks" placeholder="Describe the issues to be corrected…"></textarea>
            </div>
            <div class="di-tmpl-actions">
                <button type="button" class="di-btn di-btn-secondary" @onclick="CloseRejectDialog" disabled="@rejecting">Cancel</button>
                <button type="button" class="di-btn di-btn-primary" @onclick="ConfirmRejectAsync" disabled="@(rejecting || string.IsNullOrWhiteSpace(rejectRemarks))">
                    @if (rejecting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Rejecting…</span>
                    }
                    else
                    {
                        <span>Reject &amp; Send Back</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .di-tmpl-backdrop { position: fixed; inset: 0; background: rgba(15,22,35,0.55); display: flex; align-items: center; justify-content: center; z-index: 1080; padding: 24px; }
    .di-tmpl-modal { background: #fff; border-radius: 10px; width: min(460px, 100%); padding: 22px 24px; box-shadow: 0 12px 40px rgba(0,0,0,0.35); }
    .di-tmpl-title { margin: 0 0 6px; font-size: 18px; font-weight: 700; color: #1a2233; }
    .di-tmpl-text { margin: 0 0 16px; font-size: 13.5px; color: #6b7280; }
    .di-tmpl-radio { display: flex; align-items: center; gap: 8px; padding: 8px 0; font-size: 14.5px; color: #26303f; cursor: pointer; }
    .di-tmpl-field { margin: 10px 0 4px; display: flex; flex-direction: column; gap: 5px; }
    .di-tmpl-field label { font-size: 13px; font-weight: 600; color: #46618f; }
    .di-tmpl-field select, .di-tmpl-field textarea { padding: 9px 11px; border: 1px solid #e2e5ea; border-radius: 8px; font-size: 15px; color: #1a2233; background: #fff; font-family: inherit; }
    .di-tmpl-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
    .di-tmpl-progress { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 13.5px; color: #46618f; }
    .di-reject-remarks { margin-top: 4px; font-size: 12px; color: #b91c1c; max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>

<div class="row g-2 mb-3 no-print">
    @if (businessUnits.Count > 1 || isAdministrator)
    {
        <div class="col-auto" style="min-width: 260px;">
            <label class="form-label">Business Unit</label>
            <div class="di-bu-select">
                <button type="button" class="form-select di-bu-toggle" @onclick="ToggleBuDropdown">
                    @if (filterBusinessUnitId != 0)
                    {
                        <img src="/business-units/@filterBusinessUnitId/logo" alt="" class="di-bu-opt-logo" onerror="this.style.display='none'" />
                    }
                    <span class="di-bu-text">@SelectedBuLabel</span>
                    <span class="di-bu-caret">&#9662;</span>
                </button>
                @if (buDropdownOpen)
                {
                    <div class="di-bu-backdrop" @onclick="CloseBuDropdown"></div>
                    <div class="di-bu-menu">
                        <button type="button" class="di-bu-item @(filterBusinessUnitId == 0 ? "active" : "")" @onclick="() => SelectBuAsync(0)">
                            <span class="di-bu-text">@(SeesAllBusinessUnits ? "All Business Units" : "All My Business Units")</span>
                        </button>
                        @foreach (var businessUnit in businessUnits)
                        {
                            <button type="button" class="di-bu-item @(filterBusinessUnitId == businessUnit.Id ? "active" : "")" @onclick="() => SelectBuAsync(businessUnit.Id)">
                                <img src="/business-units/@businessUnit.Id/logo" alt="" class="di-bu-opt-logo" onerror="this.style.display='none'" />
                                <span class="di-bu-text">@businessUnit.Name</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div class="col-auto" style="min-width: 240px;">
        <label class="form-label">Supplier Name</label>
        <input class="form-control" @bind="supplierNameFilter" @bind:event="oninput" @bind:after="ReloadAsync" placeholder="Search by name..." />
    </div>
    <div class="col-auto" style="min-width: 220px;">
        <label class="form-label">Status</label>
        <select class="form-select" @bind="statusFilter" @bind:after="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            @foreach (var status in SupplierStatuses.All)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
</div>

<ul class="nav nav-tabs no-print mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.RecentlyUpdated ? "active" : "")" @onclick="() => SetTab(SupplierTab.RecentlyUpdated)">
            Recently Updated (@StatusFiltered.Count(IsRecentlyUpdated))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.UpdatedLastWeek ? "active" : "")" @onclick="() => SetTab(SupplierTab.UpdatedLastWeek)">
            Updated Last Week (@StatusFiltered.Count(IsUpdatedLastWeek))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.EverythingElse ? "active" : "")" @onclick="() => SetTab(SupplierTab.EverythingElse)">
            Everything Else (@StatusFiltered.Count(IsEverythingElse))
        </button>
    </li>
</ul>

@if (selectedIds.Count > 0)
{
    <div class="di-bulk-bar no-print">
        <span>@selectedIds.Count selected</span>
        <button class="btn btn-sm btn-primary" disabled="@bulkSending" @onclick="BulkNotifyAsync">
            @if (bulkSending)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <text> Sending...</text>
            }
            else
            {
                <text>Send Notification to Selected</text>
            }
        </button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@bulkSending" @onclick="ClearSelection">Clear Selection</button>
    </div>
}

@if (initialLoad)
{
    <LoadingIndicator Message="Supplier information is being retrieved, please wait…" />
}
else
{
@if (suppliers.Count > 0 && TotalPages > 1)
{
    <div class="d-flex align-items-center gap-2 no-print mb-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
        <span>Page @currentPage of @TotalPages (@TabFilteredSuppliers.Count() suppliers)</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
    </div>
}

<div style="overflow-x: auto;">
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th class="no-print"><input type="checkbox" checked="@AllOnPageSelected" @onchange="ToggleSelectAllOnPage" /></th>
            <th>Supplier Number</th>
            <th>Supplier Name</th>
            <th>First Name</th>
            <th>Contact Email</th>
            <th>Status</th>
            <th class="no-print">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in PagedSuppliers)
        {
            <tr>
                <td class="no-print"><input type="checkbox" checked="@selectedIds.Contains(supplier.Id)" @onchange="() => ToggleSelected(supplier.Id)" /></td>
                <td>@supplier.SupplierNumber</td>
                <td>
                    @supplier.SupplierName
                    @if (supplier.PendingSupplierChangeCount > 0)
                    {
                        <a href="/supplier/edit/@supplier.Id" class="di-bell" title="@($"{supplier.PendingSupplierChangeCount} change(s) submitted by the supplier awaiting review")">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2ZM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.375 3.632-.116.687-.257 1.382-.42 1.941-.169.588-.107 1.045.109 1.376.204.313.606.593 1.36.783C7.19 15.24 9.786 15.24 12.326 13.732c.754-.19 1.156-.47 1.36-.783.216-.331.278-.788.109-1.376a13.24 13.24 0 0 1-.42-1.94C13.134 8.196 13 6.628 13 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917Z" />
                            </svg>
                            @supplier.PendingSupplierChangeCount
                        </a>
                    }
                </td>
                <td>@supplier.FirstName</td>
                <td>@supplier.ContactEmail</td>
                <td>
                    @if (!string.IsNullOrEmpty(supplier.StatusName))
                    {
                        <span class="badge @WorkflowBadgeClass(supplier.StatusName)"
                              title="@(supplier.StatusName == SupplierStatuses.Rejected ? supplier.ReviewRemarks : null)">@supplier.StatusName</span>
                        @if (supplier.StatusName == SupplierStatuses.Rejected && !string.IsNullOrWhiteSpace(supplier.ReviewRemarks))
                        {
                            <div class="di-reject-remarks" title="@supplier.ReviewRemarks">@supplier.ReviewRemarks</div>
                        }
                    }
                </td>
                <td class="no-print">
                    <button class="btn btn-sm btn-outline-secondary" title="@(supplier.DocumentCount > 0 ? $"View {supplier.DocumentCount} attached document(s)" : "No documents attached")"
                            disabled="@(supplier.DocumentCount == 0)" @onclick="() => ShowDocumentsAsync(supplier)">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM9.5 3A1.5 1.5 0 0 0 11 4.5h1.5L9.5 1.5V3zM5 8.5a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H5z" />
                        </svg>
                    </button>
                    <a class="btn btn-sm btn-outline-primary" href="/supplier/edit/@supplier.Id" title="@(supplier.IsDraft ? "Continue editing" : "Edit")">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10ZM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5Zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5ZM3.51 10.658l-1.8 4.5 1.8-4.5.001 0Z" />
                        </svg>
                    </a>
                    @if (!supplier.IsDraft)
                    {
                        <button class="btn btn-sm btn-outline-secondary" title="Notify supplier via email"
                                disabled="@(notifyingSupplierId == supplier.Id)" @onclick="() => NotifyAsync(supplier)">
                            @if (notifyingSupplierId == supplier.Id)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z" />
                                </svg>
                            }
                        </button>
                        @if (supplier.StatusName == SupplierStatuses.ForReview)
                        {
                            <button class="btn btn-sm btn-outline-success" title="Mark review complete" @onclick="() => MarkCompleteAsync(supplier)">
                                Mark Complete
                            </button>
                        }
                        else if (supplier.StatusName == SupplierStatuses.Complete)
                        {
                            <button class="btn btn-sm btn-outline-danger" title="Reject and send back with remarks" @onclick="() => OpenRejectDialog(supplier)">
                                Reject
                            </button>
                        }
                        else if (supplier.StatusName == SupplierStatuses.Rejected)
                        {
                            <button class="btn btn-sm btn-outline-primary" title="Resubmit to the supplier for correction"
                                    disabled="@(notifyingSupplierId == supplier.Id)" @onclick="() => ResubmitAsync(supplier)">
                                @if (notifyingSupplierId == supplier.Id)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <span>Resubmit</span>
                                }
                            </button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (suppliers.Count == 0)
{
    <p><em>No supplier data yet. Use "Register Supplier" or "Upload Supplier Data" to add records.</em></p>
}
else if (TotalPages > 1)
{
    <div class="d-flex align-items-center gap-2 no-print">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
        <span>Page @currentPage of @TotalPages (@TabFilteredSuppliers.Count() suppliers)</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
    </div>
}
}

@if (showDocsModal)
{
    <div class="di-modal-backdrop no-print" @onclick="CloseDocsModal"></div>
    <div class="di-modal no-print" role="dialog" aria-modal="true">
        <div class="di-modal-head">
            <h2 class="h6 mb-0 text-truncate">Attached Documents &mdash; @docsSupplierName</h2>
            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDocsModal"></button>
        </div>
        <div class="di-modal-body" tabindex="0" @ref="docsViewerRef" @onkeydown="OnDocsKeyDown">
            @if (modalDocsLoading)
