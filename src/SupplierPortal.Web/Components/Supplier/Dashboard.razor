@code {
    private enum SupplierTab { RecentlyUpdated, UpdatedLastWeek, EverythingElse }

    // "Generate Template" dialog state.
    private bool showTemplateDialog;
    private bool templatePopulate;
    private int templateBuId;
    private bool generatingTemplate;
    private string templateProgress = "";

    private void OpenTemplateDialog()
    {
        templatePopulate = false;
        templateBuId = filterBusinessUnitId;
        generatingTemplate = false;
        showTemplateDialog = true;
    }

    private void CloseTemplateDialog()
    {
        if (generatingTemplate)
        {
            return;
        }
        showTemplateDialog = false;
    }

    /// <summary>Builds the template server-side (showing progress) and hands the finished file to the
    /// browser via JS, so the user sees a spinner while a populated template is being generated.</summary>
    private async Task DownloadTemplateAsync()
    {
        if (generatingTemplate)
        {
            return;
        }

        generatingTemplate = true;
        try
        {
            List<Supplier> suppliers = [];
            if (templatePopulate)
            {
                templateProgress = "Loading supplier data…";
                StateHasChanged();

                IReadOnlyCollection<int>? businessUnitIds = templateBuId != 0
                    ? [templateBuId]
                    : (SeesAllBusinessUnits ? null : userBusinessUnitIds);
                suppliers = await SupplierService.GetSuppliersAsync(businessUnitIds);
            }

            templateProgress = templatePopulate
                ? $"Generating template for {suppliers.Count} supplier(s)…"
                : "Generating template…";
            StateHasChanged();

            // Offload the CPU-bound workbook build so the spinner renders while it runs.
            var bytes = await Task.Run(() => ExportService.ExportToExcelUploadTemplate(suppliers));
            var fileName = templatePopulate ? "Supplier Template (Populated).xlsx" : "Supplier Template (Blank).xlsx";

            templateProgress = "Preparing download…";
            StateHasChanged();

            await JS.InvokeVoidAsync("ssDoc.download", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));

            generatingTemplate = false;
            showTemplateDialog = false;
        }
        finally
        {
            generatingTemplate = false;
        }
    }

    private static readonly System.ComponentModel.DataAnnotations.EmailAddressAttribute EmailValidator = new();

    // How many rows to show per page; admin-configurable via Settings > Supplier Fields.
    private int pageSize = 50;

    private List<SupplierListItem> suppliers = [];
    private bool initialLoad = true;
    private List<BusinessUnit> businessUnits = [];
    private bool isAdministrator;
    private List<int> userBusinessUnitIds = [];

    /// <summary>Whether the user sees every business unit's suppliers. Only an administrator with NO
    /// business-unit assignment is org-wide; a user (administrator or not) assigned to specific
    /// business units is scoped to those, matching the "Business Unit(s)" access on their account.</summary>
    private bool SeesAllBusinessUnits => isAdministrator && userBusinessUnitIds.Count == 0;

    private int filterBusinessUnitId;
    private string supplierNameFilter = "";
    private string statusFilter = "";   // default: "All Statuses"
    private SupplierTab activeTab = SupplierTab.RecentlyUpdated;
    private string currentUser = "unknown";
    private int? notifyingSupplierId;
    private int currentPage = 1;
    private HashSet<int> selectedIds = [];
    private bool bulkSending;

    // Business Unit filter is a custom dropdown so each option can show the BU logo before its name.
    private bool buDropdownOpen;

    // Attached-documents viewer modal (available on every row/status; enabled only when documents exist).
    private bool showDocsModal;
    private int docsSupplierId;
    private string docsSupplierName = "";
    private List<SupplierDocument> modalDocuments = [];
    private int modalDocIndex;
    private bool modalDocsLoading;
    private ElementReference docsViewerRef;
    private bool focusDocsPending;

    private string SelectedBuLabel => filterBusinessUnitId == 0
        ? (SeesAllBusinessUnits ? "All Business Units" : "All My Business Units")
        : businessUnits.FirstOrDefault(b => b.Id == filterBusinessUnitId)?.Name ?? "";

    // Human-readable scope for the "Notify" action, matching the current business-unit filter: a single
    // subsidiary when one is selected, otherwise all subsidiaries in view. The supplier list itself is
    // already filtered to this scope, so the notification only ever reaches suppliers in it.
    private string NotifyScopeLabel => filterBusinessUnitId == 0
        ? (SeesAllBusinessUnits ? "all subsidiaries" : "all your business units")
        : SelectedBuLabel;

    // Suppliers matching the selected workflow-status filter (empty = all statuses).
    private IEnumerable<SupplierListItem> StatusFiltered =>
        string.IsNullOrEmpty(statusFilter) ? suppliers : suppliers.Where(s => s.StatusName == statusFilter);

    private IEnumerable<SupplierListItem> TabFilteredSuppliers => activeTab switch
    {
        SupplierTab.RecentlyUpdated => StatusFiltered.Where(IsRecentlyUpdated),
        SupplierTab.UpdatedLastWeek => StatusFiltered.Where(IsUpdatedLastWeek),
        _ => StatusFiltered.Where(IsEverythingElse)
    };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TabFilteredSuppliers.Count() / (double)pageSize));

    private List<SupplierListItem> PagedSuppliers =>
        TabFilteredSuppliers.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private bool AllOnPageSelected => PagedSuppliers.Count > 0 && PagedSuppliers.All(s => selectedIds.Contains(s.Id));

    private int CountByStatus(string statusName) => suppliers.Count(s => s.StatusName == statusName);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdministrator = state.User.IsAdministrator();
        userBusinessUnitIds = state.User.GetBusinessUnitIds();
        currentUser = state.User.Identity?.Name ?? "unknown";

        var allBusinessUnits = await BusinessUnitService.GetAllAsync();
        businessUnits = SeesAllBusinessUnits
            ? allBusinessUnits
            : allBusinessUnits.Where(b => userBusinessUnitIds.Contains(b.Id)).ToList();

        pageSize = await SupplierFieldSettingService.GetListPageSizeAsync();

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        List<int>? businessUnitIds;
        if (filterBusinessUnitId != 0)
        {
            businessUnitIds = [filterBusinessUnitId];
        }
        else
        {
            businessUnitIds = SeesAllBusinessUnits ? null : userBusinessUnitIds;
        }

        await Loading.RunAsync(async () =>
        {
            suppliers = await SupplierService.GetSupplierListAsync(businessUnitIds, supplierNameFilter);
        });
        initialLoad = false;
        currentPage = 1;
        selectedIds.Clear();
    }

    private void SetTab(SupplierTab tab)
    {
        activeTab = tab;
        currentPage = 1;
    }

    private void OnStatusFilterChanged()
    {
        currentPage = 1;
        selectedIds.Clear();
    }

    private void GoToPage(int newPage)
    {
        currentPage = Math.Clamp(newPage, 1, TotalPages);
    }

    private void ToggleSelected(int supplierId)
    {
        if (!selectedIds.Add(supplierId))
        {
            selectedIds.Remove(supplierId);
        }
    }

    private void ToggleSelectAllOnPage()
    {
        if (AllOnPageSelected)
        {
            foreach (var supplier in PagedSuppliers)
            {
                selectedIds.Remove(supplier.Id);
            }
        }
        else
        {
            foreach (var supplier in PagedSuppliers)
            {
                selectedIds.Add(supplier.Id);
            }
        }
    }

    private void ClearSelection() => selectedIds.Clear();

    private void ToggleBuDropdown() => buDropdownOpen = !buDropdownOpen;
    private void CloseBuDropdown() => buDropdownOpen = false;

    private async Task SelectBuAsync(int businessUnitId)
    {
        buDropdownOpen = false;
        filterBusinessUnitId = businessUnitId;
        await ReloadAsync();
    }

    private static bool IsImage(SupplierDocument document) =>
        document.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static string SplitDocType(SupplierDocumentType type) =>
        System.Text.RegularExpressions.Regex.Replace(type.ToString(), "(?<!^)([A-Z])", " $1");

    private async Task ShowDocumentsAsync(SupplierListItem supplier)
    {
        showDocsModal = true;
        docsSupplierId = supplier.Id;
        docsSupplierName = supplier.SupplierName;
        modalDocIndex = 0;
        modalDocuments = [];
        modalDocsLoading = true;
        StateHasChanged();

        modalDocuments = await SupplierDocumentService.GetDocumentsAsync(supplier.Id);
        modalDocsLoading = false;
        focusDocsPending = true;
    }

    private void CloseDocsModal() => showDocsModal = false;
    private void ModalPrevDoc() { if (modalDocIndex > 0) { modalDocIndex--; } }
    private void ModalNextDoc() { if (modalDocIndex < modalDocuments.Count - 1) { modalDocIndex++; } }

    private async Task ModalPrintAsync(int documentId) =>
        await JS.InvokeVoidAsync("printImageUrl", $"/suppliers/documents/{documentId}");

    private void OnDocsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight" || e.Key == "PageDown") { ModalNextDoc(); }
        else if (e.Key == "ArrowLeft" || e.Key == "PageUp") { ModalPrevDoc(); }
        else if (e.Key == "Escape") { CloseDocsModal(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDocsPending)
        {
            focusDocsPending = false;
            try { await docsViewerRef.FocusAsync(); } catch { /* element not ready; harmless */ }
        }
    }

    private static bool HasValidEmail(SupplierListItem supplier) =>
        !string.IsNullOrWhiteSpace(supplier.ContactEmail) && EmailValidator.IsValid(supplier.ContactEmail);

    private async Task BulkNotifyAsync()
    {
        bulkSending = true;
        StateHasChanged();

        var selected = suppliers.Where(s => selectedIds.Contains(s.Id) && !s.IsDraft).ToList();

        // Skip suppliers that have no valid Contact Email rather than counting them as failures.
        var skipped = selected.Count(s => !HasValidEmail(s));
        var targets = selected.Where(HasValidEmail).ToList();

        var sent = 0;
        var failed = 0;
        await Loading.RunAsync(async () =>
        {
            foreach (var supplier in targets)
            {
                var (success, _) = await SupplierEmailService.NotifySupplierAsync(
                    supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);
                if (success)
                {
                    sent++;
                }
                else
                {
                    failed++;
                }
            }
        });

        var summary = $"{sent} email(s) sent.";
        if (skipped > 0)
        {
            summary += $" {skipped} skipped (no valid email).";
        }
        if (failed > 0)
        {
            summary += $" {failed} failed to send.";
        }

        if (failed > 0)
        {
            ToastService.ShowError(summary);
        }
        else if (sent == 0)
        {
            ToastService.ShowWarning(summary);
        }
        else
        {
            ToastService.ShowSuccess(summary);
        }

        selectedIds.Clear();
        bulkSending = false;
    }

    private async Task NotifyAsync(SupplierListItem supplier)
    {
        notifyingSupplierId = supplier.Id;
        StateHasChanged();

        if (!HasValidEmail(supplier))
        {
            ToastService.ShowWarning($"{supplier.SupplierName} was skipped — no valid Contact Email on file.");
            notifyingSupplierId = null;
            return;
        }

        var (success, error) = await SupplierEmailService.NotifySupplierAsync(
            supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);

        if (success)
        {
            ToastService.ShowSuccess($"1 email sent to {supplier.ContactEmail}.");
        }
        else
        {
            ToastService.ShowError($"Could not send notification: {error}");
        }

        notifyingSupplierId = null;
    }

    private async Task NotifyAllAsync()
    {
        var candidates = suppliers.Where(s => !s.IsDraft).ToList();
        var toSend = candidates.Where(HasValidEmail).ToList();
        var skipped = candidates.Count - toSend.Count;

        if (toSend.Count == 0)
        {
            ToastService.ShowWarning("No suppliers with a valid Contact Email to notify.");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Send a review notification email to {toSend.Count} supplier(s) in {NotifyScopeLabel}?" + (skipped > 0 ? $" ({skipped} without a valid email will be skipped.)" : ""));
        if (!confirmed)
        {
            return;
        }

        bulkSending = true;
        StateHasChanged();

        var sent = 0;
        var failed = 0;
        await Loading.RunAsync(async () =>
        {
            foreach (var supplier in toSend)
            {
                var (success, _) = await SupplierEmailService.NotifySupplierAsync(
                    supplier.Id, supplier.SupplierName, supplier.ContactEmail, currentUser, NavigationManager.BaseUri);
                if (success)
                {
                    sent++;
                }
                else
                {
                    failed++;
                }
            }
        });

        var summary = $"{sent} email(s) sent.";
        if (skipped > 0)
        {
            summary += $" {skipped} skipped (no valid email).";
        }
        if (failed > 0)
        {
            summary += $" {failed} failed to send.";
        }

        if (failed > 0)
        {
            ToastService.ShowError(summary);
        }
        else
        {
            ToastService.ShowSuccess(summary);
        }

        bulkSending = false;
        await ReloadAsync();
    }

    private async Task MarkCompleteAsync(SupplierListItem supplier)
    {
        await SupplierService.MarkCompleteAsync(supplier.Id, currentUser);
        ToastService.ShowSuccess($"{supplier.SupplierName} marked Complete.");
        await ReloadAsync();
    }

    // --- Reject / resubmit workflow ---
    private SupplierListItem? rejectTarget;
    private string rejectRemarks = "";
    private bool rejecting;

    private void OpenRejectDialog(SupplierListItem supplier)
    {
        rejectTarget = supplier;
        rejectRemarks = supplier.ReviewRemarks ?? "";
        rejecting = false;
    }

    private void CloseRejectDialog()
    {
        if (rejecting)
        {
            return;
        }
        rejectTarget = null;
    }

    private async Task ConfirmRejectAsync()
    {
        if (rejectTarget is null || string.IsNullOrWhiteSpace(rejectRemarks) || rejecting)
        {
            return;
        }

        rejecting = true;
        var target = rejectTarget;
        await SupplierService.RejectAsync(target.Id, rejectRemarks, currentUser);
        rejecting = false;
        rejectTarget = null;
        ToastService.ShowSuccess($"{target.SupplierName} rejected and sent back for correction.");
        await ReloadAsync();
    }

    private async Task ResubmitAsync(SupplierListItem supplier)
    {
        // Resubmitting sends the record back to the supplier (issues a new link and moves the status
        // to "Awaiting Supplier Response").
        await NotifyAsync(supplier);
    }

    private static string WorkflowBadgeClass(string? statusName) => statusName switch
    {
        SupplierStatuses.New => "bg-secondary",
        SupplierStatuses.AwaitingSupplierResponse => "bg-info text-dark",
        SupplierStatuses.ForReview => "bg-warning text-dark",
        SupplierStatuses.Complete => "bg-success",
        SupplierStatuses.Rejected => "bg-danger",
        _ => "bg-light text-dark"
    };

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("print");
    }

    private string ExportUrl(string format)
    {
        var query = new List<string>();
        if (filterBusinessUnitId != 0)
        {
            query.Add($"businessUnitId={filterBusinessUnitId}");
        }
        if (!string.IsNullOrEmpty(statusFilter))
        {
            query.Add($"status={Uri.EscapeDataString(statusFilter)}");
        }
        return query.Count > 0 ? $"/export/{format}?{string.Join("&", query)}" : $"/export/{format}";
    }

    private static DateTime EffectiveUpdated(SupplierListItem supplier) => supplier.UpdatedAt ?? supplier.CreatedAt;

    private static bool IsRecentlyUpdated(SupplierListItem supplier) => EffectiveUpdated(supplier) >= DateTime.UtcNow.AddDays(-3);

    private static bool IsUpdatedLastWeek(SupplierListItem supplier)
    {
        var updated = EffectiveUpdated(supplier);
        return updated < DateTime.UtcNow.AddDays(-3) && updated >= DateTime.UtcNow.AddDays(-7);
    }

    private static bool IsEverythingElse(SupplierListItem supplier) => EffectiveUpdated(supplier) < DateTime.UtcNow.AddDays(-7);
}
