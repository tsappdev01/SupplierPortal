@page "/supplier/dashboard"
@attribute [Authorize(Policy = "Portal.Supplier")]
@* prerender:false so a click navigates instantly to the interactive shell (which shows the
   loading indicator immediately) instead of the server holding the response until the whole
   supplier query finishes. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject SupplierService SupplierService
@inject UserService UserService
@inject BusinessUnitService BusinessUnitService
@inject SupplierDocumentService SupplierDocumentService
@inject SupplierEmailService SupplierEmailService
@inject SupplierFieldSettingService SupplierFieldSettingService
@inject ExportService ExportService
@inject ToastService ToastService
@inject LoadingService Loading
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Manage Supplier - Supplier Portal</PageTitle>

<h1>Manage Supplier</h1>

<div class="di-stat-row no-print">
    <div class="di-stat-tile di-stat-total">
        <div class="di-stat-value">@suppliers.Count</div>
        <div class="di-stat-label">Total Suppliers</div>
    </div>
    <div class="di-stat-tile di-stat-new">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.New)</div>
        <div class="di-stat-label">Not Submitted</div>
    </div>
    <div class="di-stat-tile di-stat-await">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.AwaitingSupplierResponse)</div>
        <div class="di-stat-label">Awaiting Supplier Response</div>
    </div>
    <div class="di-stat-tile di-stat-complete">
        <div class="di-stat-value">@CountByStatus(SupplierStatuses.Complete)</div>
        <div class="di-stat-label">Completed</div>
    </div>
</div>

<div class="d-flex gap-2 mb-3 no-print align-items-center">
    @* Excel, Excel (All Fields) and PDF export buttons hidden per request; use Print for a report. *@
    <button type="button" class="di-export-btn" @onclick="OpenTemplateDialog" title="Generate a supplier upload template" aria-label="Generate supplier template">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="3" width="34" height="46" rx="4" fill="#ffffff" stroke="#1565c0" stroke-width="2.5" />
            <path d="M30 3h9v9z" fill="#90caf9" stroke="#1565c0" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 16h16M12 22h16M12 28h16M12 34h9" stroke="#90caf9" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Generate Template</span>
    </button>
    <button type="button" class="di-export-btn" @onclick="OpenPrintDialog" title="Print" aria-label="Print">
        <svg width="28" height="30" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 6h20v11H14z" fill="#ffffff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round" />
            <rect x="7" y="16" width="34" height="17" rx="3.5" fill="#607d8b" />
            <rect x="14" y="29" width="20" height="13" rx="1.5" fill="#ffffff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M18 34h12M18 38h8" stroke="#455a64" stroke-width="2" stroke-linecap="round" />
            <circle cx="35" cy="22" r="2.2" fill="#c8e6c9" />
        </svg>
        <span>Print</span>
    </button>
    <button type="button" class="di-action-btn is-notify ms-auto" disabled="@bulkSending" @onclick="NotifyAllAsync"
            title="@($"Email a review notification to suppliers in {NotifyScopeLabel}")" aria-label="Notify suppliers in the selected business unit">
        @if (bulkSending)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Sending...</span>
        }
        else
        {
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2.5" y="4.5" width="19" height="14" rx="2.5" fill="#e3f6fb" stroke="#0aa2c0" stroke-width="1.7" />
                <path d="M3.5 6.5 12 12.5l8.5-6" stroke="#0aa2c0" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="19.5" cy="6" r="3.4" fill="#0aa2c0" stroke="#fff" stroke-width="1.2" />
                <path d="M19.5 4.4v3.2M17.9 6h3.2" stroke="#fff" stroke-width="1.2" stroke-linecap="round" />
            </svg>
            <span>@(filterBusinessUnitId == 0 ? "Notify All Suppliers" : $"Notify Suppliers in {SelectedBuLabel}")</span>
        }
    </button>
    @* Registering and bulk-uploading suppliers are administrator-only actions. *@
    @if (isAdministrator)
    {
        <a class="di-action-btn is-register" href="/supplier/register" title="Register a new supplier" aria-label="Register supplier">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="9.5" cy="8" r="3.6" fill="#e6ebf7" stroke="#1a2233" stroke-width="1.7" />
                <path d="M3.5 20c0-3.6 2.7-6 6-6s6 2.4 6 6" fill="#e6ebf7" stroke="#1a2233" stroke-width="1.7" stroke-linecap="round" />
                <circle cx="18.5" cy="16.5" r="4.5" fill="#1a2233" />
                <path d="M18.5 14.3v4.4M16.3 16.5h4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span>Register Supplier</span>
        </a>
        <a class="di-action-btn is-upload" href="/supplier/upload" title="Bulk-upload suppliers from an Excel file" aria-label="Upload supplier data">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 19.5a4 4 0 0 1-.6-7.96 5.5 5.5 0 0 1 10.8-1.06A3.75 3.75 0 0 1 18.5 19.5H6Z" fill="#faf1d8" stroke="#a8842f" stroke-width="1.7" stroke-linejoin="round" />
                <path d="M12 16.5V9m0 0-2.6 2.6M12 9l2.6 2.6" stroke="#a8842f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Upload Supplier Data</span>
        </a>
    }
</div>

@if (showTemplateDialog)
{
    <div class="di-print-backdrop" @onclick="CloseTemplateDialog"></div>
    <div class="di-print-dialog" @onclick:stopPropagation role="dialog" aria-modal="true" aria-label="Generate supplier template">
        <div class="di-print-head">
            <div class="di-print-head-icon">
                <svg width="22" height="22" viewBox="0 0 44 52" fill="none"><rect x="5" y="3" width="34" height="46" rx="4" fill="#fff"/><path d="M30 3h9v9z" fill="#cfe0f5"/><path d="M12 16h16M12 22h16M12 28h16M12 34h9" stroke="#274a7d" stroke-width="2.4" stroke-linecap="round"/></svg>
            </div>
            <div>
                <h3 class="di-print-title">Generate Supplier Template</h3>
                <p class="di-print-sub">Download an Excel template for the business to fill in and re-upload. Duplicate suppliers (by Supplier Number) are detected and skipped automatically on upload.</p>
            </div>
            <button type="button" class="di-print-x" aria-label="Close" @onclick="CloseTemplateDialog">✕</button>
        </div>

        <div class="di-print-body">
            <div class="di-opt-cards">
                <label class="di-opt-card @(!templatePopulate ? "is-on" : "")">
                    <input type="radio" name="tmplMode" checked="@(!templatePopulate)" @onchange="() => templatePopulate = false" />
                    <span class="di-opt-main">
                        <span class="di-opt-title">Blank template</span>
                        <span class="di-opt-desc">Headers only — a clean sheet to fill in.</span>
                    </span>
                </label>
                <label class="di-opt-card @(templatePopulate ? "is-on" : "")">
                    <input type="radio" name="tmplMode" checked="@templatePopulate" @onchange="() => templatePopulate = true" />
                    <span class="di-opt-main">
                        <span class="di-opt-title">Populate with existing data</span>
                        <span class="di-opt-desc">Pre-filled with current suppliers for review/update.</span>
                    </span>
                </label>
            </div>
            @if (templatePopulate)
            {
                <div class="di-print-field">
                    <label>Business Unit</label>
                    <select @bind="templateBuId">
                        <option value="0">@(SeesAllBusinessUnits ? "All Business Units" : "All My Business Units")</option>
                        @foreach (var bu in businessUnits)
                        {
                            <option value="@bu.Id">@bu.Name</option>
                        }
                    </select>
                </div>
            }
            @if (generatingTemplate)
            {
                <div class="di-print-hint">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>@templateProgress</span>
                </div>
            }
        </div>

        <div class="di-print-actions">
            <button type="button" class="di-btn2 di-btn2-ghost" @onclick="CloseTemplateDialog" disabled="@generatingTemplate">Cancel</button>
            <button type="button" class="di-btn2 di-btn2-primary" @onclick="DownloadTemplateAsync" disabled="@generatingTemplate">
                @if (generatingTemplate)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Generating…</span>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                    <span>Download</span>
                }
            </button>
        </div>
    </div>
}

@if (confirmNotifySupplier is not null)
{
    <div class="di-confirm-backdrop" @onclick="CancelNotify">
        <div class="di-confirm-card" @onclick:stopPropagation role="dialog" aria-modal="true">
            <button type="button" class="di-confirm-x" title="Close" @onclick="CancelNotify">&times;</button>

            <div class="di-confirm-badge">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="2.5" y="4.75" width="19" height="14.5" rx="2.5" fill="#ffffff" stroke="#0b2545" stroke-width="1.6"/>
                    <path d="M3.5 6.5 12 12.5l8.5-6" stroke="#0b2545" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="19" cy="6" r="4.4" fill="#c9a227" stroke="#ffffff" stroke-width="1.4"/>
                    <path d="M19 4.3v3.4M17.3 6h3.4" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>

            <h3 class="di-confirm-title">Send notification email?</h3>
            <p class="di-confirm-sub">We'll send the information-update request to:</p>

            <div class="di-confirm-target">
                <div class="di-confirm-avatar">@SupplierInitials(confirmNotifySupplier.SupplierName)</div>
                <div class="di-confirm-who">
                    <span class="di-confirm-name">@confirmNotifySupplier.SupplierName</span>
                    @if (!string.IsNullOrWhiteSpace(confirmNotifySupplier.ContactEmail))
                    {
                        <span class="di-confirm-email">
                            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/></svg>
                            @confirmNotifySupplier.ContactEmail
                        </span>
                    }
                </div>
            </div>

            <div class="di-confirm-actions">
                <button type="button" class="di-confirm-btn di-confirm-cancel" @onclick="CancelNotify">Cancel</button>
                <button type="button" class="di-confirm-btn di-confirm-send" @onclick="ConfirmNotifyAsync">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/></svg>
                    <span>Send Email</span>
                </button>
            </div>
        </div>
    </div>
}

<style>
    .di-tmpl-backdrop { position: fixed; inset: 0; background: rgba(15,22,35,0.55); display: flex; align-items: center; justify-content: center; z-index: 1080; padding: 24px; }
    .di-tmpl-modal { background: #fff; border-radius: 10px; width: min(460px, 100%); padding: 22px 24px; box-shadow: 0 12px 40px rgba(0,0,0,0.35); }
    .di-tmpl-title { margin: 0 0 6px; font-size: 18px; font-weight: 700; color: #1a2233; }
    .di-tmpl-text { margin: 0 0 16px; font-size: 13.5px; color: #6b7280; }
    .di-tmpl-radio { display: flex; align-items: center; gap: 8px; padding: 8px 0; font-size: 14.5px; color: #26303f; cursor: pointer; }
    .di-tmpl-field { margin: 10px 0 4px; display: flex; flex-direction: column; gap: 5px; }
    .di-tmpl-field label { font-size: 13px; font-weight: 600; color: #46618f; }
    .di-tmpl-field select, .di-tmpl-field textarea { padding: 9px 11px; border: 1px solid #e2e5ea; border-radius: 8px; font-size: 15px; color: #1a2233; background: #fff; font-family: inherit; }
    .di-tmpl-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
    .di-tmpl-progress { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 13.5px; color: #46618f; }
    .di-reject-remarks { margin-top: 4px; font-size: 12px; color: #b91c1c; max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* ---- Send-notification confirmation dialog ---- */
    .di-confirm-backdrop {
        position: fixed; inset: 0; z-index: 1090;
        background: rgba(11, 37, 69, 0.55); backdrop-filter: blur(2px);
        display: flex; align-items: center; justify-content: center; padding: 24px;
        animation: di-confirm-fade 0.15s ease;
    }
    .di-confirm-card {
        position: relative; background: #fff; width: min(430px, 100%);
        border-radius: 18px; padding: 30px 28px 24px; text-align: center;
        box-shadow: 0 24px 60px rgba(11, 37, 69, 0.35);
        animation: di-confirm-pop 0.18s cubic-bezier(.2,.9,.3,1.2);
    }
    .di-confirm-x {
        position: absolute; top: 12px; right: 14px; border: none; background: transparent;
        font-size: 24px; line-height: 1; color: #9aa6b8; cursor: pointer; padding: 2px 6px; border-radius: 8px;
    }
    .di-confirm-x:hover { background: #f1f4f9; color: #46618f; }
    .di-confirm-badge {
        width: 76px; height: 76px; margin: 0 auto 16px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: radial-gradient(circle at 30% 25%, #eaf1fb, #d7e5f7);
        box-shadow: 0 0 0 8px rgba(11, 37, 69, 0.06);
    }
    .di-confirm-title { margin: 0 0 6px; font-size: 20px; font-weight: 800; color: #0b2545; }
    .di-confirm-sub { margin: 0 0 16px; font-size: 13.5px; color: #7b8697; }
    .di-confirm-target {
        display: flex; align-items: center; gap: 12px; text-align: left;
        background: #f6f8fc; border: 1px solid #e6ecf5; border-radius: 12px; padding: 12px 14px; margin-bottom: 22px;
    }
    .di-confirm-avatar {
        flex: none; width: 42px; height: 42px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #0b2545; color: #c9a227; font-weight: 800; font-size: 14px;
    }
    .di-confirm-who { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .di-confirm-name { font-weight: 700; font-size: 14.5px; color: #1a2233; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .di-confirm-email { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: #46618f; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .di-confirm-email svg { flex: none; opacity: 0.75; }
    .di-confirm-actions { display: flex; gap: 12px; }
    .di-confirm-btn {
        flex: 1; border-radius: 10px; padding: 11px 16px; font-size: 14.5px; font-weight: 700;
        cursor: pointer; border: 1px solid transparent; transition: all 0.12s ease;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    }
    .di-confirm-cancel { background: #fff; border-color: #d3dae6; color: #46618f; }
    .di-confirm-cancel:hover { background: #f1f4f9; }
    .di-confirm-send { background: linear-gradient(135deg, #14396b, #0b2545); color: #fff; box-shadow: 0 6px 16px rgba(11,37,69,0.28); }
    .di-confirm-send:hover { transform: translateY(-1px); box-shadow: 0 9px 22px rgba(11,37,69,0.36); }
    @@keyframes di-confirm-fade { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes di-confirm-pop { from { opacity: 0; transform: translateY(10px) scale(0.96); } to { opacity: 1; transform: none; } }
</style>

<div class="row g-2 mb-3 no-print">
    @if (businessUnits.Count > 1 || isAdministrator)
    {
        <div class="col-auto" style="min-width: 260px;">
            <label class="form-label">Business Unit</label>
            <div class="di-bu-select">
                <button type="button" class="form-select di-bu-toggle" @onclick="ToggleBuDropdown">
                    @if (filterBusinessUnitId != 0)
                    {
                        <img src="/business-units/@filterBusinessUnitId/logo" alt="" class="di-bu-opt-logo" onerror="this.style.display='none'" />
                    }
                    <span class="di-bu-text">@SelectedBuLabel</span>
                    <span class="di-bu-caret">&#9662;</span>
                </button>
                @if (buDropdownOpen)
                {
                    <div class="di-bu-backdrop" @onclick="CloseBuDropdown"></div>
                    <div class="di-bu-menu">
                        <button type="button" class="di-bu-item @(filterBusinessUnitId == 0 ? "active" : "")" @onclick="() => SelectBuAsync(0)">
                            <span class="di-bu-text">@(SeesAllBusinessUnits ? "All Business Units" : "All My Business Units")</span>
                        </button>
                        @foreach (var businessUnit in businessUnits)
                        {
                            <button type="button" class="di-bu-item @(filterBusinessUnitId == businessUnit.Id ? "active" : "")" @onclick="() => SelectBuAsync(businessUnit.Id)">
                                <img src="/business-units/@businessUnit.Id/logo" alt="" class="di-bu-opt-logo" onerror="this.style.display='none'" />
                                <span class="di-bu-text">@businessUnit.Name</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div class="col-auto" style="min-width: 240px;">
        <label class="form-label">Supplier Name</label>
        <input class="form-control" @bind="supplierNameFilter" @bind:event="oninput" @bind:after="ReloadAsync" placeholder="Search by name..." />
    </div>
    <div class="col-auto" style="min-width: 220px;">
        <label class="form-label">Status</label>
        <select class="form-select" @bind="statusFilter" @bind:after="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            @foreach (var status in SupplierStatuses.All)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="col-auto" style="min-width: 160px;">
        <label class="form-label">Priority</label>
        <select class="form-select" @bind="priorityFilter" @bind:after="OnPriorityFilterChanged">
            <option value="">All Priorities</option>
            <option value="P1">P1</option>
            <option value="P2">P2</option>
            <option value="P3">P3</option>
        </select>
    </div>
    <div class="col-auto" style="min-width: 180px;">
        <label class="form-label">Assigned To</label>
        <select class="form-select" @bind="assignedFilter" @bind:after="OnAssignedFilterChanged">
            <option value="">All Assignees</option>
            <option value="unassigned">— Unassigned —</option>
            @foreach (var u in assignableUsers)
            {
                <option value="@u.Id">@(string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName)</option>
            }
        </select>
    </div>
</div>

<ul class="nav nav-tabs no-print mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.RecentlyUpdated ? "active" : "")" @onclick="() => SetTab(SupplierTab.RecentlyUpdated)">
            Recently Updated (@StatusFiltered.Count(IsRecentlyUpdated))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.UpdatedLastWeek ? "active" : "")" @onclick="() => SetTab(SupplierTab.UpdatedLastWeek)">
            Updated Last Week (@StatusFiltered.Count(IsUpdatedLastWeek))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == SupplierTab.EverythingElse ? "active" : "")" @onclick="() => SetTab(SupplierTab.EverythingElse)">
            Everything Else (@StatusFiltered.Count(IsEverythingElse))
        </button>
    </li>
</ul>

@if (selectedIds.Count > 0)
{
    <div class="di-bulk-bar no-print">
        <span>@selectedIds.Count selected</span>
        <button class="btn btn-sm btn-primary" disabled="@bulkSending" @onclick="BulkNotifyAsync">
            @if (bulkSending)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <text> Sending...</text>
            }
            else
            {
                <text>Send Notification to Selected</text>
            }
        </button>
        <span class="vr d-none d-sm-inline"></span>
        <select class="form-select form-select-sm di-assign-select" disabled="@bulkSending" @bind="bulkDepartmentId">
            <option value="">— None (remove department) —</option>
            @foreach (var d in departments)
            {
                <option value="@d.Id">@d.Name</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-primary" disabled="@bulkSending" @onclick="BulkAssignDepartmentAsync">
            @if (bulkSending)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <text> Assigning...</text>
            }
            else
            {
                <text>Assign Department to Selected</text>
            }
        </button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@bulkSending" @onclick="ClearSelection">Clear Selection</button>
    </div>
}

@if (initialLoad)
{
    <LoadingIndicator Message="Supplier information is being retrieved, please wait…" />
}
else
{
@if (suppliers.Count > 0 && TotalPages > 1)
{
    <div class="d-flex align-items-center gap-2 no-print mb-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
        <span>Page @currentPage of @TotalPages (@TabFilteredSuppliers.Count() suppliers)</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
    </div>
}

<div class="di-supplier-scroll">
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th class="no-print"><input type="checkbox" checked="@AllOnPageSelected" @onchange="ToggleSelectAllOnPage" /></th>
            <th>Supplier Number</th>
            <th>Priority</th>
            <th>Supplier Name</th>
            <th>Full Name</th>
            <th>Contact Email</th>
            <th>Status</th>
            <th class="no-print">Assigned To</th>
            <th class="no-print">Department</th>
            <th class="no-print">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in PagedSuppliers)
        {
            <tr>
                <td class="no-print"><input type="checkbox" checked="@selectedIds.Contains(supplier.Id)" @onchange="() => ToggleSelected(supplier.Id)" /></td>
                <td>@supplier.SupplierNumber</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(supplier.Priority))
                    {
                        <span class="di-priority di-priority-@supplier.Priority.ToLowerInvariant()">@supplier.Priority</span>
                    }
                </td>
                <td>
                    <img src="/business-units/@supplier.BusinessUnitId/logo" alt="" class="di-row-bu-logo" onerror="this.style.display='none'" />
                    @supplier.SupplierName
                    @if (supplier.PendingSupplierChangeCount > 0)
                    {
                        <a href="/supplier/edit/@supplier.Id" class="di-bell" title="@($"{supplier.PendingSupplierChangeCount} change(s) submitted by the supplier awaiting review")">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2ZM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.375 3.632-.116.687-.257 1.382-.42 1.941-.169.588-.107 1.045.109 1.376.204.313.606.593 1.36.783C7.19 15.24 9.786 15.24 12.326 13.732c.754-.19 1.156-.47 1.36-.783.216-.331.278-.788.109-1.376a13.24 13.24 0 0 1-.42-1.94C13.134 8.196 13 6.628 13 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917Z" />
                            </svg>
                            @supplier.PendingSupplierChangeCount
                        </a>
                    }
                </td>
                <td>@supplier.FullName</td>
                <td>@supplier.ContactEmail</td>
                <td>
                    @if (!string.IsNullOrEmpty(supplier.StatusName))
                    {
                        <span class="badge @WorkflowBadgeClass(supplier.StatusName)">@supplier.StatusName</span>
                    }
                </td>
                <td class="no-print">
                    <select class="form-select form-select-sm di-assign-select"
                            value="@supplier.AssignedToUserId"
                            @onchange="e => AssignAsync(supplier, e.Value?.ToString())">
                        <option value="">— Unassigned —</option>
                        @foreach (var u in AssignableFor(supplier))
                        {
                            <option value="@u.Id">@(string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName)</option>
                        }
                    </select>
                </td>
                <td class="no-print">
                    <select class="form-select form-select-sm di-assign-select"
                            value="@supplier.DepartmentId"
                            @onchange="e => AssignDepartmentAsync(supplier, e.Value?.ToString())">
                        <option value="">— None —</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                </td>
                <td class="no-print">
                    <button class="btn btn-sm btn-outline-secondary" title="@(supplier.DocumentCount > 0 ? $"View {supplier.DocumentCount} attached document(s)" : "No documents attached")"
                            disabled="@(supplier.DocumentCount == 0)" @onclick="() => ShowDocumentsAsync(supplier)">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM9.5 3A1.5 1.5 0 0 0 11 4.5h1.5L9.5 1.5V3zM5 8.5a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H5z" />
                        </svg>
                    </button>
                    <a class="btn btn-sm btn-outline-primary" href="/supplier/edit/@supplier.Id" title="@(supplier.IsDraft ? "Continue editing" : "Edit")">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10ZM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5Zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5ZM3.51 10.658l-1.8 4.5 1.8-4.5.001 0Z" />
                        </svg>
                    </a>
                    @if (!supplier.IsDraft)
                    {
                        <button class="btn btn-sm btn-outline-secondary" title="Notify supplier via email"
                                disabled="@(notifyingSupplierId == supplier.Id)" @onclick="() => RequestNotify(supplier)">
                            @if (notifyingSupplierId == supplier.Id)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z" />
                                </svg>
                            }
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (suppliers.Count == 0)
{
    <p><em>No supplier data yet. Use "Register Supplier" or "Upload Supplier Data" to add records.</em></p>
}
else if (TotalPages > 1)
{
    <div class="d-flex align-items-center gap-2 no-print">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
        <span>Page @currentPage of @TotalPages (@TabFilteredSuppliers.Count() suppliers)</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
    </div>
}
}

@if (showDocsModal)
{
    <div class="di-modal-backdrop no-print" @onclick="CloseDocsModal"></div>
    <div class="di-modal di-modal-adv no-print" role="dialog" aria-modal="true">
        <div class="di-modal-head">
            <div class="di-modal-head-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 2.5h8l4 4V21a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 6 21V2.5z" fill="#fff" opacity=".92"/><path d="M14 2.5v4h4" fill="#cbd8ee"/><path d="M8.5 12h7M8.5 15h7M8.5 18h4.5" stroke="#274a7d" stroke-width="1.4" stroke-linecap="round"/></svg>
            </div>
            <div class="di-modal-head-text">
                <h2 class="di-modal-title text-truncate">Attached Documents</h2>
                <p class="di-modal-subtitle text-truncate">@docsSupplierName@(modalDocuments.Count > 0 ? $" · {modalDocuments.Count} file(s)" : "")</p>
            </div>
            <button type="button" class="di-modal-x" aria-label="Close" @onclick="CloseDocsModal">✕</button>
        </div>
        <div class="di-modal-body" tabindex="0" @ref="docsViewerRef" @onkeydown="OnDocsKeyDown">
            @if (modalDocsLoading)
            {
                <LoadingIndicator Message="Documents are being retrieved, please wait…" />
            }
            else if (modalDocuments.Count == 0)
            {
                <p><em>No documents have been attached for this supplier.</em></p>
            }
            else
            {
                <div class="di-docsall-toolbar">
                    <span class="di-docsall-count">@modalDocuments.Count document(s)</span>
                    <div class="di-docsall-toolbar-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenImagesPdfAsync">All images as PDF</button>
                        <button type="button" class="btn btn-sm btn-dark" @onclick="DownloadAllZipAsync" disabled="@(zipDownloading || downloadingDocId is not null)">
                            @if (zipDownloading)
                            {
                                <span class="di-dl-spinner" aria-hidden="true"></span>
                                <span>@(dlPercent < 0 ? "Downloading…" : $"Downloading… {dlPercent}%")</span>
                            }
                            else
                            {
                                <span>⬇ Download all (zip)</span>
                            }
                        </button>
                    </div>
                </div>
                @if (zipDownloading)
                {
                    <div class="di-dl-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(dlPercent < 0 ? 0 : dlPercent)">
                        <div class="di-dl-progress-track">
                            <div class="di-dl-progress-fill @(dlPercent < 0 ? "di-dl-indeterminate" : "")"
                                 style="@(dlPercent < 0 ? "" : $"width:{dlPercent}%")"></div>
                        </div>
                        <span class="di-dl-progress-label">
                            @if (dlPercent < 0)
                            {
                                <text>Preparing your download…</text>
                            }
                            else
                            {
                                <text>@dlPercent%@(string.IsNullOrEmpty(dlTotalText) ? "" : $" — {dlReceivedText} of {dlTotalText}")</text>
                            }
                        </span>
                    </div>
                }
                <div class="di-docsall-grid">
                    @foreach (var doc in modalDocuments)
                    {
                        <div class="di-docsall-card">
                            <div class="di-docsall-preview">
                                @if (!previewLoaded.Contains(doc.Id))
                                {
                                    <div class="di-preview-loading">
                                        <span class="di-preview-spinner" aria-hidden="true"></span>
                                        <span>Loading preview…</span>
                                    </div>
                                }
                                @if (IsImage(doc))
                                {
                                    <img src="/suppliers/documents/@doc.Id" alt="@doc.FileName" loading="lazy"
                                         @onload="() => MarkPreviewLoaded(doc.Id)" @onerror="() => MarkPreviewLoaded(doc.Id)" />
                                }
                                else
                                {
                                    <iframe src="/suppliers/documents/@doc.Id#toolbar=0&navpanes=0&view=FitH" title="@doc.FileName" loading="lazy"
                                            @onload="() => MarkPreviewLoaded(doc.Id)"></iframe>
                                }
                            </div>
                            <div class="di-docsall-info">
                                <span class="di-docsall-type badge">@SplitDocType(doc.DocumentType)</span>
                                <span class="di-docsall-name" title="@doc.FileName">@doc.FileName</span>
                            </div>
                            <div class="di-docsall-actions">
                                <a class="btn btn-sm btn-outline-primary" href="/suppliers/documents/@doc.Id" target="_blank" title="Open in a new tab">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" /><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" /></svg>
                                    Open
                                </a>
                                <button type="button" class="btn btn-sm btn-primary" title="Download the original file"
                                        @onclick="() => DownloadDocAsync(doc)"
                                        disabled="@(zipDownloading || downloadingDocId is not null)">
                                    @if (downloadingDocId == doc.Id)
                                    {
                                        <span class="di-dl-spinner" aria-hidden="true"></span>
                                        <span>@(dlPercent < 0 ? "Downloading…" : $"{dlPercent}%")</span>
                                    }
                                    else
                                    {
                                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" /></svg>
                                        <span>Download</span>
                                    }
                                </button>
                            </div>
                            @if (downloadingDocId == doc.Id)
                            {
                                <div class="di-dl-progress di-dl-progress-card" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(dlPercent < 0 ? 0 : dlPercent)">
                                    <div class="di-dl-progress-track">
                                        <div class="di-dl-progress-fill @(dlPercent < 0 ? "di-dl-indeterminate" : "")"
                                             style="@(dlPercent < 0 ? "" : $"width:{dlPercent}%")"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="small text-muted mt-2">Tip: click a preview's Open to view full size, or Download to save the original. Esc closes.</div>
            }
        </div>
    </div>
}

@* ---- Advanced Print dialog: pick columns, print every row in the active tab (not just this page) ---- *@
@if (showPrintDialog)
{
    <div class="di-print-backdrop no-print" @onclick="ClosePrintDialog"></div>
    <div class="di-print-dialog no-print" role="dialog" aria-modal="true" aria-label="Print options">
        <div class="di-print-head">
            <div class="di-print-head-icon">
                <svg width="22" height="22" viewBox="0 0 48 48" fill="none"><path d="M14 6h20v11H14z" fill="#fff" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/><rect x="7" y="16" width="34" height="17" rx="3.5" fill="#fff" opacity=".55"/><rect x="14" y="29" width="20" height="13" rx="1.5" fill="#fff" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/></svg>
            </div>
            <div>
                <h3 class="di-print-title">Print Suppliers</h3>
                <p class="di-print-sub">Choose the columns to include. All <strong>@TabFilteredSuppliers.Count()</strong> supplier(s) in the “@ActiveTabLabel” tab will be printed — not just this page.</p>
            </div>
            <button type="button" class="di-print-x" aria-label="Close" @onclick="ClosePrintDialog">✕</button>
        </div>

        <div class="di-print-body">
            <div class="di-print-toolbar">
                <span class="di-print-count">@printColumns.Count(c => c.Selected) of @printColumns.Count columns</span>
                <div class="di-print-toolbar-actions">
                    <button type="button" class="di-chip-btn" @onclick="SelectAllPrintColumns">Select all</button>
                    <button type="button" class="di-chip-btn" @onclick="SelectDefaultPrintColumns">Default</button>
                    <button type="button" class="di-chip-btn" @onclick="ClearPrintColumns">Clear</button>
                </div>
            </div>
            <div class="di-print-cols">
                @foreach (var col in printColumns)
                {
                    <label class="di-print-col @(col.Selected ? "is-on" : "")">
                        <input type="checkbox" checked="@col.Selected" @onchange="e => { col.Selected = e.Value is true; }" />
                        <span>@col.Label</span>
                    </label>
                }
            </div>
            <div class="di-print-hint">
                <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/></svg>
                <span>Layout adapts automatically: <strong>@(printColumns.Count(c => c.Selected) > 5 ? "landscape" : "portrait")</strong> orientation for @printColumns.Count(c => c.Selected) selected column(s).</span>
            </div>
        </div>

        <div class="di-print-actions">
            <button type="button" class="di-btn2 di-btn2-ghost" @onclick="ClosePrintDialog">Cancel</button>
            <button type="button" class="di-btn2 di-btn2-primary" @onclick="DoPrintAsync" disabled="@(!printColumns.Any(c => c.Selected))">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/><path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a1 1 0 0 0-1 1v3h8v-3a1 1 0 0 0-1-1H5z"/></svg>
                Print @TabFilteredSuppliers.Count() row(s)
            </button>
        </div>
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
    }

    /* KPI stat-tile styles are defined globally + theme-aware in app.css (shared with Manage Customer). */

    .di-bulk-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #eef1ff;
        border: 1px solid #c7d0f7;
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 12px;
    }

    .di-bell {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        margin-left: 6px;
        color: #b5892f;
        text-decoration: none;
        font-size: 0.85em;
        font-weight: 700;
    }

    .di-bell:hover {
        color: #8a6a1f;
    }

    /* Business Unit filter dropdown (custom, so each option can show the BU logo) */
    .di-bu-select { position: relative; }
    .di-bu-toggle { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; cursor: pointer; }
    .di-bu-caret { margin-left: auto; color: #6c757d; }
    .di-bu-backdrop { position: fixed; inset: 0; z-index: 1040; background: transparent; }
    .di-bu-menu {
        position: absolute; z-index: 1050; top: calc(100% + 2px); left: 0; right: 0;
        max-height: 320px; overflow-y: auto; background: #fff;
        border: 1px solid var(--di-border, #e2e5ea); border-radius: 8px;
        box-shadow: 0 6px 20px rgba(26, 34, 51, 0.15); padding: 4px;
    }
    .di-bu-item {
        display: flex; align-items: center; gap: 8px; width: 100%; text-align: left;
        border: 0; background: transparent; padding: 6px 8px; border-radius: 6px;
        cursor: pointer; color: #1a2233;
    }
    .di-bu-item:hover, .di-bu-item.active { background: #eef1ff; }
    .di-bu-opt-logo { width: 26px; height: 22px; object-fit: contain; flex: 0 0 auto; }
    .di-row-bu-logo { width: 22px; height: 18px; object-fit: contain; margin-right: 8px; vertical-align: middle; }
    .di-priority { display: inline-block; min-width: 30px; text-align: center; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .di-assign-select { min-width: 150px; max-width: 200px; font-size: 13px; padding: 2px 6px; }
    .di-priority-p1 { background: #fdecec; color: #c0392b; }
    .di-priority-p2 { background: #fdf0dd; color: #b5892f; }
    .di-priority-p3 { background: #e9edfb; color: #3b5bdb; }
    .di-bu-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Attached-documents viewer modal */
    .di-modal-backdrop { position: fixed; inset: 0; z-index: 1055; background: rgba(0, 0, 0, 0.45); }
    .di-modal {
        position: fixed; z-index: 1060; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: min(1160px, 95vw); max-height: 92vh; display: flex; flex-direction: column;
        background: #fff; border-radius: 10px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }
    .di-modal-head {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 12px 16px; border-bottom: 1px solid var(--di-border, #e2e5ea);
    }
    .di-modal-body { padding: 12px 16px; overflow: auto; outline: none; }

    /* Advanced modal: gradient header with icon + subtitle, softer frame. */
    .di-modal-adv { border-radius: 16px; overflow: hidden; box-shadow: 0 24px 60px rgba(2, 10, 40, .4); }
    .di-modal-adv .di-modal-head {
        align-items: flex-start; gap: 14px; padding: 18px 20px; border-bottom: 0;
        background: linear-gradient(135deg, #0b2545, #274a7d); color: #fff;
    }
    .di-modal-head-icon { flex: none; width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.16); }
    .di-modal-head-text { min-width: 0; flex: 1; }
    .di-modal-title { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.2; }
    .di-modal-subtitle { margin: 3px 0 0; font-size: 12.5px; color: #cdd8ec; }
    .di-modal-x { flex: none; background: rgba(255,255,255,.14); border: 0; color: #fff; width: 30px; height: 30px; border-radius: 8px; cursor: pointer; font-size: 13px; }
    .di-modal-x:hover { background: rgba(255,255,255,.28); }
    .di-modal-adv .di-modal-body { padding: 16px 20px; }

    /* All-documents grid (preview + open + download on one screen) */
    .di-docsall-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
    .di-docsall-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .di-docsall-count { font-size: 13px; font-weight: 600; color: #46506b; }

    /* "Download all (zip)" progress bar + button spinner. */
