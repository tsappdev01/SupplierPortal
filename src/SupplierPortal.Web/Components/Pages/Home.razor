@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserService UserService

<PageTitle>Supplier Portal</PageTitle>

@if (user is not null)
{
    <div class="di-home-profile">
        @if (hasPhoto)
        {
            <img src="/users/@user.Id/photo" alt="" class="di-home-photo" />
        }
        else
        {
            <span class="di-home-photo di-home-initials">@GetInitials(user.FullName ?? user.Username)</span>
        }
        <div>
            <div class="di-home-name">@(user.FullName ?? user.Username)</div>
            @if (user.Designation is { } designation)
            {
                <div class="di-home-designation">@designation</div>
            }
        </div>
    </div>

    <div class="di-launch">
        <a class="di-launch-card di-launch-supplier" href="/supplier/dashboard">
            <span class="di-launch-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7 12 3 4 7l8 4 8-4Z"/><path d="M4 7v10l8 4 8-4V7"/><path d="m12 11 0 10"/></svg>
            </span>
            <span class="di-launch-body">
                <span class="di-launch-title">Launch Supplier</span>
                <span class="di-launch-sub">Manage suppliers, notifications and self-service.</span>
            </span>
            <span class="di-launch-arrow">→</span>
        </a>

        @if (isLeasingUser)
        {
            <a class="di-launch-card di-launch-landlord" href="/admin/land-register">
                <span class="di-launch-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/></svg>
                </span>
                <span class="di-launch-body">
                    <span class="di-launch-title">Landlord Portal</span>
                    <span class="di-launch-sub">Property list, landlord registrations and reviews.</span>
                </span>
                <span class="di-launch-arrow">→</span>
            </a>
        }
    </div>

    <h1>User Information</h1>
    <table class="table di-home-table">
        <tbody>
            <tr>
                <th>Username</th>
                <td>@user.Username</td>
            </tr>
            <tr>
                <th>Full Name</th>
                <td>@(user.FullName ?? "-")</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@user.Email</td>
            </tr>
            <tr>
                <th>Designation</th>
                <td>@(user.Designation ?? "-")</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>@(user.UserType switch { UserType.Administrator => "Administrator", UserType.LeasingManager => "Leasing Manager", _ => "Normal User" })</td>
            </tr>
        </tbody>
    </table>

    <h2>Business Unit</h2>
    @if (user.BusinessUnits.Count == 0)
    {
        <p class="text-muted">No Business Unit assigned.</p>
    }
    else
    {
        <table class="table di-home-table">
            <thead>
                <tr>
                    <th>Business Unit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var businessUnit in user.BusinessUnits)
                {
                    <tr>
                        <td>
                            <span class="di-home-bu">
                                @if (businessUnit.Logo is not null)
                                {
                                    <img src="/business-units/@businessUnit.Id/logo" alt="" class="di-home-bu-logo" />
                                }
                                else
                                {
                                    <span class="di-home-bu-logo di-home-bu-placeholder">@GetInitials(businessUnit.Name)</span>
                                }
                                <span>@businessUnit.Name</span>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<style>
    .di-launch {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }

    .di-launch-card {
        flex: 1 1 320px;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.4rem;
        border-radius: 12px;
        text-decoration: none;
        color: #fff;
        background: linear-gradient(135deg, #1a2233 0%, #2b3855 100%);
        box-shadow: 0 6px 18px rgba(26, 34, 51, .18);
        transition: transform .12s ease, box-shadow .12s ease;
    }

    .di-launch-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 26px rgba(26, 34, 51, .28);
        color: #fff;
    }

    .di-launch-landlord {
        background: linear-gradient(135deg, #0e3a66 0%, #164a7b 100%);
    }

    .di-launch-ico {
        flex: none;
        width: 52px;
        height: 52px;
        border-radius: 12px;
        background: rgba(255, 255, 255, .12);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #c8a24a;
    }

    .di-launch-ico svg { width: 28px; height: 28px; }
    .di-launch-body { flex: 1; display: flex; flex-direction: column; }
    .di-launch-title { font-size: 1.15rem; font-weight: 700; }
    .di-launch-sub { font-size: .85rem; color: rgba(255, 255, 255, .75); margin-top: 2px; }
    .di-launch-arrow { font-size: 1.4rem; opacity: .8; }

    .di-home-profile {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.5rem;
    }

    .di-home-photo {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .di-home-initials {
        background: #1a2233;
        color: #b5892f;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .di-home-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1a2233;
    }

    .di-home-designation {
        font-size: 0.9rem;
        color: #7b8697;
    }

    .di-home-table {
        max-width: 640px;
        background: #fff;
        border: 1px solid #e2e5ea;
        border-radius: 8px;
        overflow: hidden;
    }

    .di-home-table th {
        width: 200px;
        color: #1a2233;
        background: #f4f6f9;
    }

    .di-home-bu {
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

    .di-home-bu-logo {
        height: 32px;
        max-width: 110px;
        object-fit: contain;
        border: 1px solid #e2e5ea;
        border-radius: 4px;
        background: #fff;
        padding: 2px 5px;
    }

    .di-home-bu-placeholder {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 32px;
        background: #1a2233;
        color: #c8a24a;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0;
    }
</style>

@code {
    private User? user;
    private bool hasPhoto;
    private bool isLeasingUser;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.GetUserId();
        user = await UserService.GetByIdAsync(userId);
        hasPhoto = state.User.HasPhoto();
        isLeasingUser = state.User.IsLeasingUser();
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }
}
