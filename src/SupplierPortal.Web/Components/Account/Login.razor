@page "/account/login"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.ComponentModel.DataAnnotations
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@layout Layout.AccountLayout
@inject AuthService AuthService
@inject AuditService AuditService
@inject NavigationManager NavigationManager

<PageTitle>Login - Supplier Portal</PageTitle>

<h1>Login</h1>

<EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label for="email" class="form-label">Email or Login name</label>
        <InputText id="email" class="form-control" @bind-Value="Input.Email" autocomplete="username" placeholder="you@company.com or DOMAIN\login" />
        <div class="form-text">Local users sign in with their email; Active Directory users can use their login name (e.g. DOMAIN\login) or email.</div>
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="Input.Password" autocomplete="current-password" />
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary">Log in</button>
</EditForm>

<p class="mt-3">Don't have an account? <a href="/account/register">Register</a></p>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? errorMessage;

    private async Task LoginAsync()
    {
        var (success, error, user) = await AuthService.ValidateCredentialsAsync(Input.Email, Input.Password);
        if (!success || user is null)
        {
            errorMessage = error;
            return;
        }

        var principal = AuthService.BuildPrincipal(user);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
        await AuditService.LogAsync(user.Username, AuditAction.Login, "User", user.Id);

        NavigationManager.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl, forceLoad: true);
    }

    private sealed class LoginModel
    {
        // Accepts an email (local users) or an AD login name such as DOMAIN\login (Active Directory
        // users), so [EmailAddress] is intentionally not applied. AuthService matches either form.
        [Required]
        [Display(Name = "Email or Login name")]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}
