@page "/customer/self-service/{Token}/form"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@using SupplierPortal.Web.Models.Customer
@using SupplierPortal.Web.Services
@using SupplierPortal.Web.Services.SelfService
@inject ICustomerSelfServiceDataGateway DataGateway
@inject PublicBrandingState PublicBranding
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Customer Information - Customer Portal</PageTitle>

<div class="di-selfservice-wrap">
    @if (loading)
    {
        <LoadingIndicator Message="Loading your information…" />
    }
    else if (customer is null)
    {
        <div class="di-ss-card">
            <h1>Session Expired</h1>
            <p class="text-muted">
                Your verification session is no longer valid. Please use the link from your email
                again to restart verification.
            </p>
        </div>
    }
    else if (completed)
    {
        <div class="di-ss-card">
            <h1>Thank You</h1>
            <p class="text-muted">
                Your information has been submitted successfully. Our team will review the changes shortly.
            </p>
        </div>
    }
    else
    {
        <div class="di-form-page">
            <div class="di-form-topbar">
                <div class="di-form-headings">
                    <h1 class="di-form-title">@(string.IsNullOrWhiteSpace(customer.LegalName) ? "Your Information" : customer.LegalName)</h1>
                    <p class="di-form-sub">Please review and update your information below.</p>
                </div>
                <div class="di-progress" title="@ProgressPct% complete">
                    <svg class="di-progress-ring" viewBox="0 0 36 36">
                        <circle class="di-progress-bg" cx="18" cy="18" r="15.9155"></circle>
                        <circle class="di-progress-bar" cx="18" cy="18" r="15.9155" style="stroke-dasharray:@ProgressPct.ToString(System.Globalization.CultureInfo.InvariantCulture) 100"></circle>
                    </svg>
                    <div class="di-progress-center">
                        <span class="di-progress-pct">@ProgressPct%</span>
                        <span class="di-progress-word">Complete</span>
                    </div>
                </div>
            </div>

            <div class="di-stepper">
                @for (var i = 0; i < steps.Count; i++)
                {
                    var idx = i;
                    var reached = idx <= current;
                    <button type="button"
                            class="di-stepper-item @(idx == current ? "active" : "") @(reached ? "reached" : "")"
                            @onclick="() => JumpToAsync(idx)">
                        <span class="di-stepper-num">@(idx < current ? "✓" : (idx + 1).ToString())</span>
                        <span class="di-stepper-label">@steps[idx].Title</span>
                    </button>
                }
            </div>

            @if (message is not null)
            {
                <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
            }

            @{ var step = steps[current]; }

            @if (step.Group == "Documents")
            {
                <div class="di-section">
                    <div class="di-section-header">
                        <div class="di-section-heading">
                            <span class="di-section-title">KYC Documents</span>
                            <span class="di-section-desc">Please upload the required identity &amp; verification documents.</span>
                        </div>
                    </div>
                    <div class="di-section-body" style="grid-template-columns: 1fr;">
                        <CustomerDocuments CustomerId="customer.Id" SelfService="true" CurrentUser="@currentUser"
                                           Types="docTypes"
                                           SsGateway="DataGateway" SsToken="@activeToken" SsSession="@activeSession" OnChanged="OnDocsChanged" />
                    </div>
                </div>
            }
            else if (!step.IsReview)
            {
                var entity = step.Section == "Account" ? (object)customer : contact;
                <div class="di-section">
                    <div class="di-section-header">
                        <div class="di-section-heading">
                            <span class="di-section-title">@step.Title</span>
                        </div>
                    </div>
                    <div class="di-section-body">
                        @{ var lastSub = (string?)null; }
                        @foreach (var f in FieldsFor(step))
                        {
                            var cfg = f;
                            if (cfg.Section == "Account" && cfg.FieldKey == "CountryName") { continue; }
                            var target = entity;
                            var isCombinedCountry = cfg.Section == "Account" && cfg.FieldKey == "CountryCode";
                            var editable = !string.Equals(cfg.CustomerControl, CustomerFieldControls.Readonly, StringComparison.OrdinalIgnoreCase);
                            var cur = CustomerFieldAccessor.GetString(target, cfg.FieldKey);
                            var sub = step.Group == "Identification" ? Subcategory(cfg.FieldKey) : null;
                            if (sub is not null && sub != lastSub)
                            {
                                lastSub = sub;
                                <div class="di-subheading">@sub</div>
                            }
                            <div class="di-field">
                                <label>
                                    @(isCombinedCountry ? "Country" : cfg.DisplayLabel)
                                    @if (cfg.IsRequired) { <span class="di-req">*</span> }
                                </label>
                                @if (!editable)
                                {
                                    <input type="text" class="di-frozen" value="@CustomerFieldAccessor.GetDisplay(target, cfg.FieldKey)" disabled />
                                }
                                else if (cfg.FieldKind == "date")
                                {
                                    @* Calendar-only (no manual typing); past-only fields cap at today. *@
                                    <input type="date" value="@cur" max="@DateMax(cfg.FieldKey)"
                                           onkeydown="return false" onpaste="return false"
                                           @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                                }
                                else if (cfg.FieldKind == "yesno")
                                {
                                    <div class="di-switch-wrap">
                                        <button type="button" role="switch" aria-checked="@(cur == "true" ? "true" : "false")"
                                                class="di-switch @(cur == "true" ? "on" : "") @(cur == "false" ? "off" : "")"
                                                @onclick='() => OnChange(target, cfg.FieldKey, cur == "true" ? "false" : "true")'>
                                            <span class="di-switch-knob"></span>
                                        </button>
                                        <span class="di-switch-text">@(cur == "true" ? "Yes" : cur == "false" ? "No" : "—")</span>
                                    </div>
                                }
                                else if (isCombinedCountry)
                                {
                                    <select value="@cur" @onchange="e => OnCountryChange(target, e.Value?.ToString())">
                                        <option value="">— Select —</option>
                                        @foreach (var c in CustomerLookups.Countries)
                                        {
                                            <option value="@c.Code" selected="@(c.Code == cur)">@c.Code - @c.Name</option>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(cur) && !CustomerLookups.Countries.Any(c => c.Code == cur))
                                        {
                                            <option value="@cur" selected>@cur</option>
                                        }
                                    </select>
                                }
                                else if (cfg.FieldKind == "lookup")
                                {
                                    var opts = CustomerLookups.For(cfg.Section, cfg.FieldKey);
                                    <select value="@cur" @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())">
                                        <option value="">— Select —</option>
                                        @foreach (var o in opts)
                                        {
                                            <option value="@o" selected="@(o == cur)">@o</option>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(cur) && !opts.Contains(cur))
                                        {
                                            <option value="@cur" selected>@cur</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" value="@cur"
                                           maxlength="@MaxLenFor(cfg.FieldKey)"
                                           inputmode="@(MaxLenFor(cfg.FieldKey) is null ? null : "numeric")"
                                           @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="di-form-sub mb-3">Review everything captured, then submit.</p>
                @foreach (var g in steps.Where(s => !s.IsReview && s.Group != "Documents"))
                {
                    var entity = g.Section == "Account" ? (object)customer : contact;
                    var filled = FieldsFor(g).Where(f => !string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(entity, f.FieldKey))).ToList();
                    <div class="di-section">
                        <div class="di-section-header">
                            <div class="di-section-heading"><span class="di-section-title">@g.Title</span></div>
                            <button type="button" class="di-btn di-btn-secondary di-btn-sm ms-auto" @onclick="() => JumpToAsync(steps.IndexOf(g))">Edit</button>
                        </div>
                        <div class="di-section-body">
                            @if (filled.Count == 0)
                            {
                                <div class="di-review-empty">Nothing entered.</div>
                            }
                            else
                            {
                                @foreach (var f in filled)
                                {
                                    <div class="di-review-item">
                                        <div class="di-review-label">@f.DisplayLabel</div>
                                        <div class="di-review-value">@CustomerFieldAccessor.GetDisplay(entity, f.FieldKey)</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }

            <div class="di-form-footer">
                <button type="button" class="di-btn di-btn-secondary" disabled="@(current == 0 || busy)" @onclick="BackAsync">← Back</button>
                <div class="di-form-footer-right">
                    @if (savedTick) { <span class="di-saved-tick">Saved ✓</span> }
                    @if (!steps[current].IsReview)
                    {
                        <button type="button" class="di-btn di-btn-primary" disabled="@busy" @onclick="NextAsync">Save &amp; Next →</button>
                    }
                    else
                    {
                        <button type="button" class="di-btn di-btn-gold" disabled="@busy" @onclick="SubmitAsync">Submit</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (showDeclaration && customer is not null)
{
    <div class="di-decl-backdrop">
        <div class="di-decl" role="dialog" aria-modal="true">
            <div class="di-decl-head">
                <h2 class="di-decl-title">@DeclarationTitle</h2>
                <div class="di-decl-subtitle">@DeclarationSubtitle</div>
            </div>
            <div class="di-decl-body">
                <p class="di-decl-section">Declaration (For true and correct information provided):</p>
                <p>@GeneralDeclaration</p>
                <p class="di-decl-certify">@DeclarationCertify</p>

                <label class="di-decl-siglabel">Full Name (Digital Signature)</label>
                <input type="text" class="di-decl-sig" @bind="declarationSignature" @bind:event="oninput"
                       placeholder="Type your full name here" />

                <label class="di-decl-siglabel" style="margin-top:14px;">Sign here <span class="di-req">*</span></label>
                <div class="di-sigpad-wrap">
                    <canvas @ref="sigCanvas" class="di-sigpad"></canvas>
                    <button type="button" class="di-sigpad-clear" @onclick="ClearSignatureAsync" title="Clear signature">Clear</button>
                </div>
                <div class="di-sigpad-hint">Draw your signature in the box using your mouse (or finger on a touch screen).</div>
            </div>
            <div class="di-decl-actions">
                <button type="button" class="di-btn di-btn-secondary" @onclick="CancelDeclaration" disabled="@busy">Cancel</button>
                <button type="button" class="di-btn di-btn-primary" @onclick="ConfirmDeclarationAsync"
                        disabled="@(busy || string.IsNullOrWhiteSpace(declarationSignature))">
                    Agree &amp; Submit
                </button>
            </div>
        </div>
    </div>
}

<style>
    .di-selfservice-wrap { width: 100%; display: flex; justify-content: center; }
    .di-selfservice-wrap .di-form-page { width: 100%; max-width: 1000px; }
    .di-ss-card { width: 100%; max-width: 420px; background: #fff; border-radius: 8px; border: 1px solid #e2e5ea; box-shadow: 0 1px 4px rgba(0,0,0,0.06); padding: 2rem; }
</style>

@code {
    [Parameter] public string Token { get; set; } = "";
    [SupplyParameterFromQuery(Name = "s")] public string? SessionToken { get; set; }

    private record Step(string Title, string Section, string? Group, bool IsReview);

    private Customer? customer;
    private CustomerContact contact = new();
    private List<CustomerFieldConfig> config = [];
    private List<SsCustomerTab> tabs = [];
    private List<CustomerDocumentType> docTypes = [];
    private List<Step> steps = [];
    private int current;

    /// <summary>Percent complete for the header progress ring (current step of total), matching the supplier form.</summary>
    private int ProgressPct => steps.Count == 0
        ? 0 : (int)Math.Round(Math.Clamp(current + 1, 1, steps.Count) / (double)steps.Count * 100);
    private string currentUser = "Customer Self-Service";
    private string? message;
    private bool isError;
    private bool busy;
    private bool savedTick;
    private bool loading = true;
    private bool completed;

    // Pin the link + session from the first (query-bound) render. A later interactive re-render can re-bind
    // [SupplyParameterFromQuery] to null without re-running OnInitializedAsync (so the form stays visible),
    // which would blank the session passed to gateway calls and surface a spurious "session expired" on
    // document upload/save. Passing these stable copies keeps every gateway call on the loaded session.
    private string activeToken = "";
    private string activeSession = "";

    protected override async Task OnInitializedAsync()
    {
        activeToken = Token;
        activeSession = SessionToken ?? "";

        // All data comes through the gateway — the database on the internal side, or the internal API on
        // the DMZ. No direct database access here.
        SsCustomerFormData? bundle = null;
        if (!string.IsNullOrWhiteSpace(activeSession))
        {
            bundle = await DataGateway.LoadFormAsync(activeToken, activeSession);
        }

        if (bundle is not null)
        {
            customer = bundle.Customer;
            config = bundle.Config;
            tabs = bundle.Tabs;
            docTypes = bundle.DocTypes;
            contact = customer.Contact ??= new CustomerContact { CustomerId = customer.Id };
            currentUser = $"Customer Self-Service ({CustomerAccessTokenService.EmailFor(customer)})";
            PublicBranding.SetLogo(bundle.LogoSrc);
            BuildSteps();
        }

        loading = false;
    }

    private void BuildSteps()
    {
        // Honour the admin-configured tabs (title, order, visibility) sent in the bundle. Fall back to
        // deriving tabs from the field config's groups if none were sent.
        var orderedTabs = (tabs.Count > 0
                ? tabs.Where(t => t.IsVisible)
                : config.Where(f => f.IsVisible)
                    .GroupBy(f => new { f.Section, f.GroupName })
                    .Select(g => new SsCustomerTab(g.Key.Section, g.Key.GroupName, g.Key.GroupName, g.Min(x => x.Sequence), true)))
            .OrderBy(t => t.Section == "Account" ? 0 : 1).ThenBy(t => t.Sequence).ThenBy(t => t.GroupName)
            .ToList();

        var list = new List<Step>();
        foreach (var t in orderedTabs)
            if (config.Any(f => f.IsVisible && f.Section == t.Section && f.GroupName == t.GroupName))
                list.Add(new Step(t.Title, t.Section, t.GroupName, false));
        list.Add(new Step("Documents", "", "Documents", false));
        list.Add(new Step("Review & Submit", "", null, true));
        steps = list;
    }

    private IEnumerable<CustomerFieldConfig> FieldsFor(Step step) =>
        config.Where(f => f.IsVisible && f.Section == step.Section && f.GroupName == step.Group).OrderBy(f => f.Sequence);

    private static string? Subcategory(string fieldKey) => fieldKey switch
    {
        "Passport" or "PassportNumber" or "PassportIssueDate" or "PassportExpiryDate"
            or "PassportIssueCountryCode" or "PassportIssuePlaceCountry"
            or "DualPassport" or "DualPassportNumber" or "DualPassportIssueDate" or "DualPassportExpiryDate"
            => "Passport Information",
        "VISAExpiryDate" or "VISANumber" => "Visa Information",
        "TypeOfID" or "CountryGovtIDNumber" or "CountryGovtIDIssueDate" or "CountryGovtIDExpiryDate"
            or "EmirateID" or "EmirateIDExpiryDate" or "EmiratesIDIssueDate" or "IssueCountry"
            => "Government / National ID",
        _ => null
    };

    private void OnChange(object entity, string key, string? value) => CustomerFieldAccessor.SetString(entity, key, value);

    private void OnDocsChanged() => StateHasChanged();

    private void OnCountryChange(object entity, string? code)
    {
        CustomerFieldAccessor.SetString(entity, "CountryCode", code);
        var name = CustomerLookups.Countries.FirstOrDefault(c => c.Code == code).Name;
        CustomerFieldAccessor.SetString(entity, "CountryName", string.IsNullOrWhiteSpace(code) ? null : name);
    }

    private async Task SaveAsync(bool silent)
    {
        if (customer is null) return;
        busy = true;
        if (!silent) message = null;
        customer.Contact = contact;
        var result = await DataGateway.SaveAsync(activeToken, activeSession, customer, complete: false);
        // Sync the 1:1 contact's database id so a subsequent save updates the same row.
        if (result.Success && result.Saved?.Contact is { Id: > 0 } savedContact)
        {
            contact.Id = savedContact.Id;
        }
        busy = false;
        savedTick = true;
    }

    private async Task NextAsync()
    {
        await SaveAsync(true);
        var problems = MissingRequired(steps[current]).Select(m => $"{m} is required.")
            .Concat(DateErrorsForStep(steps[current]))
            .Concat(FormatErrors(FieldsFor(steps[current]))).ToList();
        if (problems.Count > 0)
        {
            ToastService.ShowErrors(problems);
            return;
        }
        if (current < steps.Count - 1) current++;
        message = null;
    }

    // Stricter than DataAnnotations' EmailAddressAttribute (which accepts "a@b" with no domain dot):
    // requires a local part, "@", and a domain with a dot and a 2+ character TLD.
    private static readonly System.Text.RegularExpressions.Regex EmailRegex = new(
        @"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$",
        System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    private static bool IsValidEmail(string? value) =>
        !string.IsNullOrWhiteSpace(value) && EmailRegex.IsMatch(value.Trim());

    /// <summary>Input maxlength for the fixed-length numeric identifiers (null = no cap, attribute omitted):
    /// Buyer TIN is 10 digits, the TRN 15 digits.</summary>
    private static int? MaxLenFor(string fieldKey) => fieldKey switch
    {
        "CustomerBuyerTIN" => 10,
        "TRNNumber" => 15,
        _ => null
    };

    private static bool IsDigits(string value, int length)
    {
        var d = value.Replace(" ", "").Replace("-", "");
        return d.Length == length && d.All(char.IsDigit);
    }

    private List<string> FormatErrors(IEnumerable<CustomerFieldConfig> fields)
    {
        var errs = new List<string>();
        if (customer is null) return errs;
        foreach (var f in fields)
        {
            var entity = f.Section == "Account" ? (object)customer : contact;
            var val = CustomerFieldAccessor.GetString(entity, f.FieldKey);
            if (string.IsNullOrWhiteSpace(val)) continue;
            if (f.FieldKey.Contains("Email", StringComparison.OrdinalIgnoreCase) && !IsValidEmail(val))
            {
                errs.Add($"{f.DisplayLabel} is not a valid email address.");
            }
            else if (f.FieldKey == "CustomerBuyerTIN" && !IsDigits(val, 10))
            {
                errs.Add("Customer/Buyer TIN must be exactly 10 digits.");
            }
            else if (f.FieldKey == "TRNNumber" && !IsDigits(val, 15))
            {
                errs.Add("TRN Number must be exactly 15 digits.");
            }
        }
        return errs;
    }

    private List<string> MissingRequired(Step step)
    {
        if (step.IsReview || customer is null) return [];
        var entity = step.Section == "Account" ? (object)customer : contact;
        return config
            .Where(f => f.IsVisible && f.IsRequired && f.Section == step.Section && f.GroupName == step.Group)
            .Where(f => !(f.Section == "Account" && f.FieldKey == "CountryName"))
            .Where(f => string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(entity, f.FieldKey)))
            .Select(f => f.DisplayLabel)
            .ToList();
    }

    private static string? DateMax(string fieldKey) =>
        (fieldKey.Contains("Issue", StringComparison.OrdinalIgnoreCase)
         || fieldKey.Equals("EstablishmentDate", StringComparison.OrdinalIgnoreCase)
         || fieldKey.Equals("DateOfBirth", StringComparison.OrdinalIgnoreCase))
            ? DateTime.Today.ToString("yyyy-MM-dd") : null;

    private List<string> TradeLicenseDateErrors()
    {
        var errs = new List<string>();
        if (customer is null) return errs;
        if (customer.TradeLicenseIssueDate is DateTime issue && issue.Date > DateTime.Today)
        {
            errs.Add("Trade License Issue Date cannot be a future date.");
        }
        if (customer.TradeLicenseIssueDate is DateTime iss && customer.TradeLicenseExpiryDate is DateTime exp
            && exp.Date < iss.Date)
        {
            errs.Add("Trade License Expiry Date cannot be before the Trade License Issue Date.");
        }
        if (customer.EstablishmentDate is DateTime est && est.Date > DateTime.Today)
        {
            errs.Add("Establishment Date cannot be a future date.");
        }
        if (customer.EstablishmentDate is DateTime e2 && customer.TradeLicenseIssueDate is DateTime i2
            && i2.Date < e2.Date)
        {
            errs.Add("Trade License Issue Date cannot be before the Establishment Date.");
        }
        return errs;
    }

    private List<string> DateErrorsForStep(Step step)
    {
        if (step.IsReview || step.Section != "Account") return [];
        var onThisStep = config.Any(f => f.Section == "Account" && f.GroupName == step.Group
            && (f.FieldKey == "TradeLicenseIssueDate" || f.FieldKey == "EstablishmentDate"));
        return onThisStep ? TradeLicenseDateErrors() : [];
    }

    private async Task BackAsync()
    {
        await SaveAsync(true);
        if (current > 0) current--;
        message = null;
    }

    private async Task JumpToAsync(int index)
    {
        if (index == current) return;
        await SaveAsync(true);
        current = Math.Clamp(index, 0, steps.Count - 1);
        message = null;
    }

    private async Task SubmitAsync()
    {
        if (customer is null) return;

        var missing = config.Where(f => f.IsVisible && f.IsRequired)
            .Where(f => !(f.Section == "Account" && f.FieldKey == "CountryName"))
            .Where(f => string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(
                f.Section == "Account" ? (object)customer : contact, f.FieldKey)))
            .Select(f => f.DisplayLabel).ToList();
        if (missing.Count > 0)
        {
            ToastService.ShowErrors(missing.Select(m => $"{m} is required."));
            return;
        }

        var dateErrors = TradeLicenseDateErrors();
        if (dateErrors.Count > 0)
        {
            ToastService.ShowErrors(dateErrors);
            return;
        }

        var formatErrors = FormatErrors(config.Where(f => f.IsVisible));
        if (formatErrors.Count > 0)
        {
            ToastService.ShowErrors(formatErrors);
            return;
        }

        var haveDocs = (await DataGateway.ListDocumentsAsync(activeToken, activeSession)).Select(d => d.DocumentType).ToHashSet();
        var missingDocs = docTypes.Where(t => t.IsRequired && !haveDocs.Contains(t.Name)).Select(t => t.Name).ToList();
        if (missingDocs.Count > 0)
        {
            ToastService.ShowErrors(missingDocs.Select(d => $"{d} document is required."));
            return;
        }

        // The customer must sign the declaration before the record is submitted — open the pop-up; the
        // submission finishes only once signed (see ConfirmDeclarationAsync).
        customer.Contact = contact;
        showDeclaration = true;
    }

    // ---- Declaration + digital signature (mirrors the supplier self-service submit) ----
    private bool showDeclaration;
    private string declarationSignature = "";
    private ElementReference sigCanvas;
    private bool sigInitialized;

    private string DeclarationTitle => "Customer Declaration";
    private string DeclarationSubtitle => "Customer Data Gathering Portal";
    private string GeneralDeclaration =>
        "I/We hereby declare that the information and data provided in this form are true, correct, and " +
        "complete to the best of our knowledge, and are furnished in compliance with the applicable UAE " +
        "regulatory and e-invoicing requirements issued by the Ministry of Finance / Federal Tax Authority. " +
        "We undertake to promptly inform Dubai Investments of any changes to the above.";
    private string DeclarationCertify =>
        "By signing below, I/We acknowledge and accept the declaration set out above.";

    private string DeclarationFullText() => string.Join("\n\n", new[]
    {
        DeclarationTitle, DeclarationSubtitle,
        "Declaration (For true and correct information provided):",
        GeneralDeclaration, DeclarationCertify
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showDeclaration && !sigInitialized)
        {
            sigInitialized = true;
            try { await JS.InvokeVoidAsync("sigpad.init", sigCanvas); } catch { /* best-effort */ }
        }
    }

    private void CancelDeclaration() { showDeclaration = false; sigInitialized = false; }
    private async Task ClearSignatureAsync() { try { await JS.InvokeVoidAsync("sigpad.clear", sigCanvas); } catch { } }

    private async Task ConfirmDeclarationAsync()
    {
        if (customer is null) return;
        if (string.IsNullOrWhiteSpace(declarationSignature))
        {
            ToastService.ShowError("Please type your full name as your signature.");
            return;
        }
        string dataUrl = "";
        try { dataUrl = await JS.InvokeAsync<string>("sigpad.dataUrl", sigCanvas); } catch { }
        if (string.IsNullOrWhiteSpace(dataUrl) || !dataUrl.StartsWith("data:image"))
        {
            ToastService.ShowError("Please draw your signature in the box before submitting.");
            return;
        }
        var comma = dataUrl.IndexOf(',');
        customer.DisclaimerSignatureImage = comma >= 0 ? Convert.FromBase64String(dataUrl[(comma + 1)..]) : null;
        customer.DisclaimerAcknowledged = true;
        customer.DisclaimerAcknowledgedAt = DateTime.UtcNow;
        customer.DisclaimerAcknowledgedBy = currentUser;
        customer.DisclaimerText = DeclarationFullText();
        customer.DisclaimerSignature = declarationSignature.Trim();

        showDeclaration = false;
        sigInitialized = false;

        busy = true; message = null;
        customer.Contact = contact;
        var result = await DataGateway.SaveAsync(activeToken, activeSession, customer, complete: true);
        busy = false;
        if (!result.Success)
        {
            ToastService.ShowError(result.Error ?? "Submission failed. Please try again.");
            return;
        }
        completed = true;
        ToastService.ShowSuccess("Your information has been submitted.");
    }
}
