@page "/admin/customers/{Id:int}"
@attribute [Authorize(Policy = "Portal.Customer")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models.Customer
@using SupplierPortal.Web.Services
@inject CustomerService CustomerService
@inject CustomerFieldConfigService FieldConfigService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>Customer - CST Portal</PageTitle>

@if (customer is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="mb-1">@(string.IsNullOrWhiteSpace(customer.LegalName) ? "New Customer" : customer.LegalName)</h1>
            <span class="badge @StatusClass(customer.Status)">@customer.Status</span>
            @if (customer.CustomerId is not null) { <span class="text-muted ms-2">@customer.CustomerId</span> }
        </div>
        <a class="btn btn-outline-secondary" href="/admin/customers">← Back to list</a>
    </div>

    @* ---------- Chevron stepper ---------- *@
    <div class="di-chevrons">
        @for (var i = 0; i < steps.Count; i++)
        {
            var idx = i;
            <button type="button"
                    class="di-chevron @(idx == current ? "is-active" : "") @(idx < current ? "is-done" : "")"
                    @onclick="() => JumpToAsync(idx)">
                <span class="di-chevron-n">@(idx < current ? "✓" : (idx + 1).ToString())</span>
                <span class="di-chevron-t">@steps[idx].Title</span>
            </button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
    }

    var step = steps[current];

    @if (!step.IsReview)
    {
        var entity = step.Section == "Account" ? (object)customer : contact;
        <div class="di-field-settings-section mt-3">
            <div class="di-field-settings-header">@step.Title</div>
            <div class="row g-3 p-3">
                @foreach (var f in FieldsFor(step))
                {
                    var cfg = f;
                    var target = entity;
                    var editable = !string.Equals(cfg.BusinessControl, CustomerFieldControls.Readonly, StringComparison.OrdinalIgnoreCase);
                    <div class="col-md-4">
                        <label class="form-label">
                            @cfg.DisplayLabel
                            @if (cfg.IsRequired) { <span class="text-danger">*</span> }
                            @if (cfg.FieldKind == "lookup") { <span class="badge bg-info-subtle text-info-emphasis ms-1">LOV</span> }
                        </label>
                        @if (!editable)
                        {
                            <div class="form-control-plaintext border rounded px-2 bg-body-secondary">@CustomerFieldAccessor.GetDisplay(target, cfg.FieldKey)</div>
                        }
                        else if (cfg.FieldKind == "date")
                        {
                            <input type="date" class="form-control" value="@CustomerFieldAccessor.GetString(target, cfg.FieldKey)"
                                   @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                        }
                        else if (cfg.FieldKind == "yesno")
                        {
                            <select class="form-select" value="@CustomerFieldAccessor.GetString(target, cfg.FieldKey)"
                                    @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())">
                                <option value="">—</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        }
                        else
                        {
                            <input type="text" class="form-control" value="@CustomerFieldAccessor.GetString(target, cfg.FieldKey)"
                                   @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @* ---------- Review step ---------- *@
        <p class="text-muted mt-3">Review everything captured, then save or submit for review.</p>
        @foreach (var g in steps.Where(s => !s.IsReview))
        {
            var entity = g.Section == "Account" ? (object)customer : contact;
            var filled = FieldsFor(g).Where(f => !string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(entity, f.FieldKey))).ToList();
            <div class="di-field-settings-section mb-3">
                <div class="di-field-settings-header d-flex justify-content-between">
                    <span>@g.Title</span>
                    <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => JumpToAsync(steps.IndexOf(g))">Edit</button>
                </div>
                <div class="row g-2 p-3">
                    @if (filled.Count == 0)
                    {
                        <div class="text-muted">Nothing entered.</div>
                    }
                    else
                    {
                        @foreach (var f in filled)
                        {
                            <div class="col-md-4">
                                <div class="small text-muted">@f.DisplayLabel</div>
                                <div>@CustomerFieldAccessor.GetDisplay(entity, f.FieldKey)</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }

    @* ---------- Wizard footer ---------- *@
    <div class="d-flex justify-content-between align-items-center gap-2 my-4">
        <button type="button" class="btn btn-outline-secondary" disabled="@(current == 0 || busy)" @onclick="BackAsync">← Back</button>
        <div class="d-flex gap-2">
            @if (savedTick) { <span class="text-success small align-self-center">Saved ✓</span> }
            @if (!steps[current].IsReview)
            {
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="NextAsync">Save &amp; Next →</button>
            }
            else
            {
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => SaveAsync(false)">Save</button>
                @if (customer.Status is CustomerStatuses.NotSubmitted or CustomerStatuses.AwaitingCustomerResponse or CustomerStatuses.Returned)
                {
                    <button type="button" class="btn btn-di-gold" disabled="@busy" @onclick="() => SaveAndSetStatus(CustomerStatuses.ForReview)">Submit for review</button>
                }
                @if (customer.Status == CustomerStatuses.ForReview)
                {
                    <button type="button" class="btn btn-success" disabled="@busy" @onclick="() => SaveAndSetStatus(CustomerStatuses.Complete)">Mark completed</button>
                    <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => SaveAndSetStatus(CustomerStatuses.Returned)">Return</button>
                }
            }
        </div>
    </div>
}

<style>
    .di-chevrons { display: flex; flex-wrap: wrap; gap: 4px; }
    .di-chevron { position: relative; border: 1px solid var(--di-border); background: var(--di-surface);
        color: var(--di-text-soft); padding: .5rem .9rem .5rem 1.1rem; font-size: .8rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: .45rem; cursor: pointer;
        clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%, 12px 50%); }
    .di-chevron:first-child { clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%); padding-left: .9rem; }
    .di-chevron-n { width: 20px; height: 20px; border-radius: 50%; background: var(--di-surface-2);
        display: grid; place-items: center; font-size: .72rem; flex: none; }
    .di-chevron.is-active { background: #0f766e; color: #fff; border-color: #0f766e; }
    .di-chevron.is-active .di-chevron-n { background: rgba(255,255,255,.25); color: #fff; }
    .di-chevron.is-done { color: #0b5a54; border-color: #bfe3de; background: #e7f4f2; }
    [data-theme="dark"] .di-chevron.is-done { color: #8fe6db; background: #123833; border-color: #1c4d47; }
    [data-theme="dark"] .di-chevron.is-active { background: #2bb3a3; border-color: #2bb3a3; color: #05201d; }
    .di-chevron.is-done .di-chevron-n { background: #0f766e; color: #fff; }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private record Step(string Title, string Section, string? Group, bool IsReview);

    private static readonly string[] AccountOrder =
        ["Company Identity & Classification", "Tax, Trade License & Registration", "Contact & Address", "Ownership, Banking & Payment"];
    private static readonly string[] ContactOrder =
        ["Personal Details", "Identification", "Contact & UAE Pass", "Employment & Other"];

    private Customer? customer;
    private CustomerContact contact = new();
    private List<CustomerFieldConfig> config = [];
    private List<Step> steps = [];
    private int current;
    private string currentUser = "unknown";
    private string? message;
    private bool isError;
    private bool busy;
    private bool savedTick;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";
        config = await FieldConfigService.GetAllAsync();
        await LoadAsync();
        BuildSteps();
    }

    private async Task LoadAsync()
    {
        customer = await CustomerService.GetAsync(Id);
        if (customer is null) return;
        contact = customer.Contact ??= new CustomerContact { CustomerId = customer.Id };
    }

    private void BuildSteps()
    {
        var list = new List<Step>();
        foreach (var g in AccountOrder)
            if (config.Any(f => f.IsVisible && f.Section == "Account" && f.GroupName == g))
                list.Add(new Step(g, "Account", g, false));
        foreach (var g in ContactOrder)
            if (config.Any(f => f.IsVisible && f.Section == "Contact" && f.GroupName == g))
                list.Add(new Step(g, "Contact", g, false));
        list.Add(new Step("Review & Save", "", null, true));
        steps = list;
    }

    private IEnumerable<CustomerFieldConfig> FieldsFor(Step step) =>
        config.Where(f => f.IsVisible && f.Section == step.Section && f.GroupName == step.Group)
              .OrderBy(f => f.Sequence);

    private void OnChange(object entity, string key, string? value) => CustomerFieldAccessor.SetString(entity, key, value);

    private async Task SaveAsync(bool silent)
    {
        if (customer is null) return;
        busy = true;
        if (!silent) message = null;
        customer.Contact = contact;
        await CustomerService.SaveAsync(customer, currentUser);
        busy = false;
        if (!silent) { isError = false; message = "Saved."; }
        savedTick = true;
    }

    private async Task NextAsync()
    {
        await SaveAsync(true);
        if (current < steps.Count - 1) current++;
        message = null;
    }

    private async Task BackAsync()
    {
        await SaveAsync(true);
        if (current > 0) current--;
        message = null;
    }

    private async Task JumpToAsync(int index)
    {
        if (index == current) return;
        await SaveAsync(true);
        current = Math.Clamp(index, 0, steps.Count - 1);
        message = null;
    }

    private async Task SaveAndSetStatus(string status)
    {
        if (customer is null) return;
        if (status == CustomerStatuses.ForReview)
        {
            var missing = config.Where(f => f.IsVisible && f.IsRequired)
                .Where(f => string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(
                    f.Section == "Account" ? (object)customer : contact, f.FieldKey)))
                .Select(f => f.DisplayLabel).ToList();
            if (missing.Count > 0)
            {
                isError = true;
                message = "Please complete the required field(s): " + string.Join(", ", missing);
                return;
            }
        }
        busy = true; message = null;
        customer.Contact = contact;
        await CustomerService.SaveAsync(customer, currentUser);
        await CustomerService.SetStatusAsync(customer.Id, status, currentUser);
        customer.Status = status;
        busy = false; isError = false;
        message = $"Saved and moved to “{status}”.";
    }

    private static string StatusClass(string status) => status switch
    {
        CustomerStatuses.Complete => "bg-success-subtle text-success-emphasis",
        CustomerStatuses.ForReview => "bg-warning-subtle text-warning-emphasis",
        CustomerStatuses.Returned => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}
