@page "/admin/customers/{Id:int}"
@attribute [Authorize(Policy = "Portal.Customer")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models.Customer
@using SupplierPortal.Web.Services
@inject CustomerService CustomerService
@inject CustomerFieldConfigService FieldConfigService
@inject CustomerDocumentService DocumentService
@inject CustomerAccessTokenService AccessTokenService
@inject CustomerEmailService CustomerEmailService
@inject UserService UserService
@inject ToastService ToastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>Customer - CST Portal</PageTitle>

@if (customer is null)
{
    <LoadingIndicator Message="Loading customer…" />
}
else
{
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == Tab.Details ? "active" : "")" @onclick="() => activeTab = Tab.Details">
            Customer Details
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == Tab.Documents ? "active" : "")" @onclick="() => activeTab = Tab.Documents">
            Documents@(docCount > 0 ? $" ({docCount})" : "")
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == Tab.EmailHistory ? "active" : "")" @onclick="ShowEmailHistoryAsync">
            Email History@(emailHistory.Count > 0 ? $" ({emailHistory.Count})" : "")
        </button>
    </li>
</ul>

<div style="display:@(activeTab == Tab.Details ? "block" : "none")">
<div class="di-form-page">
    <div class="di-form-topbar">
        <div class="di-form-headings">
            <h1 class="di-form-title">@(string.IsNullOrWhiteSpace(customer.LegalName) ? "New Customer" : customer.LegalName)</h1>
            <p class="di-form-sub">
                <span class="di-status-badge @StatusClass(customer.Status)">@customer.Status</span>
                @if (!string.IsNullOrWhiteSpace(customer.CustomerCode)) { <span class="ms-2">@customer.CustomerCode</span> }
            </p>
        </div>
        <div class="di-form-topbar-right">
            <div class="di-progress" title="@ProgressPct% complete">
                <svg class="di-progress-ring" viewBox="0 0 36 36">
                    <circle class="di-progress-bg" cx="18" cy="18" r="15.9155"></circle>
                    <circle class="di-progress-bar" cx="18" cy="18" r="15.9155" style="stroke-dasharray:@ProgressPct.ToString(System.Globalization.CultureInfo.InvariantCulture) 100"></circle>
                </svg>
                <div class="di-progress-center">
                    <span class="di-progress-pct">@ProgressPct%</span>
                    <span class="di-progress-word">Complete</span>
                </div>
            </div>
            <a class="di-btn di-btn-secondary" href="/admin/customers">← Back to list</a>
        </div>
    </div>

    @* ---------- Stepper (matches the Supplier form) ---------- *@
    <div class="di-stepper">
        @for (var i = 0; i < steps.Count; i++)
        {
            var idx = i;
            var reached = idx <= current;
            <button type="button"
                    class="di-stepper-item @(idx == current ? "active" : "") @(reached ? "reached" : "")"
                    @onclick="() => JumpToAsync(idx)">
                <span class="di-stepper-num">@(idx < current ? "✓" : (idx + 1).ToString())</span>
                <span class="di-stepper-label">@steps[idx].Title</span>
                @if (idx < steps.Count - 1)
                {
                    <svg class="di-stepper-chevron" width="9" height="14" viewBox="0 0 9 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                }
            </button>
        }
    </div>

    @if (message is not null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    @{ var step = steps[current]; }

    @if (step.Group == "Documents")
    {
        <div class="di-section">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5L9.5 0H4zm5 1.5V4a1 1 0 0 0 1 1h2.5L9 1.5z"/></svg>
                </span>
                <div class="di-section-heading">
                    <span class="di-section-title">KYC Documents</span>
                    <span class="di-section-desc">Upload the required identity &amp; verification documents.</span>
                </div>
            </div>
            <div class="di-section-body" style="grid-template-columns: 1fr;">
                <CustomerDocuments CustomerId="customer.Id" CurrentUser="@currentUser" OnChanged="OnDocsChanged" />
            </div>
        </div>
    }
    else if (!step.IsReview)
    {
        var entity = step.Section == "Account" ? (object)customer : contact;
        var tabEditable = CanEditTab(step);
        <div class="di-section">
            @if (!tabEditable)
            {
                <div class="di-tab-readonly-note">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a2 2 0 0 0-2 2v4H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1V3a2 2 0 0 0-2-2H8zm2 6H7V3a1 1 0 0 1 2 0v4h1z"/></svg>
                    <span>This tab is read-only for you. Only authorised users can edit it — contact an administrator to make changes.</span>
                </div>
            }
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M9.05.435c-.58-.58-1.52-.58-2.1 0L.436 6.95c-.58.58-.58 1.519 0 2.098l6.516 6.516c.58.58 1.519.58 2.098 0l6.516-6.516c.58-.58.58-1.519 0-2.098L9.05.435z"/></svg>
                </span>
                <div class="di-section-heading">
                    <span class="di-section-title">@step.Title</span>
                    <span class="di-section-desc">@(step.Section == "Account" ? "Company / account details" : "Primary contact details")</span>
                </div>
            </div>
            <div class="di-section-body">
                @{ var lastSub = (string?)null; }
                @foreach (var f in FieldsFor(step))
                {
                    var cfg = f;
                    // Country Name is merged into the combined Country Code dropdown below, so don't render
                    // it as its own field.
                    if (cfg.Section == "Account" && cfg.FieldKey == "CountryName") { continue; }
                    var target = entity;
                    var isCombinedCountry = cfg.Section == "Account" && cfg.FieldKey == "CountryCode";
                    var editable = tabEditable && !string.Equals(cfg.BusinessControl, CustomerFieldControls.Readonly, StringComparison.OrdinalIgnoreCase);
                    var cur = CustomerFieldAccessor.GetString(target, cfg.FieldKey);
                    var sub = step.Group == "Identification" ? Subcategory(cfg.FieldKey) : null;
                    if (sub is not null && sub != lastSub)
                    {
                        lastSub = sub;
                        <div class="di-subheading">@sub</div>
                    }
                    <div class="di-field">
                        <label>
                            @(isCombinedCountry ? "Country" : cfg.DisplayLabel)
                            @if (cfg.IsRequired) { <span class="di-req">*</span> }
                        </label>
                        @if (!editable)
                        {
                            <input type="text" class="di-frozen" value="@CustomerFieldAccessor.GetDisplay(target, cfg.FieldKey)" disabled />
                        }
                        else if (cfg.FieldKind == "date")
                        {
                            @* Calendar-only: block manual typing/paste so the date can only be picked; past-only
                               fields (issue / establishment / birth) cap at today so a future date can't be chosen. *@
                            <input type="date" value="@cur" max="@DateMax(cfg.FieldKey)"
                                   onkeydown="return false" onpaste="return false"
                                   @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                        }
                        else if (cfg.FieldKind == "yesno")
                        {
                            <div class="di-switch-wrap">
                                <button type="button" role="switch" aria-checked="@(cur == "true" ? "true" : "false")"
                                        class="di-switch @(cur == "true" ? "on" : "") @(cur == "false" ? "off" : "")"
                                        @onclick='() => OnChange(target, cfg.FieldKey, cur == "true" ? "false" : "true")'>
                                    <span class="di-switch-knob"></span>
                                </button>
                                <span class="di-switch-text">@(cur == "true" ? "Yes" : cur == "false" ? "No" : "—")</span>
                            </div>
                        }
                        else if (isCombinedCountry)
                        {
                            @* Combined Country dropdown: shows "AE - United Arab Emirates"; stores the code in
                               CountryCode and the matching name in CountryName. *@
                            <select value="@cur" @onchange="e => OnCountryChange(target, e.Value?.ToString())">
                                <option value="">— Select —</option>
                                @foreach (var c in CustomerLookups.Countries)
                                {
                                    <option value="@c.Code" selected="@(c.Code == cur)">@c.Code - @c.Name</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(cur) && !CustomerLookups.Countries.Any(c => c.Code == cur))
                                {
                                    <option value="@cur" selected>@cur</option>
                                }
                            </select>
                        }
                        else if (cfg.FieldKind == "lookup")
                        {
                            var opts = CustomerLookups.For(cfg.Section, cfg.FieldKey);
                            <select value="@cur" @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())">
                                <option value="">— Select —</option>
                                @foreach (var o in opts)
                                {
                                    <option value="@o" selected="@(o == cur)">@o</option>
                                }
                                @* Preserve any previously-stored value that is not in the current list. *@
                                @if (!string.IsNullOrWhiteSpace(cur) && !opts.Contains(cur))
                                {
                                    <option value="@cur" selected>@cur</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" value="@cur"
                                   maxlength="@MaxLenFor(cfg.FieldKey)"
                                   inputmode="@(MaxLenFor(cfg.FieldKey) is null ? null : "numeric")"
                                   @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @* ---------- Review step ---------- *@
        <p class="di-form-sub mb-3">Review everything captured, then save or submit for review.</p>
        @foreach (var g in steps.Where(s => !s.IsReview && s.Group != "Documents"))
        {
            var entity = g.Section == "Account" ? (object)customer : contact;
            var filled = FieldsFor(g).Where(f => !string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(entity, f.FieldKey))).ToList();
            <div class="di-section">
                <div class="di-section-header">
                    <div class="di-section-heading">
                        <span class="di-section-title">@g.Title</span>
                    </div>
                    <button type="button" class="di-btn di-btn-secondary di-btn-sm ms-auto" @onclick="() => JumpToAsync(steps.IndexOf(g))">Edit</button>
                </div>
                <div class="di-section-body">
                    @if (filled.Count == 0)
                    {
                        <div class="di-review-empty">Nothing entered.</div>
                    }
                    else
                    {
                        @foreach (var f in filled)
                        {
                            <div class="di-review-item">
                                <div class="di-review-label">@f.DisplayLabel</div>
                                <div class="di-review-value">@CustomerFieldAccessor.GetDisplay(entity, f.FieldKey)</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }

    @* ---------- Wizard footer ---------- *@
    <div class="di-form-footer">
        <button type="button" class="di-btn di-btn-secondary" disabled="@(current == 0 || busy)" @onclick="BackAsync">← Back</button>
        <div class="di-form-footer-right">
            @if (savedTick) { <span class="di-saved-tick">Saved ✓</span> }
            @if (!steps[current].IsReview)
            {
                <button type="button" class="di-btn di-btn-primary" disabled="@busy" @onclick="NextAsync">Save &amp; Next →</button>
            }
            else
            {
                <button type="button" class="di-btn di-btn-primary" disabled="@busy" @onclick="() => SaveAsync(false)">Save</button>
                @if (customer.Status is CustomerStatuses.NotSubmitted or CustomerStatuses.AwaitingCustomerResponse or CustomerStatuses.Returned)
                {
                    <button type="button" class="di-btn di-btn-gold" disabled="@busy" @onclick="() => SaveAndSetStatus(CustomerStatuses.ForReview)">Submit for review</button>
                }
                @if (customer.Status == CustomerStatuses.ForReview)
                {
                    <button type="button" class="di-btn di-btn-success" disabled="@busy" @onclick="() => SaveAndSetStatus(CustomerStatuses.Complete)">Mark completed</button>
                    <button type="button" class="di-btn di-btn-danger" disabled="@busy" @onclick="ReturnToCustomerAsync">Return to customer</button>
                }
            }
        </div>
    </div>
</div>
</div>

<div style="display:@(activeTab == Tab.Documents ? "block" : "none")">
    <h2 class="h5 mb-1">KYC Documents</h2>
    <p class="text-muted">Upload and review the customer's identity &amp; verification documents.</p>
    <CustomerDocuments CustomerId="customer.Id" CurrentUser="@currentUser" OnChanged="OnDocsChanged" />
</div>

<div style="display:@(activeTab == Tab.EmailHistory ? "block" : "none")">
    <h2 class="h5 mb-1">Notification Email History</h2>
    <p class="text-muted">Every self-service update link sent for this customer.</p>
    @if (!emailHistoryLoaded)
    {
        <LoadingIndicator Message="Loading email history…" />
    }
    else if (emailHistory.Count == 0)
    {
        <p><em>No notification emails have been sent for this customer yet.</em></p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Sent On</th>
                        <th>Sent By</th>
                        <th>Code Verified</th>
                        <th>Submitted</th>
                        <th>Link Expires</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in emailHistory)
                    {
                        <tr>
                            <td>@Local(entry.CreatedAt)</td>
                            <td>@entry.CreatedBy</td>
                            <td>@(entry.OtpVerifiedAt is null ? "—" : Local(entry.OtpVerifiedAt.Value))</td>
                            <td>@(entry.UsedAt is null ? "—" : Local(entry.UsedAt.Value))</td>
                            <td>@Local(entry.ExpiresAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
}

@code {
    [Parameter] public int Id { get; set; }

    private enum Tab { Details, Documents, EmailHistory }
    private Tab activeTab = Tab.Details;
    private int docCount;
    private List<CustomerAccessToken> emailHistory = [];
    private bool emailHistoryLoaded;

    private record Step(string Title, string Section, string? Group, bool IsReview);

    private Customer? customer;
    private CustomerContact contact = new();
    private List<CustomerFieldConfig> config = [];
    private List<CustomerTabSetting> tabs = [];
    private int? currentUserId;
    private List<Step> steps = [];
    private int current;

    /// <summary>Percent complete for the header progress ring (current step of total), matching the supplier form.</summary>
    private int ProgressPct => steps.Count == 0
        ? 0 : (int)Math.Round(Math.Clamp(current + 1, 1, steps.Count) / (double)steps.Count * 100);

    private string currentUser = "unknown";
    private string? message;
    private bool isError;
    private bool busy;
    private bool savedTick;

    private bool dataLoaded;

    protected override async Task OnInitializedAsync()
    {
        // Keep this cheap so the page paints (with the loading spinner) immediately; the heavier reads are
        // deferred to OnAfterRenderAsync so they run once on the interactive circuit, not again on prerender.
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoaded) return;
        dataLoaded = true;
        try
        {
            // Load the independent reads concurrently (each uses its own DbContext) instead of sequentially.
            var tConfig = FieldConfigService.GetAllAsync();
            var tTabs = FieldConfigService.GetTabsAsync();
            var tCustomer = CustomerService.GetAsync(Id);
            var tDocCount = CustomerService.GetDocumentCountAsync(Id);
            await Task.WhenAll(tConfig, tTabs, tCustomer, tDocCount);

            config = tConfig.Result;
            tabs = tTabs.Result;
            customer = tCustomer.Result;
            docCount = tDocCount.Result;
            if (customer is not null)
            {
                contact = customer.Contact ??= new CustomerContact { CustomerId = customer.Id };
            }

            // Resolve the signed-in user's Id only when a tab is actually edit-restricted (per-tab lock).
            if (tabs.Any(t => !string.IsNullOrWhiteSpace(t.EditableByUserIdsCsv)))
            {
                currentUserId = (await UserService.GetByIdentifierAsync(currentUser))?.Id;
            }
            BuildSteps();
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ShowEmailHistoryAsync()
    {
        activeTab = Tab.EmailHistory;
        if (!emailHistoryLoaded && customer is not null)
        {
            emailHistory = await AccessTokenService.GetHistoryForCustomerAsync(customer.Id);
            emailHistoryLoaded = true;
        }
    }


    private void BuildSteps()
    {
        // Tabs come from the admin-editable CustomerTabSetting (order, title, visibility). A tab renders only
        // when it is visible and has at least one visible field in the config.
        var list = new List<Step>();
        foreach (var t in tabs.Where(t => t.IsVisible)
                     .OrderBy(t => t.Section == "Account" ? 0 : 1).ThenBy(t => t.Sequence).ThenBy(t => t.GroupName))
        {
            if (config.Any(f => f.IsVisible && f.Section == t.Section && f.GroupName == t.GroupName))
                list.Add(new Step(t.Title, t.Section, t.GroupName, false));
        }
        list.Add(new Step("Review & Save", "", null, true));
        steps = list;
    }

    /// <summary>Whether the current user may EDIT the given tab. A tab with a non-empty editor list is editable
    /// only by a listed user; everyone else sees it read-only. Review/Documents steps are never restricted.</summary>
    private bool CanEditTab(Step step)
    {
        if (step.IsReview || step.Group is null) return true;
        var csv = tabs.FirstOrDefault(t => t.Section == step.Section && t.GroupName == step.Group)?.EditableByUserIdsCsv;
        if (string.IsNullOrWhiteSpace(csv)) return true;
        var allowed = SupplierFieldSettingService.ParseEditorUserIds(csv);
        return currentUserId is int id && allowed.Contains(id);
    }

    /// <summary>Field keys (per section) on tabs this user may not edit, for the server-side save guard.</summary>
    private (HashSet<string> Account, HashSet<string> Contact) LockedKeys()
    {
        var acct = new HashSet<string>();
        var cont = new HashSet<string>();
        foreach (var t in tabs)
        {
            if (string.IsNullOrWhiteSpace(t.EditableByUserIdsCsv)) continue;
            var allowed = SupplierFieldSettingService.ParseEditorUserIds(t.EditableByUserIdsCsv);
            if (currentUserId is int id && allowed.Contains(id)) continue;   // this user may edit → not locked
            foreach (var f in config.Where(f => f.Section == t.Section && f.GroupName == t.GroupName))
                (t.Section == "Account" ? acct : cont).Add(f.FieldKey);
        }
        return (acct, cont);
    }

    /// <summary>Sub-section a field belongs to within the Identification step, so the tab is grouped into
    /// Passport / Visa / Government-ID blocks. Returns null for fields outside those groups.</summary>
    private static string? Subcategory(string fieldKey) => fieldKey switch
    {
        "Passport" or "PassportNumber" or "PassportIssueDate" or "PassportExpiryDate"
            or "PassportIssueCountryCode" or "PassportIssuePlaceCountry"
            or "DualPassport" or "DualPassportNumber" or "DualPassportIssueDate" or "DualPassportExpiryDate"
            => "Passport Information",
        "VISAExpiryDate" or "VISANumber" => "Visa Information",
        "TypeOfID" or "CountryGovtIDNumber" or "CountryGovtIDIssueDate" or "CountryGovtIDExpiryDate"
            or "EmirateID" or "EmirateIDExpiryDate" or "EmiratesIDIssueDate" or "IssueCountry"
            => "Government / National ID",
        _ => null
    };

    private IEnumerable<CustomerFieldConfig> FieldsFor(Step step) =>
        config.Where(f => f.IsVisible && f.Section == step.Section && f.GroupName == step.Group)
              .Where(IsConditionallyVisible)
              .OrderBy(f => f.Sequence);

    /// <summary>A conditional field is shown only while its controlling Yes/No field currently holds the
    /// configured value; otherwise it is hidden (and cleared on save). Fields with no rule are always shown.</summary>
    private bool IsConditionallyVisible(CustomerFieldConfig cfg)
    {
        if (string.IsNullOrWhiteSpace(cfg.ControllingFieldKey)) return true;
        object? entity = cfg.Section == "Account" ? customer : contact;
        if (entity is null) return true;
        var current = CustomerFieldAccessor.GetString(entity, cfg.ControllingFieldKey);
        return string.Equals(current, cfg.ControllingValue, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Clears the stored value of every conditionally-hidden field so a stale value isn't saved.</summary>
    private void ClearHiddenConditionalFields()
    {
        foreach (var f in config.Where(f => !string.IsNullOrWhiteSpace(f.ControllingFieldKey) && !IsConditionallyVisible(f)))
        {
            object? entity = f.Section == "Account" ? customer : contact;
            if (entity is not null) CustomerFieldAccessor.SetString(entity, f.FieldKey, null);
        }
    }

    private void OnChange(object entity, string key, string? value) => CustomerFieldAccessor.SetString(entity, key, value);

    /// <summary>Combined Country dropdown: stores the selected code in CountryCode and the matching
    /// country name in CountryName, so the two underlying fields stay in sync from one control.</summary>
    private void OnCountryChange(object entity, string? code)
    {
        CustomerFieldAccessor.SetString(entity, "CountryCode", code);
        var name = CustomerLookups.Countries.FirstOrDefault(c => c.Code == code).Name;
        CustomerFieldAccessor.SetString(entity, "CountryName", string.IsNullOrWhiteSpace(code) ? null : name);
    }

    private async Task SaveAsync(bool silent)
    {
        if (customer is null) return;
        busy = true;
        if (!silent) message = null;
        ClearHiddenConditionalFields();
        customer.Contact = contact;
        var (lockedAcct, lockedCont) = LockedKeys();
        await CustomerService.SaveAsync(customer, currentUser, lockedAcct, lockedCont);
        busy = false;
        if (!silent) { isError = false; message = "Saved."; }
        savedTick = true;
    }

    private async Task NextAsync()
    {
        await SaveAsync(true);
        // A tab this user can't edit is read-only, so don't block them on its validation.
        if (CanEditTab(steps[current]))
        {
            var problems = MissingRequired(steps[current]).Select(m => $"{m} is required.")
                .Concat(DateErrorsForStep(steps[current]))
                .Concat(FormatErrors(FieldsFor(steps[current]))).ToList();
            if (problems.Count > 0)
            {
                ToastService.ShowErrors(problems);
                return;
            }
        }
        if (current < steps.Count - 1) current++;
        message = null;
    }

    // Stricter than DataAnnotations' EmailAddressAttribute (which accepts "a@b" with no domain dot):
    // requires a local part, "@", and a domain with a dot and a 2+ character TLD.
    private static readonly System.Text.RegularExpressions.Regex EmailRegex = new(
        @"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$",
        System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    private static bool IsValidEmail(string? value) =>
        !string.IsNullOrWhiteSpace(value) && EmailRegex.IsMatch(value.Trim());

    /// <summary>Input maxlength for the fixed-length numeric identifiers (null = no cap, attribute omitted):
    /// Buyer TIN is 10 digits, the TRN 15 digits.</summary>
    private static int? MaxLenFor(string fieldKey) => fieldKey switch
    {
        "CustomerBuyerTIN" => 10,
        "TRNNumber" => 15,
        _ => null
    };

    /// <summary>True when the value is exactly <paramref name="length"/> digits (spaces/dashes ignored).</summary>
    private static bool IsDigits(string value, int length)
    {
        var d = value.Replace(" ", "").Replace("-", "");
        return d.Length == length && d.All(char.IsDigit);
    }

    /// <summary>Format checks for the given visible fields (when a value is present): email fields must be a
    /// valid address, Customer/Buyer TIN must be 10 digits, TRN Number must be 15 digits.</summary>
    private List<string> FormatErrors(IEnumerable<CustomerFieldConfig> fields)
    {
        var errs = new List<string>();
        if (customer is null) return errs;
        foreach (var f in fields)
        {
            var entity = f.Section == "Account" ? (object)customer : contact;
            var val = CustomerFieldAccessor.GetString(entity, f.FieldKey);
            if (string.IsNullOrWhiteSpace(val)) continue;

            if (f.FieldKey.Contains("Email", StringComparison.OrdinalIgnoreCase) && !IsValidEmail(val))
            {
                errs.Add($"{f.DisplayLabel} is not a valid email address.");
            }
            else if (f.FieldKey == "CustomerBuyerTIN" && !IsDigits(val, 10))
            {
                errs.Add("Customer/Buyer TIN must be exactly 10 digits.");
            }
            else if (f.FieldKey == "TRNNumber" && !IsDigits(val, 15))
            {
                errs.Add("TRN Number must be exactly 15 digits.");
            }
        }
        return errs;
    }

    /// <summary>Input max for a date field so the browser calendar can't pick an illogical value: issue,
    /// establishment and birth dates cannot be in the future (capped at today); expiry dates are unbounded.</summary>
    private static string? DateMax(string fieldKey) =>
        (fieldKey.Contains("Issue", StringComparison.OrdinalIgnoreCase)
         || fieldKey.Equals("EstablishmentDate", StringComparison.OrdinalIgnoreCase)
         || fieldKey.Equals("DateOfBirth", StringComparison.OrdinalIgnoreCase))
            ? DateTime.Today.ToString("yyyy-MM-dd") : null;

    /// <summary>Logical date rules: issue and establishment dates can't be in the future, and the trade-license
    /// expiry date can't be before its issue date.</summary>
    private List<string> TradeLicenseDateErrors()
    {
        var errs = new List<string>();
        if (customer is null) return errs;
        if (customer.TradeLicenseIssueDate is DateTime issue && issue.Date > DateTime.Today)
        {
            errs.Add("Trade License Issue Date cannot be a future date.");
        }
        if (customer.TradeLicenseIssueDate is DateTime iss && customer.TradeLicenseExpiryDate is DateTime exp
            && exp.Date < iss.Date)
        {
            errs.Add("Trade License Expiry Date cannot be before the Trade License Issue Date.");
        }
        if (customer.EstablishmentDate is DateTime est && est.Date > DateTime.Today)
        {
            errs.Add("Establishment Date cannot be a future date.");
        }
        if (customer.EstablishmentDate is DateTime e2 && customer.TradeLicenseIssueDate is DateTime i2
            && i2.Date < e2.Date)
        {
            errs.Add("Trade License Issue Date cannot be before the Establishment Date.");
        }
        return errs;
    }

    /// <summary>Date rules that apply on the step containing the trade-license / establishment dates (so the
    /// check fires as the user leaves that step, not on unrelated steps).</summary>
    private List<string> DateErrorsForStep(Step step)
    {
        if (step.IsReview || step.Section != "Account") return [];
        var onThisStep = config.Any(f => f.Section == "Account" && f.GroupName == step.Group
            && (f.FieldKey == "TradeLicenseIssueDate" || f.FieldKey == "EstablishmentDate"));
        return onThisStep ? TradeLicenseDateErrors() : [];
    }

    /// <summary>Required, visible fields on a step that are still empty (by display label). The merged
    /// Country Name is excluded — it is filled from the combined Country dropdown.</summary>
    private List<string> MissingRequired(Step step)
    {
        if (step.IsReview || customer is null) return [];
        var entity = step.Section == "Account" ? (object)customer : contact;
        return config
            .Where(f => f.IsVisible && f.IsRequired && f.Section == step.Section && f.GroupName == step.Group)
            .Where(IsConditionallyVisible)
            .Where(f => !(f.Section == "Account" && f.FieldKey == "CountryName"))
            .Where(f => string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(entity, f.FieldKey)))
            .Select(f => f.DisplayLabel)
            .ToList();
    }

    private async Task BackAsync()
    {
        await SaveAsync(true);
        if (current > 0) current--;
        message = null;
    }

    private async Task JumpToAsync(int index)
    {
        if (index == current) return;
        await SaveAsync(true);
        current = Math.Clamp(index, 0, steps.Count - 1);
        message = null;
    }

    private async Task OnDocsChanged()
    {
        if (customer is not null)
        {
            docCount = await CustomerService.GetDocumentCountAsync(customer.Id);
        }
        StateHasChanged();
    }

    /// <summary>Required KYC document types that have not been uploaded for this customer.</summary>
    private async Task<List<string>> MissingRequiredDocsAsync()
    {
        if (customer is null) return [];
        var docTypes = await DocumentService.GetTypesAsync();
        var have = (await DocumentService.GetDocumentsAsync(customer.Id)).Select(d => d.DocumentType).ToHashSet();
        return docTypes.Where(t => t.IsRequired && !have.Contains(t.Name)).Select(t => t.Name).ToList();
    }

    /// <summary>Returns the record to the customer: saves, emails a fresh self-service link (which moves
    /// the status to "Awaiting Customer Response") so they can correct and resubmit.</summary>
    private async Task ReturnToCustomerAsync()
    {
        if (customer is null) return;
        busy = true; message = null;
        ClearHiddenConditionalFields();
        customer.Contact = contact;
        var (retAcct, retCont) = LockedKeys();
        await CustomerService.SaveAsync(customer, currentUser, retAcct, retCont);
        var (ok, err) = await CustomerEmailService.NotifyCustomerAsync(
            customer.Id, customer.LegalName ?? "Customer",
            CustomerAccessTokenService.EmailFor(customer), currentUser, Nav.BaseUri);
        busy = false;
        if (ok)
        {
            customer.Status = CustomerStatuses.AwaitingCustomerResponse;
            isError = false;
            message = "A self-service link was sent to the customer and the status is now “Awaiting Customer Response”.";
            ToastService.ShowSuccess("Returned to customer — update link sent.");
        }
        else
        {
            isError = true;
            message = err ?? "Could not send the update link.";
            ToastService.ShowError(err ?? "Could not send the update link.");
        }
    }

    private async Task SaveAndSetStatus(string status)
    {
        if (customer is null) return;
        if (status == CustomerStatuses.ForReview)
        {
            var missing = config.Where(f => f.IsVisible && f.IsRequired)
                .Where(IsConditionallyVisible)
                .Where(f => !(f.Section == "Account" && f.FieldKey == "CountryName"))
                .Where(f => string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(
                    f.Section == "Account" ? (object)customer : contact, f.FieldKey)))
                .Select(f => f.DisplayLabel).ToList();
            if (missing.Count > 0)
            {
                ToastService.ShowErrors(missing.Select(m => $"{m} is required."));
                return;
            }
            var dateErrors = TradeLicenseDateErrors();
            if (dateErrors.Count > 0)
            {
                ToastService.ShowErrors(dateErrors);
                return;
            }
            var formatErrors = FormatErrors(config.Where(f => f.IsVisible).Where(IsConditionallyVisible));
            if (formatErrors.Count > 0)
            {
                ToastService.ShowErrors(formatErrors);
                return;
            }
            var missingDocs = await MissingRequiredDocsAsync();
            if (missingDocs.Count > 0)
            {
                ToastService.ShowErrors(missingDocs.Select(d => $"{d} document is required."));
                return;
            }
        }
        busy = true; message = null;
        customer.Contact = contact;
        var (setAcct, setCont) = LockedKeys();
        await CustomerService.SaveAsync(customer, currentUser, setAcct, setCont);
        await CustomerService.SetStatusAsync(customer.Id, status, currentUser);
        customer.Status = status;
        busy = false; isError = false;
        message = $"Saved and moved to “{status}”.";

        // On completion, expire the self-service link so it can no longer be opened, and send the
        // customer a thank-you email (mirrors the supplier flow).
        if (status == CustomerStatuses.Complete)
        {
            await AccessTokenService.ExpireTokensForCustomerAsync(customer.Id);
            var (ok, err) = await CustomerEmailService.NotifyCustomerCompletedAsync(
                customer.Id, customer.LegalName ?? "Customer",
                CustomerAccessTokenService.EmailFor(customer), currentUser, customer.BusinessUnitId);
            if (ok) ToastService.ShowSuccess("Completion thank-you email sent to the customer.");
            else ToastService.ShowError(err ?? "Could not send the completion email.");
        }
    }

    /// <summary>Formats a stored UTC timestamp in the server's local time zone.</summary>
    private static string Local(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string StatusClass(string status) => status switch
    {
        CustomerStatuses.Complete => "bg-success-subtle text-success-emphasis",
        CustomerStatuses.ForReview => "bg-warning-subtle text-warning-emphasis",
        CustomerStatuses.Returned => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}
