@page "/admin/customers/{Id:int}"
@attribute [Authorize(Policy = "Portal.Customer")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models.Customer
@using SupplierPortal.Web.Services
@inject CustomerService CustomerService
@inject CustomerFieldConfigService FieldConfigService
@inject CustomerDocumentService DocumentService
@inject CustomerAccessTokenService AccessTokenService
@inject CustomerEmailService CustomerEmailService
@inject UserService UserService
@inject ToastService ToastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>Customer - CST Portal</PageTitle>

<SupplierPortal.Web.Components.Shared.BlockingOverlay Visible="blocking"
    Title="@blockingTitle" Message="Please wait — do not close this page." />

@if (customer is null)
{
    <LoadingIndicator Message="Loading customer…" />
}
else
{
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == Tab.Details ? "active" : "")" @onclick="() => activeTab = Tab.Details">
            Customer Details
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == Tab.Documents ? "active" : "")" @onclick="() => activeTab = Tab.Documents">
            Documents@(docCount > 0 ? $" ({docCount})" : "")
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == Tab.EmailHistory ? "active" : "")" @onclick="ShowEmailHistoryAsync">
            Email History@(emailHistory.Count > 0 ? $" ({emailHistory.Count})" : "")
        </button>
    </li>
</ul>

<div style="display:@(activeTab == Tab.Details ? "block" : "none")">
<div class="di-form-page">
    <div class="di-form-topbar">
        <div class="di-form-headings">
            <h1 class="di-form-title">@(string.IsNullOrWhiteSpace(customer.LegalName) ? "New Customer" : customer.LegalName)</h1>
            <p class="di-form-sub">
                <span class="di-status-badge @StatusClass(customer.Status)">@customer.Status</span>
                @if (!string.IsNullOrWhiteSpace(customer.CustomerCode)) { <span class="ms-2">@customer.CustomerCode</span> }
            </p>
        </div>
        <div class="di-form-topbar-right">
            <div class="di-progress" title="@ProgressPct% complete">
                <svg class="di-progress-ring" viewBox="0 0 36 36">
                    <circle class="di-progress-bg" cx="18" cy="18" r="15.9155"></circle>
                    <circle class="di-progress-bar" cx="18" cy="18" r="15.9155" style="stroke-dasharray:@ProgressPct.ToString(System.Globalization.CultureInfo.InvariantCulture) 100"></circle>
                </svg>
                <div class="di-progress-center">
                    <span class="di-progress-pct">@ProgressPct%</span>
                    <span class="di-progress-word">Complete</span>
                </div>
            </div>
            <a class="di-btn di-btn-secondary" href="/admin/customers">← Back to list</a>
        </div>
    </div>

    @* ---------- Stepper (matches the Supplier form) ---------- *@
    <div class="di-stepper">
        @for (var i = 0; i < steps.Count; i++)
        {
            var idx = i;
            var reached = idx <= current;
            <button type="button"
                    class="di-stepper-item @(idx == current ? "active" : "") @(reached ? "reached" : "")"
                    @onclick="() => JumpToAsync(idx)">
                <span class="di-stepper-num">@(idx < current ? "✓" : (idx + 1).ToString())</span>
                <span class="di-stepper-label">@steps[idx].Title</span>
                @if (idx < steps.Count - 1)
                {
                    <svg class="di-stepper-chevron" width="9" height="14" viewBox="0 0 9 14" fill="none"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                }
            </button>
        }
    </div>


    @{ var step = steps[current]; }

    @if (step.IsDocuments)
    {
        <div class="di-section">
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5L9.5 0H4zm5 1.5V4a1 1 0 0 0 1 1h2.5L9 1.5z"/></svg>
                </span>
                <div class="di-section-heading">
                    <span class="di-section-title">KYC Documents</span>
                    <span class="di-section-desc">Upload the required identity &amp; verification documents.</span>
                </div>
            </div>
            <div class="di-section-body" style="grid-template-columns: 1fr;">
                <CustomerDocuments CustomerId="customer.Id" CurrentUser="@currentUser" OnChanged="OnDocsChanged" IsApplicable="DocApplies" />
            </div>
        </div>
    }
    else if (!step.IsReview)
    {
        var tabEditable = CanEditTab(step);
        <div class="di-section">
            @if (!tabEditable)
            {
                <div class="di-tab-readonly-note">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a2 2 0 0 0-2 2v4H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1V3a2 2 0 0 0-2-2H8zm2 6H7V3a1 1 0 0 1 2 0v4h1z"/></svg>
                    <span>This tab is read-only for you. Only authorised users can edit it — contact an administrator to make changes.</span>
                </div>
            }
            <div class="di-section-header">
                <span class="di-section-icon">
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M9.05.435c-.58-.58-1.52-.58-2.1 0L.436 6.95c-.58.58-.58 1.519 0 2.098l6.516 6.516c.58.58 1.519.58 2.098 0l6.516-6.516c.58-.58.58-1.519 0-2.098L9.05.435z"/></svg>
                </span>
                <div class="di-section-heading">
                    <span class="di-section-title">@step.Title</span>
                    <span class="di-section-desc">Company / contact details</span>
                </div>
            </div>
            <div class="di-section-body">
                @{ var lastSub = (string?)null; }
                @foreach (var f in FieldsFor(step))
                {
                    var cfg = f;
                    // Country Name is merged into the combined Country Code dropdown below, so don't render
                    // it as its own field.
                    if (cfg.Section == "Account" && cfg.FieldKey == "CountryName") { continue; }
                    // VAT-group legal names is a flat import/export-only column; the VAT Group grid below
                    // captures this data on the form, so don't render it as a standalone field.
                    if (cfg.Section == "Account" && cfg.FieldKey == "VatGroupLegalNames") { continue; }
                    var target = cfg.Section == "Account" ? (object)customer : contact;
                    var isCombinedCountry = cfg.Section == "Account" && cfg.FieldKey == "CountryCode";
                    // "City" (EmirateCity, either section): a UAE-emirate dropdown when the relevant country is
                    // the UAE (Account uses CountryName, Contact uses Country), else a free-text box.
                    var isCity = cfg.FieldKey == "EmirateCity";
                    var cityCountryIsUae = isCity && string.Equals(
                        cfg.Section == "Account" ? CustomerFieldAccessor.GetString(customer, "CountryName")
                                                 : CustomerFieldAccessor.GetString(contact, "Country"),
                        CustomerLookups.UaeCountryName, StringComparison.OrdinalIgnoreCase);
                    var editable = tabEditable && !string.Equals(cfg.BusinessControl, CustomerFieldControls.Readonly, StringComparison.OrdinalIgnoreCase);
                    var cur = CustomerFieldAccessor.GetString(target, cfg.FieldKey);
                    var sub = Subcategory(cfg.FieldKey);
                    if (sub is not null && sub != lastSub)
                    {
                        lastSub = sub;
                        <div class="di-subheading">@sub</div>
                    }
                    <div class="di-field @(IsInvalidField(cfg) ? "di-field-invalid" : "")">
                        <label>
                            @(isCombinedCountry ? "Country" : cfg.DisplayLabel)
                            @if (cfg.IsRequired) { <span class="di-req">*</span> }
                            @if (!string.IsNullOrWhiteSpace(cfg.HelpText)) { <button type="button" class="di-help-icon" @onclick='() => ShowHelp(isCombinedCountry ? "Country" : cfg.DisplayLabel, cfg.HelpText)' aria-label="Show help">&#9432;</button> }
                        </label>
                        @if (!editable)
                        {
                            <input type="text" class="di-frozen" value="@CustomerFieldAccessor.GetDisplay(target, cfg.FieldKey)" disabled />
                        }
                        else if (cfg.FieldKind == "date")
                        {
                            @* Calendar-only: clicking anywhere in the field opens the native date picker, and
                               typing/paste is blocked so the date can only be chosen from the calendar. Past-only
                               fields (issue / establishment / birth) cap at today so a future date can't be chosen. *@
                            <input type="date" class="di-datepick" value="@cur" max="@DateMax(cfg.FieldKey)"
                                   onkeydown="return false" onpaste="return false"
                                   onclick="try { this.showPicker(); } catch (e) {}"
                                   @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                        }
                        else if (cfg.FieldKind == "phone")
                        {
                            <SupplierPortal.Web.Components.Shared.CustomerPhoneField
                                Value="@cur" ValueChanged="v => OnChange(target, cfg.FieldKey, v)" />
                        }
                        else if (cfg.FieldKind == "yesno")
                        {
                            <div class="di-switch-wrap">
                                <button type="button" role="switch" aria-checked="@(cur == "true" ? "true" : "false")"
                                        class="di-switch @(cur == "true" ? "on" : "") @(cur == "false" ? "off" : "")"
                                        @onclick='() => OnChange(target, cfg.FieldKey, cur == "true" ? "false" : "true")'>
                                    <span class="di-switch-knob"></span>
                                </button>
                                <span class="di-switch-text">@(cur == "true" ? "Yes" : cur == "false" ? "No" : "—")</span>
                            </div>
                        }
                        else if (isCombinedCountry)
                        {
                            @* Combined Country dropdown: shows "AE - United Arab Emirates"; stores the code in
                               CountryCode and the matching name in CountryName. *@
                            <select value="@cur" @onchange="e => OnCountryChange(target, e.Value?.ToString())">
                                <option value="">— Select —</option>
                                @foreach (var c in CustomerLookups.Countries)
                                {
                                    <option value="@c.Code" selected="@(c.Code == cur)">@c.Code - @c.Name</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(cur) && !CustomerLookups.Countries.Any(c => c.Code == cur))
                                {
                                    <option value="@cur" selected>@cur</option>
                                }
                            </select>
                        }
                        else if (isCity && cityCountryIsUae)
                        {
                            <select value="@cur" @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())">
                                <option value="">— Select —</option>
                                @foreach (var em in CustomerLookups.UaeEmirates)
                                {
                                    <option value="@em" selected="@(em == cur)">@em</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(cur) && !CustomerLookups.UaeEmirates.Contains(cur))
                                {
                                    <option value="@cur" selected>@cur</option>
                                }
                            </select>
                        }
                        else if (cfg.FieldKind == "lookup")
                        {
                            var coded = CustomerLookups.CodedOptions(cfg.Section, cfg.FieldKey);
                            <select value="@cur" @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())">
                                <option value="">— Select —</option>
                                @if (coded is not null)
                                {
                                    @* Coded lookup: the dropdown shows the Name, the stored value is the Code. *@
                                    @foreach (var o in coded)
                                    {
                                        <option value="@o.Value" selected="@(string.Equals(o.Value, cur, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(cur) && !coded.Any(o => string.Equals(o.Value, cur, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@cur" selected>@CustomerLookups.CodedDisplay(cfg.Section, cfg.FieldKey, cur)</option>
                                    }
                                }
                                else
                                {
                                    var opts = CustomerLookups.For(cfg.Section, cfg.FieldKey);
                                    @foreach (var o in opts)
                                    {
                                        <option value="@o" selected="@(o == cur)">@o</option>
                                    }
                                    @* Preserve any previously-stored value that is not in the current list. *@
                                    @if (!string.IsNullOrWhiteSpace(cur) && !opts.Contains(cur))
                                    {
                                        <option value="@cur" selected>@cur</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" value="@cur"
                                   maxlength="@(cfg.MaxLength ?? MaxLenFor(cfg.FieldKey))"
                                   inputmode="@(MaxLenFor(cfg.FieldKey) is null ? null : "numeric")"
                                   @onchange="e => OnChange(target, cfg.FieldKey, e.Value?.ToString())" />
                        }
                    </div>
                }
                @{
                    var stepHasVatStructure = FieldsFor(step).Any(f => f.Section == "Account" && f.FieldKey == "VATStructure");
                }
                @if (stepHasVatStructure && IsVatGroupSelected)
                {
                    <div class="di-field di-full di-vatgroup">
                        <div class="di-vatgroup-head">
                            <span class="di-vatgroup-title">VAT Group</span>
                            @if (tabEditable)
                            {
                                <button type="button" class="di-add-contact" @onclick="AddVatGroupEntity">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z" /></svg>
                                    <span>Add Row</span>
                                </button>
                            }
                        </div>
                        <p class="di-vatgroup-note">
                            Please list all entities registered under your VAT Group that are conducting business with our company.
                        </p>
                        <div class="di-vatgroup-scroll">
                            <table class="di-vatgroup-table">
                                <thead>
                                    <tr>
                                        <th>Business Legal Name <span class="di-req">*</span></th>
                                        <th>Address <span class="di-req">*</span></th>
                                        <th>E-Invoicing Wave<br />(Wave 1/Wave 2) <span class="di-req">*</span></th>
                                        <th>TRN Number <span class="di-req">*</span></th>
                                        <th>TIN Number <span class="di-req">*</span></th>
                                        <th>Bus. Location Type<br />(Mainland/Free Zone) <span class="di-req">*</span></th>
                                        @if (tabEditable) { <th></th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (customer.VatGroupEntities.Count == 0)
                                    {
                                        <tr><td colspan="7" class="di-vatgroup-empty">No entities added yet. Click "Add Row" to list a VAT group entity.</td></tr>
                                    }
                                    @foreach (var entity in customer.VatGroupEntities)
                                    {
                                        <tr>
                                            <td><input type="text" @bind="entity.BusinessLegalName" disabled="@(!tabEditable)" /></td>
                                            <td><input type="text" @bind="entity.Address" disabled="@(!tabEditable)" /></td>
                                            <td>
                                                <select @bind="entity.EInvoicingWave" disabled="@(!tabEditable)">
                                                    <option value="">Select</option>
                                                    @foreach (var w in CustomerLookups.EInvoicingWaves) { <option value="@w">@w</option> }
                                                </select>
                                            </td>
                                            <td><input type="text" @bind="entity.TrnNumber" disabled="@(!tabEditable)" /></td>
                                            <td><input type="text" @bind="entity.TinNumber" disabled="@(!tabEditable)" /></td>
                                            <td>
                                                <select @bind="entity.BusinessLocationType" disabled="@(!tabEditable)">
                                                    <option value="">Select</option>
                                                    @foreach (var l in CustomerLookups.BusinessLocationTypes) { <option value="@l">@l</option> }
                                                </select>
                                            </td>
                                            @if (tabEditable)
                                            {
                                                <td>
                                                    <button type="button" class="di-icon-btn di-icon-btn-danger" title="Remove entity" @onclick="() => RemoveVatGroupEntity(entity)">
                                                        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3V2h11v1h-11Z" /></svg>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @* ---------- Review step ---------- *@
        <p class="di-form-sub mb-3">Review everything captured, then save or submit for review.</p>
        @foreach (var g in steps.Where(s => !s.IsReview && !s.IsDocuments))
        {
            object Ent(CustomerFieldConfig f) => f.Section == "Account" ? (object)customer : contact;
            var filled = FieldsFor(g).Where(f => !string.IsNullOrWhiteSpace(CustomerFieldAccessor.GetString(Ent(f), f.FieldKey))).ToList();
            <div class="di-section">
                <div class="di-section-header">
                    <div class="di-section-heading">
                        <span class="di-section-title">@g.Title</span>
                    </div>
                    <button type="button" class="di-btn di-btn-secondary di-btn-sm ms-auto" @onclick="() => JumpToAsync(steps.IndexOf(g))">Edit</button>
                </div>
                <div class="di-section-body">
                    @if (filled.Count == 0)
                    {
                        <div class="di-review-empty">Nothing entered.</div>
                    }
                    else
                    {
                        @foreach (var f in filled)
                        {
                            <div class="di-review-item">
                                <div class="di-review-label">@f.DisplayLabel</div>
                                <div class="di-review-value">@CustomerFieldAccessor.GetDisplay(Ent(f), f.FieldKey)</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
        @if (IsVatGroupSelected && customer.VatGroupEntities.Count > 0)
        {
            <div class="di-section">
                <div class="di-section-header">
                    <div class="di-section-heading"><span class="di-section-title">VAT Group</span></div>
                </div>
                <div class="di-section-body">
                    <div class="di-vatgroup-scroll">
                        <table class="di-vatgroup-table">
                            <thead>
                                <tr>
                                    <th>Business Legal Name</th><th>Address</th><th>E-Invoicing Wave</th>
                                    <th>TRN Number</th><th>TIN Number</th><th>Bus. Location Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in customer.VatGroupEntities.OrderBy(x => x.SortOrder))
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(e.BusinessLegalName) ? "—" : e.BusinessLegalName)</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.Address) ? "—" : e.Address)</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.EInvoicingWave) ? "—" : e.EInvoicingWave)</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.TrnNumber) ? "—" : e.TrnNumber)</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.TinNumber) ? "—" : e.TinNumber)</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.BusinessLocationType) ? "—" : e.BusinessLocationType)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    @* ---------- Wizard footer ---------- *@
    <div class="di-form-footer">
        <button type="button" class="di-btn di-btn-secondary" disabled="@(current == 0 || busy)" @onclick="BackAsync">← Back</button>
        <div class="di-form-footer-right">
            @if (savedTick) { <span class="di-saved-tick">Saved ✓</span> }
            @if (!steps[current].IsReview)
            {
                <button type="button" class="di-btn di-btn-primary" disabled="@busy" @onclick="NextAsync">Save &amp; Next →</button>
            }
            else
            {
                <button type="button" class="di-btn di-btn-primary" disabled="@busy" @onclick="() => SaveAsync(false)">Save</button>
                @if (customer.Status != CustomerStatuses.Complete)
                {
                    <button type="button" class="di-btn di-btn-success" disabled="@busy" @onclick="() => SaveAndSetStatus(CustomerStatuses.Complete)">Mark completed</button>
                }
                else
                {
                    <button type="button" class="di-btn di-btn-danger" disabled="@busy" @onclick="() => confirmReturn = true">Return to customer</button>
                }
            }
        </div>
    </div>
</div>
</div>

<div style="display:@(activeTab == Tab.Documents ? "block" : "none")">
    <h2 class="h5 mb-1">KYC Documents</h2>
    <p class="text-muted">Upload and review the customer's identity &amp; verification documents.</p>
    <CustomerDocuments CustomerId="customer.Id" CurrentUser="@currentUser" OnChanged="OnDocsChanged" IsApplicable="DocApplies" />
</div>

<div style="display:@(activeTab == Tab.EmailHistory ? "block" : "none")">
    <h2 class="h5 mb-1">Notification Email History</h2>
    <p class="text-muted">Every self-service update link sent for this customer.</p>
    @if (!emailHistoryLoaded)
    {
        <LoadingIndicator Message="Loading email history…" />
    }
    else if (emailHistory.Count == 0)
    {
        <p><em>No notification emails have been sent for this customer yet.</em></p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Sent On</th>
                        <th>Sent By</th>
                        <th>Code Verified</th>
                        <th>Submitted</th>
                        <th>Link Expires</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in emailHistory)
                    {
                        <tr>
                            <td>@Local(entry.CreatedAt)</td>
                            <td>@entry.CreatedBy</td>
                            <td>@(entry.OtpVerifiedAt is null ? "—" : Local(entry.OtpVerifiedAt.Value))</td>
                            <td>@(entry.UsedAt is null ? "—" : Local(entry.UsedAt.Value))</td>
                            <td>@Local(entry.ExpiresAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (helpText is not null)
{
    <div class="di-help-backdrop" @onclick="CloseHelp">
        <div class="di-help-modal" @onclick:stopPropagation="true">
            <div class="di-help-modal-head">
                <span class="di-help-modal-title">@helpTitle</span>
                <button type="button" class="di-help-modal-close" @onclick="CloseHelp" aria-label="Close">&times;</button>
            </div>
            <div class="di-help-modal-body">@helpText</div>
        </div>
    </div>
}

@* ---- Return-to-customer (send update link) confirmation ---- *@
@if (confirmReturn && customer is not null)
{
    <div class="di-confirm-backdrop" @onclick="() => confirmReturn = false">
        <div class="di-confirm-card" @onclick:stopPropagation role="dialog" aria-modal="true">
            <button type="button" class="di-confirm-x" title="Close" @onclick="() => confirmReturn = false">&times;</button>
            <div class="di-confirm-badge">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="2.5" y="4.75" width="19" height="14.5" rx="2.5" fill="#ffffff" stroke="#0b2545" stroke-width="1.6"/>
                    <path d="M3.5 6.5 12 12.5l8.5-6" stroke="#0b2545" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="19" cy="6" r="4.4" fill="#c9a227" stroke="#ffffff" stroke-width="1.4"/>
                    <path d="M19 4.3v3.4M17.3 6h3.4" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
            <h3 class="di-confirm-title">Return to customer?</h3>
