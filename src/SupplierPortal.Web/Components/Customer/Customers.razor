@code {
    private List<CustomerService.CustomerRow> rows = [];
    private List<BusinessUnit> businessUnits = [];
    private int filterBusinessUnitId;
    private bool buDropdownOpen;

    private string SelectedBuLabel => filterBusinessUnitId == 0
        ? (seesAllBusinessUnits ? "All Business Units" : "All My Business Units")
        : businessUnits.FirstOrDefault(b => b.Id == filterBusinessUnitId)?.Name ?? "";

    private void ToggleBuDropdown() => buDropdownOpen = !buDropdownOpen;
    private void CloseBuDropdown() => buDropdownOpen = false;
    private void SelectBu(int id) { buDropdownOpen = false; filterBusinessUnitId = id; OnFilterChanged(); }
    private string? searchName;
    private string statusFilter = "";
    private string priorityFilter = "";
    private string assignedFilter = "";      // "", "unassigned", or a user id
    private List<User> assignableUsers = [];
    private int activeTab;
    private int currentPage = 1;
    private const int PageSize = 25;
    private readonly HashSet<int> selectedIds = [];
    private bool loading = true;
    private bool isAdministrator;
    private bool seesAllBusinessUnits;
    private string currentUser = "unknown";

    // "Generate Template" dialog state.
    private bool showTemplateDialog;
    private bool templatePopulate;
    private int templateBuId;
    private bool generatingTemplate;
    private string templateProgress = "";
    private List<int> userBuIds = [];

    // ---- derived collections ----
    private List<CustomerService.CustomerRow> buFiltered =>
        filterBusinessUnitId == 0 ? rows : rows.Where(r => r.BusinessUnitId == filterBusinessUnitId).ToList();

    private List<CustomerService.CustomerRow> statusFiltered => buFiltered
        .Where(r => string.IsNullOrEmpty(statusFilter) || r.Status == statusFilter)
        .Where(r => string.IsNullOrEmpty(priorityFilter) || r.Priority == priorityFilter)
        .Where(MatchesAssignedFilter)
        .Where(r => string.IsNullOrWhiteSpace(searchName) || r.Name.Contains(searchName!, StringComparison.OrdinalIgnoreCase))
        .OrderBy(r => PriorityRank(r.Priority)).ThenByDescending(r => r.Updated)
        .ToList();

    private bool MatchesAssignedFilter(CustomerService.CustomerRow r) => assignedFilter switch
    {
        "" => true,
        "unassigned" => r.AssignedToUserId is null,
        var v when int.TryParse(v, out var uid) => r.AssignedToUserId == uid,
        _ => true
    };

    private static int PriorityRank(string? p) => p switch { "P1" => 1, "P2" => 2, "P3" => 3, "P4" => 4, _ => 5 };

    private IEnumerable<CustomerService.CustomerRow> TabFiltered => activeTab switch
    {
        0 => statusFiltered.Where(IsRecent),
        1 => statusFiltered.Where(IsLastWeek),
        _ => statusFiltered.Where(IsOlder)
    };

    private IEnumerable<CustomerService.CustomerRow> Paged => TabFiltered.Skip((currentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TabFiltered.Count() / (double)PageSize));
    private bool AllOnPageSelected => Paged.Any() && Paged.All(r => selectedIds.Contains(r.Id));

    private static bool IsRecent(CustomerService.CustomerRow r) => r.Updated >= DateTime.UtcNow.AddDays(-1);
    private static bool IsLastWeek(CustomerService.CustomerRow r) => r.Updated < DateTime.UtcNow.AddDays(-1) && r.Updated >= DateTime.UtcNow.AddDays(-7);
    private static bool IsOlder(CustomerService.CustomerRow r) => r.Updated < DateTime.UtcNow.AddDays(-7);

    private int Count(string status) => buFiltered.Count(r => r.Status == status);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";
        isAdministrator = state.User.IsAdministrator();
        // Only an administrator with no business-unit assignment sees all customers; a user (admin or
        // not) assigned to specific business units is scoped to those — both in the list and the filter.
        var ids = state.User.GetBusinessUnitIds();
        userBuIds = ids;
        seesAllBusinessUnits = isAdministrator && ids.Count == 0;
        var scope = seesAllBusinessUnits ? new List<int>() : ids;
        var allBu = await BusinessUnitService.GetAllAsync();
        businessUnits = seesAllBusinessUnits ? allBu : allBu.Where(b => ids.Contains(b.Id)).ToList();
        rows = await CustomerService.GetDashboardAsync(scope);
        assignableUsers = await UserService.GetCustomerAssignableUsersAsync();
        loading = false;
    }

    // ---- On-grid column chooser (mirrors the supplier dashboard) ----
    private static readonly (string Key, string Label)[] ChoosableCols =
    [
        ("number", "Customer Number"),
        ("priority", "Priority"),
        ("name", "Customer Name"),
        ("fullname", "Full Name"),
        ("email", "Contact Email"),
        ("status", "Status"),
        ("assigned", "Assigned To"),
        ("actions", "Actions"),
    ];
    private readonly HashSet<string> hiddenCols = [];
    private bool showColumnMenu;
    private const string ColsKey = "di-customer-cols";
    private bool ColOn(string key) => !hiddenCols.Contains(key);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ColsKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                var visible = saved.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                hiddenCols.Clear();
                foreach (var c in ChoosableCols) { if (!visible.Contains(c.Key)) hiddenCols.Add(c.Key); }
                StateHasChanged();
            }
        }
        catch { /* localStorage unavailable — show all columns */ }
    }

    private async Task ToggleColumnAsync(string key)
    {
        if (!hiddenCols.Remove(key)) { hiddenCols.Add(key); }
        var visible = ChoosableCols.Select(c => c.Key).Where(ColOn);
        try { await JS.InvokeVoidAsync("localStorage.setItem", ColsKey, string.Join(",", visible)); } catch { }
    }

    private async Task ResetColumnsAsync()
    {
        hiddenCols.Clear();
        try { await JS.InvokeVoidAsync("localStorage.removeItem", ColsKey); } catch { }
    }

    // ---- Bulk selection actions ----
    private void ClearSelection() => selectedIds.Clear();

    private async Task BulkNotifySelectedAsync()
    {
        var targets = statusFiltered.Where(r => selectedIds.Contains(r.Id)).ToList();
        if (targets.Count == 0) { ToastService.ShowInfo("No customers selected."); return; }
        bulkSending = true;
        int sent = 0, failed = 0;
        foreach (var row in targets)
        {
            var (ok, _) = await CustomerEmailService.NotifyCustomerAsync(row.Id, row.Name, row.Email, currentUser, Nav.BaseUri);
            if (ok) { sent++; } else { failed++; }
        }
        bulkSending = false;
        await ReloadRowsAsync();
        ToastService.ShowSuccess($"Update link sent to {sent} customer(s)." + (failed > 0 ? $" {failed} skipped (no email or send error)." : ""));
    }

    private void OnFilterChanged() => currentPage = 1;
    private void SetTab(int tab) { activeTab = tab; currentPage = 1; }
    private void GoToPage(int p) => currentPage = Math.Clamp(p, 1, TotalPages);

    private void ToggleSelected(int id) { if (!selectedIds.Add(id)) selectedIds.Remove(id); }
    private void ToggleSelectAllOnPage(ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        foreach (var r in Paged) { if (on) selectedIds.Add(r.Id); else selectedIds.Remove(r.Id); }
    }

    private async Task RegisterCustomerAsync()
    {
        var id = await CustomerService.CreateDraftAsync(currentUser, filterBusinessUnitId == 0 ? null : filterBusinessUnitId);
        Nav.NavigateTo($"/admin/customers/{id}");
    }

    // ---- inline priority / assignment ----
    private async Task SetPriorityAsync(CustomerService.CustomerRow row, string? value)
    {
        var prio = string.IsNullOrWhiteSpace(value) ? null : value;
        await CustomerService.SetPriorityAsync(row.Id, prio, currentUser);
        var idx = rows.FindIndex(r => r.Id == row.Id);
        if (idx >= 0) { rows[idx] = rows[idx] with { Priority = prio }; }
    }

    private async Task AssignAsync(CustomerService.CustomerRow row, string? value)
    {
        int? uid = int.TryParse(value, out var v) ? v : null;
        var name = await CustomerService.AssignAsync(row.Id, uid, currentUser);
        var idx = rows.FindIndex(r => r.Id == row.Id);
        if (idx >= 0) { rows[idx] = rows[idx] with { AssignedToUserId = uid, AssignedToUserName = name }; }
        ToastService.ShowSuccess(uid is null ? "Customer unassigned." : $"Assigned to {name}.");
    }

    // ---- advanced Print dialog ----
    private bool showPrintDialog;
    private string printStatusFilter = "";
    private string printPriorityFilter = "";
    private string printAssignedFilter = "";
    private List<PrintColumn> printColumns = [];

    private sealed class PrintColumn
    {
        public string Label = "";
        public Func<CustomerService.CustomerRow, string> Value = _ => "";
        public bool Selected = true;
    }

    private void EnsurePrintColumns()
    {
        if (printColumns.Count > 0) { return; }
        printColumns =
        [
            new() { Label = "Customer Number", Value = r => r.Number },
            new() { Label = "Priority", Value = r => r.Priority ?? "" },
            new() { Label = "Customer Name", Value = r => r.Name },
            new() { Label = "Full Name", Value = r => r.FullName ?? "" },
            new() { Label = "Contact Email", Value = r => r.Email ?? "" },
            new() { Label = "Status", Value = r => r.Status },
            new() { Label = "Assigned To", Value = r => r.AssignedToUserName ?? "" },
            new() { Label = "Business Unit", Value = r => businessUnits.FirstOrDefault(b => b.Id == r.BusinessUnitId)?.Name ?? "" },
        ];
    }

    // Customers matching the print-dialog filters (all rows the user can see, respecting the current business
    // unit), sorted like the grid. Independent of the active tab.
    private IEnumerable<CustomerService.CustomerRow> PrintFiltered => rows
        .Where(r => filterBusinessUnitId == 0 || r.BusinessUnitId == filterBusinessUnitId)
        .Where(r => string.IsNullOrEmpty(printStatusFilter) || r.Status == printStatusFilter)
        .Where(r => string.IsNullOrEmpty(printPriorityFilter) || r.Priority == printPriorityFilter)
        .Where(MatchesPrintAssignedFilter)
        .OrderBy(r => PriorityRank(r.Priority)).ThenByDescending(r => r.Updated);

    private bool MatchesPrintAssignedFilter(CustomerService.CustomerRow r) => printAssignedFilter switch
    {
        "" => true,
        "unassigned" => r.AssignedToUserId is null,
        var v when int.TryParse(v, out var uid) => r.AssignedToUserId == uid,
        _ => true
    };

    private string PrintFilterSummary
    {
        get
        {
            var parts = new List<string> { string.IsNullOrEmpty(printStatusFilter) ? "All statuses" : printStatusFilter };
            if (!string.IsNullOrEmpty(printPriorityFilter)) { parts.Add(printPriorityFilter); }
            if (printAssignedFilter == "unassigned") { parts.Add("Unassigned"); }
            else if (int.TryParse(printAssignedFilter, out var uid))
            {
                var u = assignableUsers.FirstOrDefault(x => x.Id == uid);
                parts.Add(u is null ? "Assigned" : (string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName));
            }
            if (filterBusinessUnitId != 0)
            {
                parts.Add(businessUnits.FirstOrDefault(b => b.Id == filterBusinessUnitId)?.Name ?? "Business Unit");
            }
            return string.Join(" · ", parts);
        }
    }

    private void OpenPrintDialog()
    {
        EnsurePrintColumns();
        printStatusFilter = statusFilter;
        printPriorityFilter = priorityFilter;
        printAssignedFilter = assignedFilter;
        showPrintDialog = true;
    }

    private void ClosePrintDialog() => showPrintDialog = false;
    private void SetAllPrintCols(bool on) { foreach (var c in printColumns) { c.Selected = on; } }

    private async Task DoPrintAsync()
    {
        var cols = printColumns.Where(c => c.Selected).ToList();
        var toPrint = PrintFiltered.ToList();
        if (cols.Count == 0 || toPrint.Count == 0) { return; }
        var html = BuildPrintHtml(cols, toPrint);
        showPrintDialog = false;
        await JS.InvokeVoidAsync("printHtml", html);
    }

    /// <summary>Builds a standalone print-ready HTML report (chosen columns × every filtered row). Orientation
    /// and font size adapt to the number of columns. Mirrors the supplier dashboard's print output.</summary>
    private string BuildPrintHtml(List<PrintColumn> cols, List<CustomerService.CustomerRow> rowsToPrint)
    {
        static string Esc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
        var landscape = cols.Count > 5;
        var fontSize = cols.Count <= 6 ? "11px" : cols.Count <= 9 ? "9.5px" : "8.5px";

        var sb = new System.Text.StringBuilder();
        sb.Append("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Manage Customer</title><style>");
        sb.Append($"@page{{size:A4 {(landscape ? "landscape" : "portrait")};margin:12mm;}}");
        sb.Append($"*{{box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact;}}body{{font-family:'Segoe UI',Arial,sans-serif;color:#111827;font-size:{fontSize};margin:0;}}");
        sb.Append(".hd{display:flex;align-items:flex-end;justify-content:space-between;border-bottom:2px solid #caa04d;padding-bottom:8px;margin-bottom:12px;}");
        sb.Append(".hd h1{font-size:20px;color:#0b2545;margin:0;}");
        sb.Append(".hd .meta{font-size:10px;color:#374151;text-align:right;}");
        sb.Append("table{width:100%;border-collapse:collapse;}");
        sb.Append("th,td{border:1px solid #b7c2d6;padding:5px 7px;text-align:left;vertical-align:top;word-break:break-word;}");
        sb.Append("th{background:#e7ecf3;color:#0b2545;font-weight:700;border-bottom:2px solid #0b2545;}");
        sb.Append("tr:nth-child(even) td{background:#f4f6fb;}");
        sb.Append("</style></head><body>");
        sb.Append("<div class=\"hd\"><h1>Manage Customer</h1><div class=\"meta\">");
        sb.Append($"{Esc(PrintFilterSummary)} &middot; {rowsToPrint.Count} customer(s)<br>Generated {Esc(DateTime.Now.ToString("dd MMM yyyy HH:mm"))}");
        sb.Append("</div></div>");
        sb.Append("<table><thead><tr>");
        foreach (var c in cols) { sb.Append($"<th>{Esc(c.Label)}</th>"); }
        sb.Append("</tr></thead><tbody>");
        foreach (var r in rowsToPrint)
        {
            sb.Append("<tr>");
            foreach (var c in cols) { sb.Append($"<td>{Esc(c.Value(r))}</td>"); }
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table></body></html>");
        return sb.ToString();
    }

    // Attached-documents viewer modal.
    private bool showDocsModal;
    private int docsCustomerId;
    private string docsCustomerName = "";
    private List<CustomerDocument> modalDocuments = [];
    private bool modalDocsLoading;

    private async Task ShowDocumentsAsync(CustomerService.CustomerRow row)
    {
        var docs = await DocumentService.GetDocumentsAsync(row.Id);
        if (docs.Count == 0)
        {
            ToastService.ShowInfo($"No documents have been uploaded for {row.Name}.");
            return;
        }
        docsCustomerId = row.Id;
        docsCustomerName = row.Name;
        modalDocuments = docs;
        modalDocsLoading = false;
        showDocsModal = true;
    }

    private void CloseDocsModal() => showDocsModal = false;

    private int? notifyingId;
    private bool bulkSending;

    /// <summary>Reloads the dashboard rows after a status-changing action (e.g. a link send moves the
    /// customer to "Awaiting Customer Response").</summary>
    private async Task ReloadRowsAsync()
    {
        var scope = seesAllBusinessUnits ? new List<int>() : userBuIds;
        rows = await CustomerService.GetDashboardAsync(scope);
    }

    /// <summary>Sends one customer a secure self-service update link (mirrors the supplier flow): the
    /// customer verifies via OTP and updates their own information, moving the record to review.</summary>
    private async Task SendLinkAsync(CustomerService.CustomerRow row)
    {
        notifyingId = row.Id;
        var (ok, err) = await CustomerEmailService.NotifyCustomerAsync(row.Id, row.Name, row.Email, currentUser, Nav.BaseUri);
        notifyingId = null;
        if (ok)
        {
            ToastService.ShowSuccess($"Update link sent to {row.Name}.");
            await ReloadRowsAsync();
        }
        else
        {
            ToastService.ShowError(err ?? "Could not send the update link.");
        }
    }

    /// <summary>Emails a self-service update link to every customer currently in view (after the business
    /// unit / status / search filters), skipping those without an email.</summary>
    private async Task NotifyAllAsync()
    {
        var targets = statusFiltered.ToList();
        if (targets.Count == 0)
        {
            ToastService.ShowInfo("There are no customers in the current view to notify.");
            return;
        }

        bulkSending = true;
        int sent = 0, failed = 0;
        foreach (var row in targets)
        {
            var (ok, _) = await CustomerEmailService.NotifyCustomerAsync(row.Id, row.Name, row.Email, currentUser, Nav.BaseUri);
            if (ok) sent++; else failed++;
        }
        bulkSending = false;
        await ReloadRowsAsync();
        ToastService.ShowSuccess($"Update link sent to {sent} customer(s)." + (failed > 0 ? $" {failed} skipped (no email or send error)." : ""));
    }

    private void OpenTemplateDialog()
    {
        templatePopulate = false;
        // Default the populate scope to the business unit currently filtered in the list.
        templateBuId = filterBusinessUnitId;
        generatingTemplate = false;
        showTemplateDialog = true;
    }

    private void CloseTemplateDialog()
    {
        if (generatingTemplate) return;
        showTemplateDialog = false;
    }

    /// <summary>Builds the template workbook in-component (showing progress) and hands the finished file to
    /// the browser via JS, so the user sees a spinner while a populated template is being generated. The
    /// business-unit scope mirrors the export endpoint's server-side check.</summary>
    private async Task DownloadTemplateAsync()
    {
        if (generatingTemplate) return;
        generatingTemplate = true;
        try
        {
            var config = await FieldConfigService.GetAllAsync();

            List<Customer> customers = [];
            if (templatePopulate)
            {
                templateProgress = "Loading customer data…";
                StateHasChanged();

                var scope = seesAllBusinessUnits ? new List<int>() : userBuIds;
                int? bu = templateBuId > 0 ? templateBuId : null;
                customers = await CustomerService.GetForExportAsync(null, null, bu, scope);
            }

            templateProgress = templatePopulate
                ? $"Generating template for {customers.Count} customer(s)…"
                : "Generating template…";
            StateHasChanged();

            // Offload the CPU-bound workbook build so the spinner keeps rendering while it runs.
            var bytes = await Task.Run(() => CustomerExport.ExportUploadTemplate(customers, config));
            var fileName = templatePopulate ? "Customer Template (Populated).xlsx" : "Customer Template (Blank).xlsx";

            templateProgress = "Preparing download…";
            StateHasChanged();

            await JS.InvokeVoidAsync("ssDoc.download", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));

            showTemplateDialog = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Template generation failed: {ex.Message}");
        }
        finally
        {
            generatingTemplate = false;
        }
    }

    /// <summary>Builds an export URL carrying the current list filters (business unit, status, search) so
    /// the download matches what the grid shows. BU/status scope is re-checked server-side.</summary>
    private string ExportUrl(string format)
    {
        var q = new List<string>();
        if (filterBusinessUnitId > 0) q.Add($"businessUnitId={filterBusinessUnitId}");
        if (!string.IsNullOrWhiteSpace(statusFilter)) q.Add($"status={Uri.EscapeDataString(statusFilter)}");
        if (!string.IsNullOrWhiteSpace(searchName)) q.Add($"search={Uri.EscapeDataString(searchName)}");
        return q.Count > 0 ? $"/customers/export/{format}?{string.Join("&", q)}" : $"/customers/export/{format}";
    }

    private void ComingSoon(string what) => ToastService.ShowInfo($"{what} is coming in the next update.");

    private static string StatusClass(string status) => status switch
    {
        CustomerStatuses.Complete => "bg-success-subtle text-success-emphasis",
        CustomerStatuses.ForReview => "bg-warning-subtle text-warning-emphasis",
        CustomerStatuses.AwaitingCustomerResponse => "bg-info-subtle text-info-emphasis",
        CustomerStatuses.Returned => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
