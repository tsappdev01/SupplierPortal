@page "/admin/customers"
@attribute [Authorize(Policy = "Portal.Customer")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Models.Customer
@using SupplierPortal.Web.Services
@inject CustomerService CustomerService
@inject CustomerExportService CustomerExport
@inject CustomerEmailService CustomerEmailService
@inject CustomerDocumentService DocumentService
@inject CustomerFieldConfigService FieldConfigService
@inject BusinessUnitService BusinessUnitService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Manage Customer - CST Portal</PageTitle>

<h1>Manage Customer</h1>

<div class="di-stat-row no-print">
    <div class="di-stat-tile di-stat-total">
        <div class="di-stat-value">@buFiltered.Count</div>
        <div class="di-stat-label">Total Customers</div>
    </div>
    <div class="di-stat-tile di-stat-new">
        <div class="di-stat-value">@Count(CustomerStatuses.NotSubmitted)</div>
        <div class="di-stat-label">Not Submitted</div>
    </div>
    <div class="di-stat-tile di-stat-await">
        <div class="di-stat-value">@Count(CustomerStatuses.AwaitingCustomerResponse)</div>
        <div class="di-stat-label">Awaiting Customer Response</div>
    </div>
    <div class="di-stat-tile di-stat-review">
        <div class="di-stat-value">@Count(CustomerStatuses.ForReview)</div>
        <div class="di-stat-label">For Review</div>
    </div>
    <div class="di-stat-tile di-stat-complete">
        <div class="di-stat-value">@Count(CustomerStatuses.Complete)</div>
        <div class="di-stat-label">Completed</div>
    </div>
</div>

<div class="d-flex gap-2 mb-3 no-print align-items-center flex-wrap">
    <a class="di-export-btn" href="@ExportUrl("xlsx")" title="Export to Excel">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none"><rect x="5" y="3" width="34" height="46" rx="4" fill="#fff" stroke="#2e7d32" stroke-width="2.5"/><path d="M30 3h9v9z" fill="#a5d6a7" stroke="#2e7d32" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 15h16M12 21h16M12 27h9" stroke="#a5d6a7" stroke-width="2" stroke-linecap="round"/><rect x="5" y="33" width="34" height="15" rx="3" fill="#2e7d32"/><text x="22" y="44.5" font-family="Arial" font-size="10.5" font-weight="800" fill="#fff" text-anchor="middle">XLS</text></svg>
        <span>Excel</span>
    </a>
    <a class="di-export-btn" href="@ExportUrl("xlsx-full")" title="Export to Excel — all customer fields">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none"><rect x="5" y="3" width="34" height="46" rx="4" fill="#fff" stroke="#1b5e20" stroke-width="2.5"/><path d="M30 3h9v9z" fill="#a5d6a7" stroke="#1b5e20" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 15h16M12 21h16M12 27h16M12 33h9" stroke="#a5d6a7" stroke-width="2" stroke-linecap="round"/><rect x="5" y="37" width="34" height="12" rx="3" fill="#1b5e20"/><text x="22" y="46.5" font-family="Arial" font-size="8.5" font-weight="800" fill="#fff" text-anchor="middle">ALL</text></svg>
        <span>Excel (All Fields)</span>
    </a>
    <button type="button" class="di-export-btn" @onclick="OpenTemplateDialog" title="Generate a customer upload template">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none"><rect x="5" y="3" width="34" height="46" rx="4" fill="#fff" stroke="#1565c0" stroke-width="2.5"/><path d="M30 3h9v9z" fill="#90caf9" stroke="#1565c0" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 16h16M12 22h16M12 28h16M12 34h9" stroke="#90caf9" stroke-width="2" stroke-linecap="round"/></svg>
        <span>Generate Template</span>
    </button>
    <a class="di-export-btn" href="@ExportUrl("pdf")" title="Export to PDF">
        <svg width="26" height="30" viewBox="0 0 44 52" fill="none"><rect x="5" y="3" width="34" height="46" rx="4" fill="#fff" stroke="#c62828" stroke-width="2.5"/><path d="M30 3h9v9z" fill="#ef9a9a" stroke="#c62828" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 15h16M12 21h16M12 27h9" stroke="#ef9a9a" stroke-width="2" stroke-linecap="round"/><rect x="5" y="33" width="34" height="15" rx="3" fill="#c62828"/><text x="22" y="44.5" font-family="Arial" font-size="10.5" font-weight="800" fill="#fff" text-anchor="middle">PDF</text></svg>
        <span>PDF</span>
    </a>
    <button type="button" class="di-export-btn" @onclick="PrintAsync" title="Print">
        <svg width="28" height="30" viewBox="0 0 48 48" fill="none"><path d="M14 6h20v11H14z" fill="#fff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round"/><rect x="7" y="16" width="34" height="17" rx="3.5" fill="#607d8b"/><rect x="14" y="29" width="20" height="13" rx="1.5" fill="#fff" stroke="#455a64" stroke-width="2.5" stroke-linejoin="round"/><path d="M18 34h12M18 38h8" stroke="#455a64" stroke-width="2" stroke-linecap="round"/></svg>
        <span>Print</span>
    </button>

    <button type="button" class="di-action-btn is-notify ms-auto" disabled="@bulkSending" @onclick="NotifyAllAsync" title="Email a self-service update link to the customers in view">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="4.5" width="19" height="14" rx="2.5" fill="#e3f6fb" stroke="#0aa2c0" stroke-width="1.7"/><path d="M3.5 6.5 12 12.5l8.5-6" stroke="#0aa2c0" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="19.5" cy="6" r="3.4" fill="#0aa2c0" stroke="#fff" stroke-width="1.2"/><path d="M19.5 4.4v3.2M17.9 6h3.2" stroke="#fff" stroke-width="1.2" stroke-linecap="round"/></svg>
        <span>Notify All Customers</span>
    </button>
    <button type="button" class="di-action-btn is-register" @onclick="RegisterCustomerAsync" title="Register a new customer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="9.5" cy="8" r="3.6" fill="#e6ebf7" stroke="#1a2233" stroke-width="1.7"/><path d="M3.5 20c0-3.6 2.7-6 6-6s6 2.4 6 6" fill="#e6ebf7" stroke="#1a2233" stroke-width="1.7" stroke-linecap="round"/><circle cx="18.5" cy="16.5" r="4.5" fill="#1a2233"/><path d="M18.5 14.3v4.4M16.3 16.5h4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span>Register Customer</span>
    </button>
    <a class="di-action-btn is-upload" href="/admin/customers/upload" title="Bulk-upload customers from Excel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 19.5a4 4 0 0 1-.6-7.96 5.5 5.5 0 0 1 10.8-1.06A3.75 3.75 0 0 1 18.5 19.5H6Z" fill="#faf1d8" stroke="#a8842f" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 16.5V9m0 0-2.6 2.6M12 9l2.6 2.6" stroke="#a8842f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Upload Customer Data</span>
    </a>
</div>

@if (showTemplateDialog)
{
    <div class="di-tmpl-backdrop" @onclick="CloseTemplateDialog">
        <div class="di-tmpl-modal" @onclick:stopPropagation>
            <h5 class="di-tmpl-title">Generate Customer Template</h5>
            <p class="di-tmpl-text">
                Download an Excel template for the business to fill in and re-upload. On upload,
                existing customers (by Customer Unique Number) are updated rather than duplicated.
            </p>
            <label class="di-tmpl-radio">
                <input type="radio" name="custTmplMode" checked="@(!templatePopulate)" @onchange="() => templatePopulate = false" />
                <span>Blank template (headers only)</span>
            </label>
            <label class="di-tmpl-radio">
                <input type="radio" name="custTmplMode" checked="@templatePopulate" @onchange="() => templatePopulate = true" />
                <span>Populate with existing customer data</span>
            </label>
            @if (templatePopulate)
            {
                <div class="di-tmpl-field">
                    <label>Business Unit</label>
                    <select @bind="templateBuId" disabled="@generatingTemplate">
                        <option value="0">@(seesAllBusinessUnits ? "All Business Units" : "All My Business Units")</option>
                        @foreach (var bu in businessUnits)
                        {
                            <option value="@bu.Id">@bu.Name</option>
                        }
                    </select>
                </div>
            }
            @if (generatingTemplate)
            {
                <div class="di-tmpl-progress">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>@templateProgress</span>
                </div>
            }
            <div class="di-tmpl-actions">
                <button type="button" class="di-btn di-btn-secondary" @onclick="CloseTemplateDialog" disabled="@generatingTemplate">Cancel</button>
                <button type="button" class="di-btn di-btn-primary" @onclick="DownloadTemplateAsync" disabled="@generatingTemplate">
                    @if (generatingTemplate)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Generating…</span>
                    }
                    else
                    {
                        <span>Download</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<div class="row g-2 mb-3 no-print">
    @if (businessUnits.Count > 1 || isAdministrator)
    {
        <div class="col-auto" style="min-width: 240px;">
            <label class="form-label">Business Unit</label>
            <select class="form-select" @bind="filterBusinessUnitId" @bind:after="OnFilterChanged">
                <option value="0">All Business Units</option>
                @foreach (var bu in businessUnits)
                {
                    <option value="@bu.Id">@bu.Name</option>
                }
            </select>
        </div>
    }
    <div class="col-auto" style="min-width: 240px;">
        <label class="form-label">Customer Name</label>
        <input class="form-control" placeholder="Search by name..." @bind="searchName" @bind:event="oninput" @bind:after="OnFilterChanged" />
    </div>
    <div class="col-auto" style="min-width: 220px;">
        <label class="form-label">Status</label>
        <select class="form-select" @bind="statusFilter" @bind:after="OnFilterChanged">
            <option value="">All Statuses</option>
            @foreach (var s in CustomerStatuses.All)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
</div>

<ul class="nav nav-tabs no-print mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == 0 ? "active" : "")" @onclick="() => SetTab(0)">Recently Updated (@statusFiltered.Count(IsRecent))</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == 1 ? "active" : "")" @onclick="() => SetTab(1)">Updated Last Week (@statusFiltered.Count(IsLastWeek))</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == 2 ? "active" : "")" @onclick="() => SetTab(2)">Everything Else (@statusFiltered.Count(IsOlder))</button>
    </li>
</ul>

<div class="d-flex align-items-center gap-2 no-print mb-2">
    <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
    <span>Page @currentPage of @TotalPages (@TabFiltered.Count() customers)</span>
    <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
</div>

<div style="overflow-x: auto;">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th class="no-print"><input type="checkbox" checked="@AllOnPageSelected" @onchange="ToggleSelectAllOnPage" /></th>
                <th>Customer Number</th>
                <th>Customer Name</th>
                <th>First Name</th>
                <th>Contact Email</th>
                <th>Status</th>
                <th class="no-print">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Loading…</td></tr>
            }
            else if (!Paged.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No customers found.</td></tr>
            }
            else
            {
                @foreach (var c in Paged)
                {
                    var row = c;
                    <tr>
                        <td class="no-print"><input type="checkbox" checked="@selectedIds.Contains(row.Id)" @onchange="() => ToggleSelected(row.Id)" /></td>
                        <td>@row.Number</td>
                        <td>@row.Name</td>
                        <td>@row.FirstName</td>
                        <td>@row.Email</td>
                        <td><span class="badge @StatusClass(row.Status)">@row.Status</span></td>
                        <td class="no-print">
                            <button class="btn btn-sm btn-outline-secondary" title="View attached documents" @onclick="() => ShowDocumentsAsync(row)">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM9.5 3A1.5 1.5 0 0 0 11 4.5h1.5L9.5 1.5V3zM5 8.5a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H5z"/></svg>
                            </button>
                            <a class="btn btn-sm btn-outline-primary" href="/admin/customers/@row.Id" title="Edit">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10ZM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5Zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5Z"/></svg>
                            </a>
                            <button class="btn btn-sm btn-outline-secondary" title="Send self-service update link to customer" disabled="@(notifyingId == row.Id)" @onclick="() => SendLinkAsync(row)">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/></svg>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (showDocsModal)
{
    <div class="di-modal-backdrop no-print" @onclick="CloseDocsModal"></div>
    <div class="di-modal no-print" role="dialog" aria-modal="true">
        <div class="di-modal-head">
            <h2 class="h6 mb-0 text-truncate">Attached Documents &mdash; @docsCustomerName</h2>
            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDocsModal"></button>
        </div>
        <div class="di-modal-body">
            @if (modalDocsLoading)
            {
                <p><em>Documents are being retrieved, please wait…</em></p>
            }
            else if (modalDocuments.Count == 0)
            {
                <p><em>No documents have been uploaded for this customer.</em></p>
            }
            else
            {
                <div class="di-docsall-toolbar">
                    <span class="di-docsall-count">@modalDocuments.Count document(s)</span>
                    <div class="di-docsall-toolbar-actions">
                        <a class="btn btn-sm btn-dark" href="/customers/@docsCustomerId/documents.zip">⬇ Download all (zip)</a>
                    </div>
                </div>
                <div class="di-docsall-grid">
                    @foreach (var doc in modalDocuments)
                    {
                        <div class="di-docsall-card">
                            <div class="di-docsall-preview">
                                @if (doc.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/customers/documents/@doc.Id" alt="@doc.FileName" loading="lazy" />
                                }
                                else
                                {
                                    <iframe src="/customers/documents/@doc.Id#toolbar=0&navpanes=0&view=FitH" title="@doc.FileName" loading="lazy"></iframe>
                                }
                            </div>
                            <div class="di-docsall-info">
                                <span class="di-docsall-type badge">@doc.DocumentType</span>
                                <span class="di-docsall-name" title="@doc.FileName">@doc.FileName</span>
                            </div>
                            <div class="di-docsall-actions">
                                <a class="btn btn-sm btn-outline-primary" href="/customers/documents/@doc.Id" target="_blank" title="Open in a new tab">Open</a>
                                <a class="btn btn-sm btn-primary" href="/customers/documents/@doc.Id?download=1" title="Download the original file">Download</a>
                            </div>
                        </div>
                    }
                </div>
                <div class="small text-muted mt-2">Tip: click a preview's Open to view full size, or Download to save the original.</div>
            }
        </div>
    </div>
}

<style>
    .di-modal-backdrop { position: fixed; inset: 0; background: rgba(15,22,35,0.55); z-index: 1080; }
    .di-modal { position: fixed; inset: 24px; z-index: 1081; background: #fff; border-radius: 10px; display: flex; flex-direction: column; box-shadow: 0 14px 44px rgba(0,0,0,0.35); overflow: hidden; }
    .di-modal-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid #e2e5ea; }
    .di-modal-body { padding: 16px 18px; overflow: auto; }
    .di-docsall-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
    .di-docsall-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .di-docsall-count { font-size: 13px; font-weight: 600; color: #46506b; }
    .di-docsall-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    .di-docsall-card { border: 1px solid #e2e5ea; border-radius: 10px; overflow: hidden; background: #fff; transition: box-shadow .15s ease; }
    .di-docsall-card:hover { box-shadow: 0 6px 20px rgba(20, 30, 50, 0.1); }
    .di-docsall-preview { height: 200px; background: #f6f7f9; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .di-docsall-preview img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .di-docsall-preview iframe { width: 100%; height: 100%; border: 0; }
    .di-docsall-info { display: flex; align-items: center; gap: 8px; padding: 10px 12px 4px; }
    .di-docsall-type { background: #eef1ff; color: #3b5bdb; font-weight: 600; flex: none; }
    .di-docsall-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
    .di-docsall-actions { display: flex; gap: 8px; padding: 8px 12px 12px; }
    .di-docsall-actions .btn { display: inline-flex; align-items: center; gap: 6px; flex: 1 1 0; justify-content: center; }

    .di-tmpl-backdrop { position: fixed; inset: 0; background: rgba(15,22,35,0.55); display: flex; align-items: center; justify-content: center; z-index: 1080; padding: 24px; }
    .di-tmpl-modal { background: #fff; border-radius: 10px; width: min(460px, 100%); padding: 22px 24px; box-shadow: 0 12px 40px rgba(0,0,0,0.35); }
    .di-tmpl-title { margin: 0 0 6px; font-size: 18px; font-weight: 700; color: #1a2233; }
    .di-tmpl-text { margin: 0 0 16px; font-size: 13.5px; color: #6b7280; }
    .di-tmpl-radio { display: flex; align-items: center; gap: 8px; padding: 8px 0; font-size: 14.5px; color: #26303f; cursor: pointer; }
    .di-tmpl-field { margin: 10px 0 4px; display: flex; flex-direction: column; gap: 5px; }
    .di-tmpl-field label { font-size: 13px; font-weight: 600; color: #46618f; }
    .di-tmpl-field select { padding: 9px 11px; border: 1px solid #e2e5ea; border-radius: 8px; font-size: 15px; color: #1a2233; background: #fff; font-family: inherit; }
    .di-tmpl-progress { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 13.5px; color: #46618f; }
    .di-tmpl-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
    .di-tmpl-actions .di-btn { display: inline-flex; align-items: center; gap: 7px; font-family: inherit; font-size: 15px; font-weight: 700; padding: 10px 22px; border-radius: 8px; cursor: pointer; border: none; text-decoration: none; }
    .di-tmpl-actions .di-btn-primary { background: #3b5bdb; color: #fff; }
    .di-tmpl-actions .di-btn-primary:hover { background: #2f4bc4; }
    .di-tmpl-actions .di-btn-secondary { background: #fff; color: #1a2233; border: 1px solid #e2e5ea; }
    .di-tmpl-actions .di-btn-secondary:hover { background: #f5f7fc; }
</style>

@code {
    private List<CustomerService.CustomerRow> rows = [];
    private List<BusinessUnit> businessUnits = [];
    private int filterBusinessUnitId;
    private string? searchName;
    private string statusFilter = "";
    private int activeTab;
    private int currentPage = 1;
    private const int PageSize = 25;
    private readonly HashSet<int> selectedIds = [];
    private bool loading = true;
    private bool isAdministrator;
    private bool seesAllBusinessUnits;
    private string currentUser = "unknown";

    // "Generate Template" dialog state.
    private bool showTemplateDialog;
    private bool templatePopulate;
    private int templateBuId;
    private bool generatingTemplate;
    private string templateProgress = "";
    private List<int> userBuIds = [];

    // ---- derived collections ----
    private List<CustomerService.CustomerRow> buFiltered =>
        filterBusinessUnitId == 0 ? rows : rows.Where(r => r.BusinessUnitId == filterBusinessUnitId).ToList();

    private List<CustomerService.CustomerRow> statusFiltered => buFiltered
        .Where(r => string.IsNullOrEmpty(statusFilter) || r.Status == statusFilter)
        .Where(r => string.IsNullOrWhiteSpace(searchName) || r.Name.Contains(searchName!, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IEnumerable<CustomerService.CustomerRow> TabFiltered => activeTab switch
    {
        0 => statusFiltered.Where(IsRecent),
        1 => statusFiltered.Where(IsLastWeek),
        _ => statusFiltered.Where(IsOlder)
    };

    private IEnumerable<CustomerService.CustomerRow> Paged => TabFiltered.Skip((currentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TabFiltered.Count() / (double)PageSize));
    private bool AllOnPageSelected => Paged.Any() && Paged.All(r => selectedIds.Contains(r.Id));

    private static bool IsRecent(CustomerService.CustomerRow r) => r.Updated >= DateTime.UtcNow.AddDays(-1);
    private static bool IsLastWeek(CustomerService.CustomerRow r) => r.Updated < DateTime.UtcNow.AddDays(-1) && r.Updated >= DateTime.UtcNow.AddDays(-7);
    private static bool IsOlder(CustomerService.CustomerRow r) => r.Updated < DateTime.UtcNow.AddDays(-7);

    private int Count(string status) => buFiltered.Count(r => r.Status == status);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";
        isAdministrator = state.User.IsAdministrator();
        // Only an administrator with no business-unit assignment sees all customers; a user (admin or
        // not) assigned to specific business units is scoped to those — both in the list and the filter.
        var ids = state.User.GetBusinessUnitIds();
        userBuIds = ids;
        seesAllBusinessUnits = isAdministrator && ids.Count == 0;
        var scope = seesAllBusinessUnits ? new List<int>() : ids;
        var allBu = await BusinessUnitService.GetAllAsync();
        businessUnits = seesAllBusinessUnits ? allBu : allBu.Where(b => ids.Contains(b.Id)).ToList();
        rows = await CustomerService.GetDashboardAsync(scope);
        loading = false;
    }

    private void OnFilterChanged() => currentPage = 1;
    private void SetTab(int tab) { activeTab = tab; currentPage = 1; }
    private void GoToPage(int p) => currentPage = Math.Clamp(p, 1, TotalPages);

    private void ToggleSelected(int id) { if (!selectedIds.Add(id)) selectedIds.Remove(id); }
    private void ToggleSelectAllOnPage(ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        foreach (var r in Paged) { if (on) selectedIds.Add(r.Id); else selectedIds.Remove(r.Id); }
    }

    private async Task RegisterCustomerAsync()
    {
        var id = await CustomerService.CreateDraftAsync(currentUser, filterBusinessUnitId == 0 ? null : filterBusinessUnitId);
        Nav.NavigateTo($"/admin/customers/{id}");
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    // Attached-documents viewer modal.
    private bool showDocsModal;
    private int docsCustomerId;
    private string docsCustomerName = "";
    private List<CustomerDocument> modalDocuments = [];
    private bool modalDocsLoading;

    private async Task ShowDocumentsAsync(CustomerService.CustomerRow row)
    {
        docsCustomerId = row.Id;
        docsCustomerName = row.Name;
        modalDocuments = [];
        modalDocsLoading = true;
        showDocsModal = true;
        modalDocuments = await DocumentService.GetDocumentsAsync(row.Id);
        modalDocsLoading = false;
    }

    private void CloseDocsModal() => showDocsModal = false;

    private int? notifyingId;
    private bool bulkSending;

    /// <summary>Reloads the dashboard rows after a status-changing action (e.g. a link send moves the
    /// customer to "Awaiting Customer Response").</summary>
    private async Task ReloadRowsAsync()
    {
        var scope = seesAllBusinessUnits ? new List<int>() : userBuIds;
        rows = await CustomerService.GetDashboardAsync(scope);
    }

    /// <summary>Sends one customer a secure self-service update link (mirrors the supplier flow): the
    /// customer verifies via OTP and updates their own information, moving the record to review.</summary>
    private async Task SendLinkAsync(CustomerService.CustomerRow row)
    {
        notifyingId = row.Id;
        var (ok, err) = await CustomerEmailService.NotifyCustomerAsync(row.Id, row.Name, row.Email, currentUser, Nav.BaseUri);
        notifyingId = null;
        if (ok)
        {
            ToastService.ShowSuccess($"Update link sent to {row.Name}.");
            await ReloadRowsAsync();
        }
        else
        {
            ToastService.ShowError(err ?? "Could not send the update link.");
        }
    }

    /// <summary>Emails a self-service update link to every customer currently in view (after the business
    /// unit / status / search filters), skipping those without an email.</summary>
    private async Task NotifyAllAsync()
    {
        var targets = statusFiltered.ToList();
        if (targets.Count == 0)
        {
            ToastService.ShowInfo("There are no customers in the current view to notify.");
            return;
        }

        bulkSending = true;
        int sent = 0, failed = 0;
        foreach (var row in targets)
        {
            var (ok, _) = await CustomerEmailService.NotifyCustomerAsync(row.Id, row.Name, row.Email, currentUser, Nav.BaseUri);
            if (ok) sent++; else failed++;
        }
        bulkSending = false;
        await ReloadRowsAsync();
        ToastService.ShowSuccess($"Update link sent to {sent} customer(s)." + (failed > 0 ? $" {failed} skipped (no email or send error)." : ""));
    }

    private void OpenTemplateDialog()
    {
        templatePopulate = false;
        // Default the populate scope to the business unit currently filtered in the list.
        templateBuId = filterBusinessUnitId;
        generatingTemplate = false;
        showTemplateDialog = true;
    }

    private void CloseTemplateDialog()
    {
        if (generatingTemplate) return;
        showTemplateDialog = false;
    }

    /// <summary>Builds the template workbook in-component (showing progress) and hands the finished file to
    /// the browser via JS, so the user sees a spinner while a populated template is being generated. The
    /// business-unit scope mirrors the export endpoint's server-side check.</summary>
    private async Task DownloadTemplateAsync()
    {
        if (generatingTemplate) return;
        generatingTemplate = true;
        try
        {
            var config = await FieldConfigService.GetAllAsync();

            List<Customer> customers = [];
            if (templatePopulate)
            {
                templateProgress = "Loading customer data…";
                StateHasChanged();

                var scope = seesAllBusinessUnits ? new List<int>() : userBuIds;
                int? bu = templateBuId > 0 ? templateBuId : null;
                customers = await CustomerService.GetForExportAsync(null, null, bu, scope);
            }

            templateProgress = templatePopulate
                ? $"Generating template for {customers.Count} customer(s)…"
                : "Generating template…";
            StateHasChanged();

            // Offload the CPU-bound workbook build so the spinner keeps rendering while it runs.
            var bytes = await Task.Run(() => CustomerExport.ExportUploadTemplate(customers, config));
            var fileName = templatePopulate ? "Customer Template (Populated).xlsx" : "Customer Template (Blank).xlsx";

            templateProgress = "Preparing download…";
            StateHasChanged();

            await JS.InvokeVoidAsync("ssDoc.download", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));

            showTemplateDialog = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Template generation failed: {ex.Message}");
        }
        finally
        {
            generatingTemplate = false;
        }
    }

    /// <summary>Builds an export URL carrying the current list filters (business unit, status, search) so
    /// the download matches what the grid shows. BU/status scope is re-checked server-side.</summary>
    private string ExportUrl(string format)
    {
        var q = new List<string>();
        if (filterBusinessUnitId > 0) q.Add($"businessUnitId={filterBusinessUnitId}");
        if (!string.IsNullOrWhiteSpace(statusFilter)) q.Add($"status={Uri.EscapeDataString(statusFilter)}");
        if (!string.IsNullOrWhiteSpace(searchName)) q.Add($"search={Uri.EscapeDataString(searchName)}");
        return q.Count > 0 ? $"/customers/export/{format}?{string.Join("&", q)}" : $"/customers/export/{format}";
    }

    private void ComingSoon(string what) => ToastService.ShowInfo($"{what} is coming in the next update.");

    private static string StatusClass(string status) => status switch
    {
        CustomerStatuses.Complete => "bg-success-subtle text-success-emphasis",
        CustomerStatuses.ForReview => "bg-warning-subtle text-warning-emphasis",
        CustomerStatuses.AwaitingCustomerResponse => "bg-info-subtle text-info-emphasis",
        CustomerStatuses.Returned => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}
