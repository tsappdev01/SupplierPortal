@page "/customer/self-service/{Token}"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@using SupplierPortal.Web.Models.Customer
@using SupplierPortal.Web.Services
@using SupplierPortal.Web.Services.SelfService
@inject ICustomerSelfServiceAccessGateway Access
@inject PublicBrandingState PublicBranding
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Verify Your Identity - Customer Portal</PageTitle>

<div class="di-otp-card">
    @if (loading)
    {
        <p><em>Loading…</em></p>
    }
    else if (link is null || !link.Valid)
    {
        <h1>Link Not Available</h1>
        <p class="text-muted">
            This link is invalid or has expired. Please contact us to request a new customer
            information update link.
        </p>
    }
    else
    {
        <h1>Verify Your Identity</h1>
        <p class="text-muted">
            We've sent a 4-digit verification code to the email address on file for
            <strong>@link.CustomerName</strong>. Enter it below to continue.
        </p>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label">Verification Code</label>
            <input class="form-control di-otp-input" maxlength="4" inputmode="numeric" pattern="[0-9]*"
                   @bind="enteredCode" @bind:event="oninput" placeholder="0000" />
        </div>

        <button class="btn btn-primary w-100 mb-2" disabled="@(verifying || enteredCode.Length != 4)" @onclick="VerifyAsync">
            @(verifying ? "Verifying..." : "Verify Code")
        </button>
        <button class="btn btn-link w-100" disabled="@resending" @onclick="ResendAsync">
            @(resending ? "Sending..." : "Resend code")
        </button>
    }
</div>

<style>
    .di-otp-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e2e5ea;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        padding: 2rem;
    }

    .di-otp-input {
        font-size: 1.5rem;
        letter-spacing: 0.5rem;
        text-align: center;
    }
</style>

@code {
    [Parameter] public string Token { get; set; } = "";

    private SsCustomerLinkInfo? link;
    private bool loading = true;
    private bool verifying;
    private bool resending;
    private string enteredCode = "";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        link = await Access.ResolveAsync(Token);

        if (link.Valid)
        {
            PublicBranding.SetLogo(link.LogoSrc);

            if (link.NeedsFreshOtp)
            {
                var (success, error) = await Access.SendOtpAsync(Token);
                if (!success)
                {
                    errorMessage = error;
                }
            }
        }

        loading = false;
    }

    private async Task VerifyAsync()
    {
        if (link is null || !link.Valid) return;

        verifying = true;
        errorMessage = null;

        var (success, error, sessionToken) = await Access.VerifyOtpAsync(Token, enteredCode);
        if (success && sessionToken is not null)
        {
            NavigationManager.NavigateTo($"/customer/self-service/{Token}/form?s={sessionToken}");
            return;
        }

        errorMessage = error;
        verifying = false;
    }

    private async Task ResendAsync()
    {
        if (link is null || !link.Valid) return;

        resending = true;
        errorMessage = null;

        var (success, error) = await Access.SendOtpAsync(Token);
        if (success)
        {
            ToastService.ShowSuccess("A new verification code has been sent.");
        }
        else
        {
            errorMessage = error;
        }

        resending = false;
    }
}
