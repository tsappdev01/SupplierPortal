@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized Context="authState">
                @{ RedirectUnauthorized(authState.User.Identity?.IsAuthenticated ?? false); }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <h3>Not Found</h3>
            <p>Sorry, the content you are looking for does not exist.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private void RedirectUnauthorized(bool isAuthenticated)
    {
        if (isAuthenticated)
        {
            NavigationManager.NavigateTo("/account/access-denied", forceLoad: true);
            return;
        }

        var returnUrl = Uri.EscapeDataString(new Uri(NavigationManager.Uri).PathAndQuery);
        NavigationManager.NavigateTo($"/account/login?returnUrl={returnUrl}", forceLoad: true);
    }
}
