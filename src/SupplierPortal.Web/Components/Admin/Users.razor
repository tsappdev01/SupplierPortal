@page "/admin/users"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject UserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Manage Users - Supplier Portal</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Manage Users</h1>
    <a class="btn btn-primary" href="/admin/users/new">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="me-1">
            <path d="M8 1a.5.5 0 0 1 .5.5V7.5H14.5a.5.5 0 0 1 0 1H8.5V14.5a.5.5 0 0 1-1 0V8.5H1.5a.5.5 0 0 1 0-1H7.5V1.5A.5.5 0 0 1 8 1Z" />
        </svg>
        New User
    </a>
</div>

@if (pendingRegistrations.Count > 0)
{
    <div class="alert alert-info">
        <strong>Pending registrations awaiting linking:</strong>
        @string.Join(", ", pendingRegistrations.Select(p => p.Email))
    </div>
}

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="form-label mb-0 fw-semibold">Status</label>
    <select class="form-select form-select-sm" style="max-width: 200px;" @bind="statusFilter">
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
        <option value="Pending">Pending</option>
        <option value="All">All Statuses</option>
    </select>
    <span class="text-muted small">@FilteredUsers.Count() of @users.Count user(s)</span>
</div>

<div style="overflow-x: auto;">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th></th>
            <th>Username</th>
            <th>Full Name</th>
            <th>Designation</th>
            <th>Email</th>
            <th>Role</th>
            <th>Business Unit(s)</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in FilteredUsers)
        {
            <tr>
                <td style="width: 44px;">
                    @if (user.ProfilePhoto is not null)
                    {
                        <img src="/users/@user.Id/photo" alt="" class="di-avatar-sm" />
                    }
                    else
                    {
                        <span class="di-avatar-sm di-avatar-initials">@GetInitials(user)</span>
                    }
                </td>
                <td>@user.Username</td>
                <td>@user.FullName</td>
                <td>@(user.Designation ?? "-")</td>
                <td>@user.Email</td>
                <td>@user.UserType</td>
                <td>
                    @if (user.BusinessUnits.Count == 0)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        <div class="di-bu-logos">
                            @foreach (var bu in user.BusinessUnits)
                            {
                                @if (bu.Logo is not null)
                                {
                                    <img src="/business-units/@bu.Id/thumbnail" alt="@bu.Name" title="@bu.Name" class="di-bu-logo" />
                                }
                                else
                                {
                                    <span class="di-bu-chip" title="@bu.Name">@bu.Code</span>
                                }
                            }
                        </div>
                    }
                </td>
                <td>
                    @if (user.IsPendingRegistration)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {
                        <label class="di-switch" title="@(user.IsActive ? "Active" : "Inactive")">
                            <input type="checkbox" checked="@user.IsActive" @onchange="e => ToggleActiveAsync(user, (bool)e.Value!)" />
                            <span class="di-switch-slider"></span>
                        </label>
                        @if (user.IsDefaultAdmin)
                        {
                            <span class="badge bg-secondary ms-2">Default Admin</span>
                        }
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" href="/admin/users/edit/@user.Id" title="Edit">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10ZM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5Zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5ZM3.51 10.658l-1.8 4.5 1.8-4.5.001 0Z" />
                        </svg>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<style>
    .di-avatar-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .di-avatar-initials {
        background: #1a2233;
        color: #b5892f;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .di-bu-logos {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    .di-bu-logo {
        width: 28px;
        height: 28px;
        object-fit: contain;
        border: 1px solid #e2e5ea;
        border-radius: 4px;
        background: #fff;
        padding: 2px;
    }

    .di-bu-chip {
        font-size: 0.72rem;
        font-weight: 600;
        background: #eef1f6;
        color: #1a2233;
        border: 1px solid #dce1ea;
        border-radius: 4px;
        padding: 2px 7px;
    }

    .di-switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
        vertical-align: middle;
    }

    .di-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .di-switch-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #dc3545;
        border-radius: 22px;
        transition: background-color 0.15s ease;
    }

    .di-switch-slider::before {
        content: "";
        position: absolute;
        height: 16px;
        width: 16px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        border-radius: 50%;
        transition: transform 0.15s ease;
    }

    .di-switch input:checked + .di-switch-slider {
        background-color: #28a745;
    }

    .di-switch input:checked + .di-switch-slider::before {
        transform: translateX(18px);
    }
</style>

@code {
    private List<User> users = [];
    private List<User> pendingRegistrations = [];
    private string currentUser = "unknown";

    // Status filter — defaults to Active so the list opens on active users only.
    private string statusFilter = "Active";

    private IEnumerable<User> FilteredUsers => statusFilter switch
    {
        "Active" => users.Where(u => u.IsActive && !u.IsPendingRegistration),
        "Inactive" => users.Where(u => !u.IsActive && !u.IsPendingRegistration),
        "Pending" => users.Where(u => u.IsPendingRegistration),
        _ => users,
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";

        users = await UserService.GetAllAsync();
        pendingRegistrations = await UserService.GetPendingRegistrationsAsync();
    }

    private async Task ToggleActiveAsync(User user, bool isActive)
    {
        await UserService.SetActiveAsync(user.Id, isActive, currentUser);
        users = await UserService.GetAllAsync();
    }

    private static string GetInitials(User user)
    {
        var name = string.IsNullOrWhiteSpace(user.FullName) ? user.Username : user.FullName;
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }
}
