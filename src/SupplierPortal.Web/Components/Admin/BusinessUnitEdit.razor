@page "/admin/business-units/edit/{Id:int}"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SupplierPortal.Web.Services
@inject BusinessUnitService BusinessUnitService
@inject LoadingService Loading
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Edit Business Unit - Supplier Portal</PageTitle>

<h1>Edit Business Unit</h1>

@if (notFound)
{
    <div class="alert alert-danger">Business unit not found.</div>
}
else if (Input is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="Input" OnValidSubmit="SaveAsync" FormName="edit-business-unit" style="max-width: 480px;">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label class="form-label">Business Unit Name</label>
            <InputText class="form-control" @bind-Value="Input.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Business Unit Code</label>
            <InputText class="form-control" @bind-Value="Input.Code" />
        </div>
        <div class="mb-3">
            <label class="form-label">Domain Name</label>
            <InputText class="form-control" @bind-Value="Input.Domain" placeholder="e.g. dipark.com" />
        </div>
        <div class="mb-3">
            <label class="form-label">Logo URL <span class="text-muted small">(used in emails &amp; external links)</span></label>
            <InputText class="form-control" @bind-Value="Input.LogoUrl" placeholder="e.g. https://cdn.dipark.com/logo.png" />
            <div class="form-text">A publicly reachable image URL. When set, it is used as the brand image in emails and external links instead of the uploaded logo.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Logo <span class="text-muted small">(full-size)</span></label>
            <InputFile OnChange="OnLogoSelectedAsync" accept="image/*" class="form-control" />
            @if (logoPreview is not null)
            {
                <img src="@logoPreview" alt="Logo preview" class="mt-2" style="max-width: 160px; max-height: 100px; object-fit: contain;" />
            }
            else if (hasExistingLogo)
            {
                <img src="/business-units/@Id/logo" alt="Current logo" class="mt-2" style="max-width: 160px; max-height: 100px; object-fit: contain;" />
            }
        </div>
        <div class="mb-3">
            <label class="form-label">Thumbnail <span class="text-muted small">(square, ~640×640)</span></label>
            <InputFile OnChange="OnThumbnailSelectedAsync" accept="image/*" class="form-control" />
            @if (thumbPreview is not null)
            {
                <img src="@thumbPreview" alt="Thumbnail preview" class="mt-2" style="width: 80px; height: 80px; object-fit: contain; border: 1px solid #dee2e6; border-radius: 6px;" />
            }
            else if (hasExistingThumbnail)
            {
                <img src="/business-units/@Id/thumbnail" alt="Current thumbnail" class="mt-2" style="width: 80px; height: 80px; object-fit: contain; border: 1px solid #dee2e6; border-radius: 6px;" />
            }
        </div>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="/admin/business-units">Cancel</a>
    </EditForm>
}

@code {
    private const long MaxLogoSize = 2 * 1024 * 1024;

    [Parameter] public int Id { get; set; }

    private string currentUser = "unknown";
    private bool notFound;
    private bool hasExistingLogo;
    private bool hasExistingThumbnail;
    private string? errorMessage;
    private string? logoPreview;
    private byte[]? logoBytes;
    private string? logoContentType;
    private string? thumbPreview;
    private byte[]? thumbBytes;
    private string? thumbContentType;

    private BusinessUnitModel? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";

        var businessUnit = await BusinessUnitService.GetByIdAsync(Id);
        if (businessUnit is null)
        {
            notFound = true;
            return;
        }

        hasExistingLogo = businessUnit.Logo is not null;
        hasExistingThumbnail = businessUnit.Thumbnail is not null;
        Input = new BusinessUnitModel
        {
            Name = businessUnit.Name,
            Code = businessUnit.Code,
            Domain = businessUnit.Domain,
            LogoUrl = businessUnit.LogoUrl
        };
    }

    private async Task OnLogoSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(MaxLogoSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        logoBytes = memoryStream.ToArray();
        logoContentType = file.ContentType;
        logoPreview = $"data:{logoContentType};base64,{Convert.ToBase64String(logoBytes)}";
    }

    private async Task OnThumbnailSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(MaxLogoSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        thumbBytes = memoryStream.ToArray();
        thumbContentType = file.ContentType;
        thumbPreview = $"data:{thumbContentType};base64,{Convert.ToBase64String(thumbBytes)}";
    }

    private async Task SaveAsync()
    {
        if (Input is null)
        {
            return;
        }

        var (success, error) = await Loading.RunAsync(
            () => BusinessUnitService.UpdateAsync(Id, Input.Name, Input.Code, Input.Domain, Input.LogoUrl, logoBytes, logoContentType, thumbBytes, thumbContentType, currentUser));
        if (!success)
        {
            errorMessage = error;
            return;
        }

        NavigationManager.NavigateTo("/admin/business-units");
    }

    private sealed class BusinessUnitModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Code { get; set; } = "";

        public string? Domain { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(500)]
        public string? LogoUrl { get; set; }
    }
}
