@page "/admin/users/new"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject UserService UserService
@inject LoadingService Loading
@inject BusinessUnitService BusinessUnitService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>New User - Supplier Portal</PageTitle>

<h1>New User</h1>

@if (pendingRegistrations.Count > 0)
{
    <div class="alert alert-info">
        <strong>Pending registrations:</strong> enter one of these emails below to link and complete
        that account instead of creating a duplicate: @string.Join(", ", pendingRegistrations.Select(p => p.Email))
    </div>
}

<EditForm Model="Input" OnValidSubmit="SaveAsync" FormName="new-user" style="max-width: 640px;">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label class="form-label">Username</label>
        <InputText class="form-control" @bind-Value="Input.Username" />
    </div>
    <div class="mb-3">
        <label class="form-label">Full Name</label>
        <InputText class="form-control" @bind-Value="Input.FullName" />
    </div>
    <div class="mb-3">
        <label class="form-label">Designation</label>
        <InputText class="form-control" @bind-Value="Input.Designation" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="Input.Email" list="pending-emails" />
        <datalist id="pending-emails">
            @foreach (var p in pendingRegistrations)
            {
                <option value="@p.Email" />
            }
        </datalist>
    </div>
        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="useLdap" @bind="UseLdap" />
            <label class="form-check-label" for="useLdap">Authenticate using LDAP (Active Directory)</label>
            <div class="form-text">When ticked, the user signs in with their AD account instead of a local password.</div>
        </div>
    @if (Input.AuthSource == AuthSource.ActiveDirectory)
    {
        <div class="mb-3">
            <label class="form-label">Active Directory Login</label>
            <InputText class="form-control" @bind-Value="Input.AdLogin" placeholder="sAMAccountName, user@dipark.local or DIPARK\user" />
            <div class="form-text">The user signs in with this AD account — no local password is stored.</div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText type="password" class="form-control" @bind-Value="Input.Password" />
            <div class="form-text">Leave blank if linking a self-registered email.</div>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">Profile Photo</label>
        <InputFile OnChange="OnPhotoSelectedAsync" accept="image/*" class="form-control" />
        @if (photoPreview is not null)
        {
            <img src="@photoPreview" alt="Preview" class="mt-2" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover;" />
        }
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <InputSelect class="form-select" style="max-width: 260px;" @bind-Value="Input.UserType">
            <option value="@UserType.NormalUser">Normal User</option>
            <option value="@UserType.Administrator">Administrator</option>
        </InputSelect>
        <div class="form-text">Administrators also see the Settings area (users, business units, audit log).</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Portal Access</label>
        <div class="di-bu-checklist">
            @foreach (var portal in AllPortals)
            {
                <label class="di-bu-check">
                    <input type="checkbox" checked="@selectedPortals.Contains(portal)"
                           @onchange="e => TogglePortal(portal, (bool)e.Value!)" />
                    @portal
                </label>
            }
        </div>
        <div class="form-text">The portals this user can open. Only granted portals appear on their home page and sidebar.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Business Unit(s)</label>
        <div class="di-bu-checklist">
            @foreach (var businessUnit in businessUnits)
            {
                <label class="di-bu-check">
                    <input type="checkbox" checked="@selectedBusinessUnitIds.Contains(businessUnit.Id)"
                           @onchange="e => ToggleBusinessUnit(businessUnit.Id, (bool)e.Value!)" />
                    @businessUnit.Name
                </label>
            }
        </div>
        @if (businessUnits.Count == 0)
        {
            <div class="form-text">No business units exist yet. Add one first.</div>
        }
    </div>
    <div class="mb-3">
        <label class="form-label d-block">Status</label>
        <label class="di-switch">
            <input type="checkbox" @bind="Input.IsActive" />
            <span class="di-switch-slider"></span>
        </label>
        <span class="ms-2">@(Input.IsActive ? "Active" : "Inactive")</span>
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary">Save User</button>
    <a class="btn btn-secondary" href="/admin/users">Cancel</a>
</EditForm>

<style>
    .di-bu-checklist {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.75rem 1rem;
    }

    .di-bu-check {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: normal;
        margin-bottom: 0;
    }

    .di-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        vertical-align: middle;
    }

    .di-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .di-switch-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #dc3545;
        border-radius: 24px;
        transition: background-color 0.15s ease;
    }

    .di-switch-slider::before {
        content: "";
        position: absolute;
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        border-radius: 50%;
        transition: transform 0.15s ease;
    }

    .di-switch input:checked + .di-switch-slider {
        background-color: #28a745;
    }

    .di-switch input:checked + .di-switch-slider::before {
        transform: translateX(20px);
    }
</style>

@code {
    private const long MaxPhotoSize = 2 * 1024 * 1024;

    private static readonly PortalAccess[] AllPortals =
        [PortalAccess.Supplier, PortalAccess.Landlord, PortalAccess.Broker, PortalAccess.Customer];

    private List<BusinessUnit> businessUnits = [];
    private List<User> pendingRegistrations = [];
    private HashSet<int> selectedBusinessUnitIds = [];
    private HashSet<PortalAccess> selectedPortals = [PortalAccess.Supplier];
    private string currentUser = "unknown";
    private string? errorMessage;
    private string? photoPreview;
    private byte[]? photoBytes;
    private string? photoContentType;

    [SupplyParameterFromForm]
    private UserModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";

        businessUnits = await BusinessUnitService.GetAllAsync();
        pendingRegistrations = await UserService.GetPendingRegistrationsAsync();
    }

    private void ToggleBusinessUnit(int businessUnitId, bool isChecked)
    {
        if (isChecked)
        {
            selectedBusinessUnitIds.Add(businessUnitId);
        }
        else
        {
            selectedBusinessUnitIds.Remove(businessUnitId);
        }
    }

    private void TogglePortal(PortalAccess portal, bool isChecked)
    {
        if (isChecked) selectedPortals.Add(portal);
        else selectedPortals.Remove(portal);
    }

    private PortalAccess SelectedPortalAccess =>
        selectedPortals.Aggregate(PortalAccess.None, (acc, p) => acc | p);

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(MaxPhotoSize);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        photoBytes = memoryStream.ToArray();
        photoContentType = file.ContentType;
        photoPreview = $"data:{photoContentType};base64,{Convert.ToBase64String(photoBytes)}";
    }

    private async Task SaveAsync()
    {
        var (success, error) = await Loading.RunAsync(() => UserService.AddOrLinkUserAsync(
            Input.Username, Input.FullName, Input.Designation, Input.Email, Input.Password, Input.UserType,
            selectedBusinessUnitIds.ToList(), Input.IsActive, photoBytes, photoContentType, currentUser,
            Input.AuthSource, Input.AdLogin, SelectedPortalAccess));

        if (!success)
        {
            errorMessage = error;
            return;
        }

        NavigationManager.NavigateTo("/admin/users");
    }

    // Checkbox <-> AuthSource: ticked means the account authenticates against Active Directory (LDAP).
    private bool UseLdap
    {
        get => Input.AuthSource == AuthSource.ActiveDirectory;
        set => Input.AuthSource = value ? AuthSource.ActiveDirectory : AuthSource.Local;
    }

    private sealed class UserModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string FullName { get; set; } = "";

        public string? Designation { get; set; }

        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        public string? Password { get; set; }

        public AuthSource AuthSource { get; set; } = AuthSource.Local;

        public string? AdLogin { get; set; }

        public UserType UserType { get; set; } = UserType.NormalUser;

        public bool IsActive { get; set; } = true;
    }
}
