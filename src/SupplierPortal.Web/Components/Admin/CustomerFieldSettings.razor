@page "/admin/customer-fields"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Models.Customer
@using SupplierPortal.Web.Services
@inject CustomerFieldConfigService FieldConfigService
@inject UserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Customer Field Manager - CST Portal</PageTitle>

<div class="di-cfm">
    <div class="di-cfm-card">
        <div class="di-cfm-head">
            <div class="di-cfm-head-icon">
                <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M3 0h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V1a1 1 0 0 1 1-1zm1 3v2h8V3H4zm0 4v2h8V7H4zm0 4v2h5v-2H4z"/></svg>
            </div>
            <div>
                <h1 class="di-cfm-title">Customer Field Manager</h1>
                <p class="di-cfm-sub">Configure and manage customer portal fields, set validation rules and control field behavior.</p>
            </div>
        </div>

        @if (rows.Count == 0)
        {
            <p class="text-muted p-3"><em>Loading…</em></p>
        }
        else
        {
            @* ---------- Tab pills (drag to reorder) ---------- *@
            <div class="di-cfm-tabbar">
                <div class="di-cfm-pills">
                    @* One pill per distinct tab title — mirrors the customer form, where tabs sharing a title
                       merge into a single wizard step (so no duplicate pills). Use Manage Tabs to rename/reorder. *@
                    @foreach (var title in DistinctTabTitles())
                    {
                        var t = title;
                        <div class="di-cfm-pill @(string.Equals(tabFilter, t, StringComparison.OrdinalIgnoreCase) ? "is-active" : null) @(TabTitleVisible(t) ? null : "is-hidden")"
                             @onclick="() => ToggleTabFilter(t)"
                             title="Click to filter the fields on this tab">
                            <span>@t</span>
                        </div>
                    }
                </div>
                <button class="di-cfm-reorder-hint" @onclick="() => showTabs = true" title="Rename, hide or set who can edit tabs">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a.5.5 0 0 1 .5.5V2h-1V.5A.5.5 0 0 1 8 0zM3 5.5A.5.5 0 0 1 3.5 5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 5.5zM3 8a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 8zm0 2.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5z"/></svg>
                    Manage Tabs
                </button>
            </div>

            @* ---------- Toolbar ---------- *@
            <div class="di-cfm-toolbar">
                <div class="di-cfm-search">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242.656a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/></svg>
                    <input type="text" placeholder="Search fields (name or description)…" @bind="searchText" @bind:event="oninput" @bind:after="OnFilterChanged" />
                </div>
                <div class="di-cfm-filter">
                    <label>Module</label>
                    <select @bind="moduleFilter" @bind:after="OnFilterChanged">
                        <option value="">All Modules</option>
                        <option value="Account">Account (Company)</option>
                        <option value="Contact">Contact (Individual)</option>
                    </select>
                </div>
                <div class="di-cfm-filter">
                    <label>Field Type</label>
                    <select @bind="typeFilter" @bind:after="OnFilterChanged">
                        <option value="">All Types</option>
                        <option value="text">Text (Editable)</option>
                        <option value="lookup">Lookup (LOV)</option>
                        <option value="date">Date</option>
                        <option value="yesno">Yes / No</option>
                    </select>
                </div>
                <div class="di-cfm-filter">
                    <label>Status</label>
                    <select @bind="statusFilter" @bind:after="OnFilterChanged">
                        <option value="">All</option>
                        <option value="active">Active</option>
                        <option value="removed">Removed</option>
                    </select>
                </div>
                <div class="di-cfm-toolbar-actions">
                    <button class="di-cfm-btn di-cfm-btn-primary" @onclick="SaveAsync" disabled="@saving">
                        @(saving ? "Saving…" : "Save Changes")
                    </button>
                </div>
            </div>

            @if (savedMessage is not null)
            {
                <div class="di-cfm-saved">@savedMessage</div>
            }

            <div class="di-cfm-tablewrap">
                @{ var filtered = FilteredRows(); var paged = Paged(filtered); }
                <table class="di-cfm-table">
                    <thead>
                        <tr>
                            <th style="width: 84px;">Order</th>
                            <th style="min-width: 240px;">Field Details</th>
                            <th style="width: 78px;" class="text-center">Move</th>
                            <th style="width: 140px;">Field Type</th>
                            <th style="width: 168px;">Validation Rule</th>
                            <th style="width: 92px;" class="text-center">Status</th>
                            <th style="width: 96px;" class="text-center">Required<br /><span class="di-cfm-th-sub">Internal</span></th>
                            <th style="width: 96px;" class="text-center">Required<br /><span class="di-cfm-th-sub">Customer</span></th>
                            <th style="width: 78px;" class="text-center">Visible</th>
                            <th style="width: 172px;">Depends On</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (paged.Count == 0)
                        {
                            <tr><td colspan="11" class="di-cfm-empty">No fields match the current filters.</td></tr>
                        }
                        @foreach (var f in paged)
                        {
                            var field = f;
                            var isText = string.IsNullOrEmpty(field.FieldKind) || field.FieldKind == "text";
                            <tr class="@(field.IsRemoved ? "di-cfm-row-removed" : null)">
                                <td>
                                    <div class="di-cfm-order">
                                        <span class="di-cfm-grip">⠿</span>
                                        <span class="di-cfm-order-num">@OrderOf(field)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="di-cfm-fd">
                                        <span class="di-cfm-avatar" style="background:@AvatarBg(field.FieldKey); color:@AvatarFg(field.FieldKey);">Aa</span>
                                        <div class="di-cfm-fd-text">
                                            <div class="di-cfm-fd-name">
                                                @field.DisplayLabel
                                                @if (field.IsRequired || field.IsRequiredForCustomer) { <span class="di-cfm-star">*</span> }
                                                @if (field.FieldKind == "lookup") { <span class="di-cfm-tag">LOV</span> }
                                            </div>
                                            <div class="di-cfm-fd-desc">@field.FieldKey</div>
                                            <div class="di-cfm-fd-desc">@(string.IsNullOrWhiteSpace(field.HelpText) ? "Short description (shown as a tooltip)" : field.HelpText)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="di-cfm-move">
                                        <button title="Move up" disabled="@(field.IsRemoved || !CanMoveUp(field))" @onclick="() => MoveFieldUp(field)">
                                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 4l5 6H3z"/></svg>
                                        </button>
                                        <button title="Move down" disabled="@(field.IsRemoved || !CanMoveDown(field))" @onclick="() => MoveFieldDown(field)">
                                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 12L3 6h10z"/></svg>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    @* Field type is fixed (read-only) — changing a field's kind would break how the
                                       form renders it, so it is displayed only. *@
                                    <select class="di-cfm-select" disabled title="Field type is fixed">
                                        <option selected>@FieldTypeLabel(field.FieldKind)</option>
                                    </select>
                                </td>
                                <td>
                                    @if (isText)
                                    {
                                        <div class="di-cfm-vr">
                                            <span>Min</span>
                                            <input type="number" min="0" class="di-cfm-vr-input" @bind="field.MinLength" placeholder="—" disabled="@field.IsRemoved" />
                                            <span>Max</span>
                                            <input type="number" min="0" class="di-cfm-vr-input" @bind="field.MaxLength" placeholder="—" disabled="@field.IsRemoved" />
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="text" class="di-cfm-select" value="N/A" disabled />
                                    }
                                </td>
                                <td class="text-center">
                                    @if (field.IsRemoved)
                                    {
                                        <span class="di-cfm-status di-cfm-status-removed">Removed</span>
                                    }
                                    else
                                    {
                                        <span class="di-cfm-status di-cfm-status-active">Active</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <label class="di-switch" title="Required for internal users (admin portal)">
                                        <input type="checkbox" checked="@field.IsRequired" disabled="@(field.IsRemoved || !field.IsVisible)"
                                               @onchange="e => field.IsRequired = (bool)e.Value!" />
                                        <span class="di-switch-slider"></span>
                                    </label>
                                </td>
                                <td class="text-center">
                                    <label class="di-switch" title="Required for the customer (self-service portal)">
                                        <input type="checkbox" checked="@field.IsRequiredForCustomer" disabled="@(field.IsRemoved || !field.IsVisible)"
                                               @onchange="e => field.IsRequiredForCustomer = (bool)e.Value!" />
                                        <span class="di-switch-slider"></span>
                                    </label>
                                </td>
                                <td class="text-center">
                                    <label class="di-switch">
                                        <input type="checkbox" checked="@field.IsVisible" disabled="@field.IsRemoved"
                                               @onchange="e => OnVisibleChanged(field, (bool)e.Value!)" />
                                        <span class="di-switch-slider"></span>
                                    </label>
                                </td>
                                <td>
                                    <select class="di-cfm-select" value="@(field.ControllingFieldKey ?? "")" disabled="@field.IsRemoved"
                                            @onchange="e => OnControllingChanged(field, (string?)e.Value)">
                                        <option value="">— always shown —</option>
                                        @foreach (var yn in rows.Where(r => !r.IsRemoved && r.Section == field.Section && (r.FieldKind == "yesno" || r.FieldKind == "lookup") && r.FieldKey != field.FieldKey))
                                        {
                                            <option value="@yn.FieldKey">@yn.DisplayLabel</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrWhiteSpace(field.ControllingFieldKey))
                                    {
                                        @if (ControllingKind(field.ControllingFieldKey) == "yesno")
                                        {
                                            <select class="di-cfm-select mt-1" @bind="field.ControllingValue">
                                                <option value="true">is Yes → show</option>
                                                <option value="false">is No → show</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <input class="di-cfm-select mt-1" @bind="field.ControllingValue" placeholder="equals… (e.g. Others)" title="Show this field only when the controlling field equals this exact option" />
                                        }
                                    }
                                </td>
                                <td>
                                    <div class="di-cfm-actions">
                                        <button class="di-cfm-act di-cfm-act-edit" @onclick="() => OpenEdit(field)">
                                            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5z"/></svg>
                                            Edit
                                        </button>
                                        @if (field.IsRemoved)
                                        {
                                            <button class="di-cfm-act di-cfm-act-restore" @onclick="() => field.IsRemoved = false">Restore</button>
                                        }
                                        else
                                        {
                                            <button class="di-cfm-act di-cfm-act-remove" @onclick="() => field.IsRemoved = true">
                                                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>
                                                Remove
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="di-cfm-footer">
                <span class="di-cfm-count">Showing @paged.Count of @filtered.Count fields</span>
                @if (PageCount(filtered) > 1)
                {
                    <div class="di-cfm-pager">
                        <button class="di-cfm-page" disabled="@(page <= 1)" @onclick="() => GoToPage(page - 1)">‹</button>
                        @for (var p = 1; p <= PageCount(filtered); p++)
                        {
                            var pageNo = p;
                            <button class="di-cfm-page @(pageNo == page ? "is-active" : null)" @onclick="() => GoToPage(pageNo)">@pageNo</button>
                        }
                        <button class="di-cfm-page" disabled="@(page >= PageCount(filtered))" @onclick="() => GoToPage(page + 1)">›</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ---------- Edit field modal ---------- *@
@if (editing is not null)
{
    <div class="di-cfm-backdrop" @onclick="CloseEdit">
        <div class="di-cfm-modal" @onclick:stopPropagation="true">
            <div class="di-cfm-modal-head">
                <span>Edit Field</span>
                <button type="button" class="di-cfm-modal-close" @onclick="CloseEdit" aria-label="Close">&times;</button>
            </div>
            <div class="di-cfm-modal-body">
                <div class="di-cfm-fld">
                    <label>Field Key</label>
                    <input type="text" value="@editing.FieldKey" disabled />
                </div>
                <div class="di-cfm-fld">
                    <label>Field Label</label>
                    <input type="text" @bind="editing.DisplayLabel" maxlength="200" placeholder="Label shown on the form" />
                </div>
                <div class="di-cfm-fld">
                    <label>Description <span class="di-cfm-fld-hint">(shown as a tooltip on the form when not blank)</span></label>
                    <textarea rows="2" @bind="editing.HelpText" maxlength="500" placeholder="Short description"></textarea>
                </div>
                <div class="di-cfm-fld-row">
                    <div class="di-cfm-fld">
                        <label>Business Control</label>
                        <select @bind="editing.BusinessControl">
                            @foreach (var c in CustomerFieldControls.All) { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="di-cfm-fld">
                        <label>Customer Control</label>
                        <select @bind="editing.CustomerControl">
                            @foreach (var c in CustomerFieldControls.All) { <option value="@c">@c</option> }
                        </select>
                    </div>
                </div>
                @{ var editIsText = string.IsNullOrEmpty(editing.FieldKind) || editing.FieldKind == "text"; }
                @if (editIsText)
                {
                    <div class="di-cfm-fld-row">
                        <div class="di-cfm-fld">
                            <label>Minimum Length</label>
                            <input type="number" min="0" @bind="editing.MinLength" placeholder="No minimum" />
                        </div>
                        <div class="di-cfm-fld">
                            <label>Maximum Length</label>
                            <input type="number" min="0" @bind="editing.MaxLength" placeholder="No maximum" />
                        </div>
                    </div>
                    <p class="di-cfm-fld-note">Leave blank for no limit. The customer portal validates entered text against these limits and shows a message when the length is out of range.</p>
                }
            </div>
            <div class="di-cfm-modal-foot">
                <button class="di-cfm-btn di-cfm-btn-ghost" @onclick="CloseEdit">Cancel</button>
                <button class="di-cfm-btn di-cfm-btn-primary" @onclick="CloseEdit">Done</button>
            </div>
        </div>
    </div>
}

@* ---------- Manage tabs modal ---------- *@
@if (showTabs)
{
    <div class="di-cfm-backdrop" @onclick="() => showTabs = false">
        <div class="di-cfm-modal di-cfm-modal-wide" @onclick:stopPropagation="true">
            <div class="di-cfm-modal-head">
                <span>Manage Tabs</span>
                <button type="button" class="di-cfm-modal-close" @onclick="() => showTabs = false" aria-label="Close">&times;</button>
            </div>
            <div class="di-cfm-modal-body">
                <p class="di-cfm-fld-note">
                    Rename or hide the customer form's tabs and set their order with the <strong>▲ ▼</strong>
                    arrows (a tab can move across the Company / Individual boundary). <strong>Editable by</strong>
                    restricts who may change a tab on the internal form (leave as <em>Anyone</em> for no
                    restriction). Click <strong>Save Tabs</strong> to apply the order to the customer form.
                </p>
                @* A SINGLE unified list across both sections, in the exact order the wizard renders its steps.
                   One row per distinct tab title (tabs sharing a title merge into one step / pill). Move up/down
                   freely — a tab can cross the Company/Individual boundary, so e.g. an Individual tab can sit
                   between Company tabs and vice versa. The Section column shows which entity a tab's fields
                   belong to. *@
                <table class="di-cfm-table di-cfm-table-tight">
                    <thead>
                        <tr>
                            <th style="width: 74px;">Order</th>
                            <th>Tab Title</th>
                            <th style="width: 130px;">Section</th>
                            <th style="width: 84px;" class="text-center">Visible</th>
                            <th style="width: 240px;">Editable by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var titleGroups = AllTitleGroups(); }
                        @for (var i = 0; i < titleGroups.Count; i++)
                        {
                            var grp = titleGroups[i];
                            var index = i;
                            var geditors = GroupEditors(grp);
                            <tr>
                                <td>
                                    <div class="di-cfm-move">
                                        <button title="Move up" disabled="@(index == 0)" @onclick="() => MoveTitleGroupUp(index)">
                                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 4l5 6H3z"/></svg>
                                        </button>
                                        <button title="Move down" disabled="@(index == titleGroups.Count - 1)" @onclick="() => MoveTitleGroupDown(index)">
                                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 12L3 6h10z"/></svg>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <input class="di-cfm-select" value="@grp[0].Title" @onchange="e => RenameTitleGroup(grp, e.Value?.ToString() ?? string.Empty)" maxlength="150" />
                                    @if (grp.Count > 1)
                                    {
                                        <div class="di-cfm-fd-desc">@string.Join(" · ", grp.Select(t => t.GroupName))</div>
                                    }
                                </td>
                                <td><span class="di-cfm-fd-desc">@GroupSectionLabel(grp)</span></td>
                                <td class="text-center">
                                    <label class="di-switch">
                                        <input type="checkbox" checked="@GroupVisible(grp)" @onchange="e => SetGroupVisible(grp, (bool)e.Value!)" />
                                        <span class="di-switch-slider"></span>
                                    </label>
                                </td>
                                <td>
                                    @if (editableUsers.Count == 0)
                                    {
                                        <span class="text-muted fst-italic">No Customer-portal users</span>
                                    }
                                    else
                                    {
                                        <div class="di-cfm-fd-desc mb-1">@(geditors.Count == 0 ? "Anyone (no restriction)" : $"{geditors.Count} user(s) only")</div>
                                        <div class="di-cfm-editors">
                                            @foreach (var u in editableUsers)
                                            {
                                                <label class="di-cfm-editor">
                                                    <input type="checkbox" checked="@geditors.Contains(u.Id)"
                                                           @onchange="e => ToggleGroupEditor(grp, u.Id, (bool)e.Value!)" />
                                                    <span>@(string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName)</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="di-cfm-modal-foot">
                <button class="di-cfm-btn" @onclick="() => showTabs = false" disabled="@savingTabs">Cancel</button>
                <button class="di-cfm-btn di-cfm-btn-primary" @onclick="SaveTabsAndCloseAsync" disabled="@savingTabs">
                    @(savingTabs ? "Saving…" : "Save Tabs")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .di-cfm { --navy: #16244a; --blue: #2f6fed; --border: #e4e8f0; --label: #55627a; }
    .di-cfm-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 1px 3px rgba(16,24,40,.06); overflow: hidden; }
    .di-cfm-head { display: flex; align-items: center; gap: 14px; padding: 18px 22px; border-bottom: 1px solid var(--border); }
    .di-cfm-head-icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 10px; background: #eaf0fe; color: var(--blue); flex-shrink: 0; }
    .di-cfm-title { margin: 0; font-size: 19px; font-weight: 800; color: var(--navy); }
    .di-cfm-sub { margin: 2px 0 0; font-size: 13px; color: var(--label); }

    .di-cfm-tabbar { display: flex; align-items: center; gap: 12px; padding: 14px 22px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .di-cfm-pills { display: flex; gap: 8px; flex-wrap: wrap; flex: 1; }
    .di-cfm-pill { display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 8px; background: #f1f4fa; color: var(--navy); font-size: 13.5px; font-weight: 600; cursor: pointer; border: 1px solid transparent; user-select: none; }
    .di-cfm-pill:hover { background: #e7ecf7; }
    .di-cfm-pill.is-active { background: var(--blue); color: #fff; }
    .di-cfm-pill.is-hidden { opacity: .5; text-decoration: line-through; }
    .di-cfm-pill-grip { opacity: .55; cursor: grab; font-size: 12px; }
    .di-cfm-reorder-hint { display: inline-flex; align-items: center; gap: 6px; background: none; border: 1px solid var(--border); color: var(--label); font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 8px; cursor: pointer; }
    .di-cfm-reorder-hint:hover { background: #f5f7fc; color: var(--navy); }

    .di-cfm-toolbar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; padding: 16px 22px; border-bottom: 1px solid var(--border); }
    .di-cfm-search { position: relative; flex: 1 1 260px; min-width: 220px; }
    .di-cfm-search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9aa4b8; }
    .di-cfm-search input { width: 100%; padding: 9px 12px 9px 34px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; background: #fff; color: #1a2233; }
