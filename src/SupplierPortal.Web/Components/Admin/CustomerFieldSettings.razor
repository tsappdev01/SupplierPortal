    [data-theme="dark"] .di-cfm-pill { background: #202a42; color: #cdd6ea; }
</style>

@code {
    private List<CustomerFieldConfig> rows = [];
    private List<CustomerTabSetting> tabs = [];
    private List<User> editableUsers = [];
    private readonly Dictionary<string, HashSet<int>> tabEditors = [];   // key = Section|GroupName
    private string currentUser = "unknown";
    private string? savedMessage;
    private bool saving;

    // Filters + paging + modals
    private string searchText = "";
    private string moduleFilter = "";
    private string typeFilter = "";
    private string statusFilter = "";
    private string? tabFilter;              // tab-title pill filter
    private int page = 1;
    private const int PageSize = 10;
    private CustomerFieldConfig? editing;
    private bool showTabs;
    private bool savingTabs;

    private static readonly string[] Sections = ["Account", "Contact"];

    private List<CustomerTabSetting> TabsForSection(string section) =>
        tabs.Where(t => t.Section == section).OrderBy(t => t.Sequence).ThenBy(t => t.GroupName).ToList();

    // Distinct tab titles in the same order the customer form builds its steps (tabs sharing a title merge,
    // ordered by their minimum Sequence, then title) — so the pills match the wizard exactly, with no duplicates.
    private List<string> DistinctTabTitles() =>
        tabs.Where(t => !string.IsNullOrWhiteSpace(t.Title))
            .GroupBy(t => t.Title.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Min(t => t.Sequence)).ThenBy(g => g.Key)
            .Select(g => g.First().Title.Trim())
            .ToList();

    // A merged title is "visible" when any of its underlying tabs is visible.
    private bool TabTitleVisible(string title) =>
        tabs.Any(t => string.Equals(t.Title?.Trim(), title, StringComparison.OrdinalIgnoreCase) && t.IsVisible);

    private string? TabTitleOf(CustomerFieldConfig r) =>
        tabs.FirstOrDefault(t => t.Section == r.Section && t.GroupName == r.GroupName)?.Title?.Trim();

    // Fields ordered the way the form renders: by the unified (global) tab order, then field sequence.
    private List<CustomerFieldConfig> OrderedRows() =>
        rows.OrderBy(r => TabSeq(r.Section, r.GroupName))
            .ThenBy(r => r.Sequence)
            .ToList();

    private int TabSeq(string section, string group) =>
        tabs.FirstOrDefault(t => t.Section == section && t.GroupName == group)?.Sequence ?? 999;

    private List<CustomerFieldConfig> FilteredRows()
    {
        IEnumerable<CustomerFieldConfig> q = OrderedRows();

        q = statusFilter switch
        {
            "active" => q.Where(r => !r.IsRemoved),
            "removed" => q.Where(r => r.IsRemoved),
            _ => q
        };
        if (!string.IsNullOrWhiteSpace(moduleFilter)) q = q.Where(r => r.Section == moduleFilter);
        if (!string.IsNullOrWhiteSpace(tabFilter)) q = q.Where(r => string.Equals(TabTitleOf(r), tabFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(typeFilter))
        {
            q = typeFilter == "text"
                ? q.Where(r => string.IsNullOrEmpty(r.FieldKind) || r.FieldKind == "text")
                : q.Where(r => r.FieldKind == typeFilter);
        }
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim();
            q = q.Where(r =>
                (r.DisplayLabel?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.FieldKey?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.HelpText?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return q.ToList();
    }

    private int PageCount(List<CustomerFieldConfig> filtered) => Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize));

    private List<CustomerFieldConfig> Paged(List<CustomerFieldConfig> filtered)
    {
        if (page > PageCount(filtered)) page = PageCount(filtered);
        if (page < 1) page = 1;
        return filtered.Skip((page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void GoToPage(int p) => page = p;
    private void OnFilterChanged() => page = 1;

    private void ToggleTabFilter(string title)
    {
        tabFilter = string.Equals(tabFilter, title, StringComparison.OrdinalIgnoreCase) ? null : title;
        page = 1;
    }

    // Running order number across the (section, tab) grouping — matches the form's field order.
    private int OrderOf(CustomerFieldConfig f)
    {
        var list = OrderedRows().Where(r => !r.IsRemoved).ToList();
        var idx = list.IndexOf(f);
        return idx < 0 ? 0 : idx + 1;
    }

    private List<CustomerFieldConfig> Neighbours(CustomerFieldConfig f) =>
        rows.Where(r => !r.IsRemoved && r.Section == f.Section && r.GroupName == f.GroupName).OrderBy(r => r.Sequence).ToList();

    private bool CanMoveUp(CustomerFieldConfig f) { var l = Neighbours(f); return l.IndexOf(f) > 0; }
    private bool CanMoveDown(CustomerFieldConfig f) { var l = Neighbours(f); var i = l.IndexOf(f); return i >= 0 && i < l.Count - 1; }

    private void MoveFieldUp(CustomerFieldConfig f)
    {
        var l = Neighbours(f); var i = l.IndexOf(f);
        if (i <= 0) return;
        (l[i].Sequence, l[i - 1].Sequence) = (l[i - 1].Sequence, l[i].Sequence);
    }

    private void MoveFieldDown(CustomerFieldConfig f)
    {
        var l = Neighbours(f); var i = l.IndexOf(f);
        if (i < 0 || i >= l.Count - 1) return;
        (l[i].Sequence, l[i + 1].Sequence) = (l[i + 1].Sequence, l[i].Sequence);
    }

    // Avatar styling for the Field Details cell — deterministic pastel by field key.
    private static readonly (string Bg, string Fg)[] AvatarPalette =
    {
        ("#eaf0fe", "#2f6fed"), ("#e9f7ef", "#1c9e5b"), ("#fdeef0", "#d23b6b"), ("#fff2dc", "#b06a00"),
        ("#eef0fe", "#5a52d6"), ("#e6f7fb", "#0a8ea6"), ("#f3ecfd", "#7b3fe4"), ("#fdeee6", "#d2621f"),
    };
    private static (string Bg, string Fg) Avatar(string key)
    {
        var h = 0; foreach (var c in key ?? "") h = (h * 31 + c) & 0x7fffffff;
        return AvatarPalette[h % AvatarPalette.Length];
    }
    private static string AvatarBg(string key) => Avatar(key).Bg;
    private static string AvatarFg(string key) => Avatar(key).Fg;

    private static string FieldTypeLabel(string? kind) => kind switch
    {
        "lookup" => "Lookup",
        "date" => "Date",
        "yesno" => "Yes / No",
        "phone" => "Phone",
        _ => "Text (Editable)"
    };

    private void OpenEdit(CustomerFieldConfig f) => editing = f;
    private void CloseEdit() => editing = null;

    private static string EditorKey(CustomerTabSetting t) => $"{t.Section}|{t.GroupName}";
    private HashSet<int> EditorsFor(CustomerTabSetting t) =>
        tabEditors.TryGetValue(EditorKey(t), out var set) ? set : (tabEditors[EditorKey(t)] = []);
    private void ToggleEditor(CustomerTabSetting t, int userId, bool on)
    {
        var set = EditorsFor(t);
        if (on) set.Add(userId); else set.Remove(userId);
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";
        rows = await FieldConfigService.GetAllForAdminAsync();
        tabs = await FieldConfigService.GetTabsAsync();
        editableUsers = await UserService.GetCustomerAssignableUsersAsync();
        foreach (var t in tabs)
        {
            tabEditors[EditorKey(t)] = SupplierFieldSettingService.ParseEditorUserIds(t.EditableByUserIdsCsv);
        }
        NormalizeSequences();
    }

    private void OnVisibleChanged(CustomerFieldConfig f, bool visible)
    {
        f.IsVisible = visible;
        if (!visible) { f.IsRequired = false; f.IsRequiredForCustomer = false; }
    }

    /// <summary>The field-kind ("yesno" / "lookup") of a controlling field, so the value editor can switch
    /// between a Yes/No picker and a free-text option value.</summary>
    private string? ControllingKind(string? fieldKey) =>
        rows.FirstOrDefault(r => r.FieldKey == fieldKey)?.FieldKind;

    private void OnControllingChanged(CustomerFieldConfig f, string? controllingKey)
    {
        f.ControllingFieldKey = string.IsNullOrWhiteSpace(controllingKey) ? null : controllingKey;
        // Default the trigger value: Yes for a Yes/No controlling field; blank for an LOV so the admin types
        // the exact option (e.g. "Others").
        f.ControllingValue = f.ControllingFieldKey is null ? null
            : (ControllingKind(f.ControllingFieldKey) == "yesno" ? "true" : "");
    }

    // ---- Title-group tab management (one modal row per distinct title, unified across both sections) ----

    // ALL tabs grouped by title (merged like the pills/wizard), in one order across both sections by their
    // minimum sequence — so a Company tab and an Individual tab can be interleaved freely.
    private List<List<CustomerTabSetting>> AllTitleGroups() =>
        tabs.GroupBy(t => (t.Title ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Min(t => t.Sequence))
            .Select(g => g.OrderBy(t => t.Sequence).ThenBy(t => t.GroupName).ToList())
            .ToList();

    // The section(s) a merged tab draws its fields from, shown as a badge.
    private static string GroupSectionLabel(List<CustomerTabSetting> group) =>
        string.Join(", ", group.Select(t => t.Section == "Account" ? "Company" : "Individual").Distinct());

    private void MoveTitleGroupUp(int index)
    {
        var groups = AllTitleGroups();
        if (index <= 0 || index >= groups.Count) return;
        (groups[index], groups[index - 1]) = (groups[index - 1], groups[index]);
        ApplyTitleGroupOrder(groups);
    }

    private void MoveTitleGroupDown(int index)
    {
        var groups = AllTitleGroups();
        if (index < 0 || index >= groups.Count - 1) return;
        (groups[index], groups[index + 1]) = (groups[index + 1], groups[index]);
        ApplyTitleGroupOrder(groups);
    }

    // Reassign contiguous sequences in the new group order so each title-group stays together and moves as one.
    private static void ApplyTitleGroupOrder(List<List<CustomerTabSetting>> ordered)
    {
        var seq = 1;
        foreach (var grp in ordered)
            foreach (var t in grp)
                t.Sequence = seq++;
    }

    // Rename every tab under a title (they share one wizard step / pill).
    private static void RenameTitleGroup(List<CustomerTabSetting> group, string newTitle)
    {
        foreach (var t in group) t.Title = newTitle;
    }

    private static bool GroupVisible(List<CustomerTabSetting> group) => group.Any(t => t.IsVisible);
    private static void SetGroupVisible(List<CustomerTabSetting> group, bool visible)
    {
        foreach (var t in group) t.IsVisible = visible;
    }

    // Editors that apply to the whole title (union across its groups); toggling sets/clears across all of them.
    private HashSet<int> GroupEditors(List<CustomerTabSetting> group)
    {
        var union = new HashSet<int>();
        foreach (var t in group) union.UnionWith(EditorsFor(t));
        return union;
    }
    private void ToggleGroupEditor(List<CustomerTabSetting> group, int userId, bool on)
    {
        foreach (var t in group) ToggleEditor(t, userId, on);
    }

    // Renumber tab sequences GLOBALLY (one order across both sections, so a tab can cross the Company/Individual
    // boundary) and field sequences per (section, group), to contiguous 1..n.
    private void NormalizeSequences()
    {
        var tseq = 1;
        foreach (var t in tabs.OrderBy(t => t.Sequence).ThenBy(t => t.GroupName))
            t.Sequence = tseq++;

        foreach (var t in tabs)
        {
            var fseq = 1;
            foreach (var f in rows.Where(r => !r.IsRemoved && r.Section == t.Section && r.GroupName == t.GroupName)
                         .OrderBy(r => r.Sequence))
                f.Sequence = fseq++;
        }
    }

    // Persist ONLY the tab layout (order / title / visibility / editors) from the modal, so a reorder takes
    // effect on the customer form immediately — without needing the separate main "Save Changes" button.
    private async Task SaveTabsAndCloseAsync()
    {
        savingTabs = true;
        // Renumber tabs into one clean global order so the shuffle persists exactly as shown.
        var tseq = 1;
        foreach (var t in tabs.OrderBy(t => t.Sequence).ThenBy(t => t.GroupName)) t.Sequence = tseq++;

        var tabLayouts = tabs.Select(t => new CustomerFieldConfigService.CustomerTabLayout(
            t.Section, t.GroupName, t.Title, t.Sequence, t.IsVisible,
            EditorsFor(t).Count == 0 ? null : string.Join(",", EditorsFor(t)))).ToList();
        await FieldConfigService.SaveTabsAsync(tabLayouts, currentUser);

        savingTabs = false;
        showTabs = false;
        savedMessage = "Tab order saved — it now applies to the customer form.";
    }

    private async Task SaveAsync()
    {
        saving = true;
        savedMessage = null;
        NormalizeSequences();
        foreach (var f in rows.Where(f => !f.IsVisible || f.IsRemoved)) { f.IsRequired = false; f.IsRequiredForCustomer = false; }

        await FieldConfigService.SaveAsync(rows, currentUser);

        var tabLayouts = tabs.Select(t => new CustomerFieldConfigService.CustomerTabLayout(
            t.Section, t.GroupName, t.Title, t.Sequence, t.IsVisible,
            EditorsFor(t).Count == 0 ? null : string.Join(",", EditorsFor(t))));
        await FieldConfigService.SaveTabsAsync(tabLayouts, currentUser);

        saving = false;
        savedMessage = "Field layout saved.";
    }
}
