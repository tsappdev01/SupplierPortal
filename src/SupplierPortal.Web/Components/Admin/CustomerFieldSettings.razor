    [data-theme="dark"] .di-cfm-table thead th, [data-theme="dark"] .di-cfm-toolbar, [data-theme="dark"] .di-cfm-tabbar { background: #202a42; }
    [data-theme="dark"] .di-cfm-search input, [data-theme="dark"] .di-cfm-filter select, [data-theme="dark"] .di-cfm-select,
    [data-theme="dark"] .di-cfm-vr-input, [data-theme="dark"] .di-cfm-fld input, [data-theme="dark"] .di-cfm-fld textarea,
    [data-theme="dark"] .di-cfm-fld select { background: #131a2b; color: #e7ecf5; border-color: #2b3550; }
    [data-theme="dark"] .di-cfm-table tbody td { border-color: #232d46; }
