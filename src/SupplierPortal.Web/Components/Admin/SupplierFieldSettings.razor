@page "/admin/supplier-fields"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupplierPortal.Web.Models
@using SupplierPortal.Web.Services
@inject SupplierFieldSettingService SupplierFieldSettingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Supplier Field Settings - Supplier Portal</PageTitle>

<h1>Supplier Field Settings</h1>
<p class="text-muted">
    Choose which supplier fields are Mandatory. This governs both the Register Supplier wizard's
    step validation and which fields the Excel bulk upload rejects a row for when missing.
</p>

@if (savedMessage is not null)
{
    <div class="alert alert-success">@savedMessage</div>
}

<div class="di-field-settings-section">
    <div class="di-field-settings-header">Dashboard Display</div>
    <div class="p-3">
        <label class="form-label mb-1">Records to display per page (Manage Supplier)</label>
        <input type="number" min="1" max="500" class="form-control" style="max-width: 160px;" @bind="pageSize" />
        <div class="form-text">How many supplier rows are shown per page on the Manage Supplier screen.</div>
    </div>
</div>

@if (settings.Count == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    @foreach (var stepGroup in settings.GroupBy(f => f.Step).OrderBy(g => g.Key))
    {
        <div class="di-field-settings-section">
            <div class="di-field-settings-header">@StepLabels[stepGroup.Key]</div>
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Field</th>
                        <th style="width: 160px;">Show to Supplier</th>
                        <th style="width: 140px;">Mandatory</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var field in stepGroup)
                    {
                        <tr>
                            <td>@field.DisplayLabel</td>
                            <td>
                                <label class="di-switch">
                                    <input type="checkbox" checked="@visibleByKey[field.FieldKey]"
                                           @onchange="e => OnVisibilityChanged(field.FieldKey, (bool)e.Value!)" />
                                    <span class="di-switch-slider"></span>
                                </label>
                            </td>
                            <td>
                                <label class="di-switch">
                                    <input type="checkbox" checked="@mandatoryByKey[field.FieldKey]"
                                           disabled="@(!visibleByKey[field.FieldKey])"
                                           @onchange="e => mandatoryByKey[field.FieldKey] = (bool)e.Value!" />
                                    <span class="di-switch-slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <button class="btn btn-primary mt-2" @onclick="SaveAsync" disabled="@isSaving">Save Settings</button>
}

<style>
    .di-field-settings-section {
        background: #fff;
        border: 1px solid #e2e5ea;
        border-radius: 8px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .di-field-settings-header {
        background: #1a2233;
        color: #fff;
        padding: 0.6rem 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .di-switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
        vertical-align: middle;
    }

    .di-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .di-switch-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #dc3545;
        border-radius: 22px;
        transition: background-color 0.15s ease;
    }

    .di-switch-slider::before {
        content: "";
        position: absolute;
        height: 16px;
        width: 16px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        border-radius: 50%;
        transition: transform 0.15s ease;
    }

    .di-switch input:checked + .di-switch-slider {
        background-color: #28a745;
    }

    .di-switch input:checked + .di-switch-slider::before {
        transform: translateX(18px);
    }
</style>

@code {
    private static readonly Dictionary<int, string> StepLabels = new()
    {
        [1] = "Business / Organization Information",
        [2] = "Address Information",
        [3] = "Contact Information",
        [4] = "Site / Business Unit",
        [5] = "Payment / Banking Information"
    };

    private List<SupplierFieldSetting> settings = [];
    private Dictionary<string, bool> mandatoryByKey = [];
    private Dictionary<string, bool> visibleByKey = [];
    private string currentUser = "unknown";
    private bool isSaving;
    private string? savedMessage;
    private int pageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name ?? "unknown";

        settings = await SupplierFieldSettingService.GetAllAsync();
        mandatoryByKey = settings.ToDictionary(f => f.FieldKey, f => f.IsMandatory);
        visibleByKey = settings.ToDictionary(f => f.FieldKey, f => f.IsVisibleToSupplier);
        pageSize = await SupplierFieldSettingService.GetListPageSizeAsync();
    }

    // Hiding a field from the supplier makes it optional automatically, so clear Mandatory too.
    private void OnVisibilityChanged(string fieldKey, bool isVisible)
    {
        visibleByKey[fieldKey] = isVisible;
        if (!isVisible)
        {
            mandatoryByKey[fieldKey] = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            await SupplierFieldSettingService.SaveAsync(mandatoryByKey, visibleByKey, currentUser);
            await SupplierFieldSettingService.SetListPageSizeAsync(pageSize, currentUser);
            savedMessage = "Settings saved.";
            settings = await SupplierFieldSettingService.GetAllAsync();
            mandatoryByKey = settings.ToDictionary(f => f.FieldKey, f => f.IsMandatory);
            visibleByKey = settings.ToDictionary(f => f.FieldKey, f => f.IsVisibleToSupplier);
            pageSize = await SupplierFieldSettingService.GetListPageSizeAsync();
        }
        finally
        {
            isSaving = false;
        }
    }
}
