@page "/"

<PageTitle>Supplier Self-Service — Dubai Investments</PageTitle>

<div class="ss-card">
    <h1 class="ss-title">Supplier Self-Service</h1>
    <p class="ss-muted">
        This portal is accessed only through the secure personal link sent to your registered
        e-mail address. Please open that link to verify your identity and continue.
    </p>
    <p class="ss-muted">
        If you do not have a link, or your link has expired, please contact your
        Dubai Investments representative to request a new one.
    </p>
</div>

<style>
    .ss-card { width: 100%; max-width: 460px; background: #fff; border: 1px solid #e2e5ea; border-radius: 8px; padding: 2rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .ss-title { font-size: 24px; font-weight: 700; color: #1a2233; margin: 0 0 1rem; }
    .ss-muted { color: #7b8697; font-size: 15px; line-height: 1.5; margin: 0 0 0.85rem; }
</style>
