@inject SupplierApiClient Api
@inject IJSRuntime JS

<div class="di-form-page">
    <div class="di-form-title">Supplier Registration</div>
    <div class="di-form-sub">Dubai Investments Entities &mdash; Review &amp; update your details</div>
    <div class="di-legend">
        <div><span class="di-req">*</span> Required field</div>
    </div>

    <div class="di-stepper">
        @for (var i = 1; i <= 4; i++)
        {
            var step = i;
            <button type="button" class="di-stepper-item @(currentStep == step ? "active" : "") reached"
                    @onclick="() => GoToStep(step)">
                <span class="di-stepper-num">@step</span>
                <span class="di-stepper-label">@StepLabels[step]</span>
            </button>
            @if (i < 4)
            {
                <svg class="di-stepper-chevron" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708Z" />
                </svg>
            }
        }
    </div>

    @if (submitted)
    {
        <div class="di-section">
            <div class="di-section-header">Thank you</div>
            <div class="di-section-body" style="display:block;">
                <p>Your details have been submitted for review. You may now close this window.</p>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="model">
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            @if (statusMessage is not null)
            {
                <div class="alert alert-success">@statusMessage</div>
            }

            <!-- Step 1: Business / Organization -->
            <div class="di-section" style="display:@(currentStep == 1 ? "block" : "none")">
                <div class="di-section-header">Business / Organization Information</div>
                <div class="di-section-body">
                    <div class="di-field">
                        <label>Supplier Number</label>
                        <input type="text" value="@(string.IsNullOrWhiteSpace(model.SupplierNumber) ? "System generated" : model.SupplierNumber)" disabled />
                    </div>
                    <div class="di-field @FieldClass("SupplierName")">
                        <label>Supplier Name@(Req("SupplierName"))</label>
                        <InputText @bind-Value="model.SupplierName" />
                    </div>
                    <div class="di-field @FieldClass("PrefixId")">
                        <label>Prefix@(Req("PrefixId"))</label>
                        <InputSelect @bind-Value="model.PrefixId"><option value="">— Select —</option>@foreach (var l in prefixes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect>
                    </div>
                    <div class="di-field @FieldClass("TaxOrganizationTypeId")">
                        <label>Tax Organization Type@(Req("TaxOrganizationTypeId"))</label>
                        <InputSelect @bind-Value="model.TaxOrganizationTypeId"><option value="">— Select —</option>@foreach (var l in taxOrgTypes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect>
                    </div>
                    <div class="di-field @FieldClass("FirstName")">
                        <label>First Name@(Req("FirstName"))</label>
                        <InputText @bind-Value="model.FirstName" />
                    </div>
                    <div class="di-field @FieldClass("Email")">
                        <label>Business E-Mail@(Req("Email"))</label>
                        <InputText @bind-Value="model.Email" />
                    </div>
                    <div class="di-field @FieldClass("SupplierTypeId")">
                        <label>Supplier Type@(Req("SupplierTypeId"))</label>
                        <InputSelect @bind-Value="model.SupplierTypeId"><option value="">— Select —</option>@foreach (var l in supplierTypes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect>
                    </div>
                    <div class="di-field @FieldClass("TaxpayerCountryId")">
                        <label>Taxpayer Country@(Req("TaxpayerCountryId"))</label>
                        <InputSelect @bind-Value="model.TaxpayerCountryId"><option value="">— Select —</option>@foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}</InputSelect>
                    </div>
                    <div class="di-field @FieldClass("TaxRegistrationNumber")">
                        <label>Tax Registration Number@(Req("TaxRegistrationNumber"))</label>
                        <InputText @bind-Value="model.TaxRegistrationNumber" />
                    </div>
                    <div class="di-field @FieldClass("TradeLicenseNumber")">
                        <label>Trade License Number@(Req("TradeLicenseNumber"))</label>
                        <InputText @bind-Value="model.TradeLicenseNumber" />
                    </div>
                    <div class="di-field @FieldClass("VatCodeId")">
                        <label>VAT Code@(Req("VatCodeId"))</label>
                        <InputSelect @bind-Value="model.VatCodeId"><option value="">— Select —</option>@foreach (var l in vatCodes){<option value="@l.Id">@l.Code - @l.DisplayName</option>}</InputSelect>
                    </div>
                    <div class="di-field @FieldClass("BusinessRelationshipId")">
                        <label>Business Relationship@(Req("BusinessRelationshipId"))</label>
                        <InputSelect @bind-Value="model.BusinessRelationshipId"><option value="">— Select —</option>@foreach (var l in businessRelationships){<option value="@l.Id">@l.DisplayName</option>}</InputSelect>
                    </div>
                    <div class="di-field @FieldClass("DunsNumber")">
                        <label>D-U-N-S Number@(Req("DunsNumber"))</label>
                        <InputText @bind-Value="model.DunsNumber" />
                    </div>
                    <div class="di-field @FieldClass("CorporateWebSite")">
                        <label>Corporate Web Site@(Req("CorporateWebSite"))</label>
                        <InputText @bind-Value="model.CorporateWebSite" placeholder="https://" />
                    </div>
                    <div class="di-checkbox-row">
                        <div class="di-checkbox-item @FieldClass("IsOneTimeSupplier")"><InputCheckbox @bind-Value="model.IsOneTimeSupplier" id="oneTime" /><label for="oneTime" style="margin:0;">One-time supplier</label></div>
                    </div>

                    <div class="di-documents-row">
                        <div class="di-document-slot">
                            <label>Trade License <span class="di-req">*</span></label>
                            @if (GetDocument(SelfServiceDocumentType.TradeLicense) is { } tl){<div class="di-document-current">Uploaded: @tl.FileName<button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(tl.Id)" disabled="@viewingDocument">View</button></div>}
                            <InputFile OnChange="e => UploadDocumentAsync(e, SelfServiceDocumentType.TradeLicense)" disabled="@uploadingDocument" />
                            @if (!HasTradeLicenseDocument()){<div class="text-danger" style="font-size:0.85em;">Required — attach the Trade License before submitting.</div>}
                        </div>
                        <div class="di-document-slot">
                            <label>VAT Certificate</label>
                            @if (GetDocument(SelfServiceDocumentType.VatCertification) is { } vd){<div class="di-document-current">Uploaded: @vd.FileName<button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(vd.Id)" disabled="@viewingDocument">View</button></div>}
                            <InputFile OnChange="e => UploadDocumentAsync(e, SelfServiceDocumentType.VatCertification)" disabled="@uploadingDocument" />
                        </div>
                        <div class="di-document-slot">
                            <label>Other Documents</label>
                            @foreach (var doc in OtherDocuments){<div class="di-document-current">@doc.FileName<button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(doc.Id)" disabled="@viewingDocument">View</button><button type="button" class="di-document-remove" title="Remove" @onclick="() => RemoveDocumentAsync(doc.Id)">&times;</button></div>}
                            <InputFile OnChange="e => UploadDocumentAsync(e, SelfServiceDocumentType.Other)" disabled="@uploadingDocument" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2: Contact Information -->
            <div class="di-section" style="display:@(currentStep == 2 ? "block" : "none")">
                <div class="di-section-header">Contact Information</div>
                <div class="di-section-body">
                    <div class="di-field @FieldClass("AddressName")"><label>Address Name@(Req("AddressName"))</label><InputText @bind-Value="model.AddressName" /></div>
                    <div class="di-field @FieldClass("AddressLine1")"><label>Address Line 1@(Req("AddressLine1"))</label><InputText @bind-Value="model.AddressLine1" /></div>
                    <div class="di-field di-full @FieldClass("AddressLine2")"><label>Address Line 2@(Req("AddressLine2"))</label><InputText @bind-Value="model.AddressLine2" /></div>
                    <div class="di-field @FieldClass("CityId")"><label>City@(Req("CityId"))</label><InputSelect @bind-Value="model.CityId"><option value="">— Select —</option>@foreach (var l in provinces){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("State")"><label>State@(Req("State"))</label><InputText @bind-Value="model.State" /></div>
                    <div class="di-field @FieldClass("CountryId")"><label>Country@(Req("CountryId"))</label><InputSelect @bind-Value="model.CountryId"><option value="">— Select —</option>@foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("CountryNameId")"><label>Country Name@(Req("CountryNameId"))</label><InputSelect @bind-Value="model.CountryNameId"><option value="">— Select —</option>@foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("PostalCode")"><label>Postal Code@(Req("PostalCode"))</label><InputText @bind-Value="model.PostalCode" /></div>
                    <div class="di-field @FieldClass("AdministrativeContact")"><label>Administrative Contact@(Req("AdministrativeContact"))</label><InputText @bind-Value="model.AdministrativeContact" placeholder="Defaults to First Name if left blank" /></div>
                    <div class="di-field @FieldClass("PhoneCountryCodeId")"><label>Phone Country Code@(Req("PhoneCountryCodeId"))</label><InputSelect @bind-Value="model.PhoneCountryCodeId"><option value="">— Select —</option>@foreach (var l in countriesWithPhoneCode){<option value="@l.Id">+@l.PhoneCode @l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("PhoneAreaCode")"><label>Phone Area Code@(Req("PhoneAreaCode"))</label><InputText @bind-Value="model.PhoneAreaCode" /></div>
                </div>
            </div>

            <!-- Step 3: Payment / Banking -->
            <div class="di-section" style="display:@(currentStep == 3 ? "block" : "none")">
                <div class="di-section-header">Payment / Banking Information</div>
                <div class="di-section-body">
                    <div class="di-field @FieldClass("BankId")"><label>Bank Name@(Req("BankId"))</label><InputSelect @bind-Value="model.BankId" @bind-Value:after="OnBankChanged"><option value="">— Select —</option>@foreach (var b in banks){<option value="@b.Id">@b.Name</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("BankBranchId")"><label>Branch Name@(Req("BankBranchId"))</label><InputSelect @bind-Value="model.BankBranchId" disabled="@(model.BankId is null)"><option value="">— Select —</option>@foreach (var br in SelectedBankBranches){<option value="@br.Id">@br.Name</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("AccountCountryCodeId")"><label>Account Country Code@(Req("AccountCountryCodeId"))</label><InputSelect @bind-Value="model.AccountCountryCodeId"><option value="">— Select —</option>@foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("AccountName")"><label>Account Name@(Req("AccountName"))</label><InputText @bind-Value="model.AccountName" /></div>
                    <div class="di-field @FieldClass("AccountNumber")"><label>Account Number@(Req("AccountNumber"))</label><InputText @bind-Value="model.AccountNumber" /></div>
                    <div class="di-field @FieldClass("AccountCurrencyCodeId")"><label>Account Currency Code@(Req("AccountCurrencyCodeId"))</label><InputSelect @bind-Value="model.AccountCurrencyCodeId"><option value="">— Select —</option>@foreach (var l in currencies){<option value="@l.Id">@l.Code - @l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("SwiftCode")"><label>Swift Code / BIC Code@(Req("SwiftCode"))</label><InputText @bind-Value="model.SwiftCode" /></div>
                    <div class="di-field @FieldClass("Iban")"><label>IBAN@(Req("Iban"))</label><InputText @bind-Value="model.Iban" /></div>
                    <div class="di-field @FieldClass("AccountStartDate")"><label>Account Start Date@(Req("AccountStartDate"))</label><InputDate @bind-Value="model.AccountStartDate" /></div>
                    <div class="di-field @FieldClass("PaymentMethodCode")"><label>Payment Method Code@(Req("PaymentMethodCode"))</label><InputText @bind-Value="model.PaymentMethodCode" /></div>
                    <div class="di-field @FieldClass("RemitAdviceEmail")"><label>Remit Advice Email@(Req("RemitAdviceEmail"))</label><InputText @bind-Value="model.RemitAdviceEmail" /></div>
                    <div class="di-checkbox-row"><div class="di-checkbox-item @FieldClass("AllowInternationalPayments")"><InputCheckbox @bind-Value="model.AllowInternationalPayments" id="intlPay" /><label for="intlPay" style="margin:0;">Allow International Payments</label></div></div>

                    <div class="di-documents-row">
                        <div class="di-document-slot">
                            <label>Bank Confirmation Letter@(RequiresBankConfirmationLetter() ? " *" : "")</label>
                            @if (GetDocument(SelfServiceDocumentType.BankConfirmationLetter) is { } bl){<div class="di-document-current">Uploaded: @bl.FileName<button type="button" class="di-document-view" @onclick="() => ViewDocumentAsync(bl.Id)" disabled="@viewingDocument">View</button></div>}
                            <InputFile OnChange="e => UploadDocumentAsync(e, SelfServiceDocumentType.BankConfirmationLetter)" disabled="@uploadingDocument" />
                            @if (RequiresBankConfirmationLetter()){<div class="text-danger" style="font-size:0.85em;">Required: you changed the bank account, so a Bank Confirmation Letter must be attached.</div>}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 4: Site / Business Unit -->
            <div class="di-section" style="display:@(currentStep == 4 ? "block" : "none")">
                <div class="di-section-header">Site / Business Unit</div>
                <div class="di-section-body">
                    <div class="di-field @FieldClass("SupplierSiteBuId")"><label>Supplier Site@(Req("SupplierSiteBuId"))</label><InputSelect @bind-Value="model.SupplierSiteBuId"><option value="">— Select —</option>@foreach (var bu in businessUnits){<option value="@bu.Id">@bu.Name</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("ProcurementBuId")"><label>Procurement BU@(Req("ProcurementBuId"))</label><InputSelect @bind-Value="model.ProcurementBuId"><option value="">— Select —</option>@foreach (var bu in businessUnits){<option value="@bu.Id">@bu.Name</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("ClientBuId")"><label>Client BU@(Req("ClientBuId"))</label><InputSelect @bind-Value="model.ClientBuId"><option value="">— Select —</option>@foreach (var bu in businessUnits){<option value="@bu.Id">@bu.Name</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("BillToBuId")"><label>Bill-to BU@(Req("BillToBuId"))</label><InputSelect @bind-Value="model.BillToBuId"><option value="">— Select —</option>@foreach (var bu in businessUnits){<option value="@bu.Id">@bu.Name</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("PaymentMethodId")"><label>Payment Method@(Req("PaymentMethodId"))</label><InputSelect @bind-Value="model.PaymentMethodId"><option value="">— Select —</option>@foreach (var l in paymentMethods){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("PaymentTermsId")"><label>Payment Terms@(Req("PaymentTermsId"))</label><InputSelect @bind-Value="model.PaymentTermsId"><option value="">— Select —</option>@foreach (var l in paymentTerms){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("CommunicationMethodId")"><label>Communication Method@(Req("CommunicationMethodId"))</label><InputSelect @bind-Value="model.CommunicationMethodId"><option value="">— Select —</option>@foreach (var l in communicationMethods){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>
                    <div class="di-field @FieldClass("CommunicationEmail")"><label>Communication Email@(Req("CommunicationEmail"))</label><InputText @bind-Value="model.CommunicationEmail" /></div>
                    <div class="di-field @FieldClass("ContactEmail")"><label>Contact Email@(Req("ContactEmail"))</label><InputText @bind-Value="model.ContactEmail" /></div>
                    <div class="di-field @FieldClass("Phone")"><label>Phone@(Req("Phone"))</label><InputText @bind-Value="model.Phone" /></div>
                    <div class="di-field di-full @FieldClass("RemittanceEmail")"><label>Remittance E-mail@(Req("RemittanceEmail"))</label><InputText @bind-Value="model.RemittanceEmail" /></div>
                    @if (SiteUsageKeys.Any(k => !hiddenKeys.Contains(k)))
                    {
                        <div class="di-hint">Site usages — select all that apply:</div>
                    }
                    <div class="di-checkbox-row">
                        <div class="di-checkbox-item @FieldClass("IsRfqOrBidding")"><InputCheckbox @bind-Value="model.IsRfqOrBidding" id="rfq" /><label for="rfq" style="margin:0;">RFQ or Bidding</label></div>
                        <div class="di-checkbox-item @FieldClass("IsOrdering")"><InputCheckbox @bind-Value="model.IsOrdering" id="ordering" /><label for="ordering" style="margin:0;">Ordering</label></div>
                        <div class="di-checkbox-item @FieldClass("IsSourcingOnly")"><InputCheckbox @bind-Value="model.IsSourcingOnly" id="sourcing" /><label for="sourcing" style="margin:0;">Sourcing only</label></div>
                        <div class="di-checkbox-item @FieldClass("IsPurchasing")"><InputCheckbox @bind-Value="model.IsPurchasing" id="purchasing" /><label for="purchasing" style="margin:0;">Purchasing</label></div>
                        <div class="di-checkbox-item @FieldClass("IsPay")"><InputCheckbox @bind-Value="model.IsPay" id="pay" /><label for="pay" style="margin:0;">Pay</label></div>
                        <div class="di-checkbox-item @FieldClass("IsPrimaryPay")"><InputCheckbox @bind-Value="model.IsPrimaryPay" id="primaryPay" /><label for="primaryPay" style="margin:0;">Primary Pay</label></div>
                    </div>
                </div>
            </div>

            <div class="di-actions">
                @if (currentStep > 1)
                {
                    <button class="di-btn di-btn-secondary" type="button" @onclick="Back" disabled="@isSaving">Back</button>
                }
                @if (currentStep < 4)
                {
                    <button class="di-btn di-btn-primary" type="button" @onclick="NextAsync" disabled="@isSaving">Next</button>
                }
                else
                {
                    <button class="di-btn di-btn-primary" type="button" @onclick="SubmitAsync" disabled="@isSaving">Submit for Review</button>
                }
            </div>
        </EditForm>
    }

    @if (viewerUrl is not null)
    {
        <div class="di-viewer-backdrop" @onclick="CloseViewer">
            <div class="di-viewer" @onclick:stopPropagation="true">
                <div class="di-viewer-head">
                    <span class="di-viewer-name">@viewerName</span>
                    <button type="button" class="di-viewer-close" title="Close" @onclick="CloseViewer">&times;</button>
                </div>
                <iframe class="di-viewer-frame" src="@viewerUrl" title="Document preview"></iframe>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SupplierFormBootstrapDto Bootstrap { get; set; } = default!;
    [Parameter, EditorRequired] public string SessionToken { get; set; } = "";

    private static readonly Dictionary<int, string> StepLabels = new()
    {
        [1] = "Business / Organization", [2] = "Contact Information",
        [3] = "Payment / Banking", [4] = "Site / Business Unit"
    };

    private static readonly System.ComponentModel.DataAnnotations.EmailAddressAttribute EmailValidator = new();

    private static readonly Dictionary<int, (string Key, string Label)[]> EmailFieldsByStep = new()
    {
        [1] = [("Email", "Business E-Mail")],
        [3] = [("RemitAdviceEmail", "Remit Advice Email")],
        [4] = [("ContactEmail", "Contact Email"), ("CommunicationEmail", "Communication Email"), ("RemittanceEmail", "Remittance E-mail")]
    };

    private SupplierDto model = new();
    private int currentStep = 1;
    private bool isSaving;
    private bool submitted;
    private bool uploadingDocument;
    private bool viewingDocument;
    private string? viewerUrl;
    private string? viewerName;
    private string? errorMessage;
    private string? statusMessage;

    private List<LookupItemDto> taxOrgTypes = [], supplierTypes = [], countries = [], countriesWithPhoneCode = [],
        businessRelationships = [], provinces = [], vatCodes = [], paymentMethods = [], paymentTerms = [],
        prefixes = [], communicationMethods = [], currencies = [];
    private List<BankDto> banks = [];
    private List<BusinessUnitDto> businessUnits = [];
    private List<SupplierDocumentDto> documents = [];

    private HashSet<string> mandatoryKeys = [];
    private HashSet<string> hiddenKeys = [];

    private static readonly string[] SiteUsageKeys =
        ["IsRfqOrBidding", "IsOrdering", "IsSourcingOnly", "IsPurchasing", "IsPay", "IsPrimaryPay"];
    private HashSet<string> changedKeys = [];
    private int? originalBankId;
    private string? originalAccountNumber;

    private List<BankBranchDto> SelectedBankBranches => banks.FirstOrDefault(b => b.Id == model.BankId)?.Branches ?? [];
    private List<SupplierDocumentDto> OtherDocuments => documents.Where(d => d.DocumentType == SelfServiceDocumentType.Other).ToList();
    private SupplierDocumentDto? GetDocument(SelfServiceDocumentType type) => documents.FirstOrDefault(d => d.DocumentType == type);

    protected override void OnInitialized()
    {
        model = Bootstrap.Supplier;
        List<LookupItemDto> L(string k) => Bootstrap.Lookups.TryGetValue(k, out var v) ? v : [];
        taxOrgTypes = L("TaxOrganizationType"); supplierTypes = L("SupplierType"); countries = L("Country");
        provinces = L("Province"); vatCodes = L("VatCode"); paymentMethods = L("PaymentMethod");
        paymentTerms = L("PaymentTerms"); prefixes = L("Prefix"); currencies = L("Currency");
        businessRelationships = L("BusinessRelationship"); communicationMethods = L("CommunicationMethod");
        countriesWithPhoneCode = countries.Where(c => !string.IsNullOrWhiteSpace(c.PhoneCode)).ToList();

        banks = Bootstrap.Banks;
        businessUnits = Bootstrap.BusinessUnits;
        documents = Bootstrap.Documents;
        mandatoryKeys = Bootstrap.FieldSettings.Where(f => f.IsMandatory && f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();
        hiddenKeys = Bootstrap.FieldSettings.Where(f => !f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();
        changedKeys = Bootstrap.PendingEditedFieldKeys.ToHashSet();

        originalBankId = model.BankId;
        originalAccountNumber = model.AccountNumber;
    }

    private string FieldClass(string key)
    {
        var classes = changedKeys.Contains(key) ? "di-field-changed" : "";
        if (hiddenKeys.Contains(key))
        {
            classes = string.IsNullOrEmpty(classes) ? "di-hidden-field" : classes + " di-hidden-field";
        }
        return classes;
    }

    private bool IsHidden(string key) => hiddenKeys.Contains(key);

    private RenderFragment Req(string key) => builder =>
    {
        if (mandatoryKeys.Contains(key))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "di-req");
            builder.AddContent(2, "*");
            builder.CloseElement();
        }
    };

    private bool BankAccountChanged() =>
        model.BankId != originalBankId ||
        !string.Equals((model.AccountNumber ?? "").Trim(), (originalAccountNumber ?? "").Trim(), StringComparison.Ordinal);

    private bool HasBankConfirmationLetter() => documents.Any(d => d.DocumentType == SelfServiceDocumentType.BankConfirmationLetter);
    private bool HasTradeLicenseDocument() => documents.Any(d => d.DocumentType == SelfServiceDocumentType.TradeLicense);
    private bool RequiresBankConfirmationLetter() => BankAccountChanged() && !HasBankConfirmationLetter();

    private void OnBankChanged() => model.BankBranchId = null;
    private void Back() => currentStep = Math.Max(1, currentStep - 1);
    private void GoToStep(int step) => currentStep = step;

    private List<string> ValidateStep(int step)
    {
        var errors = new List<string>();
        foreach (var f in Bootstrap.FieldSettings.Where(f => f.Step == step && f.IsMandatory && f.IsVisibleToSupplier))
        {
            var value = typeof(SupplierDto).GetProperty(f.FieldKey)?.GetValue(model);
            if (value is null || (value is string s && string.IsNullOrWhiteSpace(s)))
            {
                errors.Add($"{f.DisplayLabel} is required.");
            }
        }
        if (EmailFieldsByStep.TryGetValue(step, out var emailFields))
        {
            foreach (var (key, label) in emailFields)
            {
                if (IsHidden(key)) { continue; }
                var value = typeof(SupplierDto).GetProperty(key)?.GetValue(model) as string;
                if (!string.IsNullOrWhiteSpace(value) && !EmailValidator.IsValid(value))
                {
                    errors.Add($"{label} is not a valid email address.");
                }
            }
        }
        return errors;
    }

    private async Task<bool> PersistAsync()
    {
        var result = await Api.SaveAsync(SessionToken, model);
        if (!result.Success)
        {
            errorMessage = string.Join(" ", result.Errors);
            return false;
        }
        if (result.Supplier is not null) { model = result.Supplier; }
        changedKeys = result.PendingEditedFieldKeys.ToHashSet();
        return true;
    }

    private async Task NextAsync()
    {
        statusMessage = null;
        var errors = ValidateStep(currentStep);
        if (errors.Count > 0) { errorMessage = string.Join(" ", errors); return; }
        if (currentStep == 3 && RequiresBankConfirmationLetter())
        {
            errorMessage = "A Bank Confirmation Letter must be attached because the bank account was changed.";
            return;
        }
        errorMessage = null;
        isSaving = true;
        try
        {
            if (await PersistAsync()) { currentStep++; }
        }
        finally { isSaving = false; }
    }

    private async Task SubmitAsync()
    {
        statusMessage = null;
        var allErrors = Enumerable.Range(1, 4).SelectMany(ValidateStep).ToList();
        if (allErrors.Count > 0)
        {
            for (var step = 1; step <= 4; step++)
            {
                if (ValidateStep(step).Count > 0) { currentStep = step; break; }
            }
            errorMessage = "Complete all required fields before submitting: " + string.Join(" ", allErrors);
            return;
        }
        if (!HasTradeLicenseDocument())
        {
            currentStep = 1;
            errorMessage = "A Trade License document must be attached before submitting.";
            return;
        }
        if (RequiresBankConfirmationLetter())
        {
            currentStep = 3;
            errorMessage = "A Bank Confirmation Letter must be attached because the bank account was changed.";
            return;
        }

        errorMessage = null;
        isSaving = true;
        try
        {
            if (!await PersistAsync()) { return; }
            var submit = await Api.SubmitAsync(SessionToken);
            if (!submit.Success) { errorMessage = submit.Error ?? "Could not submit."; return; }
            submitted = true;
        }
        finally { isSaving = false; }
    }

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e, SelfServiceDocumentType documentType)
    {
        errorMessage = null;
        statusMessage = null;
        uploadingDocument = true;
        try
        {
            const long maxBytes = 10 * 1024 * 1024;
            if (e.File.Size > maxBytes)
            {
                errorMessage = $"'{e.File.Name}' is {e.File.Size / (1024 * 1024)} MB, over the 10 MB limit. Please attach a smaller file.";
                return;
            }

            await using var stream = e.File.OpenReadStream(maxBytes);
            var result = await Api.UploadDocumentAsync(SessionToken, documentType, stream, e.File.Name, e.File.ContentType);
            if (!result.Success) { errorMessage = result.Error ?? "Upload failed."; return; }

            documents = result.Documents;
            var message = $"'{e.File.Name}' uploaded successfully.";
            if (result.ExtractedNumber is not null)
            {
                if (documentType == SelfServiceDocumentType.VatCertification)
                {
                    model.TaxRegistrationNumber = result.ExtractedNumber;
                    message += $" Tax Registration Number '{result.ExtractedNumber}' was read from the document.";
                }
                else if (documentType == SelfServiceDocumentType.TradeLicense)
                {
                    model.TradeLicenseNumber = result.ExtractedNumber;
                    message += $" Trade License Number '{result.ExtractedNumber}' was read from the document.";
                }
            }
            if (documentType == SelfServiceDocumentType.TradeLicense && result.DunsNumber is not null)
            {
                model.DunsNumber = result.DunsNumber;
                message += $" D-U-N-S Number '{result.DunsNumber}' was read from the document.";
            }
            statusMessage = message;
        }
        catch (Exception)
        {
            // Any failure (oversized stream, transient network, bad response) surfaces as a friendly
            // message instead of an unhandled circuit error that looks like "nothing happened".
            errorMessage = $"Could not upload '{e.File.Name}'. The file may be too large or in an unsupported format. Please try again.";
        }
        finally { uploadingDocument = false; }
    }

    private async Task ViewDocumentAsync(int documentId)
    {
        errorMessage = null;
        statusMessage = null;
        viewingDocument = true;
        try
        {
            await CloseViewer();
            var file = await Api.GetDocumentAsync(SessionToken, documentId);
            if (file is null)
            {
                errorMessage = "Could not open the document. Please try again.";
                return;
            }
            viewerUrl = await JS.InvokeAsync<string>("ssDoc.makeUrl", file.Value.Bytes, file.Value.ContentType);
            viewerName = file.Value.FileName;
        }
        catch (Exception)
        {
            errorMessage = "Could not open the document. Please try again.";
        }
        finally { viewingDocument = false; }
    }

    private async Task CloseViewer()
    {
        if (viewerUrl is not null)
        {
            try { await JS.InvokeVoidAsync("ssDoc.revoke", viewerUrl); } catch { /* ignore */ }
            viewerUrl = null;
            viewerName = null;
        }
    }

    private async Task RemoveDocumentAsync(int documentId)
    {
        var result = await Api.DeleteDocumentAsync(SessionToken, documentId);
        if (result.Success) { documents = result.Documents; statusMessage = "Document removed."; }
        else { errorMessage = result.Error ?? "Could not remove the document."; }
    }
}
