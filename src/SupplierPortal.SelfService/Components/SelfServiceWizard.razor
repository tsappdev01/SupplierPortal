    private List<string> ValidateStep(int step)
    {
        var errors = new List<string>();
        foreach (var f in Bootstrap.FieldSettings.Where(f => f.Step == step && f.IsMandatory && f.IsVisibleToSupplier))
        {
            // VAT-dependent fields (TRN, VAT type, TIN, VAT-group) are never required when not VAT registered.
            if (VatDependentKeys.Contains(f.FieldKey) && model.VatRegistered != true) { continue; }
            // Only enforce fields this form can actually collect (a property on SupplierDto with a fragment).
            var prop = typeof(SupplierDto).GetProperty(f.FieldKey);
            if (prop is null || !fieldFragments.ContainsKey(f.FieldKey)) { continue; }
            var value = prop.GetValue(model);
            if (value is null || (value is string s && string.IsNullOrWhiteSpace(s)))
            {
                errors.Add($"{f.DisplayLabel} is required.");
            }
        }
        if (EmailFieldsByStep.TryGetValue(step, out var emailFields))
        {
            foreach (var (key, label) in emailFields)
            {
                if (IsHidden(key)) { continue; }
                var value = typeof(SupplierDto).GetProperty(key)?.GetValue(model) as string;
                if (!string.IsNullOrWhiteSpace(value) && !EmailValidator.IsValid(value))
                {
                    errors.Add($"{label} is not a valid email address.");
                }
            }
        }

        // Format checks (data-quality) — same rules as the internal form. Supplier TIN exactly 10 digits;
        // TRN/VAT Registration Number exactly 15 digits (only when VAT registered). Fire only when a value
        // is present and the field belongs to this step.
        if (IsFieldOnStep("SupplierTin", step) && !IsHidden("SupplierTin")
            && !string.IsNullOrWhiteSpace(model.SupplierTin) && !IsDigits(model.SupplierTin, 10))
        {
            errors.Add("Supplier TIN must be exactly 10 digits.");
        }
        if (IsFieldOnStep("TaxRegistrationNumber", step) && IsVatRegistered
            && !string.IsNullOrWhiteSpace(model.TaxRegistrationNumber) && !IsDigits(model.TaxRegistrationNumber, 15))
        {
            errors.Add("TRN/VAT Registration Number must be exactly 15 digits.");
        }

        // When the address differs from the Trade License / VAT Certificate, the alternate VAT-certificate
        // address is mandatory (matches the internal form's step-2 rule).
        if (step == 2 && model.AddressSameAsTradeLicense == false)
        {
            if (string.IsNullOrWhiteSpace(model.VatAddressLine1))
            {
                errors.Add("Address (As per VAT Certificate): Address Line 1 is required.");
            }
            if (model.VatCountryId is null)
            {
                errors.Add("Address (As per VAT Certificate): Country is required.");
            }
            var vatIsUae = model.VatCountryId is null || model.VatCountryId == UaeCountryId;
            if (vatIsUae ? model.VatCityId is null : string.IsNullOrWhiteSpace(model.VatCityText))
            {
                errors.Add("Address (As per VAT Certificate): City / Emirate is required.");
            }
        }
        return errors;
    }

    private bool IsFieldOnStep(string key, int step) =>
        Bootstrap.FieldSettings.Any(f => f.FieldKey == key && f.Step == step && f.IsVisibleToSupplier);

    private async Task<bool> PersistAsync()
    {
        var result = await Api.SaveAsync(SessionToken, model);
        if (!result.Success)
        {
            errorMessage = string.Join(" ", result.Errors);
            return false;
        }
        if (result.Supplier is not null) { model = result.Supplier; }
        changedKeys = result.PendingEditedFieldKeys.ToHashSet();
        return true;
    }

    private async Task NextAsync()
    {
        var step = visibleTabs[currentIndex].Step;
        var errors = ValidateStep(step);
        if (errors.Count > 0) { errorMessage = string.Join(" ", errors); return; }
        if (step == 5 && RequiresBankConfirmationLetter())
        {
            errorMessage = "A Bank Confirmation Letter must be attached because the bank account was changed.";
            return;
        }
        isSaving = true;
        try
        {
            if (await PersistAsync()) { currentIndex = Math.Min(currentIndex + 1, visibleTabs.Count - 1); }
        }
        finally { isSaving = false; }
    }

    private async Task SubmitAsync()
    {
        var allErrors = visibleTabs.SelectMany(t => ValidateStep(t.Step)).ToList();
        if (allErrors.Count > 0)
        {
            for (var i = 0; i < visibleTabs.Count; i++)
            {
                if (ValidateStep(visibleTabs[i].Step).Count > 0) { currentIndex = i; break; }
            }
            errorMessage = "Complete all required fields before submitting: " + string.Join(" ", allErrors);
            return;
        }
        if (!HasTradeLicenseDocument())
        {
            var i = visibleTabs.FindIndex(t => t.Step == 1);
            if (i >= 0) { currentIndex = i; }
            errorMessage = "A Trade License document must be attached before submitting.";
            return;
        }
        if (RequiresBankConfirmationLetter())
        {
            var i = visibleTabs.FindIndex(t => t.Step == 5);
            if (i >= 0) { currentIndex = i; }
            errorMessage = "A Bank Confirmation Letter must be attached because the bank account was changed.";
            return;
        }

        // Save the current tab's data, then have the supplier sign the declaration before the final submit.
        isSaving = true;
        try
        {
            if (!await PersistAsync()) { return; }
        }
        finally { isSaving = false; }

        declarationSignature = "";
        sigInitialized = false;
        showDeclaration = true;
    }

    private void CancelDeclaration()
    {
        showDeclaration = false;
        sigInitialized = false;
    }

    private async Task ClearSignatureAsync()
    {
        try { await JS.InvokeVoidAsync("sigpad.clear", sigCanvas); } catch { /* best-effort */ }
    }

    private async Task ConfirmDeclarationAsync()
    {
        if (string.IsNullOrWhiteSpace(declarationSignature))
        {
            errorMessage = "Please type your full name as your signature.";
            return;
        }

        string dataUrl = "";
        try { dataUrl = await JS.InvokeAsync<string>("sigpad.dataUrl", sigCanvas); } catch { }
        if (string.IsNullOrWhiteSpace(dataUrl) || !dataUrl.StartsWith("data:image"))
        {
            errorMessage = "Please draw your signature in the box before submitting.";
            return;
        }
        var comma = dataUrl.IndexOf(',');
        var imageB64 = comma >= 0 ? dataUrl[(comma + 1)..] : "";

        var request = new SubmitRequest
        {
            SignatureName = declarationSignature.Trim(),
            SignatureImageBase64 = imageB64,
            DeclarationText = DeclarationFullText()
        };

        isSaving = true;
        try
        {
            var submit = await Api.SubmitAsync(SessionToken, request);
            if (!submit.Success) { errorMessage = submit.Error ?? "Could not submit. Please try again."; return; }
            showDeclaration = false;
            submitted = true;
        }
        catch (Exception)
        {
            // Never leave the button silently dead — always tell the supplier what to do next.
            errorMessage = "Could not submit your details. Please check your connection and try again.";
        }
        finally { isSaving = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialise the drawn-signature canvas once the declaration pop-up is on screen.
        if (showDeclaration && !sigInitialized)
        {
            sigInitialized = true;
            try { await JS.InvokeVoidAsync("sigpad.init", sigCanvas); } catch { /* best-effort */ }
        }
    }

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e, SelfServiceDocumentType documentType)
    {
        uploadingDocument = true;
        try
        {
            const long maxBytes = 10 * 1024 * 1024;
            if (e.File.Size > maxBytes)
            {
                errorMessage = $"'{e.File.Name}' is {e.File.Size / (1024 * 1024)} MB, over the 10 MB limit. Please attach a smaller file.";
                return;
            }

            uploadingFileName = e.File.Name;
            Toast.ShowInfo($"Uploading '{e.File.Name}'…");
            StateHasChanged();

            await using var stream = e.File.OpenReadStream(maxBytes);
            var result = await Api.UploadDocumentAsync(SessionToken, documentType, stream, e.File.Name, e.File.ContentType);
            if (!result.Success) { errorMessage = result.Error ?? "Upload failed."; return; }

            documents = result.Documents;
            var message = $"'{e.File.Name}' uploaded successfully.";
            if (result.ExtractedNumber is not null)
            {
                if (documentType == SelfServiceDocumentType.VatCertification)
                {
                    model.TaxRegistrationNumber = result.ExtractedNumber;
                    message += $" Tax Registration Number '{result.ExtractedNumber}' was read from the document.";
                }
                else if (documentType == SelfServiceDocumentType.TradeLicense)
                {
                    model.TradeLicenseNumber = result.ExtractedNumber;
                    message += $" Trade License Number '{result.ExtractedNumber}' was read from the document.";
                }
            }
            if (documentType == SelfServiceDocumentType.TradeLicense && result.DunsNumber is not null)
            {
                model.DunsNumber = result.DunsNumber;
                message += $" D-U-N-S Number '{result.DunsNumber}' was read from the document.";
            }
            statusMessage = message;
        }
        catch (Exception)
        {
            errorMessage = $"Could not upload '{e.File.Name}'. The file may be too large or in an unsupported format. Please try again.";
        }
        finally { uploadingDocument = false; uploadingFileName = null; }
    }

    private async Task ViewDocumentAsync(int documentId)
    {
        viewingDocument = true;
        try
        {
            await CloseViewer();
            var file = await Api.GetDocumentAsync(SessionToken, documentId);
            if (file is null)
            {
                errorMessage = "Could not open the document. Please try again.";
                return;
            }
            viewerUrl = await JS.InvokeAsync<string>("ssDoc.makeUrl", file.Value.Bytes, file.Value.ContentType);
            viewerName = file.Value.FileName;
        }
        catch (Exception)
        {
            errorMessage = "Could not open the document. Please try again.";
        }
        finally { viewingDocument = false; }
    }

    private async Task CloseViewer()
    {
        if (viewerUrl is not null)
        {
            try { await JS.InvokeVoidAsync("ssDoc.revoke", viewerUrl); } catch { /* ignore */ }
            viewerUrl = null;
            viewerName = null;
        }
    }

    private async Task RemoveDocumentAsync(int documentId)
    {
        var result = await Api.DeleteDocumentAsync(SessionToken, documentId);
        if (result.Success) { documents = result.Documents; statusMessage = "Document removed."; }
        else { errorMessage = result.Error ?? "Could not remove the document."; }
    }

    private const int MaxUploadMb = 10;

    private static string FileExtLabel(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName).TrimStart('.').ToUpperInvariant();
        return string.IsNullOrEmpty(ext) ? "FILE" : ext;
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1048576 ? $"{bytes / 1048576.0:0.#} MB"
        : bytes >= 1024 ? $"{bytes / 1024.0:0} KB"
        : $"{bytes} B";

    // A rich upload card for a single-document slot (Trade License, VAT Certificate, Bank Confirmation
    // Letter), matching the internal supplier form: coloured file thumbnail, uploaded file with date/size,
    // a View action and a branded Choose File button with supported-format hints.
    private RenderFragment DocCard(string title, SelfServiceDocumentType type, string thumbClass, bool showStar, bool showRequiredMsg, string requiredMsg)
    {
        return @<div class="di-doccard">
        @{
            var doc = GetDocument(type);
            var inputId = $"docfile-{type}";
        }
        <div class="di-doccard-thumb @thumbClass">
            <svg width="26" height="26" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM4.5 9a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0 2a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0-4a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1h-3z" /></svg>
            <span class="di-doccard-ext">@(doc is null ? "FILE" : FileExtLabel(doc.FileName))</span>
        </div>
        <div class="di-doccard-main">
            <div class="di-doccard-title">@title @if (showStar){<span class="di-req">*</span>}</div>
            @if (doc is not null)
            {
                <div class="di-doccard-chip">
                    <span class="di-doccard-uplabel">Uploaded:</span>
                    <span class="di-doccard-fname" title="@doc.FileName">@doc.FileName</span>
                </div>
                <div class="di-doccard-meta">
                    <span>Uploaded on: @doc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    <span class="di-doccard-sep"></span>
                    <span>Size: @FormatSize(doc.FileSizeBytes)</span>
                </div>
            }
            else
            {
                <div class="di-doccard-meta di-doccard-empty">No file uploaded yet.</div>
            }
            @if (showRequiredMsg)
            {
                <div class="di-doccard-required">@requiredMsg</div>
            }
        </div>
        @if (doc is not null)
        {
            <div class="di-doccard-actions">
                <button type="button" class="di-doccard-viewbtn" @onclick="() => ViewDocumentAsync(doc.Id)" disabled="@viewingDocument">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" /><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" /></svg>
                    View
                </button>
            </div>
        }
        <div class="di-doccard-upload">
            <label class="di-doccard-choose @(uploadingDocument ? "is-disabled" : null)" for="@inputId">
                <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" /></svg>
                <span>Choose File</span>
                <svg class="di-doccard-caret" width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" /></svg>
            </label>
            <InputFile id="@inputId" class="di-doccard-input" accept=".pdf,.jpg,.jpeg,.png" OnChange="e => UploadDocumentAsync(e, type)" disabled="@uploadingDocument" />
            <div class="di-doccard-hint">Supported formats: PDF, JPG, PNG<br />Max size: @MaxUploadMb MB</div>
        </div>
    </div>;
    }

    // ----- Declaration text (mirrors the internal supplier form) -----
    private bool IsVatRegistered => model.VatRegistered == true;
    private string DeclarationTitle => "Supplier Declaration";
    private string DeclarationSubtitle => "Supplier Data Gathering Portal";
    private string CompanyName => string.IsNullOrWhiteSpace(Bootstrap.BusinessUnit?.Name) ? "the Company" : Bootstrap.BusinessUnit!.Name.Trim();
    private string SupplierDisplayName => string.IsNullOrWhiteSpace(model.SupplierName) ? "the Supplier" : model.SupplierName.Trim();

    private string GeneralDeclaration =>
        "I/We hereby declare that the information and data provided in this form are true, correct, and " +
        "complete to the best of our knowledge, and are furnished in compliance with the applicable UAE " +
        "e-invoicing requirements issued by the Ministry of Finance/Federal Tax Authority. We undertake " +
        $"to promptly inform {CompanyName} of any changes to the above.";

    private string[] VatNonRegistrationParagraphs =>
    [
        $"I/We, the undersigned, being an authorized signatory of {SupplierDisplayName} (\"the Supplier\"), " +
        "hereby declare that our taxable supplies and imports have not exceeded the mandatory VAT " +
        "registration threshold of AED 375,000 during the previous 12 months, and we have therefore not " +
        "obtained registration for Value Added Tax (VAT) with the Federal Tax Authority (FTA) under UAE " +
        "Federal Decree-Law No. 8 of 2017 (as amended).",

        $"We undertake to immediately notify {CompanyName} in writing, and to obtain VAT registration " +
        "within the timeline prescribed by law, should our taxable supplies and imports exceed the mandatory " +
        "registration threshold at any point in the future. Until such registration is obtained, we confirm " +
        $"that we shall not charge VAT on any supplies made to {CompanyName}.",

        "We confirm that the above is true and correct to the best of our knowledge."
    ];

    private string DeclarationCertify =>
        "By signing below, I/We acknowledge and accept the declaration(s) set out above.";

    private string DeclarationFullText()
    {
        var parts = new List<string>
        {
            DeclarationTitle,
            DeclarationSubtitle,
            "Declaration (For true and correct information provided):",
            GeneralDeclaration
        };
        if (!IsVatRegistered)
        {
            parts.Add("Declaration – Non-Registration for VAT:");
            parts.AddRange(VatNonRegistrationParagraphs);
        }
        parts.Add(DeclarationCertify);
        return string.Join("\n\n", parts);
    }

    // ----- Field fragments (one per field key; rendered per tab in the admin-configured order) -----
    private void BuildFragments()
    {
        var f = new Dictionary<string, RenderFragment>();

        // Step 1 — Business / Organization
        f["SupplierName"] = @<div class="di-field @FieldClass("SupplierName")"><label>Supplier Name@(Req("SupplierName"))@Help("SupplierName")</label><InputText @bind-Value="model.SupplierName" /></div>;
        f["TaxOrganizationTypeId"] = @<div class="di-field @FieldClass("TaxOrganizationTypeId")"><label>Tax Organization Type@(Req("TaxOrganizationTypeId"))</label><InputSelect @bind-Value="model.TaxOrganizationTypeId"><option value="">— Select —</option>@foreach (var l in taxOrgTypes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["SupplierTypeId"] = @<div class="di-field @FieldClass("SupplierTypeId")"><label>Supplier Type@(Req("SupplierTypeId"))</label><InputSelect @bind-Value="model.SupplierTypeId"><option value="">— Select —</option>@foreach (var l in supplierTypes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["TaxpayerCountryId"] = @<div class="di-field @FieldClass("TaxpayerCountryId")"><label>Taxpayer Country@(Req("TaxpayerCountryId"))</label><InputSelect @bind-Value="model.TaxpayerCountryId"><option value="">— Select —</option>@foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["TaxRegistrationNumber"] = @<text>@if (IsVatRegistered){<div class="di-field @FieldClass("TaxRegistrationNumber")"><label>TRN/VAT Registration Number@(Req("TaxRegistrationNumber"))@Help("TaxRegistrationNumber")</label><InputText @bind-Value="model.TaxRegistrationNumber" maxlength="15" inputmode="numeric" pattern="[0-9]*" title="15 digits" /></div>}</text>;
        f["VatRegistered"] = @<div class="di-field @FieldClass("VatRegistered")"><label>VAT Registered?@(Req("VatRegistered"))</label><select class="form-select" @bind="VatRegisteredStr"><option value="">— Select —</option><option value="true">Yes</option><option value="false">No</option></select></div>;
        f["VatRegistrationTypeId"] = @<text>@if (IsVatRegistered){<div class="di-field @FieldClass("VatRegistrationTypeId")"><label>VAT Registration Type@(Req("VatRegistrationTypeId"))@Help("VatRegistrationTypeId")</label><InputSelect @bind-Value="model.VatRegistrationTypeId"><option value="">— Select —</option>@foreach (var l in vatRegistrationTypes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>}</text>;
        f["NumberOfVatGroupEntities"] = @<div class="di-field @FieldClass("NumberOfVatGroupEntities")"><label>Number of Entities if VAT Group@(Req("NumberOfVatGroupEntities"))@Help("VatGroup")</label><InputNumber @bind-Value="model.NumberOfVatGroupEntities" /></div>;
        f["VatGroupEntityNames"] = @<div class="di-field di-full @FieldClass("VatGroupEntityNames")"><label>Legal Names of all Entities under the VAT Group@(Req("VatGroupEntityNames"))</label><InputTextArea @bind-Value="model.VatGroupEntityNames" /></div>;
        f["SupplierTin"] = @<div class="di-field @FieldClass("SupplierTin")"><label>Supplier TIN@(Req("SupplierTin"))@Help("SupplierTin")</label><InputText @bind-Value="model.SupplierTin" maxlength="10" inputmode="numeric" pattern="[0-9]*" title="10 digits" /></div>;
        f["BusinessPartnerTypeId"] = @<div class="di-field @FieldClass("BusinessPartnerTypeId")"><label>Business Partner Type@(Req("BusinessPartnerTypeId"))</label><InputSelect @bind-Value="model.BusinessPartnerTypeId"><option value="">— Select —</option>@foreach (var l in businessPartnerTypes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["BusinessLocationTypeId"] = @<div class="di-field @FieldClass("BusinessLocationTypeId")"><label>Business Location Type@(Req("BusinessLocationTypeId"))</label><InputSelect @bind-Value="model.BusinessLocationTypeId"><option value="">— Select —</option>@foreach (var l in businessLocationTypes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["EInvoicingWaveId"] = @<div class="di-field @FieldClass("EInvoicingWaveId")"><label>eInvoicing Wave Applicability@(Req("EInvoicingWaveId"))@Help("EInvoicingWaveId")</label><InputSelect @bind-Value="model.EInvoicingWaveId"><option value="">— Select —</option>@foreach (var l in eInvoicingWaves){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["TradeLicenseNumber"] = @<div class="di-field @FieldClass("TradeLicenseNumber")"><label>Trade License Number@(Req("TradeLicenseNumber"))</label><InputText @bind-Value="model.TradeLicenseNumber" /></div>;
        f["TradeLicenseIssueDate"] = @<div class="di-field @FieldClass("TradeLicenseIssueDate")"><label>Trade License Issue Date@(Req("TradeLicenseIssueDate"))</label><InputDate @bind-Value="model.TradeLicenseIssueDate" /></div>;
        f["TradeLicenseExpiryDate"] = @<div class="di-field @FieldClass("TradeLicenseExpiryDate")"><label>Trade License Expiry Date@(Req("TradeLicenseExpiryDate"))</label><InputDate @bind-Value="model.TradeLicenseExpiryDate" /></div>;
        f["TradeLicenseIssuingBodyId"] = @<div class="di-field @FieldClass("TradeLicenseIssuingBodyId")"><label>Trade License Issuing Body@(Req("TradeLicenseIssuingBodyId"))@Help("TradeLicenseIssuingBodyId")</label><InputSelect @bind-Value="model.TradeLicenseIssuingBodyId"><option value="">— Select —</option>@foreach (var l in licensingAuthorities){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["IssuingBodyIfOthers"] = @<div class="di-field @FieldClass("IssuingBodyIfOthers")" style="display:@(IsOthersIssuingBody() ? "flex" : "none")"><label>Issuing Body (if Others)@(Req("IssuingBodyIfOthers"))</label><InputText @bind-Value="model.IssuingBodyIfOthers" /></div>;
        f["VatCodeId"] = @<div class="di-field @FieldClass("VatCodeId")"><label>VAT Code@(Req("VatCodeId"))</label><InputSelect @bind-Value="model.VatCodeId"><option value="">— Select —</option>@foreach (var l in vatCodes){<option value="@l.Id">@l.Code - @l.DisplayName</option>}</InputSelect></div>;
        f["BusinessRelationshipId"] = @<div class="di-field @FieldClass("BusinessRelationshipId")"><label>Business Relationship@(Req("BusinessRelationshipId"))</label><InputSelect @bind-Value="model.BusinessRelationshipId"><option value="">— Select —</option>@foreach (var l in businessRelationships){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["DunsNumber"] = @<div class="di-field @FieldClass("DunsNumber")"><label>D-U-N-S Number@(Req("DunsNumber"))</label><InputText @bind-Value="model.DunsNumber" /></div>;
        f["IsOneTimeSupplier"] = @<div class="di-checkbox-row @FieldClass("IsOneTimeSupplier")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.IsOneTimeSupplier" id="oneTime" /><label for="oneTime" style="margin:0;">One-time supplier</label></div></div>;

        // Step 2 — Address
        f["AddressName"] = @<div class="di-field @FieldClass("AddressName")"><label>Address Name@(Req("AddressName"))</label><InputText @bind-Value="model.AddressName" /></div>;
        f["AddressLine1"] = @<div class="di-field @FieldClass("AddressLine1")"><label>Address Line 1@(Req("AddressLine1"))@Help("AddressLine1")</label><InputText @bind-Value="model.AddressLine1" /></div>;
        f["AddressLine2"] = @<div class="di-field di-full @FieldClass("AddressLine2")"><label>Address Line 2@(Req("AddressLine2"))@Help("AddressLine2")</label><InputText @bind-Value="model.AddressLine2" /></div>;
        f["CityId"] = @<div class="di-field @FieldClass("CityId")"><label>City / Emirate@(Req("CityId"))@Help("CityId")</label><InputSelect @bind-Value="model.CityId"><option value="">— Select —</option>@foreach (var l in provinces){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["CountryId"] = @<div class="di-field @FieldClass("CountryId")"><label>Country@(Req("CountryId"))@Help("CountryId")</label><InputSelect @bind-Value="model.CountryId"><option value="">— Select —</option>@foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["PostalCode"] = @<div class="di-field @FieldClass("PostalCode")"><label>PO Box / Postal Code@(Req("PostalCode"))</label><InputText @bind-Value="model.PostalCode" /></div>;
        f["State"] = @<div class="di-field @FieldClass("State")"><label>State@(Req("State"))</label><InputText @bind-Value="model.State" /></div>;
        f["CorporateWebSite"] = @<div class="di-field @FieldClass("CorporateWebSite")"><label>Corporate Web Site@(Req("CorporateWebSite"))</label><InputText @bind-Value="model.CorporateWebSite" placeholder="https://" /></div>;
        f["Email"] = @<div class="di-field @FieldClass("Email")"><label>Business E-Mail@(Req("Email"))</label><InputText @bind-Value="model.Email" /></div>;
        f["BusinessPhone"] = @<div class="di-field @FieldClass("BusinessPhone")"><label>Business Contact Number@(Req("BusinessPhone"))</label><InputText @bind-Value="model.BusinessPhone" /></div>;
        f["AddressPurposeOrdering"] = @<div class="di-checkbox-row @FieldClass("AddressPurposeOrdering")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.AddressPurposeOrdering" id="apOrd" /><label for="apOrd" style="margin:0;">Address Purpose — Ordering</label></div></div>;
        f["AddressPurposeRemitTo"] = @<div class="di-checkbox-row @FieldClass("AddressPurposeRemitTo")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.AddressPurposeRemitTo" id="apRemit" /><label for="apRemit" style="margin:0;">Address Purpose — Remit to</label></div></div>;
        f["AddressPurposeRfqBidding"] = @<div class="di-checkbox-row @FieldClass("AddressPurposeRfqBidding")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.AddressPurposeRfqBidding" id="apRfq" /><label for="apRfq" style="margin:0;">Address Purpose — RFQ or Bidding</label></div></div>;

        // Step 3 — Contact Information
        f["PrefixId"] = @<div class="di-field @FieldClass("PrefixId")"><label>Prefix@(Req("PrefixId"))</label><InputSelect @bind-Value="model.PrefixId"><option value="">— Select —</option>@foreach (var l in prefixes){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["FirstName"] = @<div class="di-field @FieldClass("FirstName")"><label>First Name@(Req("FirstName"))</label><InputText @bind-Value="model.FirstName" /></div>;
        f["MiddleName"] = @<div class="di-field @FieldClass("MiddleName")"><label>Middle Name@(Req("MiddleName"))</label><InputText @bind-Value="model.MiddleName" /></div>;
        f["LastName"] = @<div class="di-field @FieldClass("LastName")"><label>Last Name@(Req("LastName"))</label><InputText @bind-Value="model.LastName" /></div>;
        f["AdministrativeContact"] = @<div class="di-field @FieldClass("AdministrativeContact")"><label>Administrative Contact@(Req("AdministrativeContact"))</label><InputText @bind-Value="model.AdministrativeContact" placeholder="Defaults to First Name if left blank" /></div>;
        f["ContactEmail"] = @<div class="di-field @FieldClass("ContactEmail")"><label>Contacts E-Mail@(Req("ContactEmail"))</label><InputText @bind-Value="model.ContactEmail" /></div>;
        // Phone and Mobile are compound controls (country dial code + area code + number in one bordered
        // group), matching the internal SupplierForm. The separate PhoneCountryCode/PhoneAreaCode /
        // MobileCountryCode/MobileAreaCode fields are absorbed here, so they have no standalone fragment
        // (that also removes them from KeysForStep rendering and the mandatory loop, which gate on the map).
        f["Phone"] = @<div class="di-field @FieldClass("Phone")"><label>Phone@(Req("Phone"))</label><PhoneField Countries="countriesWithPhoneCode" @bind-CountryCodeId="model.PhoneCountryCodeId" @bind-AreaCode="model.PhoneAreaCode" @bind-Number="model.Phone" ShowAreaCode="true" Placeholder="888 6998" /></div>;
        f["Mobile"] = @<div class="di-field @FieldClass("Mobile")"><label>Mobile@(Req("Mobile"))</label><PhoneField Countries="countriesWithPhoneCode" @bind-CountryCodeId="model.MobileCountryCodeId" @bind-AreaCode="model.MobileAreaCode" @bind-Number="model.Mobile" ShowAreaCode="true" Placeholder="50 123 4567" /></div>;

        // Step 4 — Site / Business Unit
        f["ProcurementBuId"] = @<div class="di-field @FieldClass("ProcurementBuId")"><label>Procurement BU@(Req("ProcurementBuId"))</label><InputSelect @bind-Value="model.ProcurementBuId"><option value="">— Select —</option>@foreach (var bu in businessUnits){<option value="@bu.Id">@bu.Name</option>}</InputSelect></div>;
        f["ClientBuId"] = @<div class="di-field @FieldClass("ClientBuId")"><label>Client BU@(Req("ClientBuId"))</label><InputSelect @bind-Value="model.ClientBuId"><option value="">— Select —</option>@foreach (var bu in businessUnits){<option value="@bu.Id">@bu.Name</option>}</InputSelect></div>;
        f["BillToBuId"] = @<div class="di-field @FieldClass("BillToBuId")"><label>Bill-to BU@(Req("BillToBuId"))</label><InputSelect @bind-Value="model.BillToBuId"><option value="">— Select —</option>@foreach (var bu in businessUnits){<option value="@bu.Id">@bu.Name</option>}</InputSelect></div>;
        f["PaymentMethodId"] = @<div class="di-field @FieldClass("PaymentMethodId")"><label>Payment Method@(Req("PaymentMethodId"))</label><InputSelect @bind-Value="model.PaymentMethodId"><option value="">— Select —</option>@foreach (var l in paymentMethods){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["PaymentTermsId"] = @<div class="di-field @FieldClass("PaymentTermsId")"><label>Payment Terms@(Req("PaymentTermsId"))</label><InputSelect @bind-Value="model.PaymentTermsId"><option value="">— Select —</option>@foreach (var l in paymentTerms){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["IsRfqOrBidding"] = @<div class="di-checkbox-row @FieldClass("IsRfqOrBidding")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.IsRfqOrBidding" id="rfq" /><label for="rfq" style="margin:0;">RFQ or Bidding</label></div></div>;
        f["IsOrdering"] = @<div class="di-checkbox-row @FieldClass("IsOrdering")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.IsOrdering" id="ordering" /><label for="ordering" style="margin:0;">Ordering</label></div></div>;
        f["IsSourcingOnly"] = @<div class="di-checkbox-row @FieldClass("IsSourcingOnly")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.IsSourcingOnly" id="sourcing" /><label for="sourcing" style="margin:0;">Sourcing only</label></div></div>;
        f["IsPurchasing"] = @<div class="di-checkbox-row @FieldClass("IsPurchasing")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.IsPurchasing" id="purchasing" /><label for="purchasing" style="margin:0;">Purchasing</label></div></div>;
        f["IsPay"] = @<div class="di-checkbox-row @FieldClass("IsPay")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.IsPay" id="pay" /><label for="pay" style="margin:0;">Pay</label></div></div>;
        f["IsPrimaryPay"] = @<div class="di-checkbox-row @FieldClass("IsPrimaryPay")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.IsPrimaryPay" id="primaryPay" /><label for="primaryPay" style="margin:0;">Primary Pay</label></div></div>;

        // Step 5 — Payment / Banking
        f["BankId"] = @<div class="di-field @FieldClass("BankId")"><label>Bank Name@(Req("BankId"))</label><InputSelect @bind-Value="model.BankId" @bind-Value:after="OnBankChanged"><option value="">— Select —</option>@foreach (var b in banks){<option value="@b.Id">@b.Name</option>}</InputSelect></div>;
        f["BankBranchId"] = @<div class="di-field @FieldClass("BankBranchId")"><label>Branch Name@(Req("BankBranchId"))</label><InputSelect @bind-Value="model.BankBranchId" disabled="@(model.BankId is null)"><option value="">— Select —</option>@foreach (var br in SelectedBankBranches){<option value="@br.Id">@br.Name</option>}</InputSelect></div>;
        f["AccountCountryCodeId"] = @<div class="di-field @FieldClass("AccountCountryCodeId")"><label>Account Country Code@(Req("AccountCountryCodeId"))</label><InputSelect @bind-Value="model.AccountCountryCodeId"><option value="">— Select —</option>@foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}</InputSelect></div>;
        f["AccountName"] = @<div class="di-field @FieldClass("AccountName")"><label>Account Name@(Req("AccountName"))</label><InputText @bind-Value="model.AccountName" /></div>;
        f["AccountNumber"] = @<div class="di-field @FieldClass("AccountNumber")"><label>Account Number@(Req("AccountNumber"))</label><InputText @bind-Value="model.AccountNumber" /></div>;
        f["AccountCurrencyCodeId"] = @<div class="di-field @FieldClass("AccountCurrencyCodeId")"><label>Account Currency Code@(Req("AccountCurrencyCodeId"))</label><InputSelect @bind-Value="model.AccountCurrencyCodeId"><option value="">— Select —</option>@foreach (var l in currencies){<option value="@l.Id">@l.Code - @l.DisplayName</option>}</InputSelect></div>;
        f["SwiftCode"] = @<div class="di-field @FieldClass("SwiftCode")"><label>Swift Code / BIC Code@(Req("SwiftCode"))</label><InputText @bind-Value="model.SwiftCode" /></div>;
        f["Iban"] = @<div class="di-field @FieldClass("Iban")"><label>IBAN@(Req("Iban"))</label><InputText @bind-Value="model.Iban" /></div>;
        f["AccountStartDate"] = @<div class="di-field @FieldClass("AccountStartDate")"><label>Account Start Date@(Req("AccountStartDate"))</label><InputDate @bind-Value="model.AccountStartDate" /></div>;
        f["RemitAdviceEmail"] = @<div class="di-field @FieldClass("RemitAdviceEmail")"><label>Remit Advice Email@(Req("RemitAdviceEmail"))</label><InputText @bind-Value="model.RemitAdviceEmail" /></div>;
        f["AllowInternationalPayments"] = @<div class="di-checkbox-row @FieldClass("AllowInternationalPayments")"><div class="di-checkbox-item"><InputCheckbox @bind-Value="model.AllowInternationalPayments" id="intlPay" /><label for="intlPay" style="margin:0;">Allow International Payments</label></div></div>;

        fieldFragments = f;
    }
}
