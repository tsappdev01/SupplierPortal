    {
        1 => "Provide accurate business details as per your trade license and official documents.",
        2 => "Where the business is located and how it should be contacted.",
        3 => "Primary and additional people we should reach out to.",
        4 => "Assign the supplier to business units and select site usages.",
        5 => "Bank account and payment details used to settle invoices.",
        _ => ""
    };

