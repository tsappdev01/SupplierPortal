@inject SupplierApiClient Api
@inject IJSRuntime JS
@inject ToastService Toast

<div class="di-form-page">
    @if (!submitted)
    {
    <div class="di-form-topbar">
        <div class="di-form-headings">
            <div class="di-form-title">Supplier Registration</div>
            <div class="di-form-sub">Dubai Investments Entities &mdash; Review &amp; update your details</div>
        </div>
        <div class="di-progress" title="@ProgressPct% complete">
            <svg class="di-progress-ring" viewBox="0 0 36 36">
                <circle class="di-progress-bg" cx="18" cy="18" r="15.9155"></circle>
                <circle class="di-progress-bar" cx="18" cy="18" r="15.9155" style="stroke-dasharray:@ProgressPct.ToString(System.Globalization.CultureInfo.InvariantCulture) 100"></circle>
            </svg>
            <div class="di-progress-center">
                <span class="di-progress-pct">@ProgressPct%</span>
                <span class="di-progress-word">Complete</span>
            </div>
        </div>
    </div>
    <div class="di-legend">
        <div><span class="di-req">*</span> Required field (set by Settings &gt; Supplier Fields)</div>
    </div>

    <div class="di-stepper">
        @for (var i = 0; i < visibleTabs.Count; i++)
        {
            var idx = i;
            var tab = visibleTabs[idx];
            <button type="button" class="di-stepper-item @(currentIndex == idx ? "active" : "") reached"
                    @onclick="() => GoToIndex(idx)">
                <span class="di-stepper-num">@(idx + 1)</span>
                <span class="di-stepper-label">@tab.Title</span>
            </button>
            @if (i < visibleTabs.Count - 1)
            {
                <svg class="di-stepper-chevron" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708Z" />
                </svg>
            }
        }
    </div>
    }

    @if (submitted)
    {
        <div class="di-thankyou-wrap">
            <div class="di-thankyou-card">
                <div class="di-thankyou-check" aria-hidden="true">
                    <svg width="34" height="34" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13.5 4.5 6.5 11.5 3 8" />
                    </svg>
                </div>
                <h1 class="di-thankyou-title">Thank You</h1>
                <p class="di-thankyou-text">
                    Your supplier information has been submitted successfully. Our team will review the
                    changes shortly.
                </p>
                <p class="di-thankyou-note">You may now close this window.</p>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="model">
            @if (uploadingDocument)
            {
                <div class="ss-upload-progress" role="status">
                    <span class="ss-spinner" aria-hidden="true"></span>
                    <span>Uploading@(string.IsNullOrEmpty(uploadingFileName) ? "" : $" '{uploadingFileName}'")… please wait.</span>
                    <span class="ss-progress-track"><span class="ss-progress-bar"></span></span>
                </div>
            }

            @for (var i = 0; i < visibleTabs.Count; i++)
            {
                var idx = i;
                var tab = visibleTabs[idx];
                <div class="di-section" style="display:@(currentIndex == idx ? "block" : "none")">
                    <div class="di-section-header">
                        <span class="di-section-icon">@SectionIcon(tab.Step)</span>
                        <span class="di-section-heading">
                            <span class="di-section-title">@tab.Title</span>
                            <span class="di-section-desc">@SectionDesc(tab.Step)</span>
                        </span>
                    </div>
                    <div class="di-section-body">
                        @if (tab.Step == 1)
                        {
                            <div class="di-field">
                                <label>Supplier Number</label>
                                <input type="text" value="@(string.IsNullOrWhiteSpace(model.SupplierNumber) ? "System generated" : model.SupplierNumber)" disabled />
                            </div>
                        }
                        @foreach (var key in KeysForStep(tab.Step))
                        {
                            @fieldFragments[key]
                        }

                        @if (tab.Step == 2)
                        {
                            <!-- Is the address above the same as on the Trade License and VAT Certificate?
                                 When "No", the supplier must give the alternate address per their VAT Certificate. -->
                            <div class="di-field di-full">
                                <label>Is your address the same as your Trade License and VAT Certificate?</label>
                                <div class="di-switch-wrap">
                                    <button type="button" role="switch"
                                            aria-checked="@(model.AddressSameAsTradeLicense == true ? "true" : "false")"
                                            class="di-switch @(model.AddressSameAsTradeLicense == true ? "on" : "") @(model.AddressSameAsTradeLicense == false ? "off" : "")"
                                            @onclick="ToggleAddressSameAsTradeLicense">
                                        <span class="di-switch-knob"></span>
                                    </button>
                                    <span class="di-switch-text">@(model.AddressSameAsTradeLicense == true ? "Yes" : model.AddressSameAsTradeLicense == false ? "No" : "—")</span>
                                </div>
                            </div>
                            @if (model.AddressSameAsTradeLicense == false)
                            {
                                <div class="di-field di-full">
                                    <div class="di-subsection-header">
                                        <svg class="di-subsection-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
                                        Address (As per VAT Certificate)
                                    </div>
                                </div>
                                <div class="di-field di-full">
                                    <label>Address Line 1<span class="di-req">*</span></label>
                                    <InputText @bind-Value="model.VatAddressLine1" />
                                </div>
                                <div class="di-field di-full">
                                    <label>Address Line 2</label>
                                    <InputText @bind-Value="model.VatAddressLine2" />
                                </div>
                                <div class="di-field">
                                    <label>Country<span class="di-req">*</span></label>
                                    <InputSelect @bind-Value="model.VatCountryId">
                                        <option value="">— Select —</option>
                                        @foreach (var l in countries){<option value="@l.Id">@l.DisplayName</option>}
                                    </InputSelect>
                                </div>
                                <div class="di-field">
                                    <label>City / Emirate<span class="di-req">*</span></label>
                                    @if (IsVatUaeCountry)
                                    {
                                        <InputSelect @bind-Value="model.VatCityId">
                                            <option value="">— Select Emirate —</option>
                                            @foreach (var l in provinces){<option value="@l.Id">@l.DisplayName</option>}
                                        </InputSelect>
                                    }
                                    else
                                    {
                                        <InputText @bind-Value="model.VatCityText" placeholder="Enter city" />
                                    }
                                </div>
                                <div class="di-field">
                                    <label>PO Box / Postal Code</label>
                                    <InputText @bind-Value="model.VatPostalCode" />
                                </div>
                            }
                        }

                        @if (tab.Step == 1)
                        {
                            <div class="di-documents-grid">
                                @DocCard("Trade License", SelfServiceDocumentType.TradeLicense, "di-thumb-red", true, !HasTradeLicenseDocument(), "Required — attach the Trade License before submitting.")
                                @DocCard("VAT Certificate", SelfServiceDocumentType.VatCertification, "di-thumb-green", false, false, "")
                                <div class="di-doccard">
                                    <div class="di-doccard-thumb di-thumb-amber">
                                        <svg width="26" height="26" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM4.5 9a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0 2a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0-4a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1h-3z" /></svg>
                                        <span class="di-doccard-ext">FILES</span>
                                    </div>
                                    <div class="di-doccard-main">
                                        <div class="di-doccard-title">Other Documents</div>
                                        @if (!OtherDocuments.Any())
                                        {
                                            <div class="di-doccard-meta di-doccard-empty">No files uploaded yet.</div>
                                        }
                                        else
                                        {
                                            @foreach (var doc in OtherDocuments)
                                            {
                                                <div class="di-doccard-chip">
                                                    <span class="di-doccard-fname" title="@doc.FileName">@doc.FileName</span>
                                                    <button type="button" class="di-doccard-view-inline" @onclick="() => ViewDocumentAsync(doc.Id)" disabled="@viewingDocument">View</button>
                                                    <button type="button" class="di-document-remove" title="Remove" @onclick="() => RemoveDocumentAsync(doc.Id)">&times;</button>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="di-doccard-upload">
                                        <label class="di-doccard-choose @(uploadingDocument ? "is-disabled" : null)" for="docfile-Other">
                                            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" /></svg>
                                            <span>Choose File</span>
                                            <svg class="di-doccard-caret" width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" /></svg>
                                        </label>
                                        <InputFile id="docfile-Other" class="di-doccard-input" accept=".pdf,.jpg,.jpeg,.png" OnChange="e => UploadDocumentAsync(e, SelfServiceDocumentType.Other)" disabled="@uploadingDocument" />
                                        <div class="di-doccard-hint">Supported formats: PDF, JPG, PNG<br />Max size: @MaxUploadMb MB</div>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (tab.Step == 5)
                        {
                            <div class="di-documents-grid">
                                @DocCard("Bank Confirmation Letter", SelfServiceDocumentType.BankConfirmationLetter, "di-thumb-blue", RequiresBankConfirmationLetter(), RequiresBankConfirmationLetter(), "Required: you changed the bank account, so a Bank Confirmation Letter must be attached.")
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="di-actions">
                @if (currentIndex > 0)
                {
                    <button class="di-btn di-btn-secondary" type="button" @onclick="Back" disabled="@isSaving">Back</button>
                }
                @if (currentIndex < visibleTabs.Count - 1)
                {
                    <button class="di-btn di-btn-primary" type="button" @onclick="NextAsync" disabled="@isSaving">Next</button>
                }
                else
                {
                    <button class="di-btn di-btn-primary" type="button" @onclick="SubmitAsync" disabled="@isSaving">Proceed</button>
                }
            </div>
        </EditForm>
    }

    @if (helpKey is not null && fieldHelp.TryGetValue(helpKey, out var help))
    {
        <div class="di-help-backdrop" @onclick="CloseHelp">
            <div class="di-help-pop" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <div class="di-help-head">
                    <h3 class="di-help-title">@help.Title</h3>
                    <button type="button" class="di-help-close" title="Close" @onclick="CloseHelp">&times;</button>
                </div>
                <p class="di-help-body">@help.Body</p>
            </div>
        </div>
    }

    @if (viewerUrl is not null)
    {
        <div class="di-viewer-backdrop" @onclick="CloseViewer">
            <div class="di-viewer" @onclick:stopPropagation="true">
                <div class="di-viewer-head">
                    <span class="di-viewer-name">@viewerName</span>
                    <button type="button" class="di-viewer-close" title="Close" @onclick="CloseViewer">&times;</button>
                </div>
                <iframe class="di-viewer-frame" src="@viewerUrl" title="Document preview"></iframe>
            </div>
        </div>
    }

    @if (showDeclaration)
    {
        <div class="di-decl-backdrop">
            <div class="di-decl" role="dialog" aria-modal="true">
                <div class="di-decl-head">
                    <h2 class="di-decl-title">@DeclarationTitle</h2>
                    <div class="di-decl-subtitle">@DeclarationSubtitle</div>
                </div>
                <div class="di-decl-body">
                    <p class="di-decl-section">Declaration (For true and correct information provided):</p>
                    <p>@GeneralDeclaration</p>

                    @if (!IsVatRegistered)
                    {
                        <p class="di-decl-section">Declaration &ndash; Non-Registration for VAT:</p>
                        @foreach (var para in VatNonRegistrationParagraphs)
                        {
                            <p>@para</p>
                        }
                    }

                    <p class="di-decl-certify">@DeclarationCertify</p>

                    <label class="di-decl-siglabel">Full Name (Digital Signature)</label>
                    <input type="text" class="di-decl-sig" @bind="declarationSignature" @bind:event="oninput"
                           placeholder="Type your full name here" />

                    <label class="di-decl-siglabel" style="margin-top:14px;">Sign here <span class="di-req">*</span></label>
                    <div class="di-sigpad-wrap">
                        <canvas id="di-sigpad" @ref="sigCanvas" class="di-sigpad"></canvas>
                        <button type="button" class="di-sigpad-clear" @onclick="ClearSignatureAsync" title="Clear signature">Clear</button>
                    </div>
                    <div class="di-sigpad-hint">Draw your signature in the box using your mouse (or finger on a touch screen).</div>
                </div>
                <div class="di-decl-actions">
                    <button type="button" class="di-btn di-btn-secondary" @onclick="CancelDeclaration" disabled="@isSaving">Cancel</button>
                    <button type="button" class="di-btn di-btn-primary" @onclick="ConfirmDeclarationAsync"
                            disabled="@(isSaving || string.IsNullOrWhiteSpace(declarationSignature))">
                        Agree &amp; Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SupplierFormBootstrapDto Bootstrap { get; set; } = default!;
    [Parameter, EditorRequired] public string SessionToken { get; set; } = "";

    private static readonly System.ComponentModel.DataAnnotations.EmailAddressAttribute EmailValidator = new();

    // Email fields validated per SETTINGS step number.
    private static readonly Dictionary<int, (string Key, string Label)[]> EmailFieldsByStep = new()
    {
        [2] = [("Email", "Business E-Mail")],
        [3] = [("ContactEmail", "Contacts E-Mail")],
        [5] = [("RemitAdviceEmail", "Remit Advice Email")]
    };

    private SupplierDto model = new();
    private int currentIndex;
    private bool isSaving;
    private bool submitted;
    private bool uploadingDocument;
    private string? uploadingFileName;
    private bool viewingDocument;
    private string? viewerUrl;
    private string? viewerName;

    // Declaration / signature (shown on Submit, matching the internal supplier form).
    private bool showDeclaration;
    private bool sigInitialized;
    private string declarationSignature = "";
    private ElementReference sigCanvas;

    // Write-through to the toast queue: setting errorMessage/statusMessage raises a toast. Getters null.
    private string? errorMessage { get => null; set => Toast.ShowError(value); }
    private string? statusMessage { get => null; set => Toast.ShowSuccess(value); }

    private List<LookupItemDto> taxOrgTypes = [], supplierTypes = [], countries = [], countriesWithPhoneCode = [],
        businessRelationships = [], provinces = [], vatCodes = [], paymentMethods = [], paymentTerms = [],
        prefixes = [], communicationMethods = [], currencies = [], licensingAuthorities = [],
        vatRegistrationTypes = [], businessPartnerTypes = [], businessLocationTypes = [], eInvoicingWaves = [];
    private List<BankDto> banks = [];
    private List<BusinessUnitDto> businessUnits = [];
    private List<SupplierDocumentDto> documents = [];

    private List<TabSettingDto> visibleTabs = [];
    private Dictionary<string, RenderFragment> fieldFragments = new();

    private HashSet<string> mandatoryKeys = [];
    private HashSet<string> hiddenKeys = [];
    private HashSet<string> changedKeys = [];
    private int? originalBankId;
    private string? originalAccountNumber;

    private List<BankBranchDto> SelectedBankBranches => banks.FirstOrDefault(b => b.Id == model.BankId)?.Branches ?? [];
    private List<SupplierDocumentDto> OtherDocuments => documents.Where(d => d.DocumentType == SelfServiceDocumentType.Other).ToList();
    private SupplierDocumentDto? GetDocument(SelfServiceDocumentType type) => documents.FirstOrDefault(d => d.DocumentType == type);

    // VAT Registered is a nullable bool rendered as a Yes/No/— select.
    private string VatRegisteredStr
    {
        get => model.VatRegistered switch { true => "true", false => "false", _ => "" };
        set => model.VatRegistered = value switch { "true" => true, "false" => false, _ => (bool?)null };
    }

    protected override void OnInitialized()
    {
        model = Bootstrap.Supplier;
        List<LookupItemDto> L(string k) => Bootstrap.Lookups.TryGetValue(k, out var v) ? v : [];
        taxOrgTypes = L("TaxOrganizationType"); supplierTypes = L("SupplierType"); countries = L("Country");
        provinces = L("Province"); vatCodes = L("VatCode"); paymentMethods = L("PaymentMethod");
        paymentTerms = L("PaymentTerms"); prefixes = L("Prefix"); currencies = L("Currency");
        businessRelationships = L("BusinessRelationship"); communicationMethods = L("CommunicationMethod");
        licensingAuthorities = L("LicensingAuthority"); vatRegistrationTypes = L("VatRegistrationType");
        businessPartnerTypes = L("BusinessPartnerType"); businessLocationTypes = L("BusinessLocationType");
        eInvoicingWaves = L("EInvoicingWave");
        countriesWithPhoneCode = countries.Where(c => !string.IsNullOrWhiteSpace(c.PhoneCode)).ToList();

        banks = Bootstrap.Banks;
        businessUnits = Bootstrap.BusinessUnits;
        documents = Bootstrap.Documents;
        mandatoryKeys = Bootstrap.FieldSettings.Where(f => f.IsMandatory && f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();
        hiddenKeys = Bootstrap.FieldSettings.Where(f => !f.IsVisibleToSupplier).Select(f => f.FieldKey).ToHashSet();
        changedKeys = Bootstrap.PendingEditedFieldKeys.ToHashSet();

        // Visible tabs, in configured order. Fall back to the steps that actually carry visible fields
        // (with generic titles) if no tab settings were provided.
        visibleTabs = Bootstrap.Tabs.Where(t => t.IsVisible).OrderBy(t => t.Step).ToList();
        if (visibleTabs.Count == 0)
        {
            visibleTabs = Bootstrap.FieldSettings
                .Where(f => f.IsVisibleToSupplier)
                .Select(f => f.Step).Distinct().OrderBy(s => s)
                .Select(s => new TabSettingDto { Step = s, Title = $"Section {s}", IsVisible = true })
                .ToList();
        }

        BuildFragments();

        originalBankId = model.BankId;
        originalAccountNumber = model.AccountNumber;
    }

    // Fields assigned to a step, in Sequence order, that are visible to the supplier and that this form
    // knows how to render (has a fragment for). Drives the exact set + order the admin configured.
    private IEnumerable<string> KeysForStep(int step) =>
        Bootstrap.FieldSettings
            .Where(f => f.Step == step && f.IsVisibleToSupplier && fieldFragments.ContainsKey(f.FieldKey))
            .OrderBy(f => f.Sequence)
            .Select(f => f.FieldKey);

    private string FieldClass(string key)
    {
        var classes = changedKeys.Contains(key) ? "di-field-changed" : "";
        if (hiddenKeys.Contains(key))
        {
            classes = string.IsNullOrEmpty(classes) ? "di-hidden-field" : classes + " di-hidden-field";
        }
        return classes;
    }

    private bool IsHidden(string key) => hiddenKeys.Contains(key);

    private bool IsOthersIssuingBody() =>
        licensingAuthorities.FirstOrDefault(l => l.Id == model.TradeLicenseIssuingBodyId)?.DisplayName?
            .Contains("Other", StringComparison.OrdinalIgnoreCase) == true;

    private RenderFragment Req(string key) => builder =>
    {
        if (mandatoryKeys.Contains(key))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "di-req");
            builder.AddContent(2, "*");
            builder.CloseElement();
        }
    };

    // ----- Field help pop-ups (same wording as the internal supplier form, sourced from the business Excel) -----
    private string? helpKey;
    private void ShowHelp(string fieldKey) => helpKey = fieldKey;
    private void CloseHelp() => helpKey = null;

    private static readonly Dictionary<string, (string Title, string Body)> fieldHelp = new()
    {
        ["SupplierName"] = ("Supplier Name (Legal Name)",
            "Enter name as per valid Trade License"),
        ["TaxRegistrationNumber"] = ("Tax Registration Number",
            "Tax Registration Number mentioned in the VAT Registration certificate"),
        ["VatRegistrationTypeId"] = ("VAT Registration Type",
            "Please select whether the supplier is part of a VAT Tax group or not"),
        ["VatGroup"] = ("VAT Group",
            "Number of Entities if VAT Group: Please mention number of entities part of the VAT tax group dealing with DI PJSC.\n\n" +
            "Legal Names of all Entities under the VAT Group: Please enter details of entities part of the VAT Tax Group as per " +
            "VAT Tax Group certificate dealing with DI PJSC."),
        ["SupplierTin"] = ("Supplier TIN",
            "Supplier TIN can be obtained from the Emaratax Portal. It is not the same as VAT TRN\n\n" +
            "How to obtain TIN from Emaratax Portal\n\n" +
            "1. Log in to your EmaraTax profile at www.eservices.tax.gov.ae.\n" +
            "2. View the profile of your entity.\n" +
            "3. From the left-side menu, click on E-Invoicing.\n" +
            "4. Your TIN (Tax Identification Number) will be displayed there for reference. 10 Digit number"),
        ["EInvoicingWaveId"] = ("eINvoicing Wave Applicability",
            "Revenue greater than or equal to AED 50million - Wave 1\n" +
            "Revenue less than AED 50million - Wave 2"),
        ["TradeLicenseIssuingBodyId"] = ("Trade License Issuing Body",
            "As per valid Trade License"),
        ["AddressLine1"] = ("Address Line 1",
            "Address as per valid Trade License"),
        ["AddressLine2"] = ("Address Line 2",
            "Address as per valid Trade License"),
        ["CityId"] = ("City",
            "As per valid Trade License"),
        ["CountryId"] = ("Country",
            "As per valid Trade License"),
    };

    /// <summary>Renders a small "info" button next to a label when help text exists for that field.</summary>
    private RenderFragment Help(string fieldKey) => builder =>
    {
        if (!fieldHelp.ContainsKey(fieldKey)) { return; }
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "di-help-btn");
        builder.AddAttribute(3, "title", "What's this?");
        builder.AddAttribute(4, "aria-label", "What's this?");
        builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => ShowHelp(fieldKey)));
        builder.AddEventStopPropagationAttribute(6, "onclick", true);
        builder.AddEventPreventDefaultAttribute(7, "onclick", true);
        builder.AddMarkupContent(8,
            "<svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\">" +
            "<path d=\"M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z\"/>" +
            "<path d=\"M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z\"/></svg>");
        builder.CloseElement();
    };

    private bool BankAccountChanged() =>
        model.BankId != originalBankId ||
        !string.Equals((model.AccountNumber ?? "").Trim(), (originalAccountNumber ?? "").Trim(), StringComparison.Ordinal);

    private bool HasTradeLicenseDocument() => documents.Any(d => d.DocumentType == SelfServiceDocumentType.TradeLicense);
    private bool HasBankFieldsVisible() => visibleTabs.Any(t => t.Step == 5);
    private bool RequiresBankConfirmationLetter() =>
        HasBankFieldsVisible() && BankAccountChanged() && !documents.Any(d => d.DocumentType == SelfServiceDocumentType.BankConfirmationLetter);

    private void OnBankChanged() => model.BankBranchId = null;
    private void Back() => currentIndex = Math.Max(0, currentIndex - 1);
    private void GoToIndex(int idx) => currentIndex = Math.Clamp(idx, 0, visibleTabs.Count - 1);

    // Fields only meaningful / required when the supplier is VAT registered (same rule as the internal form).
    private static readonly HashSet<string> VatDependentKeys =
        ["TaxRegistrationNumber", "VatRegistrationTypeId", "NumberOfVatGroupEntities", "VatGroupEntityNames", "SupplierTin"];

    private int? UaeCountryId =>
        countries.FirstOrDefault(c => c.DisplayName.Contains("United Arab Emirates", StringComparison.OrdinalIgnoreCase))?.Id;

    // UAE test for the alternate VAT-certificate address (drives its Emirate-LOV vs free-text city).
    private bool IsVatUaeCountry => model.VatCountryId is null || model.VatCountryId == UaeCountryId;

    // Cycles the "address same as Trade License / VAT Certificate" toggle: unset (—) → Yes → No → Yes …
    // Clears the alternate VAT-certificate address whenever the answer is not "No".
    private void ToggleAddressSameAsTradeLicense()
    {
        model.AddressSameAsTradeLicense = model.AddressSameAsTradeLicense switch
        {
            true => false,
            false => true,
            null => true,
        };
        if (model.AddressSameAsTradeLicense != false)
        {
            model.VatAddressLine1 = null;
            model.VatAddressLine2 = null;
            model.VatCityId = null;
            model.VatCityText = null;
            model.VatCountryId = null;
            model.VatPostalCode = null;
        }
    }

    // True when the value is exactly <length> digits (spaces/dashes ignored) — matches the internal form.
    private static bool IsDigits(string value, int length)
    {
        var d = value.Replace(" ", "").Replace("-", "");
        return d.Length == length && d.All(char.IsDigit);
    }

    // Circular progress: position within the visible tabs (matches the internal supplier form).
    private int ProgressPct =>
        visibleTabs.Count == 0 ? 0
        : (int)Math.Round(Math.Clamp(currentIndex + 1, 1, visibleTabs.Count) / (double)visibleTabs.Count * 100);

    // Per-step section description (mirrors the internal supplier form's di-section-desc text).
