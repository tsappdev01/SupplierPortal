@page "/supplier/self-service/{Token}/form"
@inject SupplierApiClient Api
@inject SelfServiceSession Session
@inject SelfServiceBranding Branding
@inject NavigationManager Nav

<PageTitle>Your details — Supplier Self-Service</PageTitle>

@if (loading)
{
    <div class="ss-state">
        <div class="ss-state-card">
            <div class="ss-spinner-ring" aria-hidden="true"></div>
            <h1 class="ss-state-title">Loading your details…</h1>
            <p class="ss-state-text">Securely retrieving your supplier information — this will only take a moment.</p>
        </div>
    </div>
}
else if (bootstrap is null)
{
    <div class="ss-state">
        <div class="ss-state-card">
            <div class="ss-state-icon" aria-hidden="true">
                <svg width="38" height="38" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="8" cy="8" r="6.4" />
                    <path d="M8 4.6V8l2.3 1.4" />
                </svg>
            </div>
            <h1 class="ss-state-title">Session expired</h1>
            <p class="ss-state-text">
                Your secure session has ended. For your protection, verification links time out after a
                period of inactivity.
            </p>
            <div class="ss-state-steps">
                <div class="ss-state-step"><span class="ss-state-step-num">1</span><span>Open the most recent email from Partner Connect.</span></div>
                <div class="ss-state-step"><span class="ss-state-step-num">2</span><span>Click your secure link again.</span></div>
                <div class="ss-state-step"><span class="ss-state-step-num">3</span><span>Enter the new verification code to continue.</span></div>
            </div>
        </div>
    </div>
}
else
{
    <SelfServiceWizard Bootstrap="bootstrap" SessionToken="@(Session.SessionToken!)" />
}

<style>
    .ss-state { display: flex; justify-content: center; padding: 48px 12px; }
    .ss-state-card {
        width: 100%; max-width: 480px; background: #fff; border: 1px solid #e2e5ea; border-radius: 14px;
        box-shadow: 0 10px 30px rgba(20, 34, 70, 0.08); padding: 40px 32px; text-align: center;
        animation: ss-state-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .ss-state-title { font-size: 24px; font-weight: 800; color: #1a2233; margin: 0 0 10px; letter-spacing: -0.01em; }
    .ss-state-text { font-size: 15px; line-height: 1.6; color: #46506b; margin: 0 auto; max-width: 400px; }
    .ss-state-icon {
        width: 72px; height: 72px; margin: 0 auto 18px; border-radius: 50%; display: flex; align-items: center;
        justify-content: center; color: #e8590c; background: linear-gradient(135deg, #fff3bf, #ffe3c2);
        box-shadow: 0 6px 18px rgba(232, 89, 12, 0.2); animation: ss-state-pulse 2s ease-in-out infinite;
    }
    .ss-state-steps { margin: 22px auto 0; max-width: 360px; text-align: left; display: flex; flex-direction: column; gap: 10px; }
    .ss-state-step { display: flex; align-items: center; gap: 12px; font-size: 14px; color: #35405c; }
    .ss-state-step-num {
        flex: none; width: 24px; height: 24px; border-radius: 50%; background: #eef1ff; color: #3b5bdb;
        font-size: 12.5px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center;
    }
    .ss-spinner-ring {
        width: 46px; height: 46px; margin: 0 auto 18px; border-radius: 50%;
        border: 4px solid #e7ebf3; border-top-color: #3b5bdb; animation: ss-spin 0.8s linear infinite;
    }
    @@keyframes ss-state-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes ss-state-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
    @@keyframes ss-spin { to { transform: rotate(360deg); } }
</style>

@code {
    [Parameter] public string Token { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool loading = true;
    private SupplierFormBootstrapDto? bootstrap;

    protected override async Task OnInitializedAsync()
    {
        // Restore the verified session from the HttpOnly cookie (survives refresh). Require it to belong
        // to THIS link so a stale cookie from another supplier's link can't load their data here.
        if (AuthState is not null)
        {
            Session.PopulateFrom((await AuthState).User);
        }
        if (!Session.IsActiveFor(Token))
        {
            Nav.NavigateTo($"/supplier/self-service/{Token}");
            return;
        }

        bootstrap = await Api.GetBootstrapAsync(Session.SessionToken!);
        loading = false;

        // Brand the header with the business-unit logo on this page's own circuit (survives the cookie
        // hand-off, which starts a fresh circuit where the Verify page's branding is gone).
        Branding.SetLogo(bootstrap?.BusinessUnit?.LogoUrl);

        // A null bootstrap means the session was rejected by the API (expired/revoked); clear it.
        if (bootstrap is null)
        {
            Session.Clear();
        }
    }
}
