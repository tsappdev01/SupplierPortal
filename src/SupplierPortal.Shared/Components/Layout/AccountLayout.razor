@inherits LayoutComponentBase

<LoadingBar @rendermode="InteractiveServer" />

<div class="account-layout">
    <div class="account-card">
        <div class="account-brand">
            <img src="/images/di-logo.png?v=20261022b" alt="Dubai Investments" class="account-brand-logo" />
        </div>
        @Body
    </div>
</div>

<style>
    .account-layout {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
        padding: 3rem 1rem;
        background-color: var(--di-page-bg, #f4f6f9);
    }

    .account-card {
        width: 100%;
        max-width: 420px;
        background: var(--di-surface, #fff);
        color: var(--di-text, #26303f);
        border-radius: 8px;
        border: 1px solid var(--di-border, #e2e5ea);
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        padding: 2rem;
    }

    .account-brand {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .account-brand-logo {
        height: 2.75rem;
        width: auto;
        border-radius: 4px;
    }
</style>
