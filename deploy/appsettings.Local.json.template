{
  "//": "Rename this file to appsettings.Local.json on the server and fill in real values. This file is git-ignored and must NEVER be committed. It overrides appsettings.json.",

  "ConnectionStrings": {
    "DefaultConnection": "Server=UATWEB01;Database=BP;User Id=bpuser;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  "//DefaultAdmin": "Optional: override the seeded default administrator (only used on first run, before a real Administrator exists).",
  "DefaultAdmin": {
    "Username": "admin",
    "Email": "admin@supplierportal.local",
    "Password": "Admin@12345"
  },

  "//DetailedErrors": "Set true only while troubleshooting; it exposes internal exception details to anyone who triggers an error.",
  "DetailedErrors": false,

  "//ActiveDirectory": "Internal-staff login via on-prem AD (LDAP). Set Enabled=true to turn it on. Users must be added by an administrator with Authentication = Active Directory and their AD login; the seeded local admin stays as break-glass. Use LDAPS (port 636) so passwords are never sent in clear text.",
  "ActiveDirectory": {
    "Enabled": false,
    "Host": "dc01.dipark.local",
    "Port": 636,
    "UseLdaps": true,
    "Domain": "dipark.local",
    "NetbiosName": "DIPARK",
    "LoginFormat": "UPN"
  },

  "//Ocr": "Cloud OCR for scanned/image trade-license PDFs (no embedded text). Set Provider=Azure and fill in the Azure AI Document Intelligence Endpoint + ApiKey to enable it; leave Provider empty to disable OCR. Text-based PDFs never call OCR.",
  "Ocr": {
    "Provider": "Azure",
    "Endpoint": "https://YOUR-RESOURCE.cognitiveservices.azure.com",
    "ApiKey": "CHANGE_ME",
    "ModelId": "prebuilt-read",
    "ApiVersion": "2024-11-30"
  },

  "//Sso": "Single sign-on via OpenID Connect (e.g. Microsoft Entra ID). Set Enabled=true and fill in Authority + ClientId + ClientSecret so the login screen federates to the IdP. The signed-in email must match an existing app user (create users first). ClientSecret is a secret - keep it only here, never in committed appsettings.",
  "Sso": {
    "Enabled": true,
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "ClientId": "<application-client-id>",
    "ClientSecret": "CHANGE_ME",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  }
}
